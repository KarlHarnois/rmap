(use json/value field json json->text parse-json)
(use support/scratch scratch-database)

(use process/command ->command ->command-output
                     command-output run-command)

(export database-with-roadmap error-code
        initialized-database reply research-id run-rmap
        run-rmap-pair run-rmap-text run-rmap-together
        text-at)

(defstruct reply
  :exit-code i32
  :json json)

(def binary-path "target/knave/rmap/rmap")

(rust-type child "std::process::Child")

(def spawn-raw
  (rust "std::process::Command::new({0}).args({1}).stdout(std::process::Stdio::piped()).spawn().map_err(|failure| failure.to_string())"
    (fn ((ref str) (ref (vec string)))
      (result child string))))

(def wait-raw
  (rust "{0}.wait_with_output().map(|output| (output.status.code().unwrap_or(-1), String::from_utf8_lossy(&output.stdout).to_string())).map_err(|failure| failure.to_string())"
    (fn (child)
      (result (pair i32 string) string))))

(def once
  (rust "{{ static BUILT: std::sync::OnceLock<bool> = std::sync::OnceLock::new(); *BUILT.get_or_init({0}) }}"
    (fn ((fn () bool)) bool)))

(defn build-succeeds? ()
  (= (:code (unwrap-ok (run-command (ref (->command :program (str "knave")
                                                    :args (vec (str
                                                                 "build")))))))
     0))

(defn built-binary ()
  (assert (once build-succeeds?))
  binary-path)

(type output->result (fn (command-output) reply))

(defn output->result (output)
  (->reply :exit-code (:code output)
           :json (unwrap-ok (parse-json (as-str (:stdout output))))))

(defn waited->result (waited)
  (let-match ((pair code text) waited)
    (->reply :exit-code code
             :json (unwrap-ok (parse-json (as-str text))))))

(defn rmap-command (database args)
  (->command :program (str (built-binary))
             :args (with-database database args)))

(defn run-rmap (database args)
  (output->result (unwrap-ok (run-command (ref (rmap-command database args))))))

(defn spawned (command)
  (unwrap-ok (spawn-raw (as-str (:program command))
                        (ref (:args command)))))

(defn run-rmap-pair (database first-args second-args)
  (let (first (spawned (rmap-command (clone database) first-args))
        second (spawned (rmap-command database second-args)))
    (pair (waited->result (unwrap-ok (wait-raw first)))
          (waited->result (unwrap-ok (wait-raw second))))))

(defn with-database (database args)
  (let (all (vec (str "--json") (str "--db") database))
    (for-each args
      (fn (arg) (push! all (str arg))))
    all))

(type run-rmap-together
  (fn (string (vec (ref str)) int)
    (vec reply)))

(defn run-rmap-together (database args copies)
  (let (children (vec))
    (for-each (range 0 copies)
      (fn (_)
        (push! children
               (spawned (rmap-command (clone database) (clone args))))))
    (waited-replies children)))

(defn waited-replies (children)
  (let (pending children
        replies (vec))
    (for-each (range 0 (len pending))
      (fn (_)
        (push! replies
               (waited->result (unwrap-ok (wait-raw (unwrap (pop!
                                                              pending))))))))
    replies))

(defn text-at (reply object key)
  (-> (:json reply)
      (field object)
      unwrap
      (field key)
      unwrap json->text unwrap))

(defn error-code (reply) (text-at reply "error" "code"))

(defn initialized-database (name)
  (let (database (scratch-database name))
    (assert (= (:exit-code (run-rmap (clone database) (vec "init")))
               0))
    database))

(defn database-with-roadmap (name)
  (let (database (initialized-database name))
    (assert (= (:exit-code (run-rmap (clone database)
                                     (vec "new" "road" "--manager" "m1")))
               0))
    database))

(defn research-id (database)
  (let (added (run-rmap (clone database)
                        (vec "item" "add" "--roadmap" "road"
                             "--title" "r" "--kind"
                             "research")))
    (assert (= (:exit-code added) 0))
    (text-at (ref added) "item" "id")))

(def run-without-json-variable-raw
  (rust "std::process::Command::new({0}).args({1}).env_remove(\"RMAP_JSON\").output().map(|output| (output.status.code().unwrap_or(-1), (String::from_utf8_lossy(&output.stdout).to_string(), String::from_utf8_lossy(&output.stderr).to_string()))).map_err(|failure| failure.to_string())"
    (fn ((ref str) (ref (vec string)))
      (result (pair i32 (pair string string)) string))))

(type run-rmap-text
  (fn ((vec (ref str))) command-output))

(defn run-rmap-text (args)
  (let-match ((pair code (pair stdout stderr)) (unwrap-ok (run-without-json-variable-raw
                                                            (built-binary)
                                                            (ref (collect
                                                                   (map (iter
                                                                          args)
                                                                        (fn (arg)
                                                                          (str arg))))))))
    (->command-output :code code :stdout stdout :stderr stderr)))
