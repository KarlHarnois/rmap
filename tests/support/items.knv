(use ledger/names kind-names status-names)
(use ledger/model/sessions ->session-start)

(use ledger/model ->decision-block ->decision-id ->dep
                  ->item ->item-id ->roadmap ->roadmap-id
                  ->session ->snapshot ->timestamp
                  ->work-session claim dep-type item kind
                  origin roadmap-status runtime session-kind
                  status)

(export blocks-dep child-of claimed decision-block-on
        discovered-dep epic-item id-of in-roadmap kinds
        paused-roadmap-of paused-snapshot-of roadmap-of
        session-start-named snapshot-of statuses titled
        with-origin work-item work-session-named)

(defn epic-item (id) (work-item id kind/epic status/open))

(defn work-item (id kind status)
  (->item :id (id-of id)
          :roadmap-id (->roadmap-id :value (str "rm-road"))
          :roadmap-name (str "road")
          :parent none
          :title (str "work")
          :description none
          :criteria (vec)
          :kind kind
          :status status
          :origin origin/planned
          :priority 0
          :claim claim/unclaimed
          :created-at (->timestamp :value (str "2026-01-01T00:00:00Z"))
          :closed-at none))

(type child-of
  (fn (item (ref str)) item))

(defn child-of (item epic-id)
  (assoc item :parent (some (id-of epic-id))))

(defn claimed (item)
  (assoc item
         :claim (claim/claimed-by (work-session-named "worker"))))

(defn session-start-named (name)
  (->session-start :session (->session :name (str name))
                   :branch (str name)
                   :base (str "main")))

(defn work-session-named (name)
  (->work-session :session (->session :name (str name))
                  :kind session-kind/work
                  :runtime runtime/ringleader
                  :branch (some (str name))
                  :base (some (str "main"))
                  :started-at (->timestamp :value (str
                                                    "2026-01-01T00:00:00Z"))))

(type in-roadmap
  (fn (item (ref str)) item))

(defn in-roadmap (item roadmap-id)
  (assoc item
         :roadmap-id (->roadmap-id :value (str roadmap-id))
         :roadmap-name (str roadmap-id)))

(type titled (fn (item (ref str)) item))

(defn titled (item title)
  (assoc item :title (str title)))

(type with-origin (fn (item origin) item))

(defn with-origin (item origin) (assoc item :origin origin))

(defn discovered-dep (item on)
  (->dep :item (id-of item)
         :on (id-of on)
         :type dep-type/discovered-from))

(defn decision-block-on (decision item status)
  (->decision-block :decision (->decision-id :value (str decision))
                    :item (id-of item)
                    :status status))

(defn blocks-dep (item on)
  (->dep :item (id-of item)
         :on (id-of on)
         :type dep-type/blocks))

(defn id-of (text)
  (->item-id :value (str text)))

(defn snapshot-of (items deps)
  (->snapshot :roadmaps (vec)
              :items items
              :deps deps
              :decision-blocks (vec)))

(defn paused-snapshot-of (items deps)
  (->snapshot :roadmaps (vec (paused-roadmap-of "rm-road" "manager"))
              :items items
              :deps deps
              :decision-blocks (vec)))

(defn paused-roadmap-of (id manager)
  (assoc (roadmap-of id manager)
         :status roadmap-status/paused))

(defn roadmap-of (id manager)
  (->roadmap :id (->roadmap-id :value (str id))
             :name (str id)
             :manager (->session :name (str manager))
             :status roadmap-status/active
             :created-at (->timestamp :value (str "2026-01-01T00:00:00Z"))))

(defn statuses ()
  (collect (map (iter status-names)
             (fn (entry) (first (deref entry))))))

(defn kinds ()
  (collect (map (iter kind-names)
             (fn (entry) (first (deref entry))))))
