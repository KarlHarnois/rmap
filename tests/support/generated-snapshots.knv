(use ledger/model kind status)

(use support/items blocks-dep child-of claimed in-roadmap
                   snapshot-of statuses work-item)

(export generated-roadmap-ids generated-snapshot)

(def generated-roadmap-ids (vec "rm-road" "rm-other"))

(def item-count 9)

(defstruct rolls
  :for-kind int
  :for-status int
  :for-claim int
  :for-parent int
  :for-dep int
  :for-roadmap int)

(defn generated-snapshot (seed)
  (loop (index 0
         state (next-state seed)
         items (vec (work-item "rm-1000" kind/epic status/open))
         deps (vec))
    (if (< index item-count)
      (let (rolls (rolls-after state)
            id (id-at (inc index)))
        (recur (inc index)
               (:for-roadmap rolls)
               (appended items
                         (generated-item (as-str id) (ref rolls)))
               (appended-some
                 deps
                 (generated-dep (as-str id) index (:for-dep rolls)))))
      (snapshot-of items deps))))

(defn rolls-after (state)
  (let (kind (next-state state)
        status (next-state kind)
        claim (next-state status)
        parent (next-state claim)
        dep (next-state parent)
        roadmap (next-state dep))
    (->rolls :for-kind kind
             :for-status status
             :for-claim claim
             :for-parent parent
             :for-dep dep
             :for-roadmap roadmap)))

(defn next-state (state)
  (rem (+ (* state 1103515245) 12345) 2147483648))

(defn generated-item (id rolls)
  (let (kind (choice (vec kind/research kind/design kind/build)
                     (:for-kind rolls))
        status (choice (statuses) (:for-status rolls))
        base (work-item id kind status)
        parented (with-parent base (:for-parent rolls))
        placed (in-roadmap parented
                           (choice generated-roadmap-ids (:for-roadmap rolls))))
    (with-claim placed (:for-claim rolls))))

(defn choice (items roll)
  (deref (unwrap (get items
                      (convert (pick roll
                                     (the int (convert (len items)))))))))

(defn with-parent (item roll)
  (if (= (pick roll 3) 0)
    (child-of item "rm-1000")
    item))

(defn with-claim (item roll)
  (if (= (pick roll 5) 0)
    (claimed item)
    item))

(defn generated-dep (id index roll)
  (if (> index 0)
    (some (blocks-dep id
                      (as-str (id-at (pick roll (inc index))))))
    none))

(defn pick (state option-count)
  (rem (/ state 65536) option-count))

(defn id-at (index)
  (str "rm-" (+ 1000 index)))

(defn appended-some (items extra)
  (match extra
    ((some present) (appended items present))
    (none items)))

(defn appended (items extra)
  (let (all items) (push! all extra) all))
