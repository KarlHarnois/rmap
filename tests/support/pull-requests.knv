(use ledger/api ->review-request ->review-start-request
                ->session ->verify-request criterion-result
                record-report record-review report-kind
                start-review verify-criterion)

(use ledger/model/pull-requests review-kind verdict)
(use support/report-requests report-as worker-of)

(export approved-build first-head in-review-build
        pr-report-as review-as review-start-as reviewed
        second-head start-review-result)

(def first-head "1111111111111111111111111111111111111111")

(def second-head "2222222222222222222222222222222222222222")

(defn approved-build (settings id number)
  (reviewed settings
            (ref (in-review-build settings id number))
            "reviewer" verdict/approve first-head))

(defn in-review-build (settings id number)
  (assert (ok? (record-report settings
                              (pr-report-as id
                                            report-kind/done
                                            (some number)
                                            (some (str first-head))))))
  (clone id))

(defn reviewed (settings id reviewer verdict head)
  (review-start-as settings id reviewer)
  (verify-met settings id reviewer head)
  (assert (ok? (record-review settings
                              (review-as id reviewer verdict head))))
  (clone id))

(defn review-start-as (settings id reviewer)
  (assert (ok? (start-review-result settings id reviewer)))
  (clone id))

(defn start-review-result (settings id reviewer)
  (start-review settings (review-start-request id reviewer)))

(defn pr-report-as (id kind number head)
  (assoc (report-as id (as-str (worker-of id)) kind "built it")
         :pr number
         :head head))

(defn review-as (id reviewer verdict head)
  (->review-request :item (clone id)
                    :reviewer (->session :name (str reviewer))
                    :kind review-kind/behavior
                    :head (str head)
                    :verdict verdict))

(defn verify-met (settings id reviewer head)
  (let (verdict (->verify-request :item (clone id)
                                  :position 1
                                  :verdict criterion-result/met
                                  :reviewer (->session :name (str reviewer))
                                  :head (some (str head))
                                  :note none))
    (assert (ok? (verify-criterion settings verdict)))))

(defn review-start-request (id reviewer)
  (->review-start-request :item (clone id)
                          :reviewer (->session :name (str reviewer))))
