(use ledger/model ->timestamp)

(use ledger/api ->advancement ->glob ->new-item ->session
                ->settings add-item advance-item claim-item
                clock description-input failure-code glob
                init-ledger kind kind-change new-roadmap
                origin status)

(use support/scratch scratch-database)

(export added-id advanced blocked-research
        blocked-research-in claimed fixed-clock-settings
        globs-of-patterns initialized-settings item-draft
        ledger-with-two-roadmaps other-roadmap-name
        refusal-code-of reported-research research
        research-in roadmap-name scratch-ledger
        session-named)

(def roadmap-name "road")

(def other-roadmap-name "other")

(defn ledger-with-two-roadmaps (name)
  (let (settings (scratch-ledger name))
    (assert (ok? (new-roadmap (ref settings)
                              (str other-roadmap-name)
                              (session-named "other-manager"))))
    settings))

(defn scratch-ledger (name)
  (let (settings (initialized-settings name))
    (assert (ok? (new-roadmap (ref settings)
                              (str roadmap-name)
                              (session-named "manager"))))
    settings))

(defn initialized-settings (name)
  (let (settings (fixed-clock-settings (scratch-database name)))
    (assert (ok? (init-ledger (ref settings))))
    settings))

(defn fixed-clock-settings (database)
  (->settings :database-path database
              :clock (clock/fixed (->timestamp :value (str "2026-03-03T00:00:00Z")))
              :actor (str "tester")))

(defn research (settings)
  (research-in settings roadmap-name))

(defn research-in (settings roadmap)
  (added-id-in settings roadmap
               (item-draft kind/research (vec))))

(defn blocked-research (settings blocker)
  (blocked-research-in settings roadmap-name blocker))

(defn blocked-research-in (settings roadmap blocker)
  (added-id-in settings roadmap
               (assoc (item-draft kind/research (vec))
                      :blocked-by (vec blocker))))

(defn reported-research (settings patterns)
  (advanced settings
            (claimed settings
                     (added-id settings
                               (item-draft kind/research
                                           (globs-of-patterns patterns))))
            status/reported))

(type globs-of-patterns
  (fn ((vec (ref str))) (vec glob)))

(defn globs-of-patterns (patterns)
  (collect (map (iter patterns)
             (fn (pattern)
               (->glob :pattern (str pattern))))))

(defn item-draft (kind globs)
  (->new-item :parent none
              :title (str "work")
              :description description-input/unspecified
              :kind kind
              :origin origin/planned
              :priority 0
              :globs globs
              :blocked-by (vec)
              :discovered-from none))

(defn added-id (settings draft)
  (added-id-in settings roadmap-name draft))

(defn claimed (settings id)
  (assert (ok? (claim-item settings (clone id) (session-named "worker"))))
  id)

(defn session-named (name)
  (->session :name (str name)))

(defn advanced (settings id target)
  (assert (ok? (advance-item settings
                             (clone id)
                             (->advancement
                               :to target
                               :kind-change kind-change/keep-kind))))
  id)

(defn refusal-code-of (outcome)
  (match outcome
    ((ok _) none)
    ((err failure) (some (failure-code (ref failure))))))

(defn added-id-in (settings roadmap draft)
  (clone (:id (unwrap-ok (add-item settings (str roadmap) draft)))))
