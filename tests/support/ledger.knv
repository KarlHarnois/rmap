(use ledger/model/reports report-kind)
(use ledger/model ->timestamp kind)

(use ledger/api ->advancement ->claim-request ->log-query
                ->new-item ->report-request ->session
                ->settings add-item advance-item body-source
                claim-item clock criteria-input
                description-input failure-code init-ledger
                item-id kind-change new-roadmap origin
                read-log record-report)

(use support/scratch scratch-database scratch-directory)

(export added-id advanced all-events blocked-research
        blocked-research-in claim-by claimed
        fixed-clock-settings initialized-settings item-draft
        ledger-with-two-roadmaps other-roadmap-name
        refusal-code-of reported reported-research research
        research-in roadmap-name scratch-ledger
        session-named)

(def roadmap-name "road")

(def other-roadmap-name "other")

(defn ledger-with-two-roadmaps (name)
  (let (settings (scratch-ledger name))
    (assert (ok? (new-roadmap (ref settings)
                              (str other-roadmap-name)
                              (session-named "other-manager"))))
    settings))

(defn scratch-ledger (name)
  (let (settings (initialized-settings name))
    (assert (ok? (new-roadmap (ref settings)
                              (str roadmap-name)
                              (session-named "manager"))))
    settings))

(defn initialized-settings (name)
  (let (settings (fixed-clock-settings (scratch-database name)))
    (assert (ok? (init-ledger (ref settings))))
    settings))

(defn fixed-clock-settings (database)
  (->settings :database-path database
              :repository (scratch-directory)
              :clock (clock/fixed (->timestamp :value (str "2026-03-03T00:00:00Z")))
              :actor (str "tester")))

(defn research (settings)
  (research-in settings roadmap-name))

(defn research-in (settings roadmap)
  (added-id-in settings roadmap (item-draft kind/research)))

(defn blocked-research (settings blocker)
  (blocked-research-in settings roadmap-name blocker))

(defn blocked-research-in (settings roadmap blocker)
  (added-id-in settings roadmap
               (assoc (item-draft kind/research) :blocked-by (vec blocker))))

(defn reported-research (settings)
  (reported settings
            (claimed settings
                     (added-id settings (item-draft kind/research)))))

(defn reported (settings id)
  (assert (ok? (record-report settings
                              (->report-request :item (clone id)
                                                :session (session-named (worker-name
                                                                          (ref id)))
                                                :kind report-kind/done
                                                :body (body-source/text (str "found it"))
                                                :pr none
                                                :head none))))
  id)

(defn item-draft (kind)
  (->new-item :parent none
              :title (str "work")
              :description (description-input/text (str "a spec"))
              :criteria (criteria-input/values (vec (str "a criterion")))
              :kind kind
              :origin origin/planned
              :priority 0
              :blocked-by (vec)
              :discovered-from none))

(defn added-id (settings draft)
  (added-id-in settings roadmap-name draft))

(defn claimed (settings id)
  (assert (ok? (claim-item settings
                           (clone id)
                           (claim-by (as-str (worker-name (ref id)))))))
  id)

(defn session-named (name)
  (->session :name (str name)))

(defn claim-by (name)
  (->claim-request :session (session-named name)
                   :branch none
                   :base none))

(defn advanced (settings id target)
  (assert (ok? (advance-item settings
                             (clone id)
                             (->advancement
                               :to target
                               :kind-change kind-change/keep-kind))))
  id)

(defn refusal-code-of (outcome)
  (match outcome
    ((ok _) none)
    ((err failure) (some (failure-code (ref failure))))))

(defn all-events (settings)
  (read-log settings
            (ref (->log-query :item none :decision none :after-id 0))))

(defn added-id-in (settings roadmap draft)
  (clone (:id (unwrap-ok (add-item settings (str roadmap) draft)))))

(type worker-name
  (fn ((ref item-id)) string))

(defn worker-name (id)
  (str "worker-" (:value id)))
