(export scratch-database)

(def scratch-path
  (rust "(|| -> String {{ let directory = std::env::temp_dir().join(format!(\"rmap-tests-{{}}\", std::process::id())); std::fs::create_dir_all(&directory).ok(); let path = directory.join(format!(\"{{}}.db\", {0})); for suffix in [\"\", \"-wal\", \"-shm\"] {{ std::fs::remove_file(format!(\"{{}}{{}}\", path.display(), suffix)).ok(); }} path.display().to_string() }})()"
    (fn ((ref str)) string)))

(defn scratch-database (name) (scratch-path name))
