(export scratch-database scratch-directory)

(def temp-directory
  (rust "std::env::temp_dir().display().to_string()"
    (fn () string)))

(def process-id
  (rust "std::process::id()" (fn () u32)))

(def create-directory
  (rust "drop(std::fs::create_dir_all({0}))"
    (fn ((ref str)) unit)))

(def remove-file
  (rust "drop(std::fs::remove_file({0}))"
    (fn ((ref str)) unit)))

(def database-file-suffixes (vec "" "-wal" "-shm"))

(defn scratch-database (name)
  (let (directory (scratch-directory)
        path (str directory "/" name ".db"))
    (create-directory (as-str directory))
    (for-each database-file-suffixes
      (fn (suffix)
        (remove-file (as-str (str path suffix)))))
    path))

(defn scratch-directory ()
  (str (temp-directory) "/rmap-tests-" (process-id)))
