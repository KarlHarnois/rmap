(use json/value field json->text)
(use support/rmap run-rmap)

(export approved-on-first-head build-id first-sha
        report-build review-build second-sha)

(def first-sha "1111111111111111111111111111111111111111")

(def second-sha "2222222222222222222222222222222222222222")

(defn build-id (database)
  (let (added (run-rmap (clone database)
                        (vec "item" "add" "--roadmap" "road"
                             "--title" "b" "--kind"
                             "build")))
    (assert (= (:exit-code added) 0))
    (let (id (unwrap (json->text (ref (unwrap (field (ref (unwrap (field
                                                                    (ref (:json added))
                                                                    "item")))
                                                     "id"))))))
      (assert (= (:exit-code
                   (run-rmap (clone database)
                             (vec "item" "claim" (as-str id) "--session" "s1")))
                 0))
      id)))

(defn approved-on-first-head (database id)
  (assert (= (:exit-code (report-build database id "done"
                                       (vec "--pr" "1" "--head" first-sha)))
             0))
  (assert (= (:exit-code (review-build database id "r1" "approve" first-sha))
             0)))

(defn report-build (database id kind extra)
  (let (args (vec (str "report")
                  (clone id)
                  (str "--session")
                  (str "s1")
                  (str "--kind")
                  (str kind)
                  (str "--text")
                  (str "built it")))
    (for-each extra
      (fn (arg) (push! args (str arg))))
    (run-rmap (clone database) args)))

(defn review-build (database id reviewer verdict sha)
  (run-rmap (clone database)
            (vec "pr" "review"
                 (as-str id)
                 "--verdict" verdict "--kind" "behavior"
                 "--head" sha "--reviewer" reviewer)))
