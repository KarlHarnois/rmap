(use json/value field json->text)

(use support/process run-rmap run-rmap-pair
                     scratch-database)

(def rounds 20)

(defn item-id-of (result)
  (-> (:output result)
      (field "item")
      unwrap
      (field "id")
      unwrap json->text unwrap))

(defn racing-ledger ()
  (let (database (scratch-database "claim-race"))
    (run-rmap (clone database)
              (vec "new" "road" "--manager" "m1"))
    database))

(defn add-research (database)
  (item-id-of (ref (run-rmap (clone database)
                             (vec "item" "add" "--roadmap"
                                  "road" "--title" "race"
                                  "--kind" "research")))))

(defn winners (database item)
  (let-match ((pair first second) (run-rmap-pair
                                    (clone database)
                                    (vec "item" "claim"
                                         (as-str item)
                                         "--session" "left")
                                    (vec "item" "claim"
                                         (as-str item)
                                         "--session"
                                         "right")))
    (assert (and (<= (:exit-code first) 1)
                 (<= (:exit-code second) 1)))
    (+ (if (= (:exit-code first) 0) 1 0)
       (if (= (:exit-code second) 0) 1 0))))

(deftest two-processes-claiming-one-item-leave-exactly-one-winner
  (let (database (racing-ledger))
    (for-each (range 0 rounds)
      (fn (_)
        (assert (= (winners (ref database)
                            (add-research (ref database)))
                   1))))))
