(use json/value field json->int json->items json->text)

(use support/process command-result run-rmap
                     scratch-database)

(defn rmap (database args)
  (run-rmap (clone database) args))

(defn text-at (result object key)
  (-> (:output result)
      (field object)
      unwrap
      (field key)
      unwrap json->text unwrap))

(defn error-code (result) (text-at result "error" "code"))

(type refused-with?
  (fn ((ref command-result) (ref str))
    bool))

(defn refused-with? (result code)
  (and (= (:exit-code result) 1)
       (= (error-code result) code)))

(defn new-item (database args)
  (let (result (rmap database args))
    (assert (= (:exit-code result) 0))
    (text-at (ref result) "item" "id")))

(defn ledger (name)
  (let (database (scratch-database name))
    (assert (= (:exit-code (rmap database (vec "new" "road" "--manager" "m1")))
               0))
    database))

(defn build-item (database pattern)
  (new-item database
            (vec "item" "add" "--roadmap" "road" "--title"
                 "b" "--kind" "build" "--paths" pattern)))

(defn research-item (database)
  (new-item database
            (vec "item" "add" "--roadmap" "road" "--title"
                 "r" "--kind" "research")))

(defn epic-item (database)
  (new-item database
            (vec "item" "add" "--roadmap" "road" "--title"
                 "e" "--kind" "epic")))

(deftest a-done-command-exits-zero-with-schema-version
  (let (result (rmap (scratch-database "done")
                     (vec "new" "road" "--manager" "m1")))
    (assert (= (:exit-code result) 0))
    (assert (= (json->int (unwrap (field (:output result) "schema_version")))
               (some 1)))
    (assert (= (text-at (ref result) "roadmap" "manager") "m1"))))

(deftest an-unknown-command-is-a-usage-error
  (let (result (rmap (scratch-database "usage") (vec "frobnicate")))
    (assert (= (:exit-code result) 2))
    (assert (= (error-code (ref result)) "usage"))))

(deftest a-missing-required-flag-is-a-usage-error
  (assert (= (:exit-code (rmap (ledger "missing-flag")
                               (vec "item" "claim" "rm-0000")))
             2)))

(deftest an-unknown-status-is-a-usage-error
  (assert (= (:exit-code (rmap (ledger "unknown-status")
                               (vec "item" "advance" "rm-0000" "ready")))
             2)))

(deftest an-unopenable-database-exits-three
  (let (result (run-rmap (str "/nonexistent/rmap/ledger.db") (vec "list")))
    (assert (= (:exit-code result) 3))
    (assert (= (error-code (ref result)) "database"))))

(deftest a-duplicate-roadmap-is-refused
  (assert (refused-with? (ref (rmap (ledger "duplicate")
                                    (vec "new" "road" "--manager" "m2")))
                         "roadmap-exists")))

(deftest an-unknown-roadmap-is-refused
  (assert (refused-with? (ref (rmap (ledger "no-roadmap")
                                    (vec "ready" "--roadmap" "nope")))
                         "roadmap-not-found")))

(deftest an-unknown-item-is-refused
  (assert (refused-with? (ref (rmap (ledger "no-item")
                                    (vec "item" "show" "rm-ffff")))
                         "item-not-found")))

(deftest a-build-without-paths-is-refused
  (assert (refused-with? (ref (rmap (ledger "no-paths")
                                    (vec "item" "add"
                                         "--roadmap" "road"
                                         "--title" "b"
                                         "--kind" "build")))
                         "build-needs-paths")))

(deftest an-epic-with-a-parent-is-refused
  (let (database (ledger "epic-parent")
        epic (epic-item database))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "add" "--roadmap"
                              "road" "--title" "e2" "--kind"
                              "epic" "--parent"
                              (as-str epic))))
              "epic-has-parent"))))

(deftest a-parent-that-is-not-an-epic-is-refused
  (let (database (ledger "parent-not-epic")
        research (research-item database))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "add" "--roadmap"
                              "road" "--title" "c" "--kind"
                              "research" "--parent"
                              (as-str research))))
              "parent-not-epic"))))

(deftest a-parent-in-another-roadmap-is-refused
  (let (database (ledger "parent-other")
        epic (epic-item database))
    (assert (= (:exit-code (rmap database (vec "new" "other" "--manager" "m2")))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "add" "--roadmap"
                              "other" "--title" "c" "--kind"
                              "research" "--parent"
                              (as-str epic))))
              "parent-in-other-roadmap"))))

(deftest claiming-an-epic-is-refused
  (let (database (ledger "claim-epic")
        epic (epic-item database))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "claim" (as-str epic) "--session" "s1")))
              "epic-status-computed"))))

(deftest an-invalid-transition-is-refused
  (let (database (ledger "invalid-transition")
        item (research-item database))
    (assert (refused-with? (ref (rmap database
                                      (vec "item" "close" (as-str item))))
                           "invalid-transition"))))

(deftest a-research-item-cannot-enter-review
  (let (database (ledger "research-review")
        item (research-item database))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "claim" (as-str item) "--session" "s1")))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "advance" (as-str item) "in_review")))
              "invalid-transition"))))

(deftest claiming-a-blocked-item-is-refused
  (let (database (ledger "blocked-claim")
        blocker (research-item database)
        blocked (new-item database
                          (vec "item" "add" "--roadmap"
                               "road" "--title" "x" "--kind"
                               "research" "--after"
                               (as-str blocker))))
    (assert (refused-with?
              (ref (rmap
                     database
                     (vec "item" "claim" (as-str blocked) "--session" "s1")))
              "not-ready"))))

(deftest claiming-a-path-conflicted-build-is-refused
  (let (database (ledger "conflict-claim")
        holder (build-item database "src/a/**")
        waiting (build-item database "src/a/b.rs"))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "claim" (as-str holder) "--session" "s1")))
               0))
    (assert (refused-with?
              (ref (rmap
                     database
                     (vec "item" "claim" (as-str waiting) "--session" "s2")))
              "not-ready"))))

(deftest claiming-a-claimed-item-is-refused
  (let (database (ledger "double-claim")
        item (research-item database))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "claim" (as-str item) "--session" "s1")))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "claim" (as-str item) "--session" "s2")))
              "invalid-transition"))))

(deftest becoming-a-build-on-held-paths-is-refused
  (let (database (ledger "build-conflict")
        holder (build-item database "src/**")
        research (research-item database))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "claim" (as-str holder) "--session" "s1")))
               0))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "claim" (as-str research) "--session" "s2")))
               0))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "advance" (as-str research) "reported")))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "advance"
                              (as-str research)
                              "dispatched" "--kind" "build"
                              "--paths" "src/x.rs")))
              "path-conflict"))))

(deftest becoming-a-build-without-paths-is-refused
  (let (database (ledger "build-no-paths")
        research (research-item database))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "claim" (as-str research) "--session" "s1")))
               0))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "advance" (as-str research) "reported")))
               0))
    (assert (refused-with? (ref (rmap database
                                      (vec "item" "advance"
                                           (as-str research)
                                           "dispatched"
                                           "--kind"
                                           "build")))
                           "build-needs-paths"))))

(deftest a-two-edge-cycle-is-refused
  (let (database (ledger "cycle-two")
        first (research-item database)
        second (research-item database))
    (assert (= (:exit-code (rmap
                             database
                             (vec "dep" "add" (as-str first) (as-str second))))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "dep" "add" (as-str second) (as-str first))))
              "cycle"))))

(deftest a-three-edge-cycle-is-refused
  (let (database (ledger "cycle-three")
        first (research-item database)
        second (research-item database)
        third (research-item database))
    (assert (= (:exit-code (rmap
                             database
                             (vec "dep" "add" (as-str first) (as-str second))))
               0))
    (assert (= (:exit-code (rmap
                             database
                             (vec "dep" "add" (as-str second) (as-str third))))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "dep" "add" (as-str third) (as-str first))))
              "cycle"))))

(deftest a-duplicate-dep-is-refused
  (let (database (ledger "dep-exists")
        first (research-item database)
        second (research-item database))
    (assert (= (:exit-code (rmap
                             database
                             (vec "dep" "add" (as-str first) (as-str second))))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "dep" "add" (as-str first) (as-str second))))
              "dep-exists"))))

(deftest removing-a-missing-dep-is-refused
  (let (database (ledger "dep-missing")
        first (research-item database)
        second (research-item database))
    (assert (refused-with?
              (ref (rmap database
                         (vec "dep" "rm" (as-str first) (as-str second))))
              "dep-not-found"))))

(deftest dropping-a-dropped-item-is-refused
  (let (database (ledger "drop-twice")
        item (research-item database))
    (assert (= (:exit-code
                 (rmap database
                       (vec "item" "drop" (as-str item) "--reason" "obsolete")))
               0))
    (assert (refused-with?
              (ref (rmap database
                         (vec "item" "drop" (as-str item) "--reason" "again")))
              "invalid-transition"))))

(deftest every-write-appends-an-event
  (let (database (ledger "events")
        item (research-item database)
        _ (rmap database
                (vec "item" "claim" (as-str item) "--session" "s1"))
        log (rmap database (vec "log" "--item" (as-str item))))
    (assert (= (len (unwrap (json->items (unwrap (field (:output log)
                                                        "events")))))
               2))))
