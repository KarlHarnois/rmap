(use ledger/core/paths conflict?)
(use support/items glob-of)

(defn conflicting? (left right)
  (conflict? (ref (glob-of left))
             (ref (glob-of right))))

(deftest a-directory-glob-conflicts-with-a-file-inside-it
  (assert (conflicting? "src/a/**" "src/a/b.rs"))
  (assert (conflicting? "src/a/b.rs" "src/a/**")))

(deftest sibling-directories-do-not-conflict
  (assert (not (conflicting? "src/a/*" "src/b/*"))))

(deftest a-shorter-literal-prefix-conflicts
  (assert (conflicting? "src/*" "src/a/?.rs")))

(deftest every-wildcard-ends-the-literal-prefix
  (assert (conflicting? "src/a[bc]" "src/ax"))
  (assert (conflicting? "src/{a,b}" "src/z"))
  (assert (conflicting? "src/?" "src/q")))

(deftest identical-files-conflict
  (assert (conflicting? "README.md" "README.md")))
