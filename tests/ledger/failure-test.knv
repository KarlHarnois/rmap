(use ledger/failure failure failure-code failure-message)
(use ledger/refusal refusal)

(use ledger/sqlite/connection ->database-error
                              database-problem)

(use ledger/sqlite/schema-versions ->schema-versions)

(deftest a-refusal-reports-its-refusal-code
  (assert (= (failure-code (failure/refused refusal/epic-has-parent))
             (str "epic-has-parent"))))

(deftest a-lock-timeout-reports-busy
  (assert (= (failure-code (failure/database (->database-error
                                               :problem database-problem/busy
                                               :message (str "locked"))))
             (str "busy"))))

(deftest any-other-database-error-reports-database
  (assert (= (failure-code (failure/database (->database-error
                                               :problem database-problem/failed
                                               :message (str "corrupt"))))
             (str "database"))))

(deftest a-missing-ledger-reports-no-ledger
  (assert (= (failure-code (failure/no-ledger (str "/tmp/ledger.db")))
             (str "no-ledger"))))

(deftest a-missing-repository-reports-no-repository
  (assert (= (failure-code (failure/no-repository (str "not a git repository")))
             (str "no-repository"))))

(deftest an-unreadable-description-reports-its-code-and-message
  (let (failed (failure/description-unreadable (str "could not read the description file /tmp/nope: not found")))
    (assert (= (failure-code (ref failed))
               (str "description-unreadable")))
    (assert (= (failure-message (ref failed))
               (str
                 "could not read the description file /tmp/nope: not found")))))

(deftest a-ledger-from-a-newer-rmap-reports-ledger-too-new
  (assert (= (failure-code (failure/database (->database-error
                                               :problem (database-problem/too-new
                                                          (->schema-versions
                                                            :ledger 3
                                                            :binary 2))
                                               :message (str "too new"))))
             (str "ledger-too-new"))))
