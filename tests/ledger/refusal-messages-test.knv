(use ledger/refusal refusal)
(use ledger/refusal-messages refusal->message)

(use ledger/model ->blockage ->decision-id
                  ->external-blocker-id ->item-id ->session
                  decision-status)

(use ledger/model/roadmap-pauses roadmap-pause)
(use ledger/model/criteria ->criterion-gap criterion-result)

(deftest a-priority-below-zero-message-names-the-range-and-the-value
  (assert (= (refusal->message (refusal/priority-out-of-range -1))
             (str
               "a priority must be from 0 (highest) to 4 (lowest), got -1"))))

(deftest a-priority-above-four-message-names-the-range-and-the-value
  (assert (= (refusal->message (refusal/priority-out-of-range 5))
             (str "a priority must be from 0 (highest) to 4 (lowest), got 5"))))

(deftest a-missing-description-message-says-an-item-needs-one
  (assert (= (refusal->message refusal/description-required)
             (str "an item needs a description"))))

(deftest a-missing-criteria-message-says-an-item-needs-one
  (assert (= (refusal->message refusal/criteria-required)
             (str "an item needs at least one acceptance criterion"))))

(deftest a-blank-criterion-message-says-it-cannot-be-blank
  (assert (= (refusal->message refusal/blank-criterion)
             (str "an acceptance criterion cannot be blank"))))

(deftest a-frozen-decision-message-names-its-status
  (assert (= (refusal->message (refusal/decision-frozen
                                 (->decision-id :value (str "rm-0002"))
                                 decision-status/rejected))
             (str "the decision rm-0002 is rejected, and only a proposed decision can change"))))

(deftest an-incomplete-proposal-message-names-the-gap
  (assert (= (refusal->message (refusal/decision-incomplete (str "the context is empty")))
             (str "the proposal is incomplete: the context is empty"))))

(deftest a-not-blockable-message-names-the-item
  (assert (= (refusal->message (refusal/not-blockable (->item-id :value (str "rm-0003"))))
             (str "only an open item or an unfinished epic can take a blocker, and rm-0003 is not one"))))

(deftest an-invalid-decision-transition-message-names-both-states
  (assert (= (refusal->message (refusal/invalid-decision-transition
                                 (->decision-id :value (str "rm-0002"))
                                 decision-status/accepted
                                 decision-status/deprecated))
             (str "the decision rm-0002 cannot move from accepted to deprecated"))))

(deftest an-option-not-found-message-names-the-number
  (assert (= (refusal->message (refusal/option-not-found
                                 (->decision-id :value (str "rm-0002"))
                                 4))
             (str "the decision rm-0002 has no option 4"))))

(deftest an-already-asked-message-names-the-decision
  (assert (= (refusal->message (refusal/already-asked (->decision-id :value (str
                                                                              "rm-0002"))))
             (str "the decision rm-0002 is already asked"))))

(deftest a-blank-external-blocker-message-says-it-needs-a-text
  (assert (= (refusal->message refusal/blank-external-blocker)
             (str "an external blocker needs a text"))))

(deftest a-missing-external-blocker-message-names-the-id
  (assert (= (refusal->message (refusal/external-blocker-not-found (->external-blocker-id
                                                                     :value (str
                                                                              "rm-x001"))))
             (str "no external blocker has the id rm-x001"))))

(deftest a-cleared-external-blocker-message-names-the-id
  (assert (= (refusal->message (refusal/external-blocker-cleared (->external-blocker-id
                                                                   :value (str "rm-x001"))))
             (str "the external blocker rm-x001 is already cleared"))))

(deftest an-external-blocker-of-another-item-message-names-both
  (assert (= (refusal->message (refusal/external-blocker-in-other-item
                                 (->external-blocker-id :value (str "rm-x001"))
                                 (->item-id :value (str "rm-0001"))))
             (str "the external blocker rm-x001 belongs to another item than rm-0001"))))

(deftest a-not-ready-message-names-the-blocking-decisions
  (assert (= (refusal->message (refusal/not-ready
                                 (->blockage :pause roadmap-pause/not-paused
                                             :blockers (vec)
                                             :dropped-blockers (vec)
                                             :decisions (vec (->decision-id
                                                               :value (str "rm-d1")))
                                             :capacity none
                                             :external-blockers (vec)
                                             :exclusive none)))
             (str "the item is not ready; it waits on decisions rm-d1"))))

(deftest a-block-exists-message-names-both-ids
  (assert (= (refusal->message (refusal/decision-block-exists
                                 (->decision-id :value (str "rm-d1"))
                                 (->item-id :value (str "rm-0001"))))
             (str "the decision rm-d1 already blocks rm-0001"))))

(deftest a-missing-block-message-names-both-ids
  (assert (= (refusal->message (refusal/decision-block-not-found
                                 (->decision-id :value (str "rm-d1"))
                                 (->item-id :value (str "rm-0001"))))
             (str "the decision rm-d1 does not block rm-0001"))))

(deftest an-unmet-criteria-message-names-each-criterion
  (assert (= (refusal->message (refusal/criteria-unmet
                                 (vec (->criterion-gap :position 1
                                                       :text (str "one")
                                                       :verdict none)
                                      (->criterion-gap :position 2
                                                       :text (str "two")
                                                       :verdict (some criterion-result/failed)))))
             (str "a build needs a met verdict on its current head for every acceptance criterion: "
                  "criterion 1 \"one\" has no verdict on the current head; "
                  "criterion 2 \"two\" failed"))))

(deftest a-session-not-live-message-names-the-session
  (assert (= (refusal->message (refusal/session-not-live (->session :name (str "r1"))))
             (str "the session r1 is not live"))))
