(use ledger/sqlite/values text->sql)

(use ledger/sqlite/connection database-problem execute open
                              query run-batch)

(use ledger/sqlite/schema-versions ->schema-versions)

(use ledger/sqlite/migrations ->migration migrate
                              schema-version)

(use ledger/sqlite/migration-sources migration-sources)
(use support/scratch scratch-database)
(use files/directory file-names-ending-with)

(def fixture-migration
  "tests/fixtures/0002-add-item-notes.sql")

(defn embedded-files ()
  (let (files (collect (map (iter (migration-sources))
                         (fn (migration)
                           (clone (:file migration))))))
    (sort! files)
    files))

(deftest every-migration-file-is-embedded
  (assert (= (embedded-files)
             (unwrap-ok (file-names-ending-with "migrations" ".sql")))))

(deftest each-embedded-migration-matches-its-file
  (for-each (migration-sources)
    (fn (migration)
      (assert (= (clone (:sql migration))
                 (unwrap-ok (slurp (str "migrations/" (:file migration)))))))))

(defn opened (name)
  (unwrap-ok (open (as-str (scratch-database name)))))

(defn count-roadmaps (connection)
  (len (unwrap-ok (query connection "SELECT id FROM roadmaps" (ref (vec))))))

(deftest a-new-database-reaches-the-latest-version
  (let (connection (opened "latest"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               1))))

(deftest a-later-migration-keeps-existing-rows
  (let (connection (opened "keeps-rows"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (execute (ref connection)
                        "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES (?1, ?2, ?3, ?4)"
                        (ref (vec (text->sql "rm-0001")
                                  (text->sql "kept")
                                  (text->sql "m1")
                                  (text->sql "2026-01-01")))))
    (let (extended (migration-sources))
      (push! extended
             (->migration :version 2
                          :file (str "0002-add-item-notes.sql")
                          :sql (unwrap-ok (slurp fixture-migration))))
      (unwrap-ok (migrate (ref connection) extended)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               2))
    (assert (= (count-roadmaps (ref connection)) 1))))

(deftest migrating-twice-applies-nothing-new
  (let (connection (opened "twice"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               1))))

(deftest migrations-that-share-a-version-are-refused
  (let (connection (opened "shared-version")
        clashing (migration-sources))
    (push! clashing
           (->migration :version 1
                        :file (str "0001-other.sql")
                        :sql (str "SELECT 1;")))
    (assert (err? (migrate (ref connection) clashing)))))

(deftest migrating-reports-the-version-it-started-from
  (let (connection (opened "starting-version"))
    (assert (= (migrate (ref connection) (migration-sources))
               (ok 0)))
    (assert (= (migrate (ref connection) (migration-sources))
               (ok 1)))))

(defn newest-version ()
  (-> (migration-sources) iter (map :version) max unwrap))

(defn stored-above-newest (name)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (run-batch (ref connection)
                          (as-str (str "PRAGMA user_version = "
                                       (inc (newest-version))
                                       ";"))))
    connection))

(deftest a-ledger-above-the-newest-migration-is-refused-as-too-new
  (let (connection (stored-above-newest "too-new-refused"))
    (assert (= (:problem (unwrap-err (migrate (ref connection)
                                              (migration-sources))))
               (database-problem/too-new (->schema-versions :ledger (inc (newest-version))
                                                            :binary (newest-version)))))))

(deftest a-ledger-above-the-newest-migration-keeps-its-version
  (let (connection (stored-above-newest "too-new-kept"))
    (unwrap-err (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (inc (newest-version))))))
