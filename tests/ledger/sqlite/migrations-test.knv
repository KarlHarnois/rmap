(use ledger/sqlite/values text->sql)

(use ledger/sqlite/connection database-problem execute open
                              query run-batch)

(use ledger/sqlite/rows int-cell optional-text-cell
                        rows->values text-cell)

(use ledger/sqlite/items all-items)
(use ledger/model claim)
(use ledger/sqlite/schema-versions ->schema-versions)

(use ledger/sqlite/migrations ->migration migrate
                              schema-version)

(use ledger/sqlite/migration-sources migration-sources)
(use support/scratch scratch-database)
(use files/directory file-names-ending-with)

(def fixture-migration
  "tests/fixtures/0002-add-item-notes.sql")

(def version-one-rows
  "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES ('rm-0001', 'road', 'm1', 't');
INSERT INTO items (id, roadmap_id, parent_id, title, kind, status, created_at) VALUES
  ('rm-0002', 'rm-0001', NULL, 'epic', 'epic', 'open', 't'),
  ('rm-0003', 'rm-0001', 'rm-0002', 'design', 'design', 'reported', 't'),
  ('rm-0004', 'rm-0001', NULL, 'build', 'build', 'open', 't');
INSERT INTO deps (item_id, on_id, type) VALUES ('rm-0004', 'rm-0003', 'blocks');
INSERT INTO item_paths (item_id, glob) VALUES ('rm-0004', 'src/a/**');
INSERT INTO events (at, actor, roadmap_id, item_id, type, payload_json) VALUES
  ('t', 'm1', 'rm-0001', 'rm-0003', 'item-added', '{}'),
  ('t', 'm1', 'rm-0001', 'rm-0004', 'item-added', '{}');")

(def priority-rows
  "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES ('rm-0001', 'road', 'm1', 't');
INSERT INTO items (id, roadmap_id, title, kind, status, priority, created_at) VALUES
  ('rm-0002', 'rm-0001', 'a', 'research', 'open', -1, 't'),
  ('rm-0003', 'rm-0001', 'b', 'research', 'open', 0, 't'),
  ('rm-0004', 'rm-0001', 'c', 'research', 'open', 1, 't'),
  ('rm-0005', 'rm-0001', 'd', 'research', 'open', 2, 't'),
  ('rm-0006', 'rm-0001', 'e', 'research', 'open', 3, 't'),
  ('rm-0007', 'rm-0001', 'f', 'research', 'open', 7, 't');")

(def decision-rows
  "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES ('rm-0001', 'road', 'm1', 't');
INSERT INTO decisions (id, roadmap_id, title, context, recommended_option, recommendation_reason, created_at) VALUES ('rm-0005', 'rm-0001', 'q', 'c', 2, 'r', 't');
INSERT INTO decision_options (decision_id, number, title) VALUES ('rm-0005', 1, 'a');")

(def claimed-rows
  "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES ('rm-0001', 'road', 'm1', '2026-01-01T00:00:00Z');
INSERT INTO items (id, roadmap_id, title, kind, status, claimed_by, created_at, closed_at) VALUES
  ('rm-0002', 'rm-0001', 'dispatched', 'build', 'dispatched', 's1', '2026-01-02T00:00:00Z', NULL),
  ('rm-0003', 'rm-0001', 'merged', 'build', 'merged', 's2', '2026-01-03T00:00:00Z', '2026-01-09T00:00:00Z'),
  ('rm-0004', 'rm-0001', 'open', 'research', 'open', NULL, '2026-01-04T00:00:00Z', NULL),
  ('rm-0005', 'rm-0001', 'review', 'build', 'in_review', 's3', '2026-01-05T00:00:00Z', NULL);
INSERT INTO events (at, actor, roadmap_id, item_id, type, payload_json) VALUES
  ('2026-01-06T00:00:00Z', 'm1', 'rm-0001', 'rm-0002', 'item-claimed', '{}');")

(def shared-claim-rows
  "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES ('rm-0001', 'road', 'm1', '2026-01-01T00:00:00Z');
INSERT INTO items (id, roadmap_id, title, kind, status, claimed_by, created_at) VALUES
  ('rm-0002', 'rm-0001', 'older', 'build', 'dispatched', 's1', '2026-01-02T00:00:00Z'),
  ('rm-0003', 'rm-0001', 'newer', 'build', 'dispatched', 's1', '2026-01-03T00:00:00Z');")

(defn embedded-files ()
  (let (files (collect (map (iter (migration-sources))
                         (fn (migration)
                           (clone (:file migration))))))
    (sort! files)
    files))

(defn count-roadmaps (connection)
  (len (unwrap-ok (query connection "SELECT id FROM roadmaps" (ref (vec))))))

(defn stored-above-newest (name)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (run-batch (ref connection)
                          (as-str (str "PRAGMA user_version = "
                                       (inc (newest-version))
                                       ";"))))
    connection))

(defn newest-version ()
  (-> (migration-sources) iter (map :version) max unwrap))

(defn upgraded-from-version-one (name)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (first-migration-only)))
    (unwrap-ok (run-batch (ref connection) version-one-rows))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    connection))

(defn upgraded-from-version-three (name)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (migrations-through 3)))
    (unwrap-ok (run-batch (ref connection) version-one-rows))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    connection))

(defn upgraded-from-version-six (name rows)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (migrations-through 6)))
    (unwrap-ok (run-batch (ref connection) rows))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    connection))

(defn session-rows (connection)
  (let-try (rows (query connection
                        "SELECT name, item_id, kind, runtime, branch, base, started_at, ended_at, end_reason FROM sessions ORDER BY item_id"
                        (ref (vec))))
    (rows->values (ref rows) row->texts)))

(defn row->texts (row)
  (let-try (name (text-cell row 0)
            item (text-cell row 1)
            kind (text-cell row 2)
            runtime (text-cell row 3)
            branch (optional-text-cell row 4)
            base (optional-text-cell row 5)
            started-at (text-cell row 6)
            ended-at (optional-text-cell row 7)
            end-reason (optional-text-cell row 8))
    (ok (vec (some name)
             (some item)
             (some kind)
             (some runtime)
             branch base
             (some started-at)
             ended-at end-reason))))

(defn texts (values)
  (collect (map (iter values)
             (fn (value)
               (map-some (deref value)
                 (fn (text) (str text)))))))

(defn opened (name)
  (unwrap-ok (open (as-str (scratch-database name)))))

(defn first-migration-only ()
  (collect (map (filter (iter (migration-sources))
                  (fn (migration)
                    (= (:version migration) 1)))
                clone)))

(defn row-count (connection table)
  (len (unwrap-ok (query connection
                         (as-str (str "SELECT * FROM " table))
                         (ref (vec))))))

(defn descriptions (connection)
  (let-try (rows (query connection
                        "SELECT description FROM items ORDER BY id"
                        (ref (vec))))
    (rows->values (ref rows)
      (fn (row) (optional-text-cell row 0)))))

(defn remapped-priorities (name)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (migrations-through 2)))
    (unwrap-ok (run-batch (ref connection) priority-rows))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (let-try (rows (query connection
                          "SELECT priority FROM items ORDER BY id"
                          (ref (vec))))
      (rows->values (ref rows) row->priority))))

(defn row->priority (row) (int-cell row 0))

(defn migrations-through (version)
  (collect (map (filter (iter (migration-sources))
                  (fn (migration)
                    (<= (:version migration) version)))
                clone)))

(deftest every-migration-file-is-embedded
  (assert (= (embedded-files)
             (unwrap-ok (file-names-ending-with "migrations" ".sql")))))

(deftest each-embedded-migration-matches-its-file
  (for-each (migration-sources)
    (fn (migration)
      (assert (= (clone (:sql migration))
                 (unwrap-ok (slurp (str "migrations/" (:file migration)))))))))

(deftest a-new-database-reaches-the-latest-version
  (let (connection (opened "latest"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (newest-version)))))

(deftest a-later-migration-keeps-existing-rows
  (let (connection (opened "keeps-rows"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (execute (ref connection)
                        "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES (?1, ?2, ?3, ?4)"
                        (ref (vec (text->sql "rm-0001")
                                  (text->sql "kept")
                                  (text->sql "m1")
                                  (text->sql "2026-01-01")))))
    (let (extended (migration-sources))
      (push! extended
             (->migration :version (inc (newest-version))
                          :file (str "add-item-notes.sql")
                          :sql (unwrap-ok (slurp fixture-migration))))
      (unwrap-ok (migrate (ref connection) extended)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (inc (newest-version))))
    (assert (= (count-roadmaps (ref connection)) 1))))

(deftest migrating-twice-applies-nothing-new
  (let (connection (opened "twice"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (newest-version)))))

(deftest migrations-that-share-a-version-are-refused
  (let (connection (opened "shared-version")
        clashing (migration-sources))
    (push! clashing
           (->migration :version 1
                        :file (str "0001-other.sql")
                        :sql (str "SELECT 1;")))
    (assert (err? (migrate (ref connection) clashing)))))

(deftest migrating-reports-the-version-it-started-from
  (let (connection (opened "starting-version"))
    (assert (= (migrate (ref connection) (migration-sources))
               (ok 0)))
    (assert (= (migrate (ref connection) (migration-sources))
               (ok (newest-version))))))

(deftest a-ledger-above-the-newest-migration-is-refused-as-too-new
  (let (connection (stored-above-newest "too-new-refused"))
    (assert (= (:problem (unwrap-err (migrate (ref connection)
                                              (migration-sources))))
               (database-problem/too-new (->schema-versions :ledger (inc (newest-version))
                                                            :binary (newest-version)))))))

(deftest a-ledger-above-the-newest-migration-keeps-its-version
  (let (connection (stored-above-newest "too-new-kept"))
    (unwrap-err (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (inc (newest-version))))))

(deftest the-migrations-keep-existing-rows-and-drop-item-paths
  (let (connection (upgraded-from-version-one "accepted-keeps-rows"))
    (assert (= (row-count (ref connection) "items") 3))
    (assert (= (row-count (ref connection) "deps") 1))
    (assert (= (row-count (ref connection) "events") 2))
    (assert (= (row-count (ref connection)
                          "sqlite_schema WHERE name = 'item_paths'")
               0))))

(deftest the-accepted-migration-allows-the-accepted-status
  (let (connection (upgraded-from-version-one "accepted-allowed"))
    (assert (ok? (run-batch (ref connection)
                            "UPDATE items SET status = 'accepted' WHERE id = 'rm-0003';")))
    (assert (err? (run-batch (ref connection)
                             "UPDATE items SET status = 'bogus' WHERE id = 'rm-0003';")))))

(deftest the-accepted-migration-keeps-foreign-keys
  (let (connection (upgraded-from-version-one "accepted-foreign-keys"))
    (assert (err? (run-batch (ref connection)
                             "INSERT INTO deps (item_id, on_id, type) VALUES ('rm-0004', 'rm-9999', 'blocks');")))))

(deftest the-accepted-migration-keeps-the-event-sequence
  (let (connection (upgraded-from-version-one "accepted-event-sequence"))
    (unwrap-ok (run-batch (ref connection)
                          "INSERT INTO events (at, actor, type, payload_json) VALUES ('t', 'm1', 'item-closed', '{}');"))
    (assert (= (row-count (ref connection) "events WHERE id = 3") 1))))

(deftest the-accepted-migration-keeps-the-indexes
  (assert (= (row-count
               (ref (upgraded-from-version-one "accepted-indexes"))
               "sqlite_schema WHERE name IN ('items_roadmap', 'events_item')")
             2)))

(deftest the-priority-migration-remaps-existing-priorities
  (assert (= (unwrap-ok (remapped-priorities "priority-remap"))
             (vec 4 3 2 1 0 0))))

(deftest the-description-migration-gives-old-items-no-description
  (let (connection (upgraded-from-version-three "description-null"))
    (assert (= (unwrap-ok (descriptions (ref connection)))
               (vec none none none)))))

(deftest the-decisions-migration-creates-every-decisions-and-rulings-table
  (assert (= (row-count (ref (upgraded-from-version-one "decision-tables"))
                        "sqlite_schema WHERE type = 'table' AND name IN ('decisions', 'decision_options', 'decision_option_points', 'decision_blocks', 'rulings')")
             5)))

(deftest the-decisions-migration-gives-old-events-no-decision
  (assert (= (row-count (ref (upgraded-from-version-one "decision-events"))
                        "events WHERE decision_id IS NULL")
             2)))

(deftest a-recommendation-that-names-no-option-is-refused-at-commit
  (let (connection (opened "decision-recommendation"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (err? (run-batch (ref connection)
                             (as-str
                               (str "BEGIN;\n" decision-rows "\nCOMMIT;")))))))

(deftest a-recommendation-that-names-an-option-is-kept
  (let (connection (opened "decision-recommendation-kept"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (ok? (run-batch (ref connection)
                            (as-str (str "BEGIN;\n"
                                         decision-rows
                                         "\nINSERT INTO decision_options (decision_id, number, title) VALUES ('rm-0005', 2, 'b');\nCOMMIT;")))))))

(deftest the-sessions-migration-turns-each-claim-into-a-work-session
  (assert (= (unwrap-ok (session-rows (ref (upgraded-from-version-six
                                             "sessions-backfill"
                                             claimed-rows))))
             (vec (texts (vec (some "s1")
                              (some "rm-0002")
                              (some "work")
                              (some "ringleader")
                              none none
                              (some "2026-01-06T00:00:00Z")
                              none none))
                  (texts (vec (some "s2")
                              (some "rm-0003")
                              (some "work")
                              (some "ringleader")
                              none none
                              (some "2026-01-03T00:00:00Z")
                              (some "2026-01-09T00:00:00Z")
                              (some "finished")))
                  (texts (vec (some "s3")
                              (some "rm-0005")
                              (some "work")
                              (some "ringleader")
                              none none
                              (some "2026-01-05T00:00:00Z")
                              none none))))))

(deftest the-sessions-migration-drops-the-claimed-by-column
  (assert (= (row-count (ref (upgraded-from-version-six "sessions-drop-column"
                                                        claimed-rows))
                        "pragma_table_info('items') WHERE name = 'claimed_by'")
             0)))

(deftest after-the-sessions-migration-only-unfinished-items-keep-their-claimant
  (let (items (unwrap-ok (all-items (ref (upgraded-from-version-six
                                           "sessions-claims"
                                           claimed-rows)))))
    (assert (= (collect (map (iter items)
                          (fn (item)
                            (match (:claim item)
                              ((claim/claimed-by session)
                               (some (clone (:name (:session session)))))
                              (claim/unclaimed none)))))
               (vec (some (str "s1"))
                    none none
                    (some (str "s3")))))))

(deftest the-sessions-migration-keeps-only-the-newest-of-two-live-claims-by-one-name
  (assert (= (unwrap-ok (session-rows (ref (upgraded-from-version-six
                                             "sessions-shared-name"
                                             shared-claim-rows))))
             (vec (texts (vec (some "s1")
                              (some "rm-0002")
                              (some "work")
                              (some "ringleader")
                              none none
                              (some "2026-01-02T00:00:00Z")
                              (some "2026-01-03T00:00:00Z")
                              (some "replaced")))
                  (texts (vec (some "s1")
                              (some "rm-0003")
                              (some "work")
                              (some "ringleader")
                              none none
                              (some "2026-01-03T00:00:00Z")
                              none none))))))

(deftest a-second-live-session-for-one-item-or-one-name-is-refused
  (let (connection (upgraded-from-version-six "sessions-unique" claimed-rows))
    (assert (err? (run-batch (ref connection)
                             "INSERT INTO sessions (name, item_id, kind, started_at) VALUES ('s9', 'rm-0002', 'work', 't');")))
    (assert (err? (run-batch (ref connection)
                             "INSERT INTO sessions (name, item_id, kind, started_at) VALUES ('s1', 'rm-0004', 'work', 't');")))
    (assert (ok? (run-batch (ref connection)
                            "INSERT INTO sessions (name, item_id, kind, started_at) VALUES ('s2', 'rm-0004', 'work', 't');")))))
