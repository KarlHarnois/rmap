(use ledger/sqlite/values text->sql)

(use ledger/sqlite/connection database-problem execute open
                              query run-batch)

(use ledger/sqlite/schema-versions ->schema-versions)

(use ledger/sqlite/migrations ->migration migrate
                              schema-version)

(use ledger/sqlite/migration-sources migration-sources)
(use support/scratch scratch-database)
(use files/directory file-names-ending-with)

(def fixture-migration
  "tests/fixtures/0002-add-item-notes.sql")

(def version-one-rows
  "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES ('rm-0001', 'road', 'm1', 't');
INSERT INTO items (id, roadmap_id, parent_id, title, kind, status, created_at) VALUES
  ('rm-0002', 'rm-0001', NULL, 'epic', 'epic', 'open', 't'),
  ('rm-0003', 'rm-0001', 'rm-0002', 'design', 'design', 'reported', 't'),
  ('rm-0004', 'rm-0001', NULL, 'build', 'build', 'open', 't');
INSERT INTO deps (item_id, on_id, type) VALUES ('rm-0004', 'rm-0003', 'blocks');
INSERT INTO item_paths (item_id, glob) VALUES ('rm-0004', 'src/a/**');
INSERT INTO events (at, actor, roadmap_id, item_id, type, payload_json) VALUES
  ('t', 'm1', 'rm-0001', 'rm-0003', 'item-added', '{}'),
  ('t', 'm1', 'rm-0001', 'rm-0004', 'item-added', '{}');")

(defn embedded-files ()
  (let (files (collect (map (iter (migration-sources))
                         (fn (migration)
                           (clone (:file migration))))))
    (sort! files)
    files))

(defn count-roadmaps (connection)
  (len (unwrap-ok (query connection "SELECT id FROM roadmaps" (ref (vec))))))

(defn stored-above-newest (name)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (run-batch (ref connection)
                          (as-str (str "PRAGMA user_version = "
                                       (inc (newest-version))
                                       ";"))))
    connection))

(defn newest-version ()
  (-> (migration-sources) iter (map :version) max unwrap))

(defn upgraded-from-version-one (name)
  (let (connection (opened name))
    (unwrap-ok (migrate (ref connection) (first-migration-only)))
    (unwrap-ok (run-batch (ref connection) version-one-rows))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    connection))

(defn opened (name)
  (unwrap-ok (open (as-str (scratch-database name)))))

(defn first-migration-only ()
  (collect (map (filter (iter (migration-sources))
                  (fn (migration)
                    (= (:version migration) 1)))
                clone)))

(defn row-count (connection table)
  (len (unwrap-ok (query connection
                         (as-str (str "SELECT * FROM " table))
                         (ref (vec))))))

(deftest every-migration-file-is-embedded
  (assert (= (embedded-files)
             (unwrap-ok (file-names-ending-with "migrations" ".sql")))))

(deftest each-embedded-migration-matches-its-file
  (for-each (migration-sources)
    (fn (migration)
      (assert (= (clone (:sql migration))
                 (unwrap-ok (slurp (str "migrations/" (:file migration)))))))))

(deftest a-new-database-reaches-the-latest-version
  (let (connection (opened "latest"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (newest-version)))))

(deftest a-later-migration-keeps-existing-rows
  (let (connection (opened "keeps-rows"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (execute (ref connection)
                        "INSERT INTO roadmaps (id, name, manager_session, created_at) VALUES (?1, ?2, ?3, ?4)"
                        (ref (vec (text->sql "rm-0001")
                                  (text->sql "kept")
                                  (text->sql "m1")
                                  (text->sql "2026-01-01")))))
    (let (extended (migration-sources))
      (push! extended
             (->migration :version (inc (newest-version))
                          :file (str "add-item-notes.sql")
                          :sql (unwrap-ok (slurp fixture-migration))))
      (unwrap-ok (migrate (ref connection) extended)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (inc (newest-version))))
    (assert (= (count-roadmaps (ref connection)) 1))))

(deftest migrating-twice-applies-nothing-new
  (let (connection (opened "twice"))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (unwrap-ok (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (newest-version)))))

(deftest migrations-that-share-a-version-are-refused
  (let (connection (opened "shared-version")
        clashing (migration-sources))
    (push! clashing
           (->migration :version 1
                        :file (str "0001-other.sql")
                        :sql (str "SELECT 1;")))
    (assert (err? (migrate (ref connection) clashing)))))

(deftest migrating-reports-the-version-it-started-from
  (let (connection (opened "starting-version"))
    (assert (= (migrate (ref connection) (migration-sources))
               (ok 0)))
    (assert (= (migrate (ref connection) (migration-sources))
               (ok (newest-version))))))

(deftest a-ledger-above-the-newest-migration-is-refused-as-too-new
  (let (connection (stored-above-newest "too-new-refused"))
    (assert (= (:problem (unwrap-err (migrate (ref connection)
                                              (migration-sources))))
               (database-problem/too-new (->schema-versions :ledger (inc (newest-version))
                                                            :binary (newest-version)))))))

(deftest a-ledger-above-the-newest-migration-keeps-its-version
  (let (connection (stored-above-newest "too-new-kept"))
    (unwrap-err (migrate (ref connection) (migration-sources)))
    (assert (= (unwrap-ok (schema-version (ref connection)))
               (inc (newest-version))))))

(deftest the-accepted-migration-keeps-every-row
  (let (connection (upgraded-from-version-one "accepted-keeps-rows"))
    (assert (= (row-count (ref connection) "items") 3))
    (assert (= (row-count (ref connection) "deps") 1))
    (assert (= (row-count (ref connection) "item_paths") 1))
    (assert (= (row-count (ref connection) "events") 2))))

(deftest the-accepted-migration-allows-the-accepted-status
  (let (connection (upgraded-from-version-one "accepted-allowed"))
    (assert (ok? (run-batch (ref connection)
                            "UPDATE items SET status = 'accepted' WHERE id = 'rm-0003';")))
    (assert (err? (run-batch (ref connection)
                             "UPDATE items SET status = 'bogus' WHERE id = 'rm-0003';")))))

(deftest the-accepted-migration-keeps-foreign-keys
  (let (connection (upgraded-from-version-one "accepted-foreign-keys"))
    (assert (err? (run-batch (ref connection)
                             "INSERT INTO deps (item_id, on_id, type) VALUES ('rm-0004', 'rm-9999', 'blocks');")))))

(deftest the-accepted-migration-keeps-the-event-sequence
  (let (connection (upgraded-from-version-one "accepted-event-sequence"))
    (unwrap-ok (run-batch (ref connection)
                          "INSERT INTO events (at, actor, type, payload_json) VALUES ('t', 'm1', 'item-closed', '{}');"))
    (assert (= (row-count (ref connection) "events WHERE id = 3") 1))))

(deftest the-accepted-migration-keeps-the-indexes
  (assert (= (row-count
               (ref (upgraded-from-version-one "accepted-indexes"))
               "sqlite_schema WHERE name IN ('items_roadmap', 'events_item')")
             2)))
