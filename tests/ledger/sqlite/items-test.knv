(use ledger/api add-item description-input kind)
(use ledger/sqlite/items all-items)
(use ledger/operations/transaction connect)

(use support/ledger item-draft ledger-with-two-roadmaps
                    other-roadmap-name research-in
                    roadmap-name scratch-ledger)

(deftest a-read-item-carries-the-name-of-its-roadmap
  (let (settings (ledger-with-two-roadmaps "read-roadmap-name")
        _ (research-in (ref settings) other-roadmap-name)
        connection (unwrap-ok (connect (ref settings)))
        items (unwrap-ok (all-items (ref connection))))
    (assert (= (:roadmap-name (unwrap (first items)))
               (str other-roadmap-name)))))

(deftest a-read-item-carries-its-description
  (let (settings (scratch-ledger "read-description")
        draft (assoc (item-draft kind/research)
                     :description (description-input/text (str "a spec")))
        _ (unwrap-ok (add-item (ref settings) (str roadmap-name) draft))
        connection (unwrap-ok (connect (ref settings)))
        items (unwrap-ok (all-items (ref connection))))
    (assert (= (:description (unwrap (first items)))
               (some (str "a spec"))))))
