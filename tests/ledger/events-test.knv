(use json/value copy-of null?)

(use ledger/model ->dep ->roadmap ->roadmap-id ->session
                  ->timestamp dep-type item kind
                  roadmap-status status)

(use ledger/core/deps dep-change)
(use ledger/core/new-items ->new-item description-input)

(use ledger/events dep-changed edit-changes item-added
                   item-edited roadmap-created)

(use support/items id-of work-item)
(use support/payloads columns side side-int side-text)

(defn new-research ()
  (->new-item :parent none
              :title (str "work")
              :description description-input/unspecified
              :kind kind/research
              :origin (work-origin)
              :priority 0
              :blocked-by (vec (id-of "rm-0002"))
              :discovered-from none))

(type described (fn (item) item))

(defn described (item)
  (assoc item :description (some (str "the spec"))))

(defn work-origin ()
  (:origin (research status/open)))

(defn dep-payload (change)
  (copy-of (ref (:payload (dep-changed (ref (research status/open))
                                       (ref (blocks-row))
                                       change)))))

(defn research (status)
  (work-item "rm-0001" kind/research status))

(defn blocks-row ()
  (->dep :item (id-of "rm-0001")
         :on (id-of "rm-0002")
         :type dep-type/blocks))

(deftest an-added-item-records-every-column-it-sets
  (let (payload (copy-of (ref (:payload (item-added (ref (described (research status/open)))
                                                    (ref (new-research)))))))
    (assert (= (columns payload)
               (vec (str "blocked_by")
                    (str "closed_at")
                    (str "description")
                    (str "discovered_from")
                    (str "kind")
                    (str "origin")
                    (str "parent_id")
                    (str "priority")
                    (str "status")
                    (str "title"))))
    (assert (null? (ref (side payload "title" "old"))))
    (assert (null? (ref (side payload "description" "old"))))
    (assert (= (side-text payload "description" "new")
               (some (str "the spec"))))
    (assert (null? (ref (side payload "parent_id" "new"))))))

(deftest an-edit-records-only-the-fields-that-changed
  (let (before (described (research status/open))
        after (assoc (clone before) :title (str "new") :priority 3)
        payload (copy-of (ref (:payload (item-edited (ref after)
                                                     (ref (edit-changes (ref before)
                                                                        (ref after))))))))
    (assert (= (columns payload)
               (vec (str "priority") (str "title"))))
    (assert (= (side-text payload "title" "old")
               (some (str "work"))))
    (assert (= (side-text payload "title" "new")
               (some (str "new"))))
    (assert (= (side-int payload "priority" "old") (some 0)))
    (assert (= (side-int payload "priority" "new") (some 3)))))

(deftest an-added-dep-records-its-row-as-new
  (let (payload (dep-payload dep-change/add))
    (assert (= (side-text payload "on_id" "new")
               (some (str "rm-0002"))))
    (assert (= (side-text payload "type" "new")
               (some (str "blocks"))))
    (assert (null? (ref (side payload "on_id" "old"))))))

(deftest a-removed-dep-records-its-row-as-old
  (let (payload (dep-payload dep-change/remove))
    (assert (= (side-text payload "on_id" "old")
               (some (str "rm-0002"))))
    (assert (null? (ref (side payload "type" "new"))))))

(deftest a-new-roadmap-records-its-name-manager-and-status
  (let (payload (copy-of (ref (:payload (roadmap-created
                                          (ref (->roadmap
                                                 :id (->roadmap-id :value (str "rm-road"))
                                                 :name (str "road")
                                                 :manager (->session :name (str "m1"))
                                                 :status roadmap-status/active
                                                 :created-at (->timestamp
                                                               :value (str "t0")))))))))
    (assert (= (columns payload)
               (vec (str "manager_session")
                    (str "name")
                    (str "status"))))
    (assert (= (side-text payload "manager_session" "new")
               (some (str "m1"))))))
