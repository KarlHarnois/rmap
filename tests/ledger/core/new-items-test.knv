(use ledger/model ->roadmap-id ->snapshot kind origin)
(use ledger/refusal refusal)
(use ledger/core/criteria criteria-input)

(use ledger/core/new-items ->new-item check-description
                           check-new-item description-input)

(defn refusal-of (priority)
  (match (checked priority)
    ((err refused) (some refused))
    ((ok _) none)))

(defn checked (priority)
  (let (request (draft priority)
        snapshot (->snapshot :roadmaps (vec)
                             :items (vec)
                             :deps (vec)
                             :decision-blocks (vec))
        roadmap-id (->roadmap-id :value (str "rm-0001")))
    (check-new-item (ref snapshot)
                    (ref roadmap-id)
                    (ref request))))

(defn draft (priority)
  (->new-item :parent none
              :title (str "work")
              :description description-input/unspecified
              :criteria (criteria-input/values (vec (str "a criterion")))
              :kind kind/research
              :origin origin/planned
              :priority priority
              :blocked-by (vec)
              :discovered-from none))

(defn description-refusal (description)
  (match (checked-description description)
    ((err refused) (some refused))
    ((ok _) none)))

(defn checked-description (description)
  (check-description (ref description)))

(deftest a-missing-description-is-refused
  (assert (= (description-refusal none)
             (some refusal/description-required))))

(deftest an-empty-description-is-refused
  (assert (= (description-refusal (some (str "")))
             (some refusal/description-required))))

(deftest a-whitespace-description-is-refused
  (assert (= (description-refusal (some (str "  \n\t ")))
             (some refusal/description-required))))

(deftest a-description-is-accepted
  (assert (ok? (checked-description (some (str "a spec"))))))

(deftest a-priority-below-zero-is-refused
  (assert (= (refusal-of -1)
             (some (refusal/priority-out-of-range -1)))))

(deftest a-priority-above-four-is-refused
  (assert (= (refusal-of 5)
             (some (refusal/priority-out-of-range 5)))))

(deftest priorities-from-zero-to-four-are-accepted
  (for-each (vec 0 1 2 3 4)
    (fn (priority)
      (assert (ok? (checked priority))))))
