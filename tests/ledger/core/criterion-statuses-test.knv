(use ledger/model ->item-id ->session ->timestamp kind
                  status)

(use ledger/model/criteria ->criterion-verdict
                           ->criterion-verdict-id
                           criterion-result)

(use ledger/model/pull-requests ->head)
(use ledger/core/criterion-statuses criterion-statuses)
(use support/items work-item)

(def first-sha "1111111111111111111111111111111111111111")

(defn build-with (criteria)
  (build-with-id "rm-0001" criteria))

(defn build-with-id (id criteria)
  (assoc (work-item id kind/build status/in-review)
         :criteria criteria))

(defn verdict (id position result sha)
  (verdict-for "rm-0001" id position result sha))

(defn verdict-for (item id position result sha)
  (->criterion-verdict :id (->criterion-verdict-id :value id)
                       :item (->item-id :value (str item))
                       :position position
                       :verdict result
                       :note none
                       :reviewer (->session :name (str "r1"))
                       :head (some (->head :sha (str sha)))
                       :created-at (->timestamp :value (str "2026-01-02T00:00:00Z"))))

(defn only-verdict (statuses)
  (:verdict (unwrap (clone (:verdict (at statuses 0))))))

(deftest the-latest-verdict-per-criterion-counts
  (let (statuses (criterion-statuses
                   (ref (build-with (vec (str "one"))))
                   (ref (vec (verdict 1 1 criterion-result/failed first-sha)
                             (verdict 2 1 criterion-result/met first-sha)))))
    (assert (= (len statuses) 1))
    (assert (= (only-verdict (ref statuses)) criterion-result/met))))

(deftest another-items-verdicts-do-not-count
  (let (verdicts (vec (verdict-for "rm-0001" 1 1 criterion-result/met first-sha)
                      (verdict-for "rm-0002" 2 1
                                   criterion-result/failed
                                   first-sha))
        first-statuses (criterion-statuses
                         (ref (build-with-id "rm-0001" (vec (str "one"))))
                         (ref verdicts))
        second-statuses (criterion-statuses
                          (ref (build-with-id "rm-0002" (vec (str "one"))))
                          (ref verdicts)))
    (assert (= (only-verdict (ref first-statuses)) criterion-result/met))
    (assert (= (only-verdict (ref second-statuses))
               criterion-result/failed))))
