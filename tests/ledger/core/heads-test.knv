(use ledger/model ->item-id ->timestamp)

(use ledger/model/pull-requests ->head ->pr-number
                                ->pull-request)

(use ledger/refusal refusal)
(use ledger/pull-request-refusals pull-request-refusal)
(use ledger/core/heads current-head head-of)

(def full-sha "0123456789abcdef0123456789abcdef01234567")

(defn invalid (text)
  (err (refusal/pull-request (pull-request-refusal/invalid-head (str text)))))

(deftest a-full-lowercase-sha-is-a-head
  (assert (= (head-of (ref (str full-sha)))
             (ok (->head :sha (str full-sha))))))

(deftest an-abbreviated-sha-is-refused
  (assert (= (head-of (ref (str "0123456")))
             (invalid "0123456"))))

(deftest an-uppercase-sha-is-refused
  (assert (= (head-of (ref (str "0123456789ABCDEF0123456789ABCDEF01234567")))
             (invalid "0123456789ABCDEF0123456789ABCDEF01234567"))))

(deftest a-sha-with-other-letters-is-refused
  (assert (= (head-of (ref (str "z123456789abcdef0123456789abcdef01234567")))
             (invalid "z123456789abcdef0123456789abcdef01234567"))))

(def other-sha "1111111111111111111111111111111111111111")

(defn pull-request-at (sha)
  (->pull-request :item (->item-id :value (str "rm-0001"))
                  :pr-number (->pr-number :value 12)
                  :head (->head :sha (str sha))
                  :opened-at (->timestamp :value (str "2026-01-02T00:00:00Z"))
                  :reviews (vec)))

(deftest the-current-head-is-accepted
  (assert (= (current-head (ref (pull-request-at full-sha))
                           (ref (str full-sha)))
             (ok (->head :sha (str full-sha))))))

(deftest another-head-is-refused-as-not-current
  (assert (= (current-head (ref (pull-request-at full-sha))
                           (ref (str other-sha)))
             (err (refusal/pull-request (pull-request-refusal/head-not-current
                                          (->head :sha (str other-sha))
                                          (->head :sha (str full-sha))))))))

(deftest an-abbreviated-head-is-refused-before-the-comparison
  (assert (= (current-head (ref (pull-request-at full-sha))
                           (ref (str "0123456")))
             (invalid "0123456"))))
