(use ledger/core/cycles closes-cycle?)
(use support/items blocks-dep id-of)

(def layer-count 30)

(defn closes? (deps item on)
  (closes-cycle? (ref deps)
                 (ref (id-of item))
                 (ref (id-of on))))

(defn layered-deps ()
  (let (deps (vec))
    (for-each (range 1 layer-count)
      (fn (layer)
        (for-each (vec "a" "b")
          (fn (side)
            (push! deps
                   (blocks-dep (as-str (layer-id layer side))
                               (as-str (layer-id (dec layer) "a"))))
            (push! deps
                   (blocks-dep (as-str (layer-id layer side))
                               (as-str (layer-id (dec layer) "b"))))))))
    deps))

(defn layer-id (layer side) (str "rm-" layer "-" side))

(deftest an-item-blocking-itself-closes-a-cycle
  (assert (closes? (vec) "rm-000a" "rm-000a")))

(deftest a-two-edge-loop-closes-a-cycle
  (assert (closes? (vec (blocks-dep "rm-000a" "rm-000b"))
                   "rm-000b" "rm-000a")))

(deftest a-three-edge-loop-closes-a-cycle
  (assert (closes? (vec (blocks-dep "rm-000a" "rm-000b")
                        (blocks-dep "rm-000b" "rm-000c"))
                   "rm-000c" "rm-000a")))

(deftest a-diamond-is-not-a-cycle
  (assert (not (closes? (vec (blocks-dep "rm-000a" "rm-000b")
                             (blocks-dep "rm-000a" "rm-000c")
                             (blocks-dep "rm-000b" "rm-000d"))
                        "rm-000c" "rm-000d"))))

(deftest a-reversed-chain-edge-is-not-a-cycle
  (assert (not (closes? (vec (blocks-dep "rm-000a" "rm-000b"))
                        "rm-000a" "rm-000c"))))

(deftest a-deep-layered-graph-is-searched-once-per-item
  (let (deps (layered-deps)
        top (layer-id (dec layer-count) "a")
        bottom (layer-id 0 "a"))
    (assert (not (closes? deps "rm-new" (as-str top))))
    (assert (closes? deps (as-str bottom) (as-str top)))))
