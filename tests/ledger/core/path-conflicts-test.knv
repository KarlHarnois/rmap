(use ledger/model ->path-lock kind)
(use ledger/core/path-conflicts lock-conflicts)
(use support/items glob-of id-of)

(defn lock (id kind pattern)
  (->path-lock :item (id-of id)
               :kind kind
               :globs (vec (glob-of pattern))))

(deftest a-research-item-never-conflicts-with-a-build
  (assert (empty? (lock-conflicts
                    (ref (lock "rm-0001" kind/research "src/a/**"))
                    (ref (lock "rm-0002" kind/build "src/a/**"))))))

(deftest a-design-item-never-conflicts-with-a-build
  (assert (empty? (lock-conflicts (ref (lock "rm-0001" kind/build "src/a/**"))
                                  (ref
                                    (lock "rm-0002" kind/design "src/a/**"))))))

(deftest builds-on-disjoint-paths-do-not-conflict
  (assert (empty? (lock-conflicts (ref (lock "rm-0001" kind/build "src/a/**"))
                                  (ref
                                    (lock "rm-0002" kind/build "docs/*.md"))))))

(deftest builds-on-overlapping-paths-name-the-holder-and-both-globs
  (let (conflicts (lock-conflicts (ref (lock "rm-0001" kind/build "src/a/x.rs"))
                                  (ref (lock "rm-0002" kind/build "src/a/**")))
        conflict (unwrap (first conflicts)))
    (assert (= (len conflicts) 1))
    (assert (= (:with conflict) (id-of "rm-0002")))
    (assert (= (:glob conflict) (glob-of "src/a/x.rs")))
    (assert (= (:other-glob conflict) (glob-of "src/a/**")))))
