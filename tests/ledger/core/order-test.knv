(use ledger/model ->timestamp item origin)
(use ledger/core/order ordered)
(use support/items work-item)
(use ledger/model kind status)

(defstruct rank
  :origin origin
  :priority int
  :created-at string)

(type ready-item
  (fn ((ref str) rank) item))

(defn ready-item (id rank)
  (-> (work-item id kind/build status/open)
      (assoc :origin (:origin rank))
      (assoc :priority (:priority rank))
      (assoc :created-at (->timestamp :value (clone (:created-at rank))))))

(type ids-of
  (fn ((vec item)) (vec string)))

(defn ids-of (items)
  (-> items iter
      (map (fn (item) (clone (:value (:id item)))))
      collect))

(deftest user-bugs-come-first
  (assert (= (ids-of (ordered (vec (ready-item "rm-0001"
                                               (->rank :origin origin/planned
                                                       :priority 9
                                                       :created-at (str "2026-01-01")))
                                   (ready-item "rm-0002"
                                               (->rank :origin origin/user-bug
                                                       :priority 0
                                                       :created-at (str "2026-01-02"))))))
             (vec (str "rm-0002") (str "rm-0001")))))

(deftest equal-origins-order-by-higher-priority
  (assert (= (ids-of (ordered (vec (ready-item "rm-0001"
                                               (->rank :origin origin/follow-up
                                                       :priority 1
                                                       :created-at (str "2026-01-01")))
                                   (ready-item "rm-0002"
                                               (->rank :origin origin/planned
                                                       :priority 5
                                                       :created-at (str "2026-01-02"))))))
             (vec (str "rm-0002") (str "rm-0001")))))

(deftest equal-priorities-order-by-older-first
  (assert (= (ids-of (ordered (vec (ready-item "rm-0001"
                                               (->rank :origin origin/user-bug
                                                       :priority 3
                                                       :created-at (str "2026-01-05")))
                                   (ready-item "rm-0002"
                                               (->rank :origin origin/user-bug
                                                       :priority 3
                                                       :created-at (str "2026-01-02"))))))
             (vec (str "rm-0002") (str "rm-0001")))))

(deftest equal-times-order-by-id
  (assert (= (ids-of (ordered (vec (ready-item "rm-00ff"
                                               (->rank :origin origin/planned
                                                       :priority 3
                                                       :created-at (str "2026-01-02")))
                                   (ready-item "rm-0010"
                                               (->rank :origin origin/planned
                                                       :priority 3
                                                       :created-at (str "2026-01-02"))))))
             (vec (str "rm-0010") (str "rm-00ff")))))
