(use ledger/model ->decision-id ->item-id ->roadmap-id
                  ->session ->timestamp decision-status item
                  kind roadmap-pause status)

(use ledger/core/actions action actor actor-of)
(use ledger/core/next ->deliveries next-entry next-of)
(use ledger/model/sessions ->session-id)

(use ledger/model/pull-requests ->head ->pr-number
                                ->pull-request ->review
                                ->review-id review-kind
                                verdict)

(use ledger/core/ready readiness-of)
(use ledger/core/snapshot scope)
(use ledger/model/reports ->report-id report-kind)
(use support/reports report-on)

(use support/items blocks-dep child-of claimed
                   decision-block-on epic-item id-of
                   in-roadmap paused-snapshot-of roadmap-of
                   snapshot-of work-item)

(use support/decisions sample-decision)

(use support/generated-snapshots generated-roadmap-ids
                                 generated-snapshot)

(def seed-count 300)

(def sha "1111111111111111111111111111111111111111")

(defn worker ()
  (some (->session :name (str "worker"))))

(defn claimed-in (status)
  (taken-by (sole-action (claimed (work-item "rm-0001" kind/build status)))))

(defn sole-action (item)
  (-> (next-in (alone item))
      first
      (then-some (fn (entry)
                   (map-some (first (entry-actions entry)) clone)))))

(defn alone (item)
  (snapshot-of (vec item) (vec)))

(defn taken-by (planned)
  (map-some planned
    (fn (present)
      (pair (:action present)
            (pair (:actor present)
                  (clone (:session present)))))))

(defn blocked-pair ()
  (snapshot-of (vec (work-item "rm-0001" kind/design status/open)
                    (work-item "rm-0002" kind/build status/in-review))
               (vec (blocks-dep "rm-0001" "rm-0002"))))

(defn action-of-first (snapshot)
  (let (entry (unwrap (first (next-in (clone snapshot)))))
    (clone (unwrap (first (entry-actions entry))))))

(defn next-in (snapshot)
  (next-of (ref snapshot)
           (ref (vec (road)))
           (ref (reports-only (vec)))
           (ref (vec))))

(defn road () (roadmap-of "rm-road" "manager"))

(defn reports-only (reports)
  (->deliveries :reports reports :pull-requests (vec)))

(defn ids-of (listed)
  (collect (map (filter (iter listed) item-listed?)
             (fn (entry)
               (clone (:value (:id (:item (unwrap (entry-item entry))))))))))

(defn item-listed? (entry)
  (match (entry-item entry)
    ((some _) true)
    (none false)))

(defn wait-reasons-match-ready? (snapshot)
  (let (blocked (:blocked (readiness-of snapshot (ref scope/every-roadmap))))
    (every? (iter (generated-next snapshot))
      (fn (entry)
        (every? (iter (entry-actions entry))
          (fn (planned)
            (or (not= (:action planned) action/wait)
                (match (entry-item entry)
                  ((some item)
                   (any? (iter blocked)
                     (fn (held)
                       (and (= (:id (:item held))
                               (:id (:item item)))
                            (= (:reasons planned)
                               (some (clone (:blockage held))))))))
                  (none false)))))))))

(defn actors-from-table? (snapshot)
  (every? (iter (generated-next snapshot))
    (fn (entry)
      (let (actions (entry-actions entry))
        (and (not (empty? actions))
             (every? (iter actions)
               (fn (planned)
                 (= (:actor planned)
                    (actor-of (:action planned))))))))))

(defn dispatch-order-matches-ready? (snapshot)
  (let (listed (generated-next snapshot)
        ready (:ready (readiness-of snapshot (ref scope/every-roadmap))))
    (every? (iter generated-roadmap-ids)
      (fn (roadmap-id)
        (= (dispatched-ids-in (ref listed) (deref roadmap-id))
           (ready-ids-in ready (deref roadmap-id)))))))

(defn generated-next (snapshot)
  (next-of snapshot
           (ref (generated-roadmaps))
           (ref (reports-only (vec)))
           (ref (vec))))

(defn generated-roadmaps ()
  (collect (map (iter generated-roadmap-ids)
             (fn (id)
               (roadmap-of (deref id) "manager")))))

(defn dispatched-ids-in (listed roadmap-id)
  (collect (map (filter (iter listed)
                  (fn (entry) (dispatched-entry? entry roadmap-id)))
                (fn (entry)
                  (clone (:value (:id (:item (unwrap (entry-item entry))))))))))

(defn dispatched-entry? (entry roadmap-id)
  (match (entry-item entry)
    ((some item)
     (and (= (as-str (:value (:id (:roadmap item))))
             roadmap-id)
          (any? (iter (entry-actions entry))
            (fn (planned)
              (= (:action planned) action/dispatch)))))
    (none false)))

(type ready-ids-in
  (fn ((ref (vec item)) (ref str))
    (vec string)))

(defn ready-ids-in (ready roadmap-id)
  (collect (map (filter (iter ready)
                  (fn (item)
                    (= (as-str (:value (:roadmap-id item)))
                       roadmap-id)))
                (fn (item) (clone (:value (:id item)))))))

(defn in-review-action (verdict)
  (build-action status/in-review verdict))

(defn build-action (status verdict)
  (let (listed (next-of (ref (alone (claimed
                                      (work-item "rm-0001" kind/build status))))
                        (ref (vec (road)))
                        (ref (->deliveries :reports (vec)
                                           :pull-requests (vec (pull-request-with
                                                                 verdict))))
                        (ref (vec))))
    (clone (at (entry-actions (at listed 0)) 0))))

(defn approved-deliveries ()
  (->deliveries :reports (vec)
                :pull-requests (vec (pull-request-with verdict/approve))))

(defn pull-request-with (verdict)
  (->pull-request :item (->item-id :value (str "rm-0001"))
                  :pr-number (->pr-number :value 12)
                  :head (->head :sha (str sha))
                  :opened-at (->timestamp :value (str "2026-01-02T00:00:00Z"))
                  :reviews (vec (->review :id (->review-id :value 1)
                                          :item (->item-id :value (str
                                                                    "rm-0001"))
                                          :session-id (->session-id :value 2)
                                          :reviewer (->session :name (str "r1"))
                                          :kind review-kind/behavior
                                          :head (->head :sha (str sha))
                                          :verdict verdict
                                          :created-at (->timestamp :value (str "2026-01-03T00:00:00Z"))))))

(defn item-entry-for (listed id)
  (clone (unwrap (find (iter listed)
                   (fn (entry)
                     (match (entry-item entry)
                       ((some item) (= (:id (:item item)) (id-of id)))
                       (none false)))))))

(defn decision-listed? (entry)
  (match entry
    ((next-entry/listed-item _) false)
    ((next-entry/listed-decision _) true)))

(defn reason-ids (planned)
  (collect (map (iter (:decisions (unwrap (clone (:reasons planned)))))
             (fn (id) (clone (:value id))))))

(defn blocked-snapshot (status)
  (let (item (work-item "rm-0001" kind/build status/open))
    (assoc (snapshot-of (vec item) (vec))
           :decision-blocks (vec
                              (decision-block-on "rm-d1" "rm-0001" status)))))

(defn entry-item (entry)
  (match entry
    ((next-entry/listed-item item) (some (clone item)))
    ((next-entry/listed-decision _) none)))

(defn entry-actions (entry)
  (match entry
    ((next-entry/listed-item item) (clone (:actions item)))
    ((next-entry/listed-decision decision)
     (clone (:actions decision)))))

(defn finished-with-rejected (status)
  (let (item (work-item "rm-0001" kind/build status)
        decision (assoc (sample-decision decision-status/rejected)
                        :item (some (clone (:id item)))))
    (next-of (ref (snapshot-of (vec item) (vec)))
             (ref (vec (road)))
             (ref (reports-only (vec)))
             (ref (vec decision)))))

(deftest an-open-ready-item-is-dispatched-by-the-controller
  (assert (= (taken-by (sole-action
                         (work-item "rm-0001" kind/research status/open)))
             (some (pair action/dispatch (pair actor/controller none))))))

(deftest an-open-blocked-item-waits-on-the-controller
  (assert (= (taken-by (some (action-of-first (ref (blocked-pair)))))
             (some (pair action/wait (pair actor/controller none))))))

(deftest a-blocked-item-waits-for-the-reasons-ready-gives
  (let (snapshot (blocked-pair)
        readiness (readiness-of (ref snapshot) (ref scope/every-roadmap)))
    (assert (= (:reasons (action-of-first (ref snapshot)))
               (some (clone (:blockage (unwrap (first (:blocked
                                                        readiness))))))))))

(deftest an-open-item-in-a-paused-roadmap-waits-with-the-pause-reason
  (let (snapshot (paused-snapshot-of
                   (vec (work-item "rm-0001" kind/design status/open))
                   (vec))
        action (action-of-first (ref snapshot)))
    (assert (= (:action action) action/wait))
    (assert (= (:pause (unwrap (clone (:reasons action))))
               roadmap-pause/paused))))

(deftest a-started-item-keeps-its-action-in-a-paused-roadmap
  (let (snapshot (paused-snapshot-of
                   (vec (claimed
                          (work-item "rm-0001" kind/build status/dispatched)))
                   (vec))
        action (action-of-first (ref snapshot)))
    (assert (= (:action action) action/work))))

(deftest a-dispatched-item-is-worked-by-its-session
  (assert (= (claimed-in status/dispatched)
             (some (pair action/work (pair actor/worker (worker)))))))

(deftest a-reported-item-has-its-report-accepted-by-the-agent
  (assert (= (claimed-in status/reported)
             (some (pair action/accept-report (pair actor/agent (worker)))))))

(deftest an-item-in-review-is-reviewed-by-the-agent
  (assert (= (claimed-in status/in-review)
             (some (pair action/review (pair actor/agent (worker)))))))

(deftest a-fixing-item-is-fixed-by-its-session
  (assert (= (claimed-in status/fixing)
             (some (pair action/fix (pair actor/worker (worker)))))))

(deftest a-merging-item-without-a-pull-request-goes-back-to-review
  (assert (= (claimed-in status/merging)
             (some (pair action/review (pair actor/agent (worker)))))))

(deftest an-epic-is-not-listed
  (assert (empty? (next-in (snapshot-of (vec (epic-item "rm-0001")
                                             (child-of (work-item "rm-0002"
                                                                  kind/build
                                                                  status/merged)
                                                       "rm-0001"))
                                        (vec))))))

(deftest a-merged-item-is-not-listed
  (assert (empty? (next-in (alone
                             (work-item "rm-0001" kind/build status/merged))))))

(deftest a-dropped-item-is-not-listed
  (assert (empty? (next-in
                    (alone (work-item "rm-0001" kind/build status/dropped))))))

(deftest a-lower-priority-number-comes-first-as-in-ready
  (let (listed (next-in
                 (snapshot-of
                   (vec (assoc (work-item "rm-0001" kind/research status/open)
                               :priority 4)
                        (assoc (work-item "rm-0002" kind/research status/open)
                               :priority 0))
                   (vec))))
    (assert (= (ids-of (ref listed))
               (vec (str "rm-0002") (str "rm-0001"))))))

(deftest items-follow-the-order-of-the-roadmaps-given
  (let (snapshot (snapshot-of
                   (vec (work-item "rm-0001" kind/research status/open)
                        (in-roadmap
                          (work-item "rm-0002" kind/research status/open)
                          "rm-other"))
                   (vec))
        listed (next-of (ref snapshot)
                        (ref (vec (roadmap-of "rm-other" "manager") (road)))
                        (ref (reports-only (vec)))
                        (ref (vec))))
    (assert (= (ids-of (ref listed))
               (vec (str "rm-0002") (str "rm-0001"))))))

(deftest a-roadmap-not-given-is-not-listed
  (assert (empty? (next-of (ref (alone (work-item "rm-0001"
                                                  kind/research
                                                  status/open)))
                           (ref (vec (roadmap-of "rm-other" "manager")))
                           (ref (reports-only (vec)))
                           (ref (vec))))))

(deftest a-waiting-item-gives-the-reasons-ready-gives
  (for-each (range 0 seed-count)
    (fn (seed)
      (assert (wait-reasons-match-ready? (ref (generated-snapshot seed)))))))

(deftest every-actor-comes-from-the-actions-table
  (for-each (range 0 seed-count)
    (fn (seed)
      (assert (actors-from-table? (ref (generated-snapshot seed)))))))

(deftest within-each-roadmap-dispatch-follows-the-order-of-ready
  (for-each (range 0 seed-count)
    (fn (seed)
      (assert (dispatch-order-matches-ready? (ref (generated-snapshot
                                                    seed)))))))

(deftest generated-graphs-dispatch-items-in-both-roadmaps
  (let (listed (vec))
    (for-each (range 0 seed-count)
      (fn (seed)
        (for-each (generated-next (ref (generated-snapshot seed)))
          (fn (entry)
            (push! listed (clone entry))))))
    (assert (every? (iter generated-roadmap-ids)
              (fn (roadmap-id)
                (not (empty? (dispatched-ids-in (ref listed)
                                                (deref roadmap-id)))))))))

(deftest an-accepted-item-has-no-next-action
  (assert (= (claimed-in status/accepted) none)))

(deftest an-unread-question-adds-an-answer-beside-the-status-action
  (let (listed (next-of (ref (alone (claimed (work-item "rm-0001"
                                                        kind/build
                                                        status/dispatched))))
                        (ref (vec (road)))
                        (ref (reports-only
                               (vec (report-on 2 "rm-0001"
                                               report-kind/question))))
                        (ref (vec))))
    (assert (= (collect (map (iter (entry-actions (at listed 0)))
                          (fn (planned) (:action planned))))
               (vec action/work action/answer)))
    (assert (= (:actor (at (entry-actions (at listed 0)) 1))
               actor/agent))))

(deftest an-unread-done-report-names-its-id-on-accept-report
  (let (listed (next-of (ref (alone (claimed (work-item "rm-0001"
                                                        kind/research
                                                        status/reported))))
                        (ref (vec (road)))
                        (ref (reports-only
                               (vec (report-on 3 "rm-0001" report-kind/done))))
                        (ref (vec))))
    (assert (= (:action (at (entry-actions (at listed 0)) 0))
               action/accept-report))
    (assert (= (:report (at (entry-actions (at listed 0)) 0))
               (some (->report-id :value 3))))))

(deftest an-approved-build-in-review-is-merged-by-the-controller
  (let (planned (in-review-action verdict/approve))
    (assert (= (:action planned) action/merge))
    (assert (= (:actor planned) actor/controller))))

(deftest a-build-with-changes-asked-stays-in-review
  (assert (= (:action (in-review-action verdict/changes))
             action/review)))

(deftest an-approved-merging-build-is-merged-by-the-controller
  (let (planned (build-action status/merging verdict/approve))
    (assert (= (:action planned) action/merge))
    (assert (= (:actor planned) actor/controller))))

(deftest a-merging-build-with-changes-asked-is-listed-for-review
  (assert (= (:action (build-action status/merging verdict/changes))
             action/review)))

(deftest a-proposed-decision-is-listed-before-the-roadmaps-items
  (let (snapshot (snapshot-of (vec (work-item "rm-0001" kind/build status/open))
                              (vec))
        decisions (vec (sample-decision decision-status/proposed))
        listed (next-of (ref snapshot)
                        (ref (vec (road)))
                        (ref (reports-only (vec)))
                        (ref decisions)))
    (assert (= (len listed) 2))
    (assert (decision-listed? (at listed 0)))
    (assert (item-listed? (at listed 1)))))

(deftest a-standalone-decision-is-listed-without-items
  (let (snapshot (snapshot-of (vec) (vec))
        decisions (vec (sample-decision decision-status/proposed))
        listed (next-of (ref snapshot)
                        (ref (vec (road)))
                        (ref (reports-only (vec)))
                        (ref decisions)))
    (assert (= (len listed) 1))
    (assert (decision-listed? (at listed 0)))))

(deftest a-decision-in-an-unlisted-roadmap-is-listed-nowhere
  (let (snapshot (snapshot-of (vec) (vec))
        decisions (vec (assoc (sample-decision decision-status/proposed)
                              :roadmap-id (->roadmap-id (str "rm-other"))))
        listed (next-of (ref snapshot)
                        (ref (vec (road)))
                        (ref (reports-only (vec)))
                        (ref decisions)))
    (assert (empty? listed))))

(deftest an-item-held-only-by-a-proposed-decision-waits-on-it
  (let (listed (next-in (blocked-snapshot decision-status/proposed))
        entry (item-entry-for listed "rm-0001")
        planned (clone (unwrap (first (entry-actions entry)))))
    (assert (= (:action planned) action/wait))
    (assert (= (reason-ids planned)
               (vec (str "rm-d1"))))))

(deftest an-item-held-only-by-a-rejected-decision-replans
  (let (listed (next-in (blocked-snapshot decision-status/rejected))
        entry (item-entry-for listed "rm-0001"))
    (assert (= (:action (clone (unwrap (first (entry-actions entry)))))
               action/replan))
    (assert (= (:actor (clone (unwrap (first (entry-actions entry)))))
               actor/agent))))

(deftest an-item-that-raised-a-rejected-decision-replans
  (let (item (claimed (work-item "rm-0001" kind/design status/reported))
        decision (assoc (sample-decision decision-status/rejected)
                        :item (some (clone (:id item))))
        listed (next-of (ref (snapshot-of (vec item) (vec)))
                        (ref (vec (road)))
                        (ref (reports-only (vec)))
                        (ref (vec decision)))
        entry (item-entry-for listed "rm-0001"))
    (assert (= (:action (clone (unwrap (first (entry-actions entry)))))
               action/replan))))

(deftest a-dispatched-build-keeps-working-and-replans-a-rejection
  (let (item (claimed (work-item "rm-0001" kind/build status/dispatched))
        proposed (assoc (sample-decision decision-status/proposed)
                        :item (some (clone (:id item))))
        rejected (assoc (sample-decision decision-status/rejected)
                        :id (->decision-id :value (str "rm-d2"))
                        :item (some (clone (:id item))))
        entry-with-proposed (item-entry-for
                              (next-of (ref (snapshot-of (vec item) (vec)))
                                       (ref (vec (road)))
                                       (ref (reports-only (vec)))
                                       (ref (vec proposed)))
                              "rm-0001")
        item-with-rejected (claimed
                             (work-item "rm-0001" kind/build status/dispatched))
        entry-with-rejected (item-entry-for (next-of (ref (snapshot-of (vec item-with-rejected)
                                                                       (vec)))
                                                     (ref (vec (road)))
                                                     (ref (reports-only (vec)))
                                                     (ref (vec rejected)))
                                            "rm-0001"))
    (assert (= (collect (map (iter (entry-actions entry-with-proposed))
                          (fn (planned) (:action planned))))
               (vec action/work)))
    (assert (= (collect (map (iter (entry-actions entry-with-rejected))
                          (fn (planned) (:action planned))))
               (vec action/work action/replan)))))

(deftest a-merging-build-waits-on-a-proposed-decision-it-raised
  (let (item (claimed (work-item "rm-0001" kind/build status/merging))
        decision (assoc (sample-decision decision-status/proposed)
                        :item (some (clone (:id item))))
        entry (item-entry-for (next-of (ref (snapshot-of (vec item) (vec)))
                                       (ref (vec (road)))
                                       (ref (approved-deliveries))
                                       (ref (vec decision)))
                              "rm-0001"))
    (assert (= (:action (clone (unwrap (first (entry-actions entry)))))
               action/wait))))

(deftest a-merging-build-replans-a-rejected-decision-it-raised
  (let (item (claimed (work-item "rm-0001" kind/build status/merging))
        decision (assoc (sample-decision decision-status/rejected)
                        :item (some (clone (:id item))))
        entry (item-entry-for (next-of (ref (snapshot-of (vec item) (vec)))
                                       (ref (vec (road)))
                                       (ref (approved-deliveries))
                                       (ref (vec decision)))
                              "rm-0001"))
    (assert (= (:action (clone (unwrap (first (entry-actions entry)))))
               action/replan))))

(deftest an-open-item-lists-one-replan-when-one-decision-is-raised-and-blocking
  (let (item (work-item "rm-0001" kind/build status/open)
        decision (assoc (sample-decision decision-status/rejected)
                        :id (->decision-id :value (str "rm-d1"))
                        :item (some (clone (:id item))))
        snapshot (assoc (snapshot-of (vec item) (vec))
                        :decision-blocks (vec (decision-block-on
                                                "rm-d1"
                                                "rm-0001"
                                                decision-status/rejected)))
        entry (item-entry-for (next-of (ref snapshot)
                                       (ref (vec (road)))
                                       (ref (reports-only (vec)))
                                       (ref (vec decision)))
                              "rm-0001")
        actions (entry-actions entry))
    (assert (= (len actions) 1))
    (assert (= (:action (clone (unwrap (first actions))))
               action/replan))
    (assert (= (reason-ids (clone (unwrap (first actions))))
               (vec (str "rm-d1"))))))

(deftest an-open-item-lists-one-replan-with-both-decisions-when-two-apply
  (let (item (work-item "rm-0001" kind/build status/open)
        raised (assoc (sample-decision decision-status/rejected)
                      :id (->decision-id :value (str "rm-d1"))
                      :item (some (clone (:id item))))
        blocking (assoc (sample-decision decision-status/rejected)
                        :id (->decision-id :value (str "rm-d2")))
        snapshot (assoc (snapshot-of (vec item) (vec))
                        :decision-blocks (vec (decision-block-on
                                                "rm-d2"
                                                "rm-0001"
                                                decision-status/rejected)))
        entry (item-entry-for (next-of (ref snapshot)
                                       (ref (vec (road)))
                                       (ref (reports-only (vec)))
                                       (ref (vec raised blocking)))
                              "rm-0001")
        actions (entry-actions entry))
    (assert (= (len actions) 1))
    (assert (= (:action (clone (unwrap (first actions))))
               action/replan))
    (assert (= (reason-ids (clone (unwrap (first actions))))
               (vec (str "rm-d1") (str "rm-d2"))))))

(deftest an-accepted-item-with-a-raised-rejection-is-not-listed
  (assert (empty? (finished-with-rejected status/accepted))))

(deftest a-merged-item-with-a-raised-rejection-is-not-listed
  (assert (empty? (finished-with-rejected status/merged))))

(deftest a-dropped-item-with-a-raised-rejection-is-not-listed
  (assert (empty? (finished-with-rejected status/dropped))))
