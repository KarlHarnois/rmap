(use ledger/model ->session item kind status)
(use ledger/refusal refusal)
(use ledger/core/move move)
(use ledger/model/reports report-kind)
(use ledger/core/transitions approved-move)

(use support/items claimed kinds session-start-named
                   snapshot-of statuses work-item)

(defstruct allowed-move
  :command string
  :from status
  :to status
  :kinds (vec kind))

(defstruct attempt
  :command string
  :proposed-move move
  :target status)

(defn grid-matches-spec? (kind from)
  (let (item (work-item "rm-0001" kind from))
    (every? (iter (attempts kind from))
      (fn (attempt)
        (= (verdict (ref item)
                    (ref (:proposed-move attempt)))
           (expected-refusal (ref item) attempt))))))

(defn attempts (kind from)
  (let (all (vec (->attempt :command (str "report done")
                            :proposed-move (move/report report-kind/done)
                            :target (done-target kind))
                 (->attempt :command (str "report fixed")
                            :proposed-move (move/report report-kind/fixed)
                            :target status/in-review)
                 (->attempt :command (str "report question")
                            :proposed-move (move/report report-kind/question)
                            :target from)
                 (->attempt :command (str "claim")
                            :proposed-move (move/claim (session-start-named
                                                         "s1"))
                            :target status/dispatched)
                 (->attempt :command (str "build")
                            :proposed-move move/advance-to-build
                            :target status/dispatched)
                 (->attempt :command (str "close")
                            :proposed-move move/close
                            :target (close-target kind))
                 (->attempt :command (str "drop")
                            :proposed-move (move/drop (str "no longer needed"))
                            :target status/dropped)))
    (for-each (statuses)
      (fn (target)
        (push! all
               (->attempt :command (str "advance")
                          :proposed-move (move/advance (deref target))
                          :target (deref target)))))
    all))

(defn done-target (kind)
  (match kind (build status/in-review) (_ status/reported)))

(defn close-target (kind)
  (match kind
    (research status/accepted)
    (design status/accepted)
    (_ status/merged)))

(type expected-refusal
  (fn ((ref item) (ref attempt))
    (option refusal)))

(defn expected-refusal (item attempt)
  (cond
    ((= (:kind item) kind/epic)
     (some refusal/epic-status-computed))
    ((spec-allows? item attempt) none)
    (else (some (refusal/invalid-transition (:status item)
                                            (:target attempt))))))

(type spec-allows?
  (fn ((ref item) (ref attempt)) bool))

(defn spec-allows? (item attempt)
  (any? (iter (spec-table))
    (fn (row)
      (and (= (:command row) (:command attempt))
           (= (:from row) (:status item))
           (= (:to row) (:target attempt))
           (contains? (:kinds row) (:kind item))))))

(defn spec-table ()
  (vec (->allowed-move :command (str "claim")
                       :from status/open
                       :to status/dispatched
                       :kinds (work-kinds))
       (->allowed-move :command (str "advance")
                       :from status/dispatched
                       :to status/open
                       :kinds (work-kinds))
       (->allowed-move :command (str "advance")
                       :from status/dispatched
                       :to status/reported
                       :kinds (vec kind/research kind/design))
       (->allowed-move :command (str "advance")
                       :from status/dispatched
                       :to status/in-review
                       :kinds (vec kind/build))
       (->allowed-move :command (str "build")
                       :from status/reported
                       :to status/dispatched
                       :kinds (vec kind/research kind/design))
       (->allowed-move :command (str "advance")
                       :from status/in-review
                       :to status/fixing
                       :kinds (vec kind/build))
       (->allowed-move :command (str "advance")
                       :from status/in-review
                       :to status/merging
                       :kinds (vec kind/build))
       (->allowed-move :command (str "advance")
                       :from status/fixing
                       :to status/in-review
                       :kinds (vec kind/build))
       (->allowed-move :command (str "advance")
                       :from status/merging
                       :to status/fixing
                       :kinds (vec kind/build))
       (->allowed-move :command (str "close")
                       :from status/merging
                       :to status/merged
                       :kinds (vec kind/build))
       (->allowed-move :command (str "close")
                       :from status/reported
                       :to status/accepted
                       :kinds (vec kind/research kind/design))
       (->allowed-move :command (str "drop")
                       :from status/open
                       :to status/dropped
                       :kinds (work-kinds))
       (->allowed-move :command (str "drop")
                       :from status/dispatched
                       :to status/dropped
                       :kinds (work-kinds))
       (->allowed-move :command (str "drop")
                       :from status/reported
                       :to status/dropped
                       :kinds (work-kinds))
       (->allowed-move :command (str "drop")
                       :from status/in-review
                       :to status/dropped
                       :kinds (work-kinds))
       (->allowed-move :command (str "drop")
                       :from status/fixing
                       :to status/dropped
                       :kinds (work-kinds))
       (->allowed-move :command (str "drop")
                       :from status/merging
                       :to status/dropped
                       :kinds (work-kinds))
       (->allowed-move :command (str "report done")
                       :from status/dispatched
                       :to status/reported
                       :kinds (vec kind/research kind/design))
       (->allowed-move :command (str "report question")
                       :from status/dispatched
                       :to status/dispatched
                       :kinds (work-kinds))
       (->allowed-move :command (str "report question")
                       :from status/reported
                       :to status/reported
                       :kinds (work-kinds))
       (->allowed-move :command (str "report question")
                       :from status/in-review
                       :to status/in-review
                       :kinds (work-kinds))
       (->allowed-move :command (str "report question")
                       :from status/fixing
                       :to status/fixing
                       :kinds (work-kinds))
       (->allowed-move :command (str "report question")
                       :from status/merging
                       :to status/merging
                       :kinds (work-kinds))))

(defn work-kinds ()
  (vec kind/research kind/design kind/build))

(defn verdict (item move)
  (refusal-of (approved-move (ref (snapshot-of (vec (clone item)) (vec)))
                             item
                             (clone move))))

(defn refusal-of (outcome)
  (match outcome
    ((ok _) none)
    ((err refused) (some refused))))

(defn claim-beside-worker (name)
  (let (item (work-item "rm-0001" kind/build status/open)
        busy (claimed (work-item "rm-0002" kind/build status/dispatched)))
    (approved-move (ref (snapshot-of (vec (clone item) busy)
                                     (vec)))
                   (ref item)
                   (move/claim (session-start-named name)))))

(deftest every-move-from-every-status-of-every-kind-follows-the-table
  (for-each (kinds)
    (fn (kind)
      (for-each (statuses)
        (fn (from)
          (assert (grid-matches-spec? (deref kind) (deref from))))))))

(deftest a-refused-transition-names-both-statuses
  (assert (= (verdict (ref (work-item "rm-0001" kind/build status/open))
                      (ref move/close))
             (some (refusal/invalid-transition status/open status/merged)))))

(deftest closing-a-reported-design-accepts-it
  (assert (= (verdict (ref (work-item "rm-0001" kind/design status/reported))
                      (ref move/close))
             none)))

(deftest closing-an-open-research-item-names-accepted-as-the-target
  (assert (= (verdict (ref (work-item "rm-0001" kind/research status/open))
                      (ref move/close))
             (some (refusal/invalid-transition status/open status/accepted)))))

(deftest an-accepted-item-cannot-be-dropped
  (assert (= (verdict (ref (work-item "rm-0001" kind/research status/accepted))
                      (ref (move/drop (str "late"))))
             (some (refusal/invalid-transition status/accepted
                                               status/dropped)))))

(deftest a-claim-under-the-name-of-a-live-session-is-refused
  (assert (= (claim-beside-worker "worker")
             (err (refusal/session-busy (->session :name (str "worker")))))))

(deftest a-claim-under-a-free-name-is-approved
  (assert (ok? (claim-beside-worker "other"))))
