(use ledger/model claim dep-type item item-id kind snapshot
                  status)

(use ledger/core/ready readiness-of)
(use ledger/core/snapshot scope)

(use support/items blocks-dep child-of claimed epic-item
                   id-of snapshot-of work-item)

(use support/generated-snapshots generated-snapshot)

(def seed-count 300)

(defn ready-ids (snapshot)
  (-> (:ready (readiness-of (ref snapshot) (ref scope/every-roadmap)))
      iter
      (map (fn (item) (clone (:value (:id item)))))
      collect))

(defn agrees-with-oracle? (seed)
  (let (snapshot (generated-snapshot seed)
        readiness (readiness-of (ref snapshot) (ref scope/every-roadmap))
        ready (:ready readiness))
    (and (every? (iter ready)
           (fn (item)
             (startable? (ref snapshot) item)))
         (every? (iter (:items snapshot))
           (fn (item)
             (or (not (startable? (ref snapshot) item))
                 (any? (iter ready)
                   (fn (other) (= (:id other) (:id item))))))))))

(type startable?
  (fn ((ref snapshot) (ref item)) bool))

(defn startable? (snapshot item)
  (and (not= (:kind item) kind/epic)
       (= (:status item) status/open)
       (= (:claim item) claim/unclaimed)
       (blockers-done? snapshot item)))

(type blockers-done?
  (fn ((ref snapshot) (ref item)) bool))

(defn blockers-done? (snapshot item)
  (every? (iter (:deps snapshot))
    (fn (dep)
      (or (not= (:item dep) (:id item))
          (not= (:type dep) dep-type/blocks)
          (done-for-dependents? snapshot (ref (:on dep)))))))

(defn done-for-dependents? (snapshot id)
  (match (find-in snapshot id)
    ((some target) (target-done? snapshot (ref target)))
    (none false)))

(type target-done?
  (fn ((ref snapshot) (ref item)) bool))

(defn target-done? (snapshot target)
  (match (:kind target)
    (epic (epic-done? snapshot (ref (:id target))))
    (build (= (:status target) status/merged))
    (_ (= (:status target) status/accepted))))

(type epic-done?
  (fn ((ref snapshot) (ref item-id)) bool))

(defn epic-done? (snapshot epic)
  (let (children (collect (filter (iter (:items snapshot))
                            (fn (item)
                              (= (ref (:parent item))
                                 (ref (some (clone epic))))))))
    (and (not (empty? children))
         (every? (iter children)
           (fn (child)
             (contains? (finished-statuses) (:status child)))))))

(type find-in
  (fn ((ref snapshot) (ref item-id))
    (option item)))

(defn find-in (snapshot id)
  (-> (:items snapshot)
      iter
      (find (fn (item) (= (ref (:id item)) id)))
      (map-some clone)))

(defn finished-statuses ()
  (vec status/merged status/accepted status/dropped))

(deftest an-open-unclaimed-item-is-ready
  (assert (= (ready-ids (snapshot-of
                          (vec (work-item "rm-0001" kind/research status/open))
                          (vec)))
             (vec (str "rm-0001")))))

(deftest an-epic-is-never-ready
  (assert (empty? (ready-ids (snapshot-of (vec (epic-item "rm-0001"))
                                          (vec))))))

(deftest a-claimed-item-is-not-ready
  (assert (empty? (ready-ids (snapshot-of (vec (claimed (work-item
                                                          "rm-0001"
                                                          kind/design
                                                          status/open)))
                                          (vec))))))

(deftest a-started-item-is-not-ready
  (assert (empty? (ready-ids (snapshot-of (vec (work-item "rm-0001"
                                                          kind/build
                                                          status/dispatched))
                                          (vec))))))

(deftest an-unmerged-blocker-blocks
  (assert (= (ready-ids (snapshot-of
                          (vec
                            (work-item "rm-0001" kind/design status/open)
                            (work-item "rm-0002" kind/design status/in-review))
                          (vec (blocks-dep "rm-0001" "rm-0002"))))
             (vec))))

(deftest a-merged-blocker-releases
  (assert (= (ready-ids (snapshot-of
                          (vec (work-item "rm-0001" kind/design status/open)
                               (work-item "rm-0002" kind/build status/merged))
                          (vec (blocks-dep "rm-0001" "rm-0002"))))
             (vec (str "rm-0001")))))

(deftest a-dropped-blocker-keeps-blocking
  (assert (empty? (ready-ids
                    (snapshot-of
                      (vec (work-item "rm-0001" kind/design status/open)
                           (work-item "rm-0002" kind/build status/dropped))
                      (vec (blocks-dep "rm-0001" "rm-0002")))))))

(deftest an-epic-blocker-releases-when-every-child-is-done
  (assert (= (ready-ids
               (snapshot-of
                 (vec (work-item "rm-0001" kind/design status/open)
                      (epic-item "rm-0002")
                      (child-of (work-item "rm-0003" kind/build status/merged)
                                "rm-0002")
                      (child-of (work-item "rm-0004" kind/build status/dropped)
                                "rm-0002"))
                 (vec (blocks-dep "rm-0001" "rm-0002"))))
             (vec (str "rm-0001")))))

(deftest an-epic-without-children-blocks
  (assert (empty? (ready-ids (snapshot-of
                               (vec
                                 (work-item "rm-0001" kind/design status/open)
                                 (epic-item "rm-0002"))
                               (vec (blocks-dep "rm-0001" "rm-0002")))))))

(deftest an-accepted-research-item-releases-its-dependents
  (assert (= (ready-ids (snapshot-of
                          (vec
                            (work-item "rm-0001" kind/design status/open)
                            (work-item "rm-0002" kind/research status/accepted))
                          (vec (blocks-dep "rm-0001" "rm-0002"))))
             (vec (str "rm-0001")))))

(deftest a-reported-design-not-yet-accepted-keeps-its-dependents-waiting
  (assert (= (ready-ids (snapshot-of
                          (vec
                            (work-item "rm-0001" kind/build status/open)
                            (work-item "rm-0002" kind/design status/reported))
                          (vec (blocks-dep "rm-0001" "rm-0002"))))
             (vec))))

(deftest a-dropped-blocker-is-reported-apart-from-waiting-blockers
  (let (readiness (readiness-of
                    (ref (snapshot-of
                           (vec (work-item "rm-0001" kind/design status/open)
                                (work-item "rm-0002" kind/build status/dropped)
                                (work-item "rm-0003" kind/build status/fixing))
                           (vec (blocks-dep "rm-0001" "rm-0002")
                                (blocks-dep "rm-0001" "rm-0003"))))
                    (ref scope/every-roadmap))
        blockage (clone (:blockage (unwrap (first (:blocked readiness))))))
    (assert (= (:dropped-blockers blockage)
               (vec (id-of "rm-0002"))))
    (assert (= (:blockers blockage)
               (vec (id-of "rm-0003"))))))

(deftest ready-matches-an-independent-oracle-over-generated-graphs
  (for-each (range 0 seed-count)
    (fn (seed)
      (assert (agrees-with-oracle? seed)))))

(deftest generated-graphs-contain-ready-and-blocked-items
  (let (ready-total 0
        blocked-total 0)
    (for-each (range 0 seed-count)
      (fn (seed)
        (let (readiness (readiness-of (ref (generated-snapshot seed))
                                      (ref scope/every-roadmap)))
          (set! ready-total
                (+ ready-total (len (:ready readiness))))
          (set! blocked-total
                (+ blocked-total (len (:blocked readiness)))))))
    (assert (> ready-total 0))
    (assert (> blocked-total 0))))
