(use json/value copy-of field json->entries json->int
                json->text)

(use ledger/model ->roadmap ->roadmap-id ->session
                  ->timestamp roadmap-status)

(use ledger/model/events event-type)

(use ledger/roadmap-events roadmap-max-active-changed
                           roadmap-status-changed)

(defn side-text (payload column which)
  (json->text (ref (side payload column which))))

(defn side (payload column which)
  (-> (ref payload)
      (field "changes")
      unwrap
      (field column)
      unwrap
      (field which)
      unwrap))

(defn side-int (payload column which)
  (json->int (side payload column which)))

(defn columns (payload)
  (collect (map (iter (json->entries (ref (unwrap (field (ref payload)
                                                         "changes")))))
                (fn (entry) (clone (first entry))))))

(defn roadmap-in (status)
  (->roadmap :id (->roadmap-id :value (str "rm-road"))
             :name (str "road")
             :manager (->session :name (str "m1"))
             :max-active none
             :status status
             :created-at (->timestamp :value (str "t0"))))

(defn status-change-payload (before after type)
  (copy-of (ref (:payload
                  (roadmap-status-changed (ref before) (ref after) type)))))

(deftest a-pause-records-its-status-as-old-and-new
  (let (payload (status-change-payload (roadmap-in roadmap-status/active)
                                       (roadmap-in roadmap-status/paused)
                                       event-type/roadmap-paused))
    (assert (= (columns payload)
               (vec (str "status"))))
    (assert (= (side-text payload "status" "old")
               (some (str "active"))))
    (assert (= (side-text payload "status" "new")
               (some (str "paused"))))))

(deftest a-resume-records-its-status-as-old-and-new
  (let (payload (status-change-payload (roadmap-in roadmap-status/paused)
                                       (roadmap-in roadmap-status/active)
                                       event-type/roadmap-resumed))
    (assert (= (columns payload)
               (vec (str "status"))))
    (assert (= (side-text payload "status" "old")
               (some (str "paused"))))
    (assert (= (side-text payload "status" "new")
               (some (str "active"))))))

(deftest setting-a-cap-records-its-old-and-new-value
  (let (before (roadmap-in roadmap-status/active)
        after (assoc (clone before) :max-active (some 2))
        draft (roadmap-max-active-changed (ref before) (ref after))
        payload (copy-of (ref (:payload draft))))
    (assert (= (:type draft) event-type/roadmap-max-active-changed))
    (assert (= (columns payload)
               (vec (str "max_active"))))
    (assert (= (side-int payload "max_active" "old") none))
    (assert (= (side-int payload "max_active" "new") (some 2)))))

(deftest clearing-a-cap-records-both-values
  (let (before (assoc (roadmap-in roadmap-status/active)
                      :max-active (some 2))
        after (assoc (clone before) :max-active none)
        payload (copy-of (ref (:payload (roadmap-max-active-changed (ref before)
                                                                    (ref after))))))
    (assert (= (side-int payload "max_active" "old") (some 2)))
    (assert (= (side-int payload "max_active" "new") none))))
