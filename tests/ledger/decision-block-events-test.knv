(use json/value copy-of field json->entries json->text
                null?)

(use ledger/model decision-status)
(use ledger/model/events event-type)

(use ledger/decision-block-events decision-block-added
                                  decision-block-removed)

(use support/decisions decision-id-of sample-decision)
(use support/items id-of)

(defn proposed ()
  (sample-decision decision-status/proposed))

(defn columns (payload)
  (let (names (collect (map (iter (json->entries (ref (changes-of payload))))
                         (fn (entry) (clone (first entry))))))
    (sort! names)
    names))

(defn changes-of (payload)
  (unwrap (field (ref payload) "changes")))

(defn side (payload column which)
  (-> (ref (changes-of payload))
      (field column)
      unwrap
      (field which)
      unwrap))

(deftest a-block-event-records-the-decision-and-the-item-as-inserted
  (let (draft (decision-block-added (ref (proposed))
                                    (id-of "rm-0002"))
        payload (copy-of (ref (:payload draft))))
    (assert (= (:type draft) event-type/decision-block-added))
    (assert (= (:item-id draft)
               (some (id-of "rm-0002"))))
    (assert (= (:decision-id draft)
               (some (decision-id-of "rm-d001"))))
    (assert (= (columns payload)
               (vec (str "decision_id") (str "item_id"))))
    (assert (null? (ref (side payload "decision_id" "old"))))
    (assert (= (json->text (ref (side payload "item_id" "new")))
               (some (str "rm-0002"))))))

(deftest a-removed-block-event-records-the-old-decision-and-item
  (let (draft (decision-block-removed (ref (proposed))
                                      (id-of "rm-0002"))
        payload (copy-of (ref (:payload draft))))
    (assert (= (:type draft) event-type/decision-block-removed))
    (assert (null? (ref (side payload "decision_id" "new"))))
    (assert (= (json->text (ref (side payload "decision_id" "old")))
               (some (str "rm-d001"))))
    (assert (= (json->text (ref (side payload "item_id" "old")))
               (some (str "rm-0002"))))))
