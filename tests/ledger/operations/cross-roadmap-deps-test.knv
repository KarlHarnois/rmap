(use ledger/api add-dep kind new-roadmap ready-items status)

(use support/ledger added-id added-id-in advanced claimed
                    item-draft refusal-code-of
                    scratch-ledger session-named)

(def other-roadmap "other")

(defn ledger-with-two-roadmaps (name)
  (let (settings (scratch-ledger name))
    (assert (ok? (new-roadmap (ref settings)
                              (str other-roadmap)
                              (session-named "other-manager"))))
    settings))

(defn research (settings)
  (added-id settings (item-draft kind/research (vec))))

(defn other-research (settings)
  (added-id-in settings other-roadmap
               (item-draft kind/research (vec))))

(defn other-research-blocked-by (settings blocker)
  (added-id-in settings other-roadmap
               (assoc (item-draft kind/research (vec))
                      :blocked-by (vec blocker))))

(defn other-readiness (settings)
  (unwrap-ok (ready-items settings (some (str other-roadmap)))))

(deftest a-dep-on-an-item-in-another-roadmap-is-added
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-dep")
        blocker (research (ref settings))
        blocked (other-research (ref settings)))
    (assert (ok? (add-dep (ref settings) blocked blocker)))))

(deftest a-cycle-through-two-roadmaps-is-refused
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-cycle")
        first (research (ref settings))
        second (other-research (ref settings)))
    (assert (ok? (add-dep (ref settings)
                          (clone first)
                          (clone second))))
    (assert (= (refusal-code-of (add-dep (ref settings) second first))
               (some (str "cycle"))))))

(deftest an-open-blocker-in-another-roadmap-keeps-an-item-waiting
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-waiting")
        blocker (research (ref settings))
        _blocked (other-research-blocked-by (ref settings) blocker)
        readiness (other-readiness (ref settings)))
    (assert (= (len (:ready readiness)) 0))
    (assert (= (len (:blocked readiness)) 1))))

(deftest a-delivered-blocker-in-another-roadmap-frees-the-item
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-freed")
        blocker (research (ref settings))
        _blocked (other-research-blocked-by (ref settings) (clone blocker))
        _delivered (advanced (ref settings)
                             (claimed (ref settings) blocker)
                             status/reported))
    (assert (= (len (:ready (other-readiness (ref settings))))
               1))))
