(use ledger/api add-dep kind remove-dep)

(use support/ledger added-id added-id-in item-draft
                    ledger-with-two-roadmaps
                    other-roadmap-name refusal-code-of
                    scratch-ledger)

(defn research (settings)
  (added-id settings (item-draft kind/research (vec))))

(defn other-research (settings)
  (added-id-in settings other-roadmap-name
               (item-draft kind/research (vec))))

(deftest a-two-edge-cycle-is-refused
  (let (settings (scratch-ledger "two-edge-cycle")
        first (research (ref settings))
        second (research (ref settings)))
    (assert (ok? (add-dep (ref settings)
                          (clone first)
                          (clone second))))
    (assert (= (refusal-code-of (add-dep (ref settings) second first))
               (some (str "cycle"))))))

(deftest a-three-edge-cycle-is-refused
  (let (settings (scratch-ledger "three-edge-cycle")
        first (research (ref settings))
        second (research (ref settings))
        third (research (ref settings)))
    (assert (ok? (add-dep (ref settings)
                          (clone first)
                          (clone second))))
    (assert (ok? (add-dep (ref settings)
                          (clone second)
                          (clone third))))
    (assert (= (refusal-code-of (add-dep (ref settings) third first))
               (some (str "cycle"))))))

(deftest a-repeated-dep-is-refused
  (let (settings (scratch-ledger "repeated-dep")
        first (research (ref settings))
        second (research (ref settings)))
    (assert (ok? (add-dep (ref settings)
                          (clone first)
                          (clone second))))
    (assert (= (refusal-code-of (add-dep (ref settings) first second))
               (some (str "dep-exists"))))))

(deftest removing-a-missing-dep-is-refused
  (let (settings (scratch-ledger "missing-dep")
        first (research (ref settings))
        second (research (ref settings)))
    (assert (= (refusal-code-of (remove-dep (ref settings) first second))
               (some (str "dep-not-found"))))))

(deftest a-dep-on-an-item-in-another-roadmap-is-added
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-dep")
        blocker (research (ref settings))
        blocked (other-research (ref settings)))
    (assert (ok? (add-dep (ref settings) blocked blocker)))))

(deftest a-cycle-through-two-roadmaps-is-refused
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-cycle")
        first (research (ref settings))
        second (other-research (ref settings)))
    (assert (ok? (add-dep (ref settings)
                          (clone first)
                          (clone second))))
    (assert (= (refusal-code-of (add-dep (ref settings) second first))
               (some (str "cycle"))))))
