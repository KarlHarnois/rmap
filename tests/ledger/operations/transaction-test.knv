(use ledger/model ->roadmap ->roadmap-id ->session
                  ->timestamp roadmap roadmap-status)

(use ledger/refusal refusal)
(use ledger/events roadmap-created)
(use ledger/sqlite/connection query)
(use ledger/sqlite/roadmaps insert-roadmap)

(use ledger/operations/transaction ->settings clock connect
                                   in-transaction record
                                   settings transaction)

(use ledger/failure failure)
(use support/scratch scratch-database)

(defn ledger-settings (name)
  (->settings :database-path (scratch-database name)
              :clock (clock/fixed (->timestamp :value (str "2026-03-03T00:00:00Z")))
              :actor (str "tester")))

(defn sample-roadmap ()
  (->roadmap :id (->roadmap-id :value (str "rm-0001"))
             :name (str "road")
             :manager (->session :name (str "m1"))
             :status roadmap-status/active
             :created-at (->timestamp :value (str "2026-03-03T00:00:00Z"))))

(type write-roadmap
  (fn ((ref transaction) (ref roadmap))
    (result unit failure)))

(defn write-roadmap (transaction roadmap)
  (let-try (_ (insert-roadmap (ref (:connection transaction)) roadmap)
            _ (record transaction (roadmap-created roadmap)))
    (ok (do))))

(type write-then-refuse
  (fn ((ref transaction))
    (result unit failure)))

(defn write-then-refuse (transaction)
  (let-try (_ (write-roadmap transaction (ref (sample-roadmap))))
    (err (failure/refused refusal/epic-has-parent))))

(type write-twice
  (fn ((ref transaction))
    (result unit failure)))

(defn write-twice (transaction)
  (let-try (_ (write-roadmap transaction (ref (sample-roadmap))))
    (write-roadmap transaction (ref (sample-roadmap)))))

(defn row-count (settings table)
  (let (connection (unwrap-ok (connect settings)))
    (len (unwrap-ok (query (ref connection)
                           (as-str (str "SELECT * FROM " table))
                           (ref (vec)))))))

(defn kept-roadmaps-and-events (settings)
  (pair (row-count settings "roadmaps")
        (row-count settings "events")))

(deftest a-write-that-succeeds-keeps-its-row-and-its-event
  (let (settings (ledger-settings "transaction-commit"))
    (assert (ok? (in-transaction (ref settings)
                   (fn (transaction)
                     (write-roadmap transaction (ref (sample-roadmap)))))))
    (assert (= (kept-roadmaps-and-events (ref settings))
               (pair 1 1)))))

(deftest a-refused-write-keeps-neither-its-row-nor-its-event
  (let (settings (ledger-settings "transaction-refusal"))
    (assert (err? (in-transaction (ref settings) write-then-refuse)))
    (assert (= (kept-roadmaps-and-events (ref settings))
               (pair 0 0)))))

(deftest a-failed-write-undoes-the-writes-before-it
  (let (settings (ledger-settings "transaction-failure"))
    (assert (err? (in-transaction (ref settings) write-twice)))
    (assert (= (kept-roadmaps-and-events (ref settings))
               (pair 0 0)))))
