(use json/value copy-of field json->int json->text null?)
(use ledger/model/reports report-kind)

(use ledger/api ->follow-up-draft ->item-id ->session
                add-dep add-proposals drop-item
                export-ledger item-id propose-decision
                record-report set-max-active settings)

(use ledger/model kind status)
(use ledger/model/pull-requests verdict)
(use ledger/sqlite/connection open run-batch)
(use support/decisions proposal-in)

(use support/ledger added-id all-events claimed item-draft
                    research roadmap-name scratch-ledger)

(use support/pull-requests first-head in-review-build
                           reviewed)

(use support/report-requests report-as worker-of)

(defn export-fixture (name)
  (let (settings (scratch-ledger name)
        reported (reported-research (ref settings)))
    (build-with-review (ref settings))
    (dropped-design (ref settings))
    (let (open (added-id (ref settings) (item-draft kind/research))
          blocker (added-id (ref settings) (item-draft kind/design)))
      (unwrap-ok (add-dep settings (clone open) (clone blocker)))
      (let (decision (unwrap-ok (propose-decision settings
                                                  (assoc (proposal-with-skips
                                                           roadmap-name)
                                                         :blocks (vec (clone open))))))
        (add-proposals settings
                       (clone reported)
                       (->session :name (str "manager"))
                       (vec (->follow-up-draft :id (str "p1")
                                               :title (str "first")
                                               :kind kind/build
                                               :priority 2
                                               :description (str "d")
                                               :criteria (vec (str "c"))
                                               :after (vec)
                                               :decision none)
                            (->follow-up-draft :id (str "p2")
                                               :title (str "second")
                                               :kind kind/build
                                               :priority 2
                                               :description (str "d")
                                               :criteria (vec (str "c"))
                                               :after (vec (str "p1"))
                                               :decision none)))
        (insert-ruling (ref settings) (ref reported))
        decision)
      settings)))

(defn proposal-with-skips (roadmap)
  (let (request (proposal-in roadmap)
        proposal (clone (:proposal request))
        options (:options proposal))
    (assoc request
           :proposal (assoc proposal
                            :options (vec (clone (unwrap (get options 0)))
                                          (assoc (clone (unwrap (get options
                                                                     1)))
                                                 :skips (vec (str "p1"))))))))

(defn reported-research (settings)
  (let (id (claimed settings (research settings)))
    (unwrap-ok (record-report settings
                              (report-as (ref id)
                                         (as-str (worker-of (ref id)))
                                         report-kind/done
                                         "found it")))
    id))

(defn build-with-review (settings)
  (let (id (in-review-build settings
                            (ref (claimed settings
                                          (added-id settings
                                                    (item-draft kind/build))))
                            12))
    (reviewed settings (ref id) "r1" verdict/approve first-head)
    id))

(defn dropped-design (settings)
  (unwrap-ok (drop-item settings
                        (added-id settings (item-draft kind/design))
                        (str "not needed"))))

(type insert-ruling
  (fn ((ref settings) (ref item-id)) unit))

(defn insert-ruling (settings item)
  (let (connection (unwrap-ok (open (as-str (:database-path settings)))))
    (unwrap-ok (run-batch (ref connection)
                          (as-str (str "INSERT INTO rulings (id,item_id,question,choice,reason,supersedes_id,ruled_by,created_at) VALUES ('rm-r001','"
                                       (:value item)
                                       "','Q?','A','why',NULL,'owner','2026-03-03T00:00:00Z');"))))))

(defn ordered? (values key)
  (let (keys (collect (map (iter values) key))
        expected (collect (map (iter keys) clone)))
    (sort-by! expected
      (fn (value) (clone value)))
    (= keys expected)))

(defn ordered-json-text? (values key)
  (let (keys (collect (map (iter values)
                        (fn (value) (json-text-value value key))))
        expected (collect (map (iter keys) clone)))
    (sort-by! expected
      (fn (value) (clone value)))
    (= keys expected)))

(defn ordered-numbers? (values key)
  (let (keys (collect (map (iter values)
                        (fn (value)
                          (unwrap (json->int (ref (unwrap (field (copy-of value)
                                                                 key))))))))
        expected (collect (map (iter keys) clone)))
    (sort-by! expected
      (fn (value) (clone value)))
    (= keys expected)))

(defn proposal-references-resolve? (document items decisions proposal-ids)
  (and
    (every? (:export-item-proposals document)
      (fn (record)
        (and (holds? items (json-text-value record "item"))
             (or (null-text? (ref (unwrap (field (copy-of record)
                                                 "decision_id"))))
                 (holds? decisions (json-text-value record "decision_id"))))))
    (every? (:export-proposal-criteria document)
      (fn (record)
        (and (holds? items (json-text-value record "item"))
             (holds? proposal-ids (json-text-value record "proposal_id")))))
    (every? (:export-proposal-deps document)
      (fn (record)
        (and (holds? items (json-text-value record "item"))
             (holds? proposal-ids (json-text-value record "proposal_id"))
             (or (holds? proposal-ids (json-text-value record "on_id"))
                 (holds? items (json-text-value record "on_id"))))))
    (every? (:export-option-skips document)
      (fn (record)
        (and (holds? decisions (json-text-value record "decision_id"))
             (holds? proposal-ids (json-text-value record "proposal_id")))))))

(defn null-text? (value)
  (null? (ref value)))

(defn json-text-value (record key)
  (unwrap (json->text (ref (unwrap (field (copy-of record) key))))))

(type holds?
  (where ((a partial-eq))
    (fn ((ref (vec a)) a) bool)))

(defn holds? (values id)
  (any? values (fn (value) (= value id))))

(deftest the-snapshot-holds-every-record-kind
  (let (settings (export-fixture "export-kinds")
        document (unwrap-ok (export-ledger (ref settings))))
    (assert (= (len (:export-roadmaps document)) 1))
    (assert (= (len (:export-items document)) 5))
    (assert (= (len (:export-criteria document)) 5))
    (assert (= (len (:export-deps document)) 1))
    (assert (= (len (:export-sessions document)) 3))
    (assert (= (len (:export-reports document)) 2))
    (assert (= (len (:export-pull-requests document)) 1))
    (assert (= (len (:export-reviews document)) 1))
    (assert (= (len (:export-decisions document)) 1))
    (assert (= (len (:export-decision-options document)) 2))
    (assert (> (len (:export-decision-option-points document)) 0))
    (assert (= (len (:export-decision-blocks document)) 1))
    (assert (= (len (:export-rulings document)) 1))
    (assert (> (len (:export-events document)) 0))
    (assert (= (len (:export-item-proposals document)) 2))
    (assert (= (len (:export-proposal-criteria document)) 2))
    (assert (= (len (:export-proposal-deps document)) 1))
    (assert (= (len (:export-option-skips document)) 1))))

(deftest the-snapshot-keeps-finished-and-dropped-items
  (let (settings (export-fixture "export-statuses")
        document (unwrap-ok (export-ledger (ref settings))))
    (assert (holds? (collect (map (iter (:export-items document))
                               (fn (item)
                                 (:status (:exported-item item)))))
                    status/reported))
    (assert (holds? (collect (map (iter (:export-items document))
                               (fn (item)
                                 (:status (:exported-item item)))))
                    status/dropped))))

(deftest the-snapshot-orders-every-list-by-id
  (let (settings (export-fixture "export-order")
        document (unwrap-ok (export-ledger (ref settings))))
    (assert (ordered? (:export-roadmaps document)
              (fn (roadmap)
                (clone (:value (:id roadmap))))))
    (assert (ordered? (:export-items document)
              (fn (item)
                (clone (:value (:id (:exported-item item)))))))
    (assert (ordered? (:export-decision-options document)
              (fn (record) (:number (:option record)))))
    (assert (ordered? (:export-events document) :id))
    (assert (ordered-json-text? (:export-item-proposals document)
                                "proposal_id"))
    (assert (ordered-numbers? (:export-proposal-criteria document)
                              "position"))
    (assert (ordered-json-text? (:export-proposal-deps document)
                                "proposal_id"))
    (assert (ordered-numbers? (:export-option-skips document)
                              "position"))))

(deftest every-reference-in-the-snapshot-resolves
  (let (settings (export-fixture "export-references")
        document (unwrap-ok (export-ledger (ref settings)))
        items (collect (map (iter (:export-items document))
                         (fn (record)
                           (clone (:value (:id (:exported-item record)))))))
        roadmaps (collect (map (iter (:export-roadmaps document))
                            (fn (roadmap)
                              (clone (:value (:id roadmap))))))
        sessions (collect (map (iter (:export-sessions document))
                            (fn (session)
                              (clone (:value (:id session))))))
        decisions (collect (map (iter (:export-decisions document))
                             (fn (decision)
                               (clone (:value (:id decision))))))
        option-numbers (collect (map (iter (:export-decision-options document))
                                  (fn (record) (:number (:option record)))))
        proposal-ids (collect (map (iter (:export-item-proposals document))
                                (fn (record)
                                  (json-text-value record "proposal_id")))))
    (assert (every? (:export-items document)
              (fn (record)
                (holds? roadmaps
                        (clone (:value (:roadmap-id (:exported-item
                                                      record))))))))
    (assert (every? (:export-deps document)
              (fn (dep)
                (and (holds? items
                             (clone (:value (:item dep))))
                     (holds? items
                             (clone (:value (:on dep))))))))
    (assert (every? (:export-sessions document)
              (fn (session)
                (match (:item session)
                  ((some item) (holds? items (clone (:value item))))
                  (none true)))))
    (assert (every? (:export-reports document)
              (fn (report)
                (and (holds? items
                             (clone (:value (:item report))))
                     (holds? sessions
                             (clone (:value (:session-id report))))))))
    (assert (every? (:export-pull-requests document)
              (fn (record)
                (holds? items
                        (clone (:value (:item (:exported-pull-request
                                                record))))))))
    (assert (every? (:export-reviews document)
              (fn (review)
                (and (holds? items
                             (clone (:value (:item review))))
                     (holds? sessions
                             (clone (:value (:session-id review))))))))
    (assert (every? (:export-decisions document)
              (fn (decision)
                (holds? roadmaps
                        (clone (:value (:roadmap-id decision)))))))
    (assert (every? (:export-decision-options document)
              (fn (record)
                (holds? decisions
                        (clone (:value (:decision record)))))))
    (assert (every? (:export-decision-blocks document)
              (fn (block)
                (and (holds? decisions (json-text-value block "decision_id"))
                     (holds? items (json-text-value block "item_id"))))))
    (assert (every? (:export-rulings document)
              (fn (ruling)
                (holds? items (json-text-value ruling "item_id")))))
    (assert (holds? option-numbers 1))
    (assert (proposal-references-resolve?
              document items decisions proposal-ids))))

(deftest the-snapshot-records-no-event
  (let (settings (export-fixture "export-no-event")
        before (len (unwrap-ok (all-events (ref settings)))))
    (unwrap-ok (export-ledger (ref settings)))
    (assert (= (len (unwrap-ok (all-events (ref settings))))
               before))))

(deftest every-criterion-carries-its-item-position-and-text
  (let (settings (export-fixture "export-criteria")
        document (unwrap-ok (export-ledger (ref settings)))
        item-ids (collect (map (iter (:export-items document))
                            (fn (record)
                              (clone (:value (:id (:exported-item record))))))))
    (assert
      (every? (:export-criteria document)
        (fn (criterion)
          (and (holds? (ref item-ids)
                       (unwrap (json->text (ref (unwrap (field (copy-of
                                                                 criterion)
                                                               "item"))))))
               (> (unwrap (json->int (ref (unwrap (field (copy-of criterion)
                                                         "position")))))
                  0)
               (= (json->text (ref (unwrap (field (copy-of criterion) "text"))))
                  (some (str "a criterion")))))))
    (assert (ordered-numbers? (:export-criteria document) "position"))))

(deftest the-snapshot-carries-readiness-and-approval
  (let (settings (export-fixture "export-facts")
        document (unwrap-ok (export-ledger (ref settings))))
    (assert (any? (:export-items document)
              (fn (record) (:item-ready record))))
    (assert (any? (:export-items document)
              (fn (record)
                (match (:item-blockage record)
                  ((some blockage)
                   (and (not (empty? (:blockers blockage)))
                        (not (empty? (:decisions blockage)))))
                  (none false)))))
    (assert (any? (:export-pull-requests document)
              (fn (record)
                (and (:request-approved record)
                     (not (empty? (:approved-by (:request-approval
                                                  record))))))))))

(deftest the-snapshot-orders-pull-requests-by-item
  (let (settings (scratch-ledger "export-pr-order")
        connection (unwrap-ok (open (as-str (:database-path settings)))))
    (unwrap-ok (run-batch (ref connection)
                          "INSERT INTO items (id, roadmap_id, title, kind, status, origin, priority, created_at) SELECT 'rm-0001', id, 'a', 'build', 'open', 'planned', 0, '2026-01-01T00:00:00Z' FROM roadmaps LIMIT 1; INSERT INTO items (id, roadmap_id, title, kind, status, origin, priority, created_at) SELECT 'rm-0002', id, 'b', 'build', 'open', 'planned', 0, '2026-01-01T00:00:00Z' FROM roadmaps LIMIT 1; INSERT INTO pull_requests (item_id, number, head_sha, opened_at) VALUES ('rm-0001', 2, '1111111111111111111111111111111111111111', '2026-01-01T00:00:00Z'), ('rm-0002', 1, '1111111111111111111111111111111111111111', '2026-01-01T00:00:00Z');"))
    (let (records (:export-pull-requests (unwrap-ok (export-ledger (ref settings)))))
      (assert (= (collect (map (iter records)
                            (fn (record)
                              (clone (:value (:item (:exported-pull-request
                                                      record)))))))
                 (vec (str "rm-0001") (str "rm-0002"))))
      (assert (= (collect (map (iter records)
                            (fn (record)
                              (clone (:value (:pr-number (:exported-pull-request
                                                           record)))))))
                 (vec 2 1))))))

(deftest the-snapshot-carries-the-cap-on-items-and-roadmaps
  (let (settings (scratch-ledger "export-cap")
        _first (claimed (ref settings)
                        (research (ref settings)))
        _second (claimed (ref settings)
                         (research (ref settings)))
        open (added-id (ref settings) (item-draft kind/research)))
    (unwrap-ok (set-max-active (ref settings)
                               (str roadmap-name)
                               (some 2)))
    (let (document (unwrap-ok (export-ledger (ref settings)))
          held (clone (unwrap (find (iter (:export-items document))
                                (fn (record)
                                  (= (:id (:exported-item record)) open)))))
          roadmap (unwrap (first (:export-roadmaps document))))
      (assert (not (:item-ready held)))
      (match (:item-blockage held)
        ((some blockage)
         (let (capacity (unwrap (:capacity blockage)))
           (assert (= (:active capacity) 2))
           (assert (= (:max-active capacity) 2))))
        (none (assert false)))
      (assert (= (:max-active roadmap) (some 2))))))
