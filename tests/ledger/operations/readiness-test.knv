(use ledger/api ready-items status)

(use support/ledger added-blocked-research-in added-research
                    advanced claimed
                    ledger-with-two-roadmaps
                    other-roadmap-name refusal-code-of
                    roadmap-name scratch-ledger)

(deftest an-unknown-roadmap-is-refused
  (let (settings (scratch-ledger "unknown-roadmap"))
    (assert (= (refusal-code-of (ready-items (ref settings)
                                             (some (str "nope"))))
               (some (str "roadmap-not-found"))))))

(deftest naming-a-roadmap-limits-ready-items-to-it
  (let (settings (ledger-with-two-roadmaps "ready-in-one-roadmap")
        _ (added-research (ref settings)))
    (assert (= (len (:ready (readiness-in (ref settings) other-roadmap-name)))
               0))
    (assert (= (len (:ready (readiness-in (ref settings) roadmap-name)))
               1))))

(defn readiness-in (settings roadmap)
  (unwrap-ok (ready-items settings (some (str roadmap)))))

(deftest an-open-blocker-in-another-roadmap-keeps-an-item-waiting
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-waiting")
        blocker (added-research (ref settings))
        _blocked (added-blocked-research-in (ref settings)
                                            other-roadmap-name
                                            blocker)
        readiness (readiness-in (ref settings) other-roadmap-name))
    (assert (= (len (:ready readiness)) 0))
    (assert (= (len (:blocked readiness)) 1))))

(deftest a-delivered-blocker-in-another-roadmap-frees-the-item
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-freed")
        blocker (added-research (ref settings))
        _blocked (added-blocked-research-in (ref settings)
                                            other-roadmap-name
                                            (clone blocker))
        _delivered (advanced (ref settings)
                             (claimed (ref settings) blocker)
                             status/reported))
    (assert (= (len (:ready (readiness-in (ref settings) other-roadmap-name)))
               1))))
