(use ledger/api batch-size-of kind list-items read-log
                ready-batch ready-items status)

(use support/ledger added-id advanced blocked-research-in
                    claimed globs-of-patterns item-draft
                    ledger-with-two-roadmaps
                    other-roadmap-name refusal-code-of
                    research roadmap-name scratch-ledger)

(deftest an-unknown-roadmap-is-refused
  (let (settings (scratch-ledger "unknown-roadmap"))
    (assert (= (refusal-code-of (ready-items (ref settings)
                                             (some (str "nope"))))
               (some (str "roadmap-not-found"))))))

(deftest naming-a-roadmap-limits-ready-items-to-it
  (let (settings (ledger-with-two-roadmaps "ready-in-one-roadmap")
        _ (research (ref settings)))
    (assert (= (len (:ready (readiness-in (ref settings) other-roadmap-name)))
               0))
    (assert (= (len (:ready (readiness-in (ref settings) roadmap-name)))
               1))))

(defn readiness-in (settings roadmap)
  (unwrap-ok (ready-items settings (some (str roadmap)))))

(deftest an-open-blocker-in-another-roadmap-keeps-an-item-waiting
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-waiting")
        blocker (research (ref settings))
        _blocked (blocked-research-in (ref settings)
                                      other-roadmap-name
                                      blocker)
        readiness (readiness-in (ref settings) other-roadmap-name))
    (assert (= (len (:ready readiness)) 0))
    (assert (= (len (:blocked readiness)) 1))))

(deftest a-delivered-blocker-in-another-roadmap-frees-the-item
  (let (settings (ledger-with-two-roadmaps "cross-roadmap-freed")
        blocker (research (ref settings))
        _blocked (blocked-research-in (ref settings)
                                      other-roadmap-name
                                      (clone blocker))
        _delivered (advanced (ref settings)
                             (claimed (ref settings) blocker)
                             status/reported))
    (assert (= (len (:ready (readiness-in (ref settings) other-roadmap-name)))
               1))))

(defn overlapping-build (settings)
  (added-id settings
            (item-draft kind/build (globs-of-patterns (vec "src/a/**")))))

(defn event-ids (settings)
  (collect (map (iter (unwrap-ok (read-log settings none 0)))
             (fn (event) (:id event)))))

(deftest picking-a-batch-writes-no-event-and-changes-no-row
  (let (settings (ledger-with-two-roadmaps "batch-is-read-only")
        _first (overlapping-build (ref settings))
        _second (overlapping-build (ref settings))
        events-before (event-ids (ref settings))
        items-before (unwrap-ok (list-items (ref settings) none))
        batch (unwrap-ok (ready-batch (ref settings)
                                      none
                                      (unwrap (batch-size-of 2)))))
    (assert (= (len (:picked batch)) 1))
    (assert (= (len (:skipped batch)) 1))
    (assert (= (event-ids (ref settings)) events-before))
    (assert (= (unwrap-ok (list-items (ref settings) none))
               items-before))))
