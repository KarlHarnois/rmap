(use ledger/model kind)
(use ledger/model status)
(use ledger/api ->item-id drop-item show-item)

(use support/ledger added-id item-draft refusal-code-of
                    scratch-ledger)

(defn child-draft (epic)
  (assoc (item-draft kind/research)
         :parent (some (clone epic))))

(defn child-ids (settings id)
  (collect (map (iter (:children (unwrap-ok (show-item settings id))))
             (fn (child) (clone (:id child))))))

(deftest showing-an-unknown-item-is-refused
  (let (settings (scratch-ledger "unknown-item"))
    (assert (= (refusal-code-of (show-item (ref settings)
                                           (->item-id :value (str "rm-ffff"))))
               (some (str "item-not-found"))))))

(deftest an-epic-shows-the-status-its-children-give-it
  (let (settings (scratch-ledger "epic-status-shown")
        epic (added-id (ref settings) (item-draft kind/epic)))
    (assert (= (:status (:item (unwrap-ok (show-item (ref settings) epic))))
               status/open))))

(deftest an-epic-shows-its-children-ordered-by-id
  (let (settings (scratch-ledger "epic-children-shown")
        epic (added-id (ref settings) (item-draft kind/epic))
        expected (vec (added-id (ref settings)
                                (child-draft (ref epic)))
                      (added-id (ref settings)
                                (child-draft (ref epic)))
                      (added-id (ref settings)
                                (child-draft (ref epic)))))
    (sort-by! expected
      (fn (id) (clone (:value id))))
    (assert (= (child-ids (ref settings) epic) expected))))

(deftest an-epic-shows-its-dropped-children
  (let (settings (scratch-ledger "epic-dropped-child-shown")
        epic (added-id (ref settings) (item-draft kind/epic))
        child (added-id (ref settings)
                        (child-draft (ref epic))))
    (assert (ok? (drop-item (ref settings)
                            (clone child)
                            (str "obsolete"))))
    (assert (= (child-ids (ref settings) epic)
               (vec child)))))

(deftest an-item-without-children-shows-none
  (let (settings (scratch-ledger "no-children-shown")
        research (added-id (ref settings) (item-draft kind/research)))
    (assert (empty? (:children (unwrap-ok (show-item (ref settings)
                                                     research)))))))
