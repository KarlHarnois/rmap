(use ledger/api ->advancement ->claim-request ->session
                advance-item claim claim-item close-item
                drop-item failure kind kind-change
                record-head refusal settings status)

(use ledger/model ->timestamp ->work-session runtime
                  session-kind)

(use ledger/sqlite/connection open query)
(use ledger/sqlite/rows optional-text-cell rows->values)
(use support/repositories repository-with-origin-head)
(use ledger/model/pull-requests verdict)

(use support/pull-requests approved-build first-head
                           in-review-build reviewed
                           second-head)

(use support/ledger added-id all-events blocked-research
                    claim-by claimed item-draft
                    refusal-code-of reported-research
                    research scratch-ledger)

(def clock-time "2026-03-03T00:00:00Z")

(defn build (settings)
  (added-id settings (item-draft kind/build)))

(defn claim-of (outcome)
  (clone (:claim (unwrap-ok outcome))))

(defn live-session (name branch base)
  (claim/claimed-by (->work-session :session (->session :name (str name))
                                    :kind session-kind/work
                                    :runtime runtime/ringleader
                                    :branch (some (str branch))
                                    :base (some (str base))
                                    :started-at (->timestamp :value (str clock-time)))))

(type end-reasons
  (fn ((ref settings))
    (vec (option string))))

(defn end-reasons (settings)
  (let (connection (unwrap-ok (open (as-str (:database-path settings))))
        rows (unwrap-ok (query (ref connection)
                               "SELECT end_reason FROM sessions WHERE kind = 'work' ORDER BY id"
                               (ref (vec)))))
    (unwrap-ok (rows->values (ref rows)
                 (fn (row) (optional-text-cell row 0))))))

(defn advance (settings id target)
  (advance-item settings
                (clone id)
                (->advancement :to target
                               :kind-change kind-change/keep-kind)))

(deftest a-kind-change-is-refused-unless-the-item-advances-to-dispatched
  (let (settings (scratch-ledger "kind-change-needs-dispatch")
        research (reported-research (ref settings)))
    (assert (= (advance-item (ref settings)
                             (clone research)
                             (->advancement
                               :to status/dropped
                               :kind-change kind-change/become-build))
               (err (failure/refused refusal/invalid-kind-change))))))

(deftest every-event-records-the-settings-actor
  (let (settings (scratch-ledger "actor-recorded")
        _research (reported-research (ref settings)))
    (assert (every? (iter (unwrap-ok (all-events (ref settings))))
              (fn (event)
                (= (:actor event) (str "tester")))))))

(deftest claiming-an-epic-is-refused
  (let (settings (scratch-ledger "claim-epic")
        epic (added-id (ref settings) (item-draft kind/epic)))
    (assert (= (refusal-code-of
                 (claim-item (ref settings) epic (claim-by "worker")))
               (some (str "epic-status-computed"))))))

(deftest closing-an-open-item-is-refused
  (let (settings (scratch-ledger "close-open"))
    (assert (= (refusal-code-of (close-item (ref settings)
                                            (build (ref settings))))
               (some (str "invalid-transition"))))))

(deftest a-research-item-cannot-enter-review
  (let (settings (scratch-ledger "research-review")
        item (claimed (ref settings)
                      (research (ref settings))))
    (assert (= (refusal-code-of (advance-item
                                  (ref settings)
                                  item
                                  (->advancement
                                    :to status/in-review
                                    :kind-change kind-change/keep-kind)))
               (some (str "invalid-transition"))))))

(deftest claiming-a-claimed-item-is-refused
  (let (settings (scratch-ledger "claim-twice")
        item (claimed (ref settings)
                      (research (ref settings))))
    (assert (= (refusal-code-of
                 (claim-item (ref settings) item (claim-by "other")))
               (some (str "invalid-transition"))))))

(deftest claiming-a-blocked-item-is-refused
  (let (settings (scratch-ledger "claim-blocked")
        blocker (research (ref settings))
        blocked (blocked-research (ref settings) blocker))
    (assert (= (refusal-code-of
                 (claim-item (ref settings) blocked (claim-by "worker")))
               (some (str "not-ready"))))))

(deftest dropping-a-dropped-item-is-refused
  (let (settings (scratch-ledger "drop-twice")
        item (research (ref settings)))
    (assert (ok? (drop-item (ref settings)
                            (clone item)
                            (str "obsolete"))))
    (assert (= (refusal-code-of (drop-item (ref settings) item (str "again")))
               (some (str "invalid-transition"))))))

(deftest a-claim-defaults-the-branch-to-the-session-name
  (let (settings (scratch-ledger "claim-defaults"))
    (assert (= (claim-of (claim-item (ref settings)
                                     (research (ref settings))
                                     (claim-by "s1")))
               (live-session "s1" "s1" "main")))))

(deftest a-claim-takes-its-default-base-from-origin-head
  (let (settings (assoc (scratch-ledger "claim-origin-head")
                        :repository (repository-with-origin-head
                                      "claim-origin-head"
                                      "trunk")))
    (assert (= (claim-of (claim-item (ref settings)
                                     (research (ref settings))
                                     (claim-by "s1")))
               (live-session "s1" "s1" "trunk")))))

(deftest a-claim-keeps-the-branch-and-base-it-is-given
  (let (settings (scratch-ledger "claim-flags"))
    (assert (= (claim-of (claim-item (ref settings)
                                     (research (ref settings))
                                     (->claim-request
                                       :session (->session :name (str "s1"))
                                       :branch (some (str "feature"))
                                       :base (some (str "release")))))
               (live-session "s1" "feature" "release")))))

(deftest a-claim-under-the-name-of-a-live-session-is-refused
  (let (settings (scratch-ledger "claim-session-busy")
        first (research (ref settings))
        second (research (ref settings)))
    (assert (ok? (claim-item (ref settings) first (claim-by "s1"))))
    (assert (= (refusal-code-of
                 (claim-item (ref settings) second (claim-by "s1")))
               (some (str "session-busy"))))))

(deftest a-name-is-free-again-once-its-session-ends
  (let (settings (scratch-ledger "claim-name-reused")
        first (research (ref settings))
        second (research (ref settings)))
    (assert (ok? (claim-item (ref settings)
                             (clone first)
                             (claim-by "s1"))))
    (assert (ok? (advance (ref settings) first status/open)))
    (assert (= (claim-of (claim-item (ref settings) second (claim-by "s1")))
               (live-session "s1" "s1" "main")))))

(deftest a-reopen-ends-the-session-and-frees-the-item-for-a-new-one
  (let (settings (scratch-ledger "reopen-ends-session")
        item (claimed (ref settings)
                      (research (ref settings))))
    (assert (= (claim-of (advance (ref settings) (clone item) status/open))
               claim/unclaimed))
    (assert (ok? (claim-item (ref settings) item (claim-by "s2"))))
    (assert (= (end-reasons (ref settings))
               (vec (some (str "reopened")) none)))))

(deftest a-merge-an-accept-and-a-drop-end-the-session-as-finished
  (let (settings (scratch-ledger "finish-ends-session")
        merged (approved-build (ref settings)
                               (ref (claimed (ref settings)
                                             (build (ref settings))))
                               12)
        accepted (reported-research (ref settings))
        dropped (claimed (ref settings)
                         (research (ref settings))))
    (assert (ok? (advance (ref settings) (clone merged) status/merging)))
    (assert (= (claim-of (close-item (ref settings) merged))
               claim/unclaimed))
    (assert (= (claim-of (close-item (ref settings) accepted))
               claim/unclaimed))
    (assert (= (claim-of (drop-item (ref settings) dropped (str "obsolete")))
               claim/unclaimed))
    (assert (= (end-reasons (ref settings))
               (vec (some (str "finished"))
                    (some (str "finished"))
                    (some (str "finished")))))))

(deftest a-build-in-review-moves-to-merging-only-once-approved
  (let (settings (scratch-ledger "merge-needs-approval")
        id (in-review-build (ref settings)
                            (ref (claimed (ref settings)
                                          (build (ref settings))))
                            12))
    (assert (= (refusal-code-of
                 (advance (ref settings) (clone id) status/merging))
               (some (str "not-approved"))))
    (reviewed (ref settings)
              (ref id)
              "r1" verdict/approve first-head)
    (assert (ok? (advance (ref settings) id status/merging)))))

(deftest a-change-request-while-merging-is-recorded-and-blocks-the-close
  (let (settings (scratch-ledger "close-held-by-changes")
        id (approved-build (ref settings)
                           (ref (claimed (ref settings)
                                         (build (ref settings))))
                           12))
    (assert (ok? (advance (ref settings) (clone id) status/merging)))
    (reviewed (ref settings)
              (ref id)
              "r2" verdict/changes first-head)
    (assert (= (refusal-code-of (close-item (ref settings) (clone id)))
               (some (str "not-approved"))))
    (reviewed (ref settings)
              (ref id)
              "r2" verdict/approve first-head)
    (assert (ok? (close-item (ref settings) id)))))

(deftest a-change-request-holds-the-build-in-review
  (let (settings (scratch-ledger "merge-held-by-changes")
        id (approved-build (ref settings)
                           (ref (claimed (ref settings)
                                         (build (ref settings))))
                           12))
    (reviewed (ref settings)
              (ref id)
              "r2" verdict/changes first-head)
    (assert (= (refusal-code-of (advance (ref settings) id status/merging))
               (some (str "not-approved"))))))

(deftest a-recorded-head-voids-the-approval-of-the-older-head
  (let (settings (scratch-ledger "merge-old-head")
        id (approved-build (ref settings)
                           (ref (claimed (ref settings)
                                         (build (ref settings))))
                           12))
    (assert (ok? (record-head (ref settings)
                              (clone id)
                              (str second-head))))
    (assert (= (refusal-code-of (advance (ref settings) id status/merging))
               (some (str "not-approved"))))))

(deftest a-research-item-reaches-reported-only-through-its-report
  (let (settings (scratch-ledger "advance-into-reported")
        id (claimed (ref settings)
                    (research (ref settings))))
    (assert (= (refusal-code-of (advance (ref settings) id status/reported))
               (some (str "invalid-transition"))))))

(deftest a-build-cannot-skip-its-report-into-review
  (let (settings (scratch-ledger "advance-into-review")
        id (claimed (ref settings)
                    (build (ref settings))))
    (assert (= (refusal-code-of (advance (ref settings) id status/in-review))
               (some (str "invalid-transition"))))))
