(use ledger/api ->advancement advance-item claim-item
                close-item drop-item failure kind
                kind-change read-log refusal status)

(use support/ledger added-id blocked-research claimed
                    item-draft refusal-code-of
                    reported-research research
                    scratch-ledger session-named)

(defn build (settings)
  (added-id settings (item-draft kind/build)))

(deftest a-kind-change-is-refused-unless-the-item-advances-to-dispatched
  (let (settings (scratch-ledger "kind-change-needs-dispatch")
        research (reported-research (ref settings)))
    (assert (= (advance-item (ref settings)
                             (clone research)
                             (->advancement
                               :to status/dropped
                               :kind-change kind-change/become-build))
               (err (failure/refused refusal/invalid-kind-change))))))

(deftest every-event-records-the-settings-actor
  (let (settings (scratch-ledger "actor-recorded")
        _research (reported-research (ref settings)))
    (assert (every? (iter (unwrap-ok (read-log (ref settings) none 0)))
              (fn (event)
                (= (:actor event) (str "tester")))))))

(deftest claiming-an-epic-is-refused
  (let (settings (scratch-ledger "claim-epic")
        epic (added-id (ref settings) (item-draft kind/epic)))
    (assert (= (refusal-code-of
                 (claim-item (ref settings) epic (session-named "worker")))
               (some (str "epic-status-computed"))))))

(deftest closing-an-open-item-is-refused
  (let (settings (scratch-ledger "close-open"))
    (assert (= (refusal-code-of (close-item (ref settings)
                                            (build (ref settings))))
               (some (str "invalid-transition"))))))

(deftest a-research-item-cannot-enter-review
  (let (settings (scratch-ledger "research-review")
        item (claimed (ref settings)
                      (research (ref settings))))
    (assert (= (refusal-code-of (advance-item
                                  (ref settings)
                                  item
                                  (->advancement
                                    :to status/in-review
                                    :kind-change kind-change/keep-kind)))
               (some (str "invalid-transition"))))))

(deftest claiming-a-claimed-item-is-refused
  (let (settings (scratch-ledger "claim-twice")
        item (claimed (ref settings)
                      (research (ref settings))))
    (assert (= (refusal-code-of
                 (claim-item (ref settings) item (session-named "other")))
               (some (str "invalid-transition"))))))

(deftest claiming-a-blocked-item-is-refused
  (let (settings (scratch-ledger "claim-blocked")
        blocker (research (ref settings))
        blocked (blocked-research (ref settings) blocker))
    (assert (= (refusal-code-of
                 (claim-item (ref settings) blocked (session-named "worker")))
               (some (str "not-ready"))))))

(deftest dropping-a-dropped-item-is-refused
  (let (settings (scratch-ledger "drop-twice")
        item (research (ref settings)))
    (assert (ok? (drop-item (ref settings)
                            (clone item)
                            (str "obsolete"))))
    (assert (= (refusal-code-of (drop-item (ref settings) item (str "again")))
               (some (str "invalid-transition"))))))
