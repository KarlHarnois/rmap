(use json/value copy-of)

(use ledger/api ->item-id record-review settings show-item
                status)

(use ledger/model kind)
(use ledger/model/pull-requests verdict)
(use ledger/sqlite/connection open query)

(use ledger/sqlite/rows optional-text-cell rows->values
                        text-cell)

(use support/payloads side-text)

(use support/ledger added-id all-events claimed item-draft
                    refusal-code-of scratch-ledger)

(use support/pull-requests first-head in-review-build
                           review-as reviewed second-head)

(defn build-in-review (settings)
  (in-review-build settings
                   (ref (claimed settings
                                 (added-id settings (item-draft kind/build))))
                   12))

(type review-sessions
  (fn ((ref settings))
    (vec (vec (option string)))))

(defn review-sessions (settings)
  (let (connection (unwrap-ok (open (as-str (:database-path settings))))
        rows (unwrap-ok (query (ref connection)
                               "SELECT name, kind, ended_at, end_reason FROM sessions WHERE kind = 'review' ORDER BY id"
                               (ref (vec)))))
    (unwrap-ok (rows->values (ref rows)
                 (fn (row)
                   (let-try (name (text-cell row 0)
                             kind (text-cell row 1)
                             ended-at (optional-text-cell row 2)
                             end-reason (optional-text-cell row 3))
                     (ok
                       (vec (some name) (some kind) ended-at end-reason))))))))

(defn last-payload (settings)
  (let (events (unwrap-ok (all-events settings)))
    (copy-of (ref (:payload (unwrap (last events)))))))

(deftest a-review-is-recorded-without-moving-the-build
  (let (settings (scratch-ledger "review-recorded")
        id (build-in-review (ref settings))
        recorded (unwrap-ok
                   (record-review
                     (ref settings)
                     (review-as (ref id) "r1" verdict/approve first-head))))
    (assert (= (:name (:reviewer (:review recorded)))
               (str "r1")))
    (assert (= (len (:reviews (:pull-request recorded)))
               1))
    (assert (= (:status (:item (unwrap-ok (show-item (ref settings)
                                                     (clone id)))))
               status/in-review))))

(deftest a-review-records-a-finished-review-session
  (let (settings (scratch-ledger "review-session")
        id (build-in-review (ref settings)))
    (reviewed (ref settings)
              (ref id)
              "r1" verdict/changes first-head)
    (assert (= (review-sessions (ref settings))
               (vec (vec (some (str "r1"))
                         (some (str "review"))
                         (some (str "2026-03-03T00:00:00Z"))
                         (some (str "finished"))))))))

(deftest a-review-records-an-item-reviewed-event
  (let (settings (scratch-ledger "review-event")
        id (build-in-review (ref settings)))
    (reviewed (ref settings)
              (ref id)
              "r1" verdict/changes first-head)
    (let (payload (last-payload (ref settings)))
      (assert (= (side-text (copy-of (ref payload)) "verdict" "new")
                 (some (str "changes"))))
      (assert (= (side-text (copy-of (ref payload)) "session_kind" "new")
                 (some (str "review"))))
      (assert (= (side-text payload "head_sha" "new")
                 (some (str first-head)))))))

(deftest a-review-at-another-head-than-the-ledger-head-is-refused
  (let (settings (scratch-ledger "review-other-head")
        id (build-in-review (ref settings)))
    (assert (= (refusal-code-of
                 (record-review
                   (ref settings)
                   (review-as (ref id) "r1" verdict/approve second-head)))
               (some (str "head-not-current"))))))

(deftest a-review-of-a-build-without-a-pull-request-is-refused
  (let (settings (scratch-ledger "review-no-pr")
        id (claimed (ref settings)
                    (added-id (ref settings) (item-draft kind/build))))
    (assert (= (refusal-code-of
                 (record-review
                   (ref settings)
                   (review-as (ref id) "r1" verdict/approve first-head)))
               (some (str "pr-not-found"))))))

(deftest a-review-of-a-missing-item-is-refused
  (let (settings (scratch-ledger "review-missing"))
    (assert (= (refusal-code-of (record-review (ref settings)
                                               (review-as (ref (->item-id
                                                                 :value (str "rm-ffff")))
                                                          "r1"
                                                          verdict/approve
                                                          first-head)))
               (some (str "item-not-found"))))))
