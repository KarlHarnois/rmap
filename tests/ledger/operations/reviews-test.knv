(use json/value copy-of)

(use ledger/api ->item-id ->review-start-request ->session
                claim-item clock record-head record-review
                settings show-item)

(use ledger/model ->timestamp claim kind status)
(use ledger/model/pull-requests verdict)
(use ledger/sqlite/connection open query)

(use ledger/sqlite/rows optional-text-cell rows->values
                        text-cell)

(use support/payloads side-text)

(use support/ledger added-id advanced all-events claim-by
                    claimed item-draft refusal-code-of
                    scratch-ledger)

(use support/pull-requests first-head in-review-build
                           review-as review-start-as
                           second-head start-review-result)

(defn build-in-review (settings)
  (in-review-build settings
                   (ref (claimed settings
                                 (added-id settings (item-draft kind/build))))
                   12))

(defn with-clock (settings at)
  (assoc (clone settings)
         :clock (clock/fixed (->timestamp :value at))))

(type review-sessions
  (fn ((ref settings))
    (vec (vec (option string)))))

(defn review-sessions (settings)
  (let (connection (unwrap-ok (open (as-str (:database-path settings))))
        rows (unwrap-ok (query (ref connection)
                               "SELECT name, kind, started_at, ended_at, end_reason FROM sessions WHERE kind = 'review' ORDER BY id"
                               (ref (vec)))))
    (unwrap-ok (rows->values (ref rows)
                 (fn (row)
                   (let-try (name (text-cell row 0)
                             kind (text-cell row 1)
                             started-at (text-cell row 2)
                             ended-at (optional-text-cell row 3)
                             end-reason (optional-text-cell row 4))
                     (ok (vec (some name)
                              (some kind)
                              (some started-at)
                              ended-at end-reason))))))))

(defn last-payload (settings)
  (let (events (unwrap-ok (all-events settings)))
    (copy-of (ref (:payload (unwrap (last events)))))))

(deftest a-review-is-recorded-without-moving-the-build
  (let (settings (scratch-ledger "review-recorded")
        id (build-in-review (ref settings))
        _started (review-start-as (ref settings) (ref id) "r1")
        recorded (unwrap-ok
                   (record-review
                     (ref settings)
                     (review-as (ref id) "r1" verdict/approve first-head))))
    (assert (= (:name (:reviewer (:review recorded)))
               (str "r1")))
    (assert (= (len (:reviews (:pull-request recorded)))
               1))
    (assert (= (:status (:item (unwrap-ok (show-item (ref settings)
                                                     (clone id)))))
               status/in-review))))

(deftest a-review-ends-the-review-session-started-earlier
  (let (settings (scratch-ledger "review-session")
        id (build-in-review (ref settings))
        start-settings (with-clock settings (str "2026-03-03T00:01:00Z"))
        end-settings (with-clock settings (str "2026-03-03T00:02:00Z")))
    (review-start-as (ref start-settings) (ref id) "r1")
    (unwrap-ok (record-review
                 (ref end-settings)
                 (review-as (ref id) "r1" verdict/changes first-head)))
    (assert (= (review-sessions (ref settings))
               (vec (vec (some (str "r1"))
                         (some (str "review"))
                         (some (str "2026-03-03T00:01:00Z"))
                         (some (str "2026-03-03T00:02:00Z"))
                         (some (str "finished"))))))))

(deftest a-review-records-an-item-reviewed-event
  (let (settings (scratch-ledger "review-event")
        id (build-in-review (ref settings)))
    (review-start-as (ref settings) (ref id) "r1")
    (unwrap-ok (record-review
                 (ref settings)
                 (review-as (ref id) "r1" verdict/changes first-head)))
    (let (payload (last-payload (ref settings)))
      (assert (= (side-text (copy-of (ref payload)) "verdict" "new")
                 (some (str "changes"))))
      (assert (= (side-text (copy-of (ref payload)) "end_reason" "new")
                 (some (str "finished"))))
      (assert (= (side-text payload "head_sha" "new")
                 (some (str first-head)))))))

(deftest a-review-start-records-a-review-started-event
  (let (settings (scratch-ledger "review-start-event")
        id (build-in-review (ref settings)))
    (review-start-as (ref settings) (ref id) "r1")
    (let (payload (last-payload (ref settings)))
      (assert (= (side-text (copy-of (ref payload)) "session_kind" "new")
                 (some (str "review"))))
      (assert (= (side-text payload "session" "new")
                 (some (str "r1")))))))

(deftest a-review-start-outside-in-review-is-refused
  (let (settings (scratch-ledger "review-start-open")
        id (claimed (ref settings)
                    (added-id (ref settings) (item-draft kind/build))))
    (assert (= (refusal-code-of
                 (start-review-result (ref settings) (ref id) "r1"))
               (some (str "review-not-in-review"))))))

(deftest a-second-live-review-session-is-refused
  (let (settings (scratch-ledger "review-second-live")
        id (build-in-review (ref settings)))
    (review-start-as (ref settings) (ref id) "r1")
    (assert (= (refusal-code-of
                 (start-review-result (ref settings) (ref id) "r2"))
               (some (str "review-already-live"))))))

(deftest a-live-review-session-and-a-live-work-session-coexist
  (let (settings (scratch-ledger "review-with-work")
        id (build-in-review (ref settings)))
    (review-start-as (ref settings) (ref id) "r1")
    (let (detail (unwrap-ok (show-item (ref settings) (clone id)))
          claim (:claim (:item detail)))
      (assert (= (match claim
                   ((claimed-by session) (clone (:name (:session session))))
                   (unclaimed (str "")))
                 (str "worker-" (:value id)))))))

(deftest a-review-start-by-the-items-live-worker-is-refused
  (let (settings (scratch-ledger "review-start-worker")
        id (build-in-review (ref settings)))
    (assert (= (refusal-code-of (start-review-result (ref settings)
                                                     (ref id)
                                                     (str "worker-"
                                                          (:value id))))
               (some (str "reviewer-is-worker"))))))

(deftest a-review-without-a-live-review-session-is-refused
  (let (settings (scratch-ledger "review-needs-session")
        id (build-in-review (ref settings)))
    (assert (= (refusal-code-of
                 (record-review
                   (ref settings)
                   (review-as (ref id) "r1" verdict/approve first-head)))
               (some (str "review-session-required"))))))

(deftest a-recorded-head-ends-a-live-review-session-as-superseded
  (let (settings (scratch-ledger "review-head-supersedes")
        id (build-in-review (ref settings)))
    (review-start-as (ref settings) (ref id) "r1")
    (unwrap-ok (record-head (ref settings)
                            (clone id)
                            (str second-head)))
    (assert (= (review-sessions (ref settings))
               (vec (vec (some (str "r1"))
                         (some (str "review"))
                         (some (str "2026-03-03T00:00:00Z"))
                         (some (str "2026-03-03T00:00:00Z"))
                         (some (str "superseded"))))))))

(deftest a-review-at-another-head-than-the-ledger-head-is-refused
  (let (settings (scratch-ledger "review-other-head")
        id (build-in-review (ref settings)))
    (review-start-as (ref settings) (ref id) "r1")
    (assert (= (refusal-code-of
                 (record-review
                   (ref settings)
                   (review-as (ref id) "r1" verdict/approve second-head)))
               (some (str "head-not-current"))))))

(deftest a-review-of-a-build-without-a-pull-request-is-refused
  (let (settings (scratch-ledger "review-no-pr")
        id (claimed (ref settings)
                    (added-id (ref settings) (item-draft kind/build))))
    (assert (= (refusal-code-of
                 (record-review
                   (ref settings)
                   (review-as (ref id) "r1" verdict/approve first-head)))
               (some (str "pr-not-found"))))))

(deftest a-review-start-of-a-missing-item-is-refused
  (let (settings (scratch-ledger "review-start-missing"))
    (assert (= (refusal-code-of (start-review-result (ref settings)
                                                     (ref (->item-id :value (str
                                                                              "rm-ffff")))
                                                     "r1"))
               (some (str "item-not-found"))))))

(deftest a-review-of-a-missing-item-is-refused
  (let (settings (scratch-ledger "review-missing"))
    (assert (= (refusal-code-of (record-review (ref settings)
                                               (review-as (ref (->item-id
                                                                 :value (str "rm-ffff")))
                                                          "r1"
                                                          verdict/approve
                                                          first-head)))
               (some (str "item-not-found"))))))

(deftest a-review-start-by-a-finished-worker-session-is-refused
  (let (settings (scratch-ledger "review-finished-worker")
        id (added-id (ref settings) (item-draft kind/build)))
    (unwrap-ok (claim-item (ref settings)
                           (clone id)
                           (claim-by "old-worker")))
    (advanced (ref settings) (clone id) status/open)
    (claimed (ref settings) (clone id))
    (in-review-build (ref settings) (ref id) 12)
    (assert (= (refusal-code-of
                 (start-review-result (ref settings) (ref id) "old-worker"))
               (some (str "reviewer-is-worker"))))))

(deftest a-review-start-by-a-reviewer-of-another-head-is-refused
  (let (settings (scratch-ledger "review-start-stale")
        id (build-in-review (ref settings)))
    (review-start-as (ref settings) (ref id) "r1")
    (unwrap-ok (record-review
                 (ref settings)
                 (review-as (ref id) "r1" verdict/approve first-head)))
    (unwrap-ok (record-head (ref settings)
                            (clone id)
                            (str second-head)))
    (assert (= (refusal-code-of
                 (start-review-result (ref settings) (ref id) "r1"))
               (some (str "reviewer-not-fresh"))))))

(deftest a-worker-session-of-another-item-can-review
  (let (settings (scratch-ledger "review-other-item-worker")
        id (build-in-review (ref settings))
        other (added-id (ref settings) (item-draft kind/build)))
    (unwrap-ok (claim-item (ref settings)
                           (clone other)
                           (claim-by "other-item-worker")))
    (advanced (ref settings) (clone other) status/open)
    (review-start-as (ref settings)
                     (ref id)
                     "other-item-worker")
    (assert (ok? (record-review (ref settings)
                                (review-as (ref id)
                                           "other-item-worker"
                                           verdict/approve
                                           first-head))))))
