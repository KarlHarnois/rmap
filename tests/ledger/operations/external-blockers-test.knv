(use ledger/model kind)
(use ledger/model/events event-type)

(use ledger/api add-external-blocker clear-external-blocker
                show-item)

(use support/ledger added-id all-events claimed item-draft
                    refusal-code-of scratch-ledger)

(defn research (settings)
  (added-id settings (item-draft kind/research)))

(defn blockers-of (settings id)
  (clone (:external-blockers (unwrap-ok (show-item settings id)))))

(deftest adding-a-blocker-stores-it-and-records-one-event
  (let (settings (scratch-ledger "external-blocker-added")
        item (research (ref settings))
        before (len (unwrap-ok (all-events (ref settings))))
        blocker (unwrap-ok (add-external-blocker (ref settings)
                                                 (clone item)
                                                 (str "the release")))
        events (unwrap-ok (all-events (ref settings)))
        event (unwrap (last events)))
    (assert (= (:text blocker) (str "the release")))
    (assert (= (:item blocker) item))
    (assert (= (:created-by blocker) (str "tester")))
    (assert (= (len events) (inc before)))
    (assert (= (:type event) event-type/external-blocker-added))
    (assert (= (:item-id event) (some (clone item))))
    (assert (= (len (blockers-of (ref settings) item))
               1))))

(deftest a-blank-blocker-text-is-refused-and-writes-nothing
  (let (settings (scratch-ledger "external-blocker-blank")
        item (research (ref settings))
        before (len (unwrap-ok (all-events (ref settings)))))
    (assert (= (refusal-code-of (add-external-blocker (ref settings)
                                                      (clone item)
                                                      (str "  ")))
               (some (str "blank-external-blocker"))))
    (assert (= (len (unwrap-ok (all-events (ref settings))))
               before))))

(deftest a-claimed-item-cannot-take-a-blocker
  (let (settings (scratch-ledger "external-blocker-claimed")
        item (claimed (ref settings)
                      (research (ref settings))))
    (assert (= (refusal-code-of (add-external-blocker (ref settings)
                                                      (clone item)
                                                      (str "the release")))
               (some (str "not-blockable"))))))

(deftest clearing-a-blocker-records-one-event-and-keeps-the-row
  (let (settings (scratch-ledger "external-blocker-cleared")
        item (research (ref settings))
        blocker (unwrap-ok (add-external-blocker (ref settings)
                                                 (clone item)
                                                 (str "the release")))
        before (len (unwrap-ok (all-events (ref settings))))
        cleared (unwrap-ok (clear-external-blocker (ref settings)
                                                   (clone item)
                                                   (clone (:value (:id
                                                                    blocker)))
                                                   (some (str "the vendor shipped"))))
        events (unwrap-ok (all-events (ref settings)))
        event (unwrap (last events)))
    (assert (some? (:cleared-at cleared)))
    (assert (= (:cleared-by cleared)
               (some (str "tester"))))
    (assert (= (:clear-note cleared)
               (some (str "the vendor shipped"))))
    (assert (= (len events) (inc before)))
    (assert (= (:type event) event-type/external-blocker-cleared))
    (assert (= (len (blockers-of (ref settings) item))
               1))))

(deftest a-cleared-blocker-is-refused-when-cleared-again
  (let (settings (scratch-ledger "external-blocker-twice")
        item (research (ref settings))
        blocker (unwrap-ok (add-external-blocker (ref settings)
                                                 (clone item)
                                                 (str "the release"))))
    (unwrap-ok (clear-external-blocker (ref settings)
                                       (clone item)
                                       (clone (:value (:id blocker)))
                                       none))
    (assert (= (refusal-code-of (clear-external-blocker (ref settings)
                                                        (clone item)
                                                        (clone (:value (:id blocker)))
                                                        none))
               (some (str "external-blocker-cleared"))))))

(deftest an-unknown-blocker-is-refused
  (let (settings (scratch-ledger "external-blocker-unknown")
        item (research (ref settings)))
    (assert (= (refusal-code-of (clear-external-blocker (ref settings)
                                                        (clone item)
                                                        (str "rm-ffff")
                                                        none))
               (some (str "external-blocker-not-found"))))))

(deftest a-blocker-of-another-item-cannot-be-cleared
  (let (settings (scratch-ledger "external-blocker-other-item")
        item (research (ref settings))
        other (research (ref settings))
        blocker (unwrap-ok (add-external-blocker (ref settings)
                                                 (clone other)
                                                 (str "the release"))))
    (assert (= (refusal-code-of (clear-external-blocker (ref settings)
                                                        (clone item)
                                                        (clone (:value (:id blocker)))
                                                        none))
               (some (str "external-blocker-in-other-item"))))))

(deftest a-cleared-blocker-stays-in-the-items-detail
  (let (settings (scratch-ledger "external-blocker-detail")
        item (research (ref settings))
        blocker (unwrap-ok (add-external-blocker (ref settings)
                                                 (clone item)
                                                 (str "the release"))))
    (unwrap-ok (clear-external-blocker (ref settings)
                                       (clone item)
                                       (clone (:value (:id blocker)))
                                       none))
    (assert (= (len (blockers-of (ref settings) item))
               1))))
