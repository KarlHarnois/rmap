(use ledger/model/events event-type)
(use ledger/model kind)

(use ledger/api ->item-edit close-item criteria-input
                description-input edit-item failure-code
                show-item)

(use support/ledger added-id all-events item-draft
                    refusal-code-of reported-research
                    scratch-ledger)

(defn edit (title priority description)
  (->item-edit :title title
               :priority priority
               :description description
               :criteria criteria-input/unspecified))

(defn shown (settings id)
  (clone (:item (unwrap-ok (show-item (ref settings) id)))))

(defn events (settings)
  (unwrap-ok (all-events (ref settings))))

(defn edit-criteria (criteria)
  (->item-edit :title none
               :priority none
               :description description-input/unspecified
               :criteria criteria))

(deftest an-edit-changes-title-priority-and-description
  (let (settings (scratch-ledger "edit-fields")
        id (added-id (ref settings) (item-draft kind/research))
        _ (unwrap-ok (edit-item (ref settings)
                                (clone id)
                                (edit (some (str "new title"))
                                      (some 4)
                                      (description-input/text (str
                                                                "new spec")))))
        item (shown (ref settings) id))
    (assert (= (:title item) (str "new title")))
    (assert (= (:priority item) 4))
    (assert (= (:description item)
               (some (str "new spec"))))))

(deftest an-edit-cannot-clear-the-description
  (let (settings (scratch-ledger "edit-empty-description")
        id (added-id (ref settings)
                     (assoc (item-draft kind/research)
                            :description (description-input/text (str "old spec"))))
        before (events (ref settings))
        outcome (edit-item (ref settings)
                           (clone id)
                           (edit none none (description-input/text (str "")))))
    (assert (= (refusal-code-of outcome)
               (some (str "description-required"))))
    (assert (= (:description (shown (ref settings) id))
               (some (str "old spec"))))
    (assert (= (len (events (ref settings)))
               (len before)))))

(deftest a-finished-item-cannot-clear-its-description
  (let (settings (scratch-ledger "edit-empty-description-file")
        id (reported-research (ref settings))
        _ (unwrap-ok (close-item (ref settings) (clone id)))
        before (events (ref settings))
        outcome (edit-item (ref settings)
                           (clone id)
                           (edit none none
                                 (description-input/from-file (str
                                                                "/dev/null")))))
    (assert (= (refusal-code-of outcome)
               (some (str "description-required"))))
    (assert (= (:description (shown (ref settings) id))
               (some (str "a spec"))))
    (assert (= (len (events (ref settings)))
               (len before)))))

(deftest an-edit-records-one-edited-event
  (let (settings (scratch-ledger "edit-event")
        id (added-id (ref settings) (item-draft kind/research))
        before (len (events (ref settings)))
        _ (unwrap-ok (edit-item (ref settings)
                                (clone id)
                                (edit (some (str "renamed"))
                                      none
                                      description-input/unspecified)))
        after (events (ref settings))
        last (unwrap (get after (- (len after) 1))))
    (assert (= (len after) (+ before 1)))
    (assert (= (:type last) event-type/edited))))

(deftest an-edit-that-changes-nothing-writes-no-event
  (let (settings (scratch-ledger "edit-noop")
        id (added-id (ref settings) (item-draft kind/research))
        before (events (ref settings))
        _ (unwrap-ok (edit-item (ref settings)
                                (clone id)
                                (edit none none description-input/unspecified)))
        after (events (ref settings)))
    (assert (= (len after) (len before)))))

(deftest editing-a-closed-item-title-is-refused
  (let (settings (scratch-ledger "edit-closed")
        id (reported-research (ref settings))
        _ (unwrap-ok (close-item (ref settings) (clone id))))
    (assert (= (refusal-code-of (edit-item (ref settings)
                                           id
                                           (edit
                                             (some (str "again"))
                                             none
                                             description-input/unspecified)))
               (some (str "item-closed"))))))

(deftest a-closed-item-takes-a-description-edit
  (let (settings (scratch-ledger "edit-closed-description")
        id (reported-research (ref settings))
        _ (unwrap-ok (close-item (ref settings) (clone id)))
        _ (unwrap-ok (edit-item (ref settings)
                                (clone id)
                                (edit none none
                                      (description-input/text (str
                                                                "new spec")))))
        latest (unwrap (last (events (ref settings)))))
    (assert (= (:description (shown (ref settings) id))
               (some (str "new spec"))))
    (assert (= (:type latest) event-type/edited))))

(deftest a-priority-outside-the-range-is-refused
  (let (settings (scratch-ledger "edit-priority-range")
        id (added-id (ref settings) (item-draft kind/research)))
    (assert (= (refusal-code-of
                 (edit-item (ref settings)
                            id
                            (edit none (some 5) description-input/unspecified)))
               (some (str "priority-out-of-range"))))))

(deftest an-unreadable-description-file-fails
  (let (settings (scratch-ledger "edit-unreadable")
        id (added-id (ref settings) (item-draft kind/research))
        outcome (edit-item (ref settings)
                           id
                           (edit none none
                                 (description-input/from-file (str "/nonexistent/description.txt")))))
    (match outcome
      ((err error)
       (assert (= (failure-code (ref error))
                  (str "description-unreadable"))))
      ((ok _) (assert false)))))

(deftest an-edit-replaces-the-whole-criteria-list
  (let (settings (scratch-ledger "edit-criteria")
        id (added-id (ref settings)
                     (assoc (item-draft kind/research)
                            :criteria (criteria-input/values (vec (str "first")
                                                                  (str "second")))))
        _ (unwrap-ok (edit-item (ref settings)
                                (clone id)
                                (edit-criteria (criteria-input/values (vec (str "third")
                                                                           (str "fourth"))))))
        item (shown (ref settings) id))
    (assert (= (:criteria item)
               (vec (str "third") (str "fourth"))))))

(deftest an-edit-cannot-clear-the-criteria
  (let (settings (scratch-ledger "edit-empty-criteria")
        id (added-id (ref settings) (item-draft kind/research))
        before (events (ref settings))
        outcome (edit-item (ref settings)
                           (clone id)
                           (edit-criteria (criteria-input/from-file (str "/dev/null")))))
    (assert (= (refusal-code-of outcome)
               (some (str "criteria-required"))))
    (assert (= (:criteria (shown (ref settings) id))
               (vec (str "a criterion"))))
    (assert (= (len (events (ref settings)))
               (len before)))))

(deftest a-finished-item-takes-a-criteria-edit
  (let (settings (scratch-ledger "edit-closed-criteria")
        id (reported-research (ref settings))
        _ (unwrap-ok (close-item (ref settings) (clone id)))
        _ (unwrap-ok (edit-item (ref settings)
                                (clone id)
                                (edit-criteria (criteria-input/values (vec (str "new criterion")))))))
    (assert (= (:criteria (shown (ref settings) id))
               (vec (str "new criterion"))))))
