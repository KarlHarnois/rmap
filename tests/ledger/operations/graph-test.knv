(use ledger/api ->graph-request draw-graph graph-format
                history list-items read-log)

(use support/ledger blocked-research refusal-code-of
                    research scratch-ledger)

(defn mermaid-request (roadmap)
  (->graph-request :roadmap roadmap
                   :history history/with-merged
                   :format graph-format/mermaid))

(deftest drawing-the-graph-writes-no-event-and-changes-no-row
  (let (settings (scratch-ledger "graph-read-only")
        blocker (research (ref settings))
        _ (blocked-research (ref settings) blocker)
        event-count (len (unwrap-ok (read-log (ref settings) none 0)))
        items-before (unwrap-ok (list-items (ref settings) none)))
    (assert (ok? (draw-graph (ref settings) (mermaid-request none))))
    (assert (= (len (unwrap-ok (read-log (ref settings) none 0)))
               event-count))
    (assert (= (unwrap-ok (list-items (ref settings) none))
               items-before))))

(deftest drawing-an-unknown-roadmap-is-refused
  (let (settings (scratch-ledger "graph-unknown-roadmap"))
    (assert (= (refusal-code-of (draw-graph (ref settings)
                                            (mermaid-request (some (str
                                                                     "nope")))))
               (some (str "roadmap-not-found"))))))
