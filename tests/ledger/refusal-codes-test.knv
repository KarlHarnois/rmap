(use ledger/model ->blockage ->decision-id ->item-id
                  ->session decision-status roadmap-pause
                  status)

(use ledger/model/reports ->report-id)
(use ledger/refusal refusal)
(use ledger/pull-request-refusals pull-request-refusal)

(use ledger/model/pull-requests ->approval ->head
                                ->pr-number)

(use ledger/refusal-text refusal-catalog refusal-code-text)

(defn every-refusal ()
  (vec (refusal/roadmap-not-found (str "road"))
       (refusal/roadmap-exists (str "road"))
       (refusal/roadmap-already-paused (str "road"))
       (refusal/roadmap-not-paused (str "road"))
       (refusal/item-not-found (sample-id))
       (refusal/item-closed (sample-id))
       (refusal/parent-not-epic (sample-id))
       (refusal/parent-in-other-roadmap (sample-id))
       refusal/epic-has-parent
       (refusal/priority-out-of-range 5)
       refusal/epic-status-computed
       refusal/invalid-kind-change
       (refusal/invalid-transition status/open status/merged)
       (refusal/not-ready (->blockage :pause roadmap-pause/not-paused
                                      :blockers (vec)
                                      :dropped-blockers (vec)
                                      :decisions (vec)))
       (refusal/cycle (sample-id) (sample-id))
       (refusal/dep-exists (sample-id) (sample-id))
       (refusal/dep-not-found (sample-id) (sample-id))
       (refusal/decision-not-found (sample-decision-id))
       (refusal/decision-frozen (sample-decision-id)
                                decision-status/accepted)
       (refusal/decision-incomplete (str "the title is empty"))
       (refusal/invalid-decision-transition (sample-decision-id)
                                            decision-status/proposed
                                            decision-status/accepted)
       (refusal/option-not-found (sample-decision-id) 3)
       (refusal/already-asked (sample-decision-id))
       (refusal/not-blockable (sample-id))
       (refusal/decision-in-other-roadmap (sample-id))
       (refusal/decision-block-exists (sample-decision-id)
                                      (sample-id))
       (refusal/decision-block-not-found (sample-decision-id)
                                         (sample-id))
       (refusal/supersede-target-not-accepted (sample-decision-id))
       (refusal/session-busy (->session :name (str "s1")))
       (refusal/session-not-claimant (->session :name (str "s1"))
                                     (sample-id))
       refusal/report-empty
       (refusal/report-not-found (->report-id :value 3))
       (refusal/report-already-read (->report-id :value 3))
       (refusal/pull-request pull-request-refusal/pr-required)
       (refusal/pull-request pull-request-refusal/head-required)
       (refusal/pull-request pull-request-refusal/pr-not-allowed)
       (refusal/pull-request (pull-request-refusal/pr-number-taken
                               (->pr-number :value 12)))
       (refusal/pull-request (pull-request-refusal/pr-not-found (sample-id)))
       (refusal/pull-request (pull-request-refusal/invalid-head (str "abc")))
       (refusal/pull-request (pull-request-refusal/not-approved (sample-approval)))))

(defn sample-approval ()
  (->approval :pr-number (->pr-number :value 12)
              :head (->head :sha (str "abc"))
              :approved-by (vec)
              :changes-requested (vec)
              :stale-heads (vec)))

(defn sample-decision-id ()
  (->decision-id :value (str "rm-0002")))

(defn sample-id ()
  (->item-id :value (str "rm-0001")))

(defn catalog-codes ()
  (collect (map (iter (refusal-catalog))
             (fn (description)
               (clone (:code description))))))

(deftest the-catalog-describes-every-refusal-code
  (let (codes (catalog-codes))
    (for-each (every-refusal)
      (fn (refused)
        (assert (contains? codes (refusal-code-text refused)))))))

(deftest the-catalog-describes-each-code-once
  (let (codes (catalog-codes)
        unique (catalog-codes))
    (sort! unique)
    (dedup! unique)
    (assert (= (len unique) (len codes)))
    (assert (= (len codes) (len (every-refusal))))))
