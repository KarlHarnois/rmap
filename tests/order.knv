(use ledger/model ->timestamp item origin)
(use ledger/core/order ordered)
(use support/items work-item)
(use ledger/model kind status)

(defn ready-item (id origin priority created-at)
  (-> (work-item id kind/build status/open)
      (assoc :origin origin)
      (assoc :priority priority)
      (assoc :created-at (->timestamp :value (str created-at)))))

(type ids-of
  (fn ((vec item)) (vec string)))

(defn ids-of (items)
  (-> items iter
      (map (fn (item) (clone (:value (:id item)))))
      collect))

(deftest user-bugs-come-first
  (assert (= (ids-of
               (ordered
                 (vec (ready-item "rm-0001" origin/planned 9 "2026-01-01")
                      (ready-item "rm-0002" origin/user-bug 0 "2026-01-02"))))
             (vec (str "rm-0002") (str "rm-0001")))))

(deftest equal-origins-order-by-higher-priority
  (assert (= (ids-of (ordered
                       (vec
                         (ready-item "rm-0001" origin/follow-up 1 "2026-01-01")
                         (ready-item "rm-0002" origin/planned 5 "2026-01-02"))))
             (vec (str "rm-0002") (str "rm-0001")))))

(deftest equal-priorities-order-by-older-first
  (assert (= (ids-of
               (ordered
                 (vec (ready-item "rm-0001" origin/user-bug 3 "2026-01-05")
                      (ready-item "rm-0002" origin/user-bug 3 "2026-01-02"))))
             (vec (str "rm-0002") (str "rm-0001")))))

(deftest equal-times-order-by-id
  (assert (= (ids-of (ordered
                       (vec
                         (ready-item "rm-00ff" origin/planned 3 "2026-01-02")
                         (ready-item "rm-0010" origin/planned 3 "2026-01-02"))))
             (vec (str "rm-0010") (str "rm-00ff")))))
