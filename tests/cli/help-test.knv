(use json/value copy-of field json->bool json->items
                json->text null?)

(use cli/help command-help-document help-document)
(use cli/routes route-name)
(use cli/commands routes)

(defn global-flag (name)
  (let (document (help-document)
        flags (unwrap (json->items (unwrap (field (ref document)
                                                  "global_flags")))))
    (unwrap (map-some (find (iter flags)
                        (fn (spec)
                          (= (json->text (unwrap (field spec "name")))
                             (some (str name)))))
                      copy-of))))

(defn command-summary (name)
  (let (document (help-document)
        commands (unwrap (json->items (unwrap (field (ref document)
                                                     "commands")))))
    (-> commands iter
        (find (fn (command)
                (= (json->text (unwrap (field command "command")))
                   (some (str name)))))
        unwrap
        (field "summary")
        unwrap json->text unwrap)))

(defn described-names (document)
  (-> document
      (field "commands")
      unwrap json->items unwrap iter
      (map (fn (command)
             (unwrap (json->text (unwrap (field command "command"))))))
      collect))

(defn environment-variable-names ()
  (-> (help-document)
      (field "environment")
      unwrap json->items unwrap iter
      (map (fn (variable)
             (unwrap (json->text (unwrap (field variable "name"))))))
      collect))

(defn command-document (name)
  (-> (help-document)
      (field "commands")
      unwrap json->items unwrap iter
      (find (fn (command)
              (= (json->text (unwrap (field command "command")))
                 (some (str name)))))
      unwrap
      (field "document")
      unwrap))

(deftest a-boolean-flag-keeps-a-text-value-and-says-it-is-boolean
  (let (spec (global-flag "json"))
    (assert (= (json->text (unwrap (field (ref spec) "value")))
               (some (str ""))))
    (assert (= (json->bool (unwrap (field (ref spec) "boolean")))
               (some true)))))

(deftest a-flag-with-a-value-is-not-boolean
  (let (spec (global-flag "db"))
    (assert (= (json->text (unwrap (field (ref spec) "value")))
               (some (str "<path>"))))
    (assert (= (json->bool (unwrap (field (ref spec) "boolean")))
               (some false)))))

(deftest next-says-a-manager-without-roadmaps-gives-an-empty-list
  (assert (contains? (as-str (command-summary "next"))
                     "A manager with no roadmaps gives an empty list")))

(deftest command-help-describes-only-the-given-commands
  (let (next-routes (collect (filter (map (iter (routes)) clone)
                               (fn (route)
                                 (= (route-name route) (str "next")))))
        document (command-help-document next-routes))
    (assert (= (described-names (ref document))
               (vec (str "next"))))))

(deftest help-lists-the-environment-variables-it-reads
  (assert (= (environment-variable-names)
             (vec (str "RMAP_JSON")
                  (str "RMAP_ACTOR")
                  (str "USER")))))

(deftest the-json-help-gives-decision-revise-the-document-shape
  (assert (some? (field (ref (command-document "decision revise")) "options"))))

(deftest the-json-help-gives-other-commands-a-null-document
  (assert (null? (ref (command-document "item add")))))
