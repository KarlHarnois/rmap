(use ledger/model ->blockage ->decision-id decision-status
                  kind roadmap-pause status)

(use ledger/api ->session)
(use ledger/core/actions action planned planned-for-report)
(use ledger/model/reports ->report-id)
(use ledger/core/decision-next ->decision-next)
(use ledger/core/next ->next-item next-entry)
(use cli/next-text next-text)
(use support/items roadmap-of work-item)

(deftest with-nothing-to-do-the-text-says-so
  (assert (= (next-text (ref (vec)))
             (str "Nothing to do."))))

(deftest each-action-gets-its-own-line
  (let (entry (->next-item
                :item (work-item "rm-0001" kind/build status/in-review)
                :roadmap (roadmap-of "rm-road" "manager")
                :actions (vec (planned action/review
                                       (some (->session :name (str "s1")))
                                       none)
                              (planned action/wait none
                                       (some (->blockage
                                               :pause roadmap-pause/not-paused
                                               :blockers (vec)
                                               :dropped-blockers (vec)
                                               :decisions (vec)
                                               :capacity none))))))
    (assert (= (next-text (ref (vec (next-entry/listed-item entry))))
               (str "review  manager     s1  rm-0001  work\n"
                    "wait    controller  -   rm-0001  work")))))

(deftest an-action-on-a-report-names-the-report
  (let (entry (->next-item
                :item (work-item "rm-0001" kind/research status/reported)
                :roadmap (roadmap-of "rm-road" "manager")
                :actions (vec (planned-for-report action/accept-report
                                                  none
                                                  (->report-id :value 3))
                              (planned-for-report action/answer
                                                  (some (->session :name (str "s1")))
                                                  (->report-id :value 4)))))
    (assert (= (next-text (ref (vec (next-entry/listed-item entry))))
               (str "accept-report (report 3)  manager  -   rm-0001  work\n"
                    "answer (report 4)         manager  s1  rm-0001  work")))))

(deftest a-decision-gets-its-own-line-naming-the-decision
  (let (entry (next-entry/listed-decision
                (->decision-next
                  :decision (->decision-id :value (str "rm-d1"))
                  :roadmap (roadmap-of "rm-road" "manager")
                  :status decision-status/proposed
                  :title (str "Where?")
                  :actions (vec (planned action/await-decision none none)))))
    (assert (= (next-text (ref (vec entry)))
               (str "await-decision  user  -  rm-d1  Where?")))))
