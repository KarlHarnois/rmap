(use ledger/model ->dep dep-type kind status)
(use ledger/operations/items ->item-detail)
(use cli/item-detail-text item-detail-text)

(use support/items blocks-dep child-of claimed epic-item
                   id-of work-item)

(deftest item-detail-lists-its-claim-and-dependencies
  (let (detail (->item-detail :item (claimed (work-item "rm-0002"
                                                        kind/build
                                                        status/dispatched))
                              :deps (vec (blocks-dep "rm-0002" "rm-0001")
                                         (->dep :item (id-of "rm-0002")
                                                :on (id-of "rm-0009")
                                                :type dep-type/discovered-from))
                              :children (vec)
                              :criterion-statuses (vec)
                              :proposals (vec)
                              :pull-request none
                              :external-blockers (vec)))
    (assert (= (item-detail-text (ref detail))
               (str "rm-0002  work\n  roadmap          rm-road\n  kind             build\n  status           dispatched\n  claimed by       worker\n  origin           planned\n  priority         0\n  parent           -\n  created          2026-01-01T00:00:00Z\n  closed           -\n  after            rm-0001\n  discovered from  rm-0009\n\nAcceptance criteria: -")))))

(deftest item-detail-prints-a-description-section-after-the-rows
  (let (detail (->item-detail
                 :item (assoc (work-item "rm-0001" kind/research status/open)
                              :description (some (str "line one\nline two")))
                 :deps (vec)
                 :children (vec)
                 :criterion-statuses (vec)
                 :proposals (vec)
                 :pull-request none
                 :external-blockers (vec)))
    (assert (= (item-detail-text (ref detail))
               (str "rm-0001  work\n  roadmap          rm-road\n  kind             research\n  status           open\n  claimed by       -\n  origin           planned\n  priority         0\n  parent           -\n  created          2026-01-01T00:00:00Z\n  closed           -\n  after            -\n  discovered from  -\n\nDescription:\n  line one\n  line two\n\nAcceptance criteria: -")))))

(deftest an-epic-detail-lists-its-children-under-a-heading
  (let (detail (->item-detail :item (epic-item "rm-0001")
                              :deps (vec)
                              :children (vec (child-of (work-item "rm-0002"
                                                                  kind/build
                                                                  status/merged)
                                                       "rm-0001"))
                              :criterion-statuses (vec)
                              :proposals (vec)
                              :pull-request none
                              :external-blockers (vec)))
    (assert (= (item-detail-text (ref detail))
               (str "rm-0001  work\n  roadmap          rm-road\n  kind             epic\n  status           open\n  claimed by       -\n  origin           planned\n  priority         0\n  parent           -\n  created          2026-01-01T00:00:00Z\n  closed           -\n  after            -\n  discovered from  -\n\nAcceptance criteria: -\n\nChildren:\n  ID       ROADMAP  KIND   STATUS  PRIORITY  TITLE\n  rm-0002  road     build  merged  0         work")))))
