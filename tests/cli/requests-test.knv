(use ledger/api description-input)
(use cli/arguments ->arguments)

(use cli/requests add-item-request edit-item-request
                  request)

(type flags-with
  (fn ((iterator (ref (pair string string))))
    (vec (pair string string))))

(defn flags-with (extra)
  (let (flags (base-flags))
    (for-each extra
      (fn (entry) (push! flags (clone entry))))
    flags))

(defn base-flags ()
  (vec (pair (str "roadmap") (str "road"))
       (pair (str "title") (str "work"))
       (pair (str "kind") (str "research"))))

(defn draft-for (flags)
  (match (add-item-request
           (->arguments :words (vec) :flags flags :switches (vec)))
    ((ok (request/add-item _ draft)) (some draft))
    (_ none)))

(deftest an-item-without-a-priority-gets-the-default
  (assert (= (:priority (unwrap (draft-for (base-flags))))
             2)))

(deftest an-item-keeps-the-priority-it-is-given
  (let (flags (base-flags))
    (push! flags
           (pair (str "priority") (str "4")))
    (assert (= (:priority (unwrap (draft-for flags)))
               4))))

(deftest an-item-without-a-description-has-none
  (assert (= (:description (unwrap (draft-for (base-flags))))
             description-input/unspecified)))

(deftest an-item-keeps-the-description-it-is-given
  (assert (= (:description (unwrap (draft-for (flags-with (vec (pair (str "description")
                                                                     (str "the spec")))))))
             (description-input/text (str "the spec")))))

(deftest an-item-reads-its-description-from-a-file
  (assert (= (:description (unwrap (draft-for (flags-with (vec (pair (str "description-file")
                                                                     (str "specs.txt")))))))
             (description-input/from-file (str "specs.txt")))))

(deftest an-item-reads-its-description-from-stdin
  (assert (= (:description (unwrap (draft-for (flags-with (vec (pair (str "description-file")
                                                                     (str "-")))))))
             description-input/from-stdin)))

(deftest an-edit-request-carries-the-fields-it-is-given
  (let (arguments (->arguments :words (vec (str "rm-0001"))
                               :flags (vec (pair (str "title") (str "new"))
                                           (pair (str "priority") (str "3"))
                                           (pair (str "description")
                                                 (str "spec")))
                               :switches (vec)))
    (match (edit-item-request arguments (str "rm-0001"))
      ((ok (request/edit-item id edit))
       (assert (= (:value id) (str "rm-0001")))
       (assert (= (:title edit) (some (str "new"))))
       (assert (= (:priority edit) (some 3)))
       (assert (= (:description edit)
                  (description-input/text (str "spec")))))
      (_ (assert false)))))

(deftest an-edit-without-a-field-is-refused
  (assert (err? (edit-item-request (->arguments :words (vec)
                                                :flags (vec)
                                                :switches (vec))
                                   (str "rm-0001")))))

(deftest an-item-refuses-a-description-and-a-description-file
  (assert (err? (add-item-request (->arguments :words (vec)
                                               :flags (flags-with (vec
                                                                    (pair (str "description")
                                                                          (str "the spec"))
                                                                    (pair (str "description-file")
                                                                          (str "specs.txt"))))
                                               :switches (vec))))))
