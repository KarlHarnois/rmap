(use json/value json object text->json)

(use ledger/model ->event ->item-id ->roadmap-id ->timestamp
                  event-type)

(use cli/event-text events-text)

(deftest events-print-their-roadmap-item-and-non-null-details
  (assert (= (events-text
               (ref (vec
                      (->event
                        :id 4
                        :at (->timestamp :value (str "2026-01-01T00:00:00Z"))
                        :actor (str "ana")
                        :roadmap-id (some (->roadmap-id :value (str "rm-0a0a")))
                        :item-id (some (->item-id :value (str "rm-0001")))
                        :type event-type/item-claimed
                        :payload (object (vec (pair (str "to")
                                                    (text->json "dispatched"))
                                              (pair (str "parent_id") json/null)
                                              (pair (str "session")
                                                    (text->json "s1"))))))))
             (str "ID  AT                    ACTOR  EVENT         ROADMAP  ITEM     DETAILS\n4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  session=s1 to=dispatched"))))
