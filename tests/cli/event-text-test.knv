(use json/value array json object text->json)
(use ledger/model ->decision-id ->roadmap-id ->timestamp)
(use ledger/model/events ->event event-type)
(use cli/event-text events-text)
(use support/items id-of)

(defn header ()
  "ID  AT                    ACTOR  EVENT         ROADMAP  ITEM     DETAILS")

(defn claim-event (payload)
  (->event :id 4
           :at (->timestamp :value (str "2026-01-01T00:00:00Z"))
           :actor (str "ana")
           :roadmap-id (some (->roadmap-id :value (str "rm-0a0a")))
           :item-id (some (id-of "rm-0001"))
           :decision-id none
           :type event-type/item-claimed
           :payload payload))

(defn legacy-claim-payload ()
  (object (vec (text-field "to" "dispatched")
               (pair (str "parent_id") json/null)
               (text-field "session" "s1"))))

(defn claim-payload ()
  (object (vec (pair (str "changes")
                     (object (vec (change "status"
                                          (text->json "open")
                                          (text->json "dispatched"))
                                  (change "claimed_by"
                                          json/null
                                          (text->json "s1"))))))))

(defn set-changes-payload (changes)
  (object (vec (pair (str "changes") (object changes)))))

(defn change (column old new)
  (pair (str column)
        (object (vec (pair (str "old") old)
                     (pair (str "new") new)))))

(defn text-field (key value)
  (pair (str key) (text->json value)))

(defn lines (texts) (join texts "\n"))

(deftest events-in-the-old-shape-print-their-non-null-details
  (assert (= (events-text (ref (vec (claim-event (legacy-claim-payload)))))
             (lines (vec (header)
                         "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  session=s1 to=dispatched")))))

(deftest changes-print-as-old-to-new-with-a-dash-for-null
  (assert (= (events-text (ref (vec (claim-event (claim-payload)))))
             (lines (vec (header)
                         "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  claimed_by=-->s1 status=open->dispatched")))))

(deftest a-column-null-before-and-after-is-left-out
  (let (payload (object (vec (pair (str "changes")
                                   (object (vec (change "parent_id"
                                                        json/null
                                                        json/null)
                                                (change "title"
                                                        json/null
                                                        (text->json "a"))))))))
    (assert (= (events-text (ref (vec (claim-event payload))))
               (lines (vec (header)
                           "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  title=-->a"))))))

(deftest a-set-with-nothing-before-or-after-is-left-out
  (let (payload (set-changes-payload
                  (vec (change "blocked_by" json/null (array (vec)))
                       (change "paths"
                               (array (vec))
                               (array (vec)))
                       (change "title" json/null (text->json "a")))))
    (assert (= (events-text (ref (vec (claim-event payload))))
               (lines (vec (header)
                           "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  title=-->a"))))))

(deftest a-set-that-changes-prints-as-json-arrays
  (let (payload (set-changes-payload (vec (change "paths"
                                                  (array (vec))
                                                  (array (vec (text->json
                                                                "src/*")))))))
    (assert (= (events-text (ref (vec (claim-event payload))))
               (lines (vec (header)
                           "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  paths=[]->[\"src/*\"]"))))))

(deftest context-keys-print-after-the-changes
  (let (payload (object (vec (pair (str "reason") (text->json "obsolete"))
                             (pair (str "changes")
                                   (object (vec (change "status"
                                                        (text->json "open")
                                                        (text->json
                                                          "dropped"))))))))
    (assert (= (events-text (ref (vec (claim-event payload))))
               (lines (vec (header)
                           "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  status=open->dropped reason=obsolete"))))))

(deftest a-decision-event-names-its-decision-first
  (let (event (assoc (claim-event
                       (set-changes-payload
                         (vec (change "title" json/null (text->json "q")))))
                     :decision-id (some (->decision-id :value (str
                                                                "rm-d001")))))
    (assert (= (events-text (ref (vec event)))
               (lines (vec (header)
                           "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  decision=rm-d001 title=-->q"))))))

(deftest a-context-key-with-old-and-new-prints-as-a-change
  (let (payload (object (vec (change "blocks"
                                     (array (vec))
                                     (array (vec (text->json "rm-0002"))))
                             (pair (str "changes") (object (vec))))))
    (assert (= (events-text (ref (vec (claim-event payload))))
               (lines (vec (header)
                           "4   2026-01-01T00:00:00Z  ana    item-claimed  rm-0a0a  rm-0001  blocks=[]->[\"rm-0002\"]"))))))
