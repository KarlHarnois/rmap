(use ledger/model ->roadmap-id ->timestamp kind status)
(use ledger/model/events ->event event-type)
(use cli/ledger-json event->json item->json)
(use json/value field json->text object same? text->json)
(use support/items id-of work-item)

(defn item-text-field (key)
  (-> (item->json (ref (work-item "rm-0001" kind/build status/open)))
      (field key)
      unwrap json->text unwrap))

(deftest an-item-names-its-roadmap
  (assert (= (item-text-field "roadmap") (str "road"))))

(deftest an-item-keeps-its-roadmap-id
  (assert (= (item-text-field "roadmap_id") (str "rm-road"))))

(defn legacy-claim-payload ()
  (object (vec (pair (str "from") (text->json "open"))
               (pair (str "to") (text->json "dispatched"))
               (pair (str "session") (text->json "s1")))))

(defn legacy-claim-event ()
  (->event :id 4
           :at (->timestamp :value (str "2026-01-01T00:00:00Z"))
           :actor (str "ana")
           :roadmap-id (some (->roadmap-id :value (str "rm-0a0a")))
           :item-id (some (id-of "rm-0001"))
           :type event-type/item-claimed
           :payload (legacy-claim-payload)))

(deftest an-event-in-the-old-shape-keeps-its-payload-unchanged
  (assert (same? (ref (unwrap (field (ref (event->json (ref (legacy-claim-event))))
                                     "payload")))
                 (ref (legacy-claim-payload)))))
