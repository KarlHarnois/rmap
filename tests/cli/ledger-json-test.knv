(use ledger/model ->roadmap-id ->timestamp kind status)
(use ledger/model/events ->event event-type)
(use cli/ledger-json event->json item->json item-fields)

(use json/value field json->text null? object same?
                text->json)

(use support/items claimed id-of work-item)

(defn item-text-field (key)
  (-> (item->json (ref (work-item "rm-0001" kind/build status/open)))
      (field key)
      unwrap json->text unwrap))

(defn legacy-claim-event ()
  (->event :id 4
           :at (->timestamp :value (str "2026-01-01T00:00:00Z"))
           :actor (str "ana")
           :roadmap-id (some (->roadmap-id :value (str "rm-0a0a")))
           :item-id (some (id-of "rm-0001"))
           :decision-id none
           :type event-type/item-claimed
           :payload (legacy-claim-payload)))

(defn legacy-claim-payload ()
  (object (vec (pair (str "from") (text->json "open"))
               (pair (str "to") (text->json "dispatched"))
               (pair (str "session") (text->json "s1")))))

(defn item-field (item key)
  (-> (item->json (ref item))
      (field key)
      unwrap))

(deftest an-item-names-its-roadmap
  (assert (= (item-text-field "roadmap") (str "road"))))

(deftest an-item-keeps-its-roadmap-id
  (assert (= (item-text-field "roadmap_id") (str "rm-road"))))

(deftest an-item-without-a-description-prints-null
  (assert (null? (ref (item-field (work-item "rm-0001" kind/build status/open)
                                  "description")))))

(deftest an-item-prints-its-description
  (let (item (assoc (work-item "rm-0001" kind/build status/open)
                    :description (some (str "a spec"))))
    (assert (= (json->text (ref (item-field item "description")))
               (some (str "a spec"))))))

(deftest an-event-in-the-old-shape-keeps-its-payload-unchanged
  (assert (same? (ref (unwrap (field (ref (event->json (ref (legacy-claim-event))))
                                     "payload")))
                 (ref (legacy-claim-payload)))))

(deftest a-claimed-item-names-its-claimant-and-its-session
  (let (item (claimed (work-item "rm-0001" kind/build status/dispatched)))
    (assert (= (json->text (ref (item-field (clone item) "claimed_by")))
               (some (str "worker"))))
    (assert (= (-> (item-field item "session")
                   (field "name")
                   unwrap json->text)
               (some (str "worker"))))))

(deftest an-unclaimed-item-prints-a-null-session
  (assert (null? (ref (item-field (work-item "rm-0001" kind/build status/open)
                                  "session")))))

(deftest an-item-record-keeps-its-claimant-but-not-its-session
  (let (item (claimed (work-item "rm-0001" kind/build status/dispatched))
        record (object (item-fields item)))
    (assert (= (json->text (ref (unwrap (field record "claimed_by"))))
               (some (str "worker"))))
    (assert (none? (field record "session")))))
