(use ledger/model ->blockage ->glob ->item-id
                  ->path-conflict)

(use cli/readiness-text blockage-lines)

(defn id-of (text)
  (->item-id :value (str text)))

(defn glob-of (pattern)
  (->glob :pattern (str pattern)))

(deftest each-reason-an-item-is-held-back-gets-its-own-line
  (assert (= (blockage-lines
               (ref (->blockage :blockers (vec (id-of "rm-0001"))
                                :dropped-blockers (vec (id-of "rm-0002"))
                                :path-conflicts (vec (->path-conflict
                                                       :with (id-of "rm-0003")
                                                       :glob (glob-of "src/**")
                                                       :other-glob (glob-of "src/a/**"))))))
             (vec (str "waits on rm-0001")
                  (str "waits on dropped rm-0002")
                  (str "path src/** overlaps src/a/**, held by rm-0003")))))

(deftest a-blockage-without-reasons-has-no-lines
  (assert (empty? (blockage-lines (ref (->blockage :blockers (vec)
                                                   :dropped-blockers (vec)
                                                   :path-conflicts (vec)))))))
