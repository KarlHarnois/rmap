(use ledger/model ->blockage ->item-id)
(use ledger/model/capacity ->capacity)
(use ledger/model/roadmap-pauses roadmap-pause)
(use ledger/model kind status)
(use ledger/core/ready ->blocked-item ->readiness)
(use cli/readiness-text blockage-lines readiness-text)
(use support/items external-blocker-on work-item)

(defn id-of (text)
  (->item-id :value (str text)))

(deftest each-reason-an-item-is-held-back-gets-its-own-line
  (assert (= (blockage-lines (ref (->blockage :pause roadmap-pause/not-paused
                                              :blockers (vec (id-of "rm-0001"))
                                              :dropped-blockers (vec (id-of "rm-0002"))
                                              :decisions (vec)
                                              :capacity none
                                              :external-blockers (vec)
                                              :exclusive none)))
             (vec (str "waits on rm-0001")
                  (str "waits on dropped rm-0002")))))

(deftest a-paused-roadmap-gets-a-line-of-its-own
  (assert (= (blockage-lines (ref (->blockage :pause roadmap-pause/paused
                                              :blockers (vec)
                                              :dropped-blockers (vec)
                                              :decisions (vec)
                                              :capacity none
                                              :external-blockers (vec)
                                              :exclusive none)))
             (vec (str "paused")))))

(deftest a-full-roadmap-gets-a-capacity-line
  (assert (= (blockage-lines (ref (->blockage :pause roadmap-pause/not-paused
                                              :blockers (vec)
                                              :dropped-blockers (vec)
                                              :decisions (vec)
                                              :capacity (some (->capacity
                                                                :active 3
                                                                :max-active 3))
                                              :external-blockers (vec)
                                              :exclusive none)))
             (vec (str "at capacity: 3 of 3 active")))))

(deftest a-blockage-without-reasons-has-no-lines
  (assert (empty? (blockage-lines (ref (->blockage
                                         :pause roadmap-pause/not-paused
                                         :blockers (vec)
                                         :dropped-blockers (vec)
                                         :decisions (vec)
                                         :capacity none
                                         :external-blockers (vec)
                                         :exclusive none))))))

(deftest with-nothing-ready-the-blocked-section-follows-the-notice
  (assert
    (= (readiness-text
         (->readiness
           :ready (vec)
           :blocked (vec (->blocked-item
                           :item (work-item "rm-0002" kind/research status/open)
                           :blockage (->blockage :pause roadmap-pause/not-paused
                                                 :blockers (vec (id-of
                                                                  "rm-0001"))
                                                 :dropped-blockers (vec)
                                                 :decisions (vec)
                                                 :capacity none
                                                 :external-blockers (vec)
                                                 :exclusive none)))))
       (str "Nothing is ready.\n\nBlocked:\n  rm-0002  work\n    waits on rm-0001"))))

(deftest an-external-blocker-gets-a-line-with-its-id-and-text
  (assert (= (blockage-lines (ref (->blockage :pause roadmap-pause/not-paused
                                              :blockers (vec)
                                              :dropped-blockers (vec)
                                              :decisions (vec)
                                              :capacity none
                                              :external-blockers (vec (external-blocker-on
                                                                        "rm-x1"
                                                                        "rm-0001"
                                                                        (str "the release")
                                                                        none))
                                              :exclusive none)))
             (vec (str "waits on external rm-x1: the release")))))
