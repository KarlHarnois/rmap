(use cli/invocations invocation parse-invocation)
(use cli/requests request)
(use cli/routes route-name)
(use ledger/api ->item-id ->session graph-format history)

(type refused-with?
  (fn ((vec (ref str)) (ref str)) bool))

(defn refused-with? (words fragment)
  (match (parsed words)
    ((ok _) false)
    ((err message) (contains? (as-str message) fragment))))

(defn command-help-names (words)
  (match (unwrap-ok (parsed words))
    ((invocation/command-help routes)
     (collect (map (iter routes) route-name)))
    (_ (vec))))

(defn graph-request-of (words)
  (match (:request (unwrap (ledger-call-of words)))
    ((request/graph graph) (some (clone graph)))
    (_ none)))

(defn ready-request-of (words)
  (clone (:request (unwrap (ledger-call-of words)))))

(defn ledger-call-of (words)
  (match (unwrap-ok (parsed words))
    ((invocation/on-ledger call) (some call))
    (_ none)))

(defn parsed (words)
  (parse-invocation (collect (map (iter words)
                               (fn (word) (str (deref word)))))))

(deftest help-needs-no-ledger
  (assert (= (unwrap-ok (parsed (vec "help")))
             invocation/help)))

(deftest the-database-and-actor-flags-travel-with-the-call
  (let (call (unwrap (ledger-call-of
                       (vec "--db" "x.db" "list" "--actor" "boss"))))
    (assert (= (:database call) (some (str "x.db"))))
    (assert (= (:actor call) (some (str "boss"))))))

(deftest blockers-are-read-from-a-comma-list-with-blanks-dropped
  (match (:request (unwrap (ledger-call-of
                             (vec "item" "add" "--roadmap"
                                  "r" "--title" "t" "--kind"
                                  "design" "--after"
                                  " rm-0001, rm-0002,,"))))
    ((request/add-item _ draft)
     (assert (= (:blocked-by draft)
                (vec (->item-id :value (str "rm-0001"))
                     (->item-id :value (str "rm-0002"))))))
    (_ (assert false))))

(deftest next-reads-its-roadmap-and-manager-flags
  (assert (= (:request (unwrap
                         (ledger-call-of
                           (vec "next" "--roadmap" "road" "--manager" "m1"))))
             (request/next (some (str "road"))
                           (some (->session :name (str "m1")))))))

(deftest an-unknown-command-is-refused
  (assert (refused-with? (vec "frobnicate") "unknown command")))

(deftest a-missing-operand-is-refused
  (assert (refused-with? (vec "item" "show") "takes 1 operands")))

(deftest an-unknown-flag-is-refused
  (assert (refused-with? (vec "list" "--colour" "red")
                         "does not take --colour")))

(deftest missing-required-flags-are-named
  (assert (refused-with? (vec "item" "add" "--roadmap" "r")
                         "needs --title, --kind")))

(deftest a-flag-without-a-value-is-refused
  (assert (refused-with? (vec "ready" "--roadmap")
                         "--roadmap needs a value")))

(deftest an-unknown-kind-is-refused
  (assert (refused-with? (vec "item" "add" "--roadmap" "r"
                              "--title" "t" "--kind"
                              "chore")
                         "--kind does not accept chore")))

(deftest a-priority-must-be-a-whole-number
  (assert (refused-with? (vec "item" "add" "--roadmap" "r"
                              "--title" "t" "--kind"
                              "design" "--priority" "high")
                         "--priority takes a whole number")))

(deftest an-unknown-status-is-refused
  (assert (refused-with? (vec "item" "advance" "rm-0001" "ready")
                         "unknown status: ready")))

(deftest only-build-is-a-kind-change
  (assert (refused-with? (vec "item" "advance" "rm-0001"
                              "dispatched" "--kind"
                              "design")
                         "--kind takes only build")))

(deftest a-call-without-a-command-is-help
  (assert (= (unwrap-ok (parsed (vec "--json")))
             invocation/help)))

(deftest the-json-flag-goes-with-any-command
  (assert (some? (ledger-call-of (vec "list" "--json")))))

(deftest the-json-flag-is-never-a-flag-value
  (assert (refused-with? (vec "ready" "--roadmap" "--json")
                         "--roadmap needs a value")))

(deftest global-flags-without-a-command-are-help
  (assert (= (unwrap-ok (parsed (vec "--db" "x.db" "--json")))
             invocation/help)))

(deftest a-command-flag-without-a-command-is-refused
  (assert (refused-with? (vec "--roadmap" "road")
                         "--roadmap needs a command")))

(deftest graph-leaves-out-merged-items-and-draws-mermaid-by-default
  (let (graph (unwrap (graph-request-of (vec "graph"))))
    (assert (= (:history graph) history/without-merged))
    (assert (= (:format graph) graph-format/mermaid))
    (assert (= (:roadmap graph) none))))

(deftest graph-all-includes-merged-items
  (assert (= (:history (unwrap (graph-request-of
                                 (vec "graph" "--all" "--roadmap" "road"))))
             history/with-merged)))

(deftest graph-refuses-a-format-other-than-mermaid
  (assert (refused-with? (vec "graph" "--format" "dot")
                         "--format does not accept dot")))

(deftest a-command-without-all-refuses-it
  (assert (refused-with? (vec "ready" "--all")
                         "ready does not take --all")))

(deftest ready-without-a-limit-asks-for-the-ready-items
  (assert (= (ready-request-of (vec "ready" "--roadmap" "road"))
             (request/ready (some (str "road"))))))

(deftest ready-with-a-limit-asks-for-a-batch-of-that-size
  (match (ready-request-of (vec "ready" "--limit" "2"))
    ((request/ready-batch roadmap size)
     (assert (none? roadmap))
     (assert (= (:count size) 2)))
    (_ (assert false))))

(deftest a-ready-limit-below-one-is-refused
  (assert (refused-with? (vec "ready" "--limit" "0") "at least 1"))
  (assert (refused-with? (vec "ready" "--limit" "-1") "at least 1")))

(deftest a-ready-limit-that-is-not-a-number-is-refused
  (assert (refused-with? (vec "ready" "--limit" "abc") "whole number")))

(deftest the-help-flag-describes-a-command-without-its-required-flags
  (assert (= (command-help-names (vec "item" "add" "--help"))
             (vec (str "item add")))))

(deftest the-help-flag-describes-every-command-of-a-group
  (assert (= (command-help-names (vec "dep" "--help"))
             (vec (str "dep add") (str "dep rm")))))

(deftest the-help-flag-skips-the-check-of-unknown-flags
  (assert (= (command-help-names (vec "ready" "--limit" "abc" "--help"))
             (vec (str "ready")))))

(deftest the-help-flag-is-never-a-flag-value
  (assert (= (command-help-names (vec "next" "--help" "--roadmap" "r"))
             (vec (str "next")))))

(deftest the-help-flag-without-a-command-is-help
  (assert (= (unwrap-ok (parsed (vec "--help")))
             invocation/help)))

(deftest the-help-flag-on-an-unknown-command-is-refused
  (assert (refused-with? (vec "frobnicate" "--help")
                         "unknown command: frobnicate")))

(deftest the-help-flag-on-an-unknown-command-in-a-group-is-refused
  (assert (refused-with? (vec "item" "frob" "--help")
                         "unknown command: item frob")))
