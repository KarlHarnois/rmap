(use ledger/model item kind status)

(use cli/item-text item-added-text item-edited-text
                   item-moved-text items-text)

(use support/items work-item)

(deftest adding-an-item-names-its-id-kind-and-title
  (assert (= (item-added-text (ref
                                (work-item "rm-0001" kind/build status/open)))
             (str "Added rm-0001 (build): work"))))

(deftest editing-an-item-names-its-id-and-title
  (assert (= (item-edited-text
               (ref (work-item "rm-0001" kind/research status/open)))
             (str "Edited rm-0001: work"))))

(deftest moving-an-item-names-its-new-status
  (assert (= (item-moved-text
               (ref (work-item "rm-0001" kind/build status/dispatched)))
             (str "rm-0001 is now dispatched: work"))))

(deftest items-print-as-a-table-under-a-header
  (assert (= (items-text (ref (vec
                                (work-item "rm-0001" kind/build status/open))))
             (str "ID       ROADMAP  KIND   STATUS  PRIORITY  TITLE\nrm-0001  road     build  open    0         work"))))

(deftest an-empty-item-list-says-so
  (assert (= (items-text (ref (the (vec item) (vec))))
             (str "No items."))))
