(use ledger/model ->roadmap ->roadmap-id ->session
                  ->timestamp roadmap roadmap-status)

(use ledger/model/events event)
(use ledger/api graph-format)
(use ledger/operations/graph ->graph-source)
(use ledger/model decision-status)
(use cli/replies reply)
(use cli/reply-text reply->text)
(use support/decisions sample-decision)
(use support/items blocks-dep)

(deftest adding-a-dep-says-which-item-comes-after-which
  (assert (= (reply->text (reply/dep-added (blocks-dep "rm-0002" "rm-0001")))
             (str "rm-0002 now comes after rm-0001."))))

(deftest removing-a-dep-says-the-order-no-longer-holds
  (assert (= (reply->text (reply/dep-removed (blocks-dep "rm-0002" "rm-0001")))
             (str "rm-0002 no longer comes after rm-0001."))))

(deftest an-empty-roadmap-list-says-so
  (assert (= (reply->text (reply/roadmaps-listed (the (vec roadmap) (vec))))
             (str "No roadmaps."))))

(deftest an-empty-log-says-so
  (assert (= (reply->text (reply/log-read (the (vec event) (vec))))
             (str "No events."))))

(deftest roadmaps-print-as-a-table-with-their-ids
  (assert (= (reply->text (reply/roadmaps-listed
                            (vec (->roadmap
                                   :id (->roadmap-id :value (str "rm-0a0a"))
                                   :name (str "website")
                                   :manager (->session :name (str "m1"))
                                   :status roadmap-status/active
                                   :max-active none
                                   :created-at (->timestamp :value (str "2026-01-01T00:00:00Z"))))))
             (str "ID       NAME     STATUS  MAX ACTIVE  MANAGER  CREATED\nrm-0a0a  website  active  -           m1       2026-01-01T00:00:00Z"))))

(deftest a-graph-prints-its-raw-source
  (assert (= (reply->text (reply/graph-drawn (->graph-source
                                               :format graph-format/mermaid
                                               :source (str "flowchart LR"))))
             (str "flowchart LR"))))

(deftest decision-actions-print-a-sentence
  (let (decision (sample-decision decision-status/proposed))
    (assert (= (reply->text (reply/decision-asked (clone decision)))
               (str "Asked rm-d001: Where do sessions live?")))
    (assert (= (reply->text (reply/decision-accepted (clone decision)))
               (str "Accepted rm-d001.")))
    (assert (= (reply->text (reply/decision-rejected (clone decision)))
               (str "Rejected rm-d001.")))
    (assert (= (reply->text (reply/decision-deprecated (clone decision)))
               (str "Deprecated rm-d001.")))))
