(use cli/help-text command-help-text help-text)
(use cli/routes route-name)
(use cli/commands routes)

(defn routes-named (name)
  (collect (filter (map (iter (routes)) clone)
             (fn (route)
               (= (route-name route) (str name))))))

(deftest command-help-shows-the-command-usage
  (assert (starts-with? (as-str (command-help-text (routes-named "item add")))
                        "Usage:\n  rmap item add --roadmap <name>")))

(deftest command-help-shows-the-command-summary
  (assert (contains? (as-str (command-help-text (routes-named "item add")))
                     "Adds an item to a roadmap.")))

(deftest command-help-points-to-the-full-help
  (assert (contains? (as-str (command-help-text (routes-named "list")))
                     "Run `rmap help` for the global flags")))

(deftest help-lists-the-environment-variables
  (assert (contains? (as-str (help-text))
                     "Environment:\n  RMAP_JSON   Set to 1 to print JSON")))

(deftest decision-propose-help-shows-the-document-shape
  (let (text (command-help-text (routes-named "decision propose")))
    (assert (contains? (as-str text) "Document:"))
    (assert (contains? (as-str text) "\"recommendation\": {"))))

(deftest commands-without-a-document-show-no-document
  (assert (not (contains? (as-str (command-help-text (routes-named "item add")))
                          "Document:"))))

(deftest decision-accept-help-lists-its-flags
  (let (text (command-help-text (routes-named "decision accept")))
    (assert (contains? (as-str text) "--option <number>"))
    (assert (contains? (as-str text) "--justification <text>"))
    (assert (contains? (as-str text) "--consequences <text>"))))

(deftest decision-revise-help-shows-the-no-supersedes-switch
  (assert (contains? (as-str (command-help-text (routes-named
                                                  "decision revise")))
                     "--no-supersedes")))

(deftest item-add-help-shows-an-example-criterion-in-the-when-then-style
  (assert (contains?
            (as-str (command-help-text (routes-named "item add")))
            "WHEN I run item show, rmap SHALL print the acceptance criteria.")))
