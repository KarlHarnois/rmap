(use ledger/sqlite/connection open run-batch)
(use json/value field json->int)

(use support/rmap database-with-roadmap error-code
                  initialized-database run-rmap)

(use files/presence file-presence file-presence-at)
(use support/scratch scratch-database)
(use process/command ->command run-command)

(deftest a-command-that-runs-exits-zero-with-the-schema-version
  (let (reply (run-rmap (initialized-database "exit-zero")
                        (vec "new" "road" "--manager" "m1")))
    (assert (= (:exit-code reply) 0))
    (assert (= (json->int (unwrap (field (:json reply) "schema_version")))
               (some 1)))))

(deftest a-refusal-exits-one-with-its-code
  (let (reply (run-rmap (database-with-roadmap "exit-one")
                        (vec "new" "road" "--manager" "m2")))
    (assert (= (:exit-code reply) 1))
    (assert (= (error-code (ref reply)) "roadmap-exists"))))

(deftest arguments-that-match-no-command-exit-two
  (let (reply (run-rmap (scratch-database "exit-two") (vec "frobnicate")))
    (assert (= (:exit-code reply) 2))
    (assert (= (error-code (ref reply)) "usage"))))

(deftest a-missing-ledger-exits-two-with-no-ledger
  (let (reply (run-rmap (scratch-database "exit-no-ledger") (vec "list")))
    (assert (= (:exit-code reply) 2))
    (assert (= (error-code (ref reply)) "no-ledger"))))

(deftest a-missing-ledger-stays-missing
  (let (database (scratch-database "stays-missing"))
    (run-rmap (clone database) (vec "list"))
    (assert (= (file-presence-at (as-str database))
               (ok file-presence/absent)))))

(defn run-tool (program args)
  (assert (ok? (run-command (ref (->command :program (str program)
                                            :args args))))))

(defn set-mode (directory mode)
  (run-tool "chmod"
            (vec (str mode) (clone directory))))

(deftest a-ledger-behind-an-unreadable-directory-exits-three
  (let (directory (str (scratch-database "unreadable") ".d"))
    (run-tool "mkdir"
              (vec (str "-p") (clone directory)))
    (set-mode (ref directory) "000")
    (let (reply (run-rmap (str directory "/ledger.db") (vec "list")))
      (set-mode (ref directory) "700")
      (assert (= (:exit-code reply) 3))
      (assert (= (error-code (ref reply)) "database")))))

(deftest a-database-that-cannot-open-exits-three
  (let (reply (run-rmap (str "/nonexistent/rmap/ledger.db") (vec "init")))
    (assert (= (:exit-code reply) 3))
    (assert (= (error-code (ref reply)) "database"))))

(deftest a-write-that-waits-out-the-lock-exits-three-with-busy
  (let (database (database-with-roadmap "exit-busy")
        holder (unwrap-ok (open (as-str database))))
    (unwrap-ok (run-batch (ref holder) "BEGIN IMMEDIATE"))
    (let (reply (run-rmap database (vec "new" "other" "--manager" "m2")))
      (assert (= (:exit-code reply) 3))
      (assert (= (error-code (ref reply)) "busy")))))
