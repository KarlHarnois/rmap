(use json/value json parse-json)
(use process/command ->command command-output run-command)

(export command-result run-rmap run-rmap-pair
        run-rmap-together)

(defstruct command-result
  :exit-code i32
  :output json)

(def binary-path "target/knave/rmap/rmap")

(rust-type child "std::process::Child")

(def spawn-raw
  (rust "std::process::Command::new({0}).args({1}).stdout(std::process::Stdio::piped()).spawn().map_err(|failure| failure.to_string())"
    (fn ((ref str) (ref (vec string)))
      (result child string))))

(def wait-raw
  (rust "{0}.wait_with_output().map(|output| (output.status.code().unwrap_or(-1), String::from_utf8_lossy(&output.stdout).to_string())).map_err(|failure| failure.to_string())"
    (fn (child)
      (result (pair i32 string) string))))

(def once
  (rust "{{ static BUILT: std::sync::OnceLock<bool> = std::sync::OnceLock::new(); *BUILT.get_or_init({0}) }}"
    (fn ((fn () bool)) bool)))

(defn build-succeeds? ()
  (= (:code (unwrap-ok (run-command (ref (->command :program (str "knave")
                                                    :args (vec (str
                                                                 "build")))))))
     0))

(defn built-binary ()
  (assert (once build-succeeds?))
  binary-path)

(type output->result (fn (command-output) command-result))

(defn output->result (output)
  (->command-result :exit-code (:code output)
                    :output (unwrap-ok (parse-json (as-str (:stdout output))))))

(defn waited->result (waited)
  (let-match ((pair code text) waited)
    (->command-result :exit-code code
                      :output (unwrap-ok (parse-json (as-str text))))))

(defn rmap-command (database args)
  (->command :program (str (built-binary))
             :args (with-database database args)))

(defn run-rmap (database args)
  (output->result (unwrap-ok (run-command (ref (rmap-command database args))))))

(defn spawned (command)
  (unwrap-ok (spawn-raw (as-str (:program command))
                        (ref (:args command)))))

(defn run-rmap-pair (database first-args second-args)
  (let (first (spawned (rmap-command (clone database) first-args))
        second (spawned (rmap-command database second-args)))
    (pair (waited->result (unwrap-ok (wait-raw first)))
          (waited->result (unwrap-ok (wait-raw second))))))

(defn with-database (database args)
  (let (all (vec (str "--db") database))
    (for-each args
      (fn (arg) (push! all (str arg))))
    all))

(type run-rmap-together
  (fn (string (vec (ref str)) int)
    (vec i32)))

(defn run-rmap-together (database args copies)
  (let (children (vec))
    (for-each (range 0 copies)
      (fn (_)
        (push! children
               (spawned (rmap-command (clone database) (clone args))))))
    (waited-codes children)))

(defn waited-codes (children)
  (let (pending children
        codes (vec))
    (for-each (range 0 (len pending))
      (fn (_)
        (push! codes
               (:exit-code (waited->result (unwrap-ok (wait-raw (unwrap (pop! pending)))))))))
    codes))
