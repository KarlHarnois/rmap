(use json/value copy-of field json->items json->text)

(use support/rmap database-with-roadmap error-code run-rmap
                  run-rmap-text run-rmap-with-stdin text-at)

(use support/scratch scratch-database)

(def write-file
  (rust "std::fs::write({0}, {1}).map_err(|failure| failure.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(defn item-add (database extra)
  (let (args (vec (str "item")
                  (str "add")
                  (str "--roadmap")
                  (str "road")
                  (str "--title")
                  (str "w")
                  (str "--kind")
                  (str "research")))
    (for-each extra
      (fn (arg) (push! args (str arg))))
    (run-rmap (clone database) args)))

(defn stdin-reply (database args text)
  (let (reply (run-rmap-with-stdin database args text))
    (assert (= (:exit-code reply) 0))
    (copy-of (ref (:json reply)))))

(defn item-description (database id)
  (unwrap (field (shown-item database id) "description")))

(defn shown-item (database id)
  (let (reply (run-rmap (clone database)
                        (vec "item" "show" (as-str id))))
    (assert (= (:exit-code reply) 0))
    (unwrap (field (:json reply) "item"))))

(deftest adding-an-item-with-a-description-keeps-it
  (let (database (database-with-roadmap "description-text")
        added (item-add (ref database)
                        (vec (str "--description") (str "line one\nline two")))
        id (text-at (ref added) "item" "id"))
    (assert (= (json->text (ref (item-description (ref database) id)))
               (some (str "line one\nline two"))))))

(deftest adding-an-item-without-a-description-is-refused
  (let (database (database-with-roadmap "description-absent")
        reply (item-add (ref database)
                        (the (vec string) (vec))))
    (assert (= (:exit-code reply) 1))
    (assert (= (error-code (ref reply))
               (str "description-required")))))

(deftest adding-an-item-with-an-empty-description-is-refused
  (let (database (database-with-roadmap "description-empty")
        reply (item-add (ref database)
                        (vec (str "--description") (str ""))))
    (assert (= (:exit-code reply) 1))
    (assert (= (error-code (ref reply))
               (str "description-required")))))

(deftest adding-an-item-with-an-empty-description-file-is-refused
  (let (database (database-with-roadmap "description-empty-file")
        reply (item-add (ref database)
                        (vec (str "--description-file") (str "/dev/null"))))
    (assert (= (:exit-code reply) 1))
    (assert (= (error-code (ref reply))
               (str "description-required")))))

(deftest an-item-reads-its-description-from-a-file
  (let (database (database-with-roadmap "description-file")
        path (str (scratch-database "description-file-source") ".txt")
        text (str "from a file\nsecond line"))
    (unwrap-ok (write-file (as-str path) (as-str text)))
    (let (added (item-add (ref database)
                          (vec (str "--description-file") (str path)))
          id (text-at (ref added) "item" "id"))
      (assert (= (json->text (ref (item-description (ref database) id)))
                 (some text))))))

(deftest an-item-reads-its-description-from-stdin
  (let (database (database-with-roadmap "description-stdin")
        reply (stdin-reply database
                           (vec (str "item")
                                (str "add")
                                (str "--roadmap")
                                (str "road")
                                (str "--title")
                                (str "w")
                                (str "--kind")
                                (str "research")
                                (str "--description-file")
                                (str "-"))
                           (str "from stdin\nsecond line"))
        description (unwrap (field (unwrap (field reply "item"))
                                   "description")))
    (assert (= (json->text (ref description))
               (some (str "from stdin\nsecond line"))))))

(deftest item-show-prints-a-description-section-in-text
  (let (database (database-with-roadmap "description-show-text")
        added (item-add (ref database)
                        (vec (str "--description") (str "line one\nline two")))
        id (text-at (ref added) "item" "id")
        output (run-rmap-text
                 (vec "--db" (as-str database) "item" "show" (as-str id)))
        expected (str "Description:\n  line one\n  line two"))
    (assert (= (:code output) 0))
    (assert (contains? (:stdout output) (as-str expected)))))

(deftest item-list-json-includes-each-description
  (let (database (database-with-roadmap "description-list")
        _ (item-add (ref database)
                    (vec (str "--description") (str "a spec")))
        _ (item-add (ref database)
                    (vec (str "--description") (str "b spec")))
        reply (run-rmap (clone database) (vec "item" "list"))
        descriptions (collect (map (iter (unwrap (json->items (unwrap (field (:json
                                                                               reply)
                                                                             "items")))))
                                   (fn (item)
                                     (json->text
                                       (unwrap (field item "description")))))))
    (assert (= descriptions
               (vec (some (str "a spec"))
                    (some (str "b spec")))))))

(deftest an-unreadable-description-file-is-reported
  (let (database (database-with-roadmap "description-unreadable")
        reply (item-add (ref database)
                        (vec (str "--description-file")
                             (str "/nonexistent/description.txt"))))
    (assert (= (:exit-code reply) 2))
    (assert (= (error-code (ref reply))
               (str "description-unreadable")))))
