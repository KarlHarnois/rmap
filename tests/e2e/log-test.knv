(use json/value copy-of field json->items json->text null?
                parse-json same?)

(use ledger/sqlite/connection open run-batch)

(use support/rmap database-with-roadmap research-id run-rmap
                  run-rmap-text)

(def legacy-payload
  "{\"from\":\"open\",\"session\":\"s1\",\"to\":\"dispatched\"}")

(defn logged-changes (name)
  (let (database (database-with-roadmap name)
        item (research-id (clone database)))
    (assert (= (:exit-code
                 (run-rmap (clone database)
                           (vec "item" "claim" (as-str item) "--session" "s1")))
               0))
    (assert (= (:exit-code (run-rmap
                             (clone database)
                             (vec "item" "advance" (as-str item) "open")))
               0))
    (let (reply (run-rmap database (vec "log" "--item" (as-str item))))
      (assert (= (:exit-code reply) 0))
      (collect
        (map (iter (unwrap (json->items (unwrap (field (ref (:json reply))
                                                       "events")))))
             (fn (event)
               (unwrap (field (unwrap (field event "payload")) "changes"))))))))

(defn side-text (changes column which)
  (-> (ref changes)
      (field column)
      unwrap
      (field which)
      unwrap
      (copy-of)
      (json->text)))

(defn side-null? (changes column which)
  (null? (ref (-> (ref changes)
                  (field column)
                  unwrap
                  (field which)
                  unwrap))))

(defn ledger-with-legacy-event (name)
  (let (database (database-with-roadmap name)
        item (research-id (clone database)))
    (store-legacy-claim (clone database) (clone item))
    (assert (= (:exit-code
                 (run-rmap (clone database)
                           (vec "item" "claim" (as-str item) "--session" "s2")))
               0))
    database))

(defn store-legacy-claim (database item)
  (let (connection (unwrap-ok (open (as-str database))))
    (unwrap-ok (run-batch (ref connection)
                          (as-str (str "INSERT INTO events (at, actor, roadmap_id, item_id, type, payload_json) SELECT '2026-01-01T00:00:00Z', 'ana', roadmap_id, id, 'item-claimed', '"
                                       legacy-payload
                                       "' FROM items WHERE id = '"
                                       item "';"))))))

(defn logged-payloads (database)
  (let (reply (run-rmap database (vec "log")))
    (assert (= (:exit-code reply) 0))
    (collect (map (iter (unwrap (json->items (unwrap (field (ref (:json reply))
                                                            "events")))))
                  (fn (event)
                    (unwrap (field event "payload")))))))

(defn logged-text (database)
  (let (output (run-rmap-text (vec "--db" (as-str database) "log")))
    (assert (= (:code output) 0))
    (clone (:stdout output))))

(deftest the-log-records-each-change-as-old-and-new
  (let (changes (logged-changes "log-changes")
        added (copy-of (unwrap (get changes 0)))
        claimed (copy-of (unwrap (get changes 1)))
        reopened (copy-of (unwrap (get changes 2))))
    (assert (= (len changes) 3))
    (assert (= (side-text added "title" "new")
               (some (str "r"))))
    (assert (side-null? added "title" "old"))
    (assert (none? (field (ref added) "claimed_by")))
    (assert (= (side-text claimed "status" "old")
               (some (str "open"))))
    (assert (= (side-text claimed "session" "new")
               (some (str "s1"))))
    (assert (= (side-text claimed "branch" "new")
               (some (str "s1"))))
    (assert (= (side-text reopened "session" "old")
               (some (str "s1"))))
    (assert (side-null? reopened "session" "new"))))

(deftest the-json-log-keeps-an-old-shape-payload-unchanged
  (let (payloads (logged-payloads (ledger-with-legacy-event "log-legacy-json"))
        legacy (unwrap-ok (parse-json legacy-payload)))
    (assert (= (len payloads) 4))
    (assert (same? (unwrap (get payloads 2))
                   (ref legacy)))
    (assert (some? (field (unwrap (get payloads 3)) "changes")))))

(deftest the-text-log-prints-old-and-new-shape-events-side-by-side
  (let (text (logged-text (ledger-with-legacy-event "log-legacy-text")))
    (assert (contains? (as-str text)
                       "from=open session=s1 to=dispatched"))
    (assert (contains? (as-str text) "session=-->s2"))
    (assert (not (contains? (as-str text) "blocked_by=")))))
