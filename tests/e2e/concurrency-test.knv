(use support/rmap database-with-roadmap error-code
                  research-id run-rmap run-rmap-pair
                  run-rmap-together text-at)

(use support/scratch scratch-database)

(def rounds 20)

(def settle-attempts 5)

(def fresh-rounds 5)

(def first-users 6)

(defn winners (database item)
  (let-match ((pair first second) (run-rmap-pair (clone database)
                                                 (claim-args (ref item) "left")
                                                 (claim-args (ref item)
                                                             "right")))
    (let (left (settled (fn ()
                          (run-rmap (clone database)
                                    (claim-args (ref item) "left")))
                        first)
          right (settled (fn ()
                           (run-rmap (clone database)
                                     (claim-args (ref item) "right")))
                         second))
      (assert (and (<= (:exit-code left) 1)
                   (<= (:exit-code right) 1)))
      (+ (if (= (:exit-code left) 0) 1 0)
         (if (= (:exit-code right) 0) 1 0)))))

(defn claim-args (item session)
  (vec "item" "claim" (as-str item) "--session" session))

(defn racing-inits (round)
  (let (database (scratch-database (as-str (str "fresh-race-" round))))
    (settled-all (clone database)
                 (run-rmap-together (clone database)
                                    (vec "init")
                                    first-users))))

(defn settled-all (database replies)
  (let (pending replies
        done (vec))
    (for-each (range 0 (len pending))
      (fn (_)
        (push! done
               (settled (fn ()
                          (run-rmap (clone database) (vec "init")))
                        (unwrap (pop! pending))))))
    done))

(defn settled (rerun reply)
  (loop (attempt 1
         outcome reply)
    (if (and (busy? (ref outcome))
             (< attempt settle-attempts))
      (recur (inc attempt) (rerun))
      outcome)))

(defn busy? (reply)
  (if (= (:exit-code reply) 3)
    (= (error-code (ref reply)) "busy")
    false))

(defn created-count (replies)
  (count (filter (iter replies)
           (fn (reply) (created? reply)))))

(defn created? (reply)
  (if (= (:exit-code reply) 0)
    (= (text-at reply "ledger" "outcome") "created")
    false))

(deftest two-processes-claiming-one-item-leave-exactly-one-winner
  (let (database (database-with-roadmap "claim-race"))
    (for-each (range 0 rounds)
      (fn (_)
        (assert (= (winners (ref database)
                            (research-id (ref database)))
                   1))))))

(deftest processes-initializing-one-new-ledger-at-once-all-succeed
  (for-each (range 0 fresh-rounds)
    (fn (round)
      (assert (every? (iter (racing-inits round))
                (fn (reply) (= (:exit-code reply) 0)))))))

(deftest only-one-of-several-racing-inits-reports-created
  (for-each (range 0 fresh-rounds)
    (fn (round)
      (assert (= (created-count (ref (racing-inits round)))
                 1)))))
