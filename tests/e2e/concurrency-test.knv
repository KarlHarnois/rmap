(use json/value field json->text)

(use support/rmap database-with-roadmap research-id run-rmap
                  run-rmap-pair run-rmap-together)

(use support/scratch scratch-database)

(def rounds 20)

(defn winners (database item)
  (let-match ((pair first second) (run-rmap-pair
                                    (clone database)
                                    (vec "item" "claim"
                                         (as-str item)
                                         "--session" "left")
                                    (vec "item" "claim"
                                         (as-str item)
                                         "--session"
                                         "right")))
    (assert (and (<= (:exit-code first) 1)
                 (<= (:exit-code second) 1)))
    (+ (if (= (:exit-code first) 0) 1 0)
       (if (= (:exit-code second) 0) 1 0))))

(deftest two-processes-claiming-one-item-leave-exactly-one-winner
  (let (database (database-with-roadmap "claim-race"))
    (for-each (range 0 rounds)
      (fn (_)
        (assert (= (winners (ref database)
                            (research-id (ref database)))
                   1))))))

(def fresh-rounds 5)

(def first-users 6)

(defn all-succeed-on-a-fresh-database? (round)
  (let (database (scratch-database (as-str (str "fresh-race-" round))))
    (every? (iter (run-rmap-together database (vec "list") first-users))
      (fn (code) (= (deref code) 0)))))

(deftest processes-first-using-a-new-database-at-once-all-succeed
  (for-each (range 0 fresh-rounds)
    (fn (round)
      (assert (all-succeed-on-a-fresh-database? round)))))
