(use json/value copy-of field json->int json->items
                json->text null?)

(use ledger/model/criteria criterion-result)

(use support/rmap database-with-roadmap error-code run-rmap
                  run-rmap-text text-at)

(use support/pr-commands build-id first-sha report-build
                         report-build-as review-build
                         review-existing-session
                         review-start second-sha
                         verify-and-review-build
                         verify-criterion)

(defn reported-build (database id)
  (assert (= (:exit-code (report-build database id "done"
                                       (vec "--pr" "1" "--head" first-sha)))
             0))
  id)

(defn advance (database id status)
  (run-rmap (clone database)
            (vec "item" "advance" (as-str id) status)))

(defn error-int (reply key)
  (json->int (unwrap (field (ref (unwrap (field (ref (:json reply)) "error")))
                            key))))

(defn error-criteria (reply)
  (unwrap (json->items (unwrap (field (ref (unwrap (field (ref (:json reply))
                                                          "error")))
                                      "criteria")))))

(defn criterion-field (criterion key)
  (json->text (unwrap (field (ref criterion) key))))

(defn shown-verdicts (database id)
  (let (reply (run-rmap (clone database)
                        (vec "item" "show" (as-str id))))
    (unwrap (json->items (unwrap (field (ref (:json reply))
                                        "criterion_verdicts"))))))

(defn two-verdict-builds (database first-result second-result)
  (let (first (reported-with-pr (ref database)
                                (build-claimed-by (ref database) "s1")
                                "s1" "1")
        second (reported-with-pr (ref database)
                                 (build-claimed-by (ref database) "s2")
                                 "s2" "2"))
    (assert (= (:exit-code
                 (approved-with (ref database) first "r1" first-result))
               0))
    (assert (= (:exit-code
                 (approved-with (ref database) second "r3" second-result))
               0))
    (vec first second)))

(defn approved-with (database id reviewer result)
  (match result
    (met (verify-and-review-build database id reviewer
                                  "approve" first-sha))
    (failed (failed-and-reviewed database id reviewer))))

(defn failed-and-reviewed (database id reviewer)
  (assert (= (:exit-code (review-start (clone database) id reviewer))
             0))
  (assert (= (:exit-code
               (verify-failed (ref database) (ref id) reviewer 1 first-sha))
             0))
  (let (reply (review-existing-session (clone database)
                                       id reviewer "approve"
                                       first-sha))
    (assert (= (:exit-code reply) 0))
    reply))

(defn verify-failed (database id reviewer position head)
  (run-rmap (clone database)
            (vec "item" "verify"
                 (as-str id)
                 (as-str (position-text position))
                 "--failed" "--reviewer" reviewer "--head"
                 head)))

(defn position-text (position) (str position))

(defn build-claimed-by (database session)
  (let (added (run-rmap (clone database)
                        (vec "item" "add" "--roadmap" "road"
                             "--title" "b" "--kind" "build"
                             "--description" "a spec"
                             "--criterion" "a criterion")))
    (assert (= (:exit-code added) 0))
    (let (id (text-at (ref added) "item" "id"))
      (assert (= (:exit-code
                   (run-rmap
                     (clone database)
                     (vec "item" "claim" (as-str id) "--session" session)))
                 0))
      id)))

(defn reported-with-pr (database id session pr)
  (assert (= (:exit-code (report-build-as database id
                                          session "done"
                                          (vec "--pr" pr "--head" first-sha)))
             0))
  id)

(defn next-action-for (database id)
  (let (entry (next-entry-for database id)
        actions (unwrap (json->items (unwrap (field entry "actions"))))
        action (unwrap (first actions)))
    (json->text (unwrap (field (copy-of action) "action")))))

(defn next-entry-for (database id)
  (let (reply (run-rmap (clone database) (vec "next"))
        entries (unwrap (json->items (unwrap (field (ref (:json reply))
                                                    "next")))))
    (copy-of (unwrap (find (iter entries)
                       (fn (entry)
                         (= (json->text (unwrap (field (copy-of entry) "item")))
                            (some (str id)))))))))

(deftest merging-without-a-criterion-verdict-is-refused-naming-it
  (let (database (database-with-roadmap "verdict-gate")
        id (build-id (ref database)))
    (reported-build (ref database) (clone id))
    (assert (= (:exit-code (review-build (ref database)
                                         (ref id)
                                         "r1" "approve"
                                         first-sha))
               0))
    (let (reply (advance (ref database) (ref id) "merging")
          gaps (error-criteria (ref reply)))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "criteria-unmet")))
      (assert (= (len gaps) 1))
      (assert (= (criterion-field (at gaps 0) "text")
                 (some (str "a criterion"))))
      (assert (null? (ref (unwrap (field (copy-of (at gaps 0)) "verdict"))))))))

(deftest a-met-verdict-on-the-head-lets-a-build-merge
  (let (database (database-with-roadmap "verdict-met")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (verify-and-review-build
                             (ref database)
                             (ref id)
                             "r1" "approve" first-sha))
               0))
    (assert (= (:exit-code (advance (ref database) (ref id) "merging"))
               0))))

(deftest a-failed-verdict-blocks-merging
  (let (database (database-with-roadmap "verdict-failed")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r1"))
               0))
    (assert (= (:exit-code
                 (verify-failed (ref database) (ref id) "r1" 1 first-sha))
               0))
    (assert (= (:exit-code (review-existing-session
                             (ref database)
                             (ref id)
                             "r1" "approve" first-sha))
               0))
    (let (reply (advance (ref database) (ref id) "merging")
          gaps (error-criteria (ref reply)))
      (assert (= (error-code (ref reply))
                 (str "criteria-unmet")))
      (assert (= (criterion-field (at gaps 0) "verdict")
                 (some (str "failed")))))))

(deftest a-verdict-on-an-old-head-stops-counting
  (let (database (database-with-roadmap "verdict-stale")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (verify-and-review-build
                             (ref database)
                             (ref id)
                             "r1" "approve" first-sha))
               0))
    (assert (= (:exit-code (advance (ref database) (ref id) "merging"))
               0))
    (assert (= (:exit-code (run-rmap (clone database)
                                     (vec "pr" "head" (as-str id) second-sha)))
               0))
    (assert (= (:exit-code (review-build (ref database)
                                         (ref id)
                                         "r2" "approve"
                                         second-sha))
               0))
    (let (reply (advance (ref database) (ref id) "merging"))
      (assert (= (error-code (ref reply))
                 (str "criteria-unmet"))))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r3"))
               0))
    (assert (= (:exit-code
                 (verify-criterion (ref database) (ref id) "r3" 1 second-sha))
               0))
    (assert (= (:exit-code (advance (ref database) (ref id) "merging"))
               0))))

(deftest the-items-work-session-cannot-verify
  (let (database (database-with-roadmap "verdict-worker")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (let (reply (run-rmap (clone database)
                          (vec "item" "verify"
                               (as-str id)
                               "1" "--met" "--reviewer" "s1"
                               "--head" first-sha)))
      (assert (= (error-code (ref reply))
                 (str "verifier-is-worker"))))))

(deftest the-roadmaps-manager-cannot-verify
  (let (database (database-with-roadmap "verdict-manager")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (review-start (ref database) (ref id) "m1"))
               0))
    (let (reply (run-rmap (clone database)
                          (vec "item" "verify"
                               (as-str id)
                               "1" "--met" "--reviewer" "m1"
                               "--head" first-sha)))
      (assert (= (error-code (ref reply))
                 (str "verifier-is-manager"))))))

(deftest a-verdict-needs-a-live-review-session
  (let (database (database-with-roadmap "verdict-no-session")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (let (reply (verify-criterion (ref database) (ref id) "r1" 1 first-sha))
      (assert (= (error-code (ref reply))
                 (str "verifier-not-reviewer"))))))

(deftest a-verdict-needs-the-pull-requests-current-head
  (let (database (database-with-roadmap "verdict-head")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r1"))
               0))
    (let (missing (run-rmap (clone database)
                            (vec "item" "verify"
                                 (as-str id)
                                 "1" "--met" "--reviewer"
                                 "r1"))
          stale (verify-criterion (ref database) (ref id) "r1" 1 second-sha))
      (assert (= (error-code (ref missing))
                 (str "verdict-head-required")))
      (assert (= (error-code (ref stale))
                 (str "verdict-head-not-current"))))))

(deftest a-verdict-names-an-existing-criterion
  (let (database (database-with-roadmap "verdict-position")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r1"))
               0))
    (let (reply (verify-criterion (ref database) (ref id) "r1" 2 first-sha))
      (assert (= (error-code (ref reply))
                 (str "criterion-not-found")))
      (assert (= (error-int (ref reply) "position")
                 (some 2))))))

(deftest item-show-lists-the-latest-verdict-and-the-text-output-names-it
  (let (database (database-with-roadmap "verdict-show")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r1"))
               0))
    (assert (= (:exit-code
                 (verify-failed (ref database) (ref id) "r1" 1 first-sha))
               0))
    (assert (= (:exit-code
                 (verify-criterion (ref database) (ref id) "r1" 1 first-sha))
               0))
    (let (verdict (at (shown-verdicts (ref database) (ref id))
                      0)
          output (run-rmap-text
                   (vec "--db" (as-str database) "item" "show" (as-str id))))
      (assert (= (criterion-field verdict "verdict")
                 (some (str "met"))))
      (assert (= (criterion-field verdict "reviewer")
                 (some (str "r1"))))
      (assert (= (criterion-field verdict "head")
                 (some (str first-sha))))
      (assert (contains? (:stdout output)
                         (as-str (str "[met by r1 on " first-sha "]")))))))

(deftest a-criteria-edit-while-merging-blocks-the-close
  (let (database (database-with-roadmap "verdict-edit-merging")
        id (reported-build (ref database)
                           (build-id (ref database))))
    (assert (= (:exit-code (verify-and-review-build
                             (ref database)
                             (ref id)
                             "r1" "approve" first-sha))
               0))
    (assert (= (:exit-code (advance (ref database) (ref id) "merging"))
               0))
    (assert (= (:exit-code (run-rmap (clone database)
                                     (vec "item" "edit"
                                          (as-str id)
                                          "--criterion"
                                          "a new criterion")))
               0))
    (let (reply (run-rmap (clone database)
                          (vec "item" "close" (as-str id)))
          gaps (error-criteria (ref reply)))
      (assert (= (error-code (ref reply))
                 (str "criteria-unmet")))
      (assert (= (len gaps) 1))
      (assert (= (criterion-field (at gaps 0) "text")
                 (some (str "a new criterion")))))))

(deftest next-keeps-a-met-verdict-from-covering-another-items-failed-verdict
  (let (database (database-with-roadmap "verdict-next-a-met")
        builds (two-verdict-builds (ref database)
                                   criterion-result/met
                                   criterion-result/failed)
        first (at builds 0)
        second (at builds 1))
    (assert (= (next-action-for (ref database) first)
               (some (str "merge"))))
    (assert (= (next-action-for (ref database) second)
               (some (str "verify"))))))

(deftest next-keeps-a-failed-verdict-from-blocking-another-items-met-verdict
  (let (database (database-with-roadmap "verdict-next-a-failed")
        builds (two-verdict-builds (ref database)
                                   criterion-result/failed
                                   criterion-result/met)
        first (at builds 0)
        second (at builds 1))
    (assert (= (next-action-for (ref database) first)
               (some (str "verify"))))
    (assert (= (next-action-for (ref database) second)
               (some (str "merge"))))))
