(use json/value copy-of field json->bool json->int
                json->items json->text null?)

(use support/rmap database-with-roadmap error-code run-rmap
                  text-at)

(use support/pr-commands approved-on-first-head build-id
                         first-sha report-build
                         report-build-as review-build
                         review-start second-sha)

(defn advance (database id status)
  (run-rmap (clone database)
            (vec "item" "advance" (as-str id) status)))

(defn review-count (database id)
  (len (unwrap (json->items (ref (pull-request-field
                                   (ref (run-rmap
                                          (clone database)
                                          (vec "pr" "show" (as-str id))))
                                   "reviews"))))))

(defn pull-request-field (reply key)
  (copy-of (unwrap (field (ref (unwrap (field (ref (:json reply))
                                              "pull_request")))
                          key))))

(defn error-field (reply key)
  (json->text (unwrap (field (ref (unwrap (field (ref (:json reply)) "error")))
                             key))))

(defn changes-requested (reply)
  (let (error (copy-of (unwrap (field (ref (:json reply)) "error"))))
    (collect (map (iter (unwrap (json->items (ref (unwrap (field (ref error)
                                                                 "changes_requested"))))))
                  (fn (name) (unwrap (json->text name)))))))

(defn first-action (database)
  (let (reply (run-rmap (clone database) (vec "next"))
        entry (copy-of (unwrap (first (unwrap (json->items (ref (unwrap
                                                                  (field (ref (:json
                                                                                reply))
                                                                         "next")))))))))
    (unwrap (json->text
              (ref (unwrap (field (ref (copy-of (unwrap
                                                  (first (unwrap
                                                           (json->items
                                                             (ref (unwrap
                                                                    (field (ref entry)
                                                                           "actions")))))))))
                                  "action")))))))

(deftest a-done-report-opens-the-pull-request-and-moves-the-build-to-review
  (let (database (database-with-roadmap "e2e-pr-done")
        id (build-id (ref database))
        reply (report-build (ref database)
                            (ref id)
                            "done"
                            (vec "--pr" "7" "--head" first-sha)))
    (assert (= (:exit-code reply) 0))
    (assert (= (text-at (ref reply) "item" "status")
               (str "in_review")))
    (assert (= (json->int (ref (pull-request-field (ref reply) "number")))
               (some 7)))))

(deftest a-done-report-on-a-build-without-a-pull-request-is-refused
  (let (database (database-with-roadmap "e2e-pr-required")
        id (build-id (ref database))
        reply (report-build (ref database)
                            (ref id)
                            "done"
                            (the (vec (ref str)) (vec))))
    (assert (= (:exit-code reply) 1))
    (assert (= (error-code (ref reply))
               (str "pr-required")))))

(deftest a-review-only-records-and-next-turns-to-merge-once-approved
  (let (database (database-with-roadmap "e2e-pr-review")
        id (build-id (ref database)))
    (report-build (ref database)
                  (ref id)
                  "done"
                  (vec "--pr" "7" "--head" first-sha))
    (assert (= (first-action (ref database))
               (str "review")))
    (let (reply (review-build (ref database)
                              (ref id)
                              "r1" "approve" first-sha))
      (assert (= (:exit-code reply) 0))
      (assert (= (json->bool (ref (pull-request-field (ref reply) "approved")))
                 (some true))))
    (assert (= (first-action (ref database))
               (str "merge")))
    (assert (= (text-at (ref (run-rmap (clone database)
                                       (vec "item" "show" (as-str id))))
                        "item" "status")
               (str "in_review")))))

(deftest merging-without-approval-is-refused-with-the-reviewers-who-asked
  (let (database (database-with-roadmap "e2e-pr-gate")
        id (build-id (ref database)))
    (report-build (ref database)
                  (ref id)
                  "done"
                  (vec "--pr" "7" "--head" first-sha))
    (review-build (ref database)
                  (ref id)
                  "r1" "changes" first-sha)
    (let (reply (advance (ref database) (ref id) "merging"))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "not-approved")))
      (assert (= (changes-requested (ref reply))
                 (vec (str "r1")))))))

(deftest a-fix-on-a-new-head-needs-a-new-approval
  (let (database (database-with-roadmap "e2e-pr-fix")
        id (build-id (ref database)))
    (approved-on-first-head (ref database) (ref id))
    (assert (= (:exit-code (advance (ref database) (ref id) "fixing"))
               0))
    (assert (= (:exit-code (report-build (ref database)
                                         (ref id)
                                         "fixed"
                                         (vec "--head" second-sha)))
               0))
    (assert (= (error-code (ref (advance (ref database) (ref id) "merging")))
               (str "not-approved")))
    (review-build (ref database)
                  (ref id)
                  "r2" "approve" second-sha)
    (assert (= (:exit-code (advance (ref database) (ref id) "merging"))
               0))))

(deftest a-review-by-the-items-own-worker-is-refused
  (let (database (database-with-roadmap "e2e-pr-worker-review")
        id (build-id (ref database)))
    (assert (= (:exit-code (advance (ref database) (ref id) "open"))
               0))
    (assert (= (:exit-code (run-rmap
                             (clone database)
                             (vec "item" "claim" (as-str id) "--session" "s2")))
               0))
    (report-build-as (ref database)
                     (ref id)
                     "s2" "done"
                     (vec "--pr" "7" "--head" first-sha))
    (let (reply (review-start (ref database) (ref id) "s1"))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "reviewer-is-worker")))
      (assert (= (error-field (ref reply) "reviewer")
                 (some (str "s1"))))
      (assert (= (review-count (ref database) (ref id))
                 0)))))

(deftest a-reviewer-of-another-head-is-refused
  (let (database (database-with-roadmap "e2e-pr-stale-reviewer")
        id (build-id (ref database)))
    (approved-on-first-head (ref database) (ref id))
    (assert (= (:exit-code (advance (ref database) (ref id) "fixing"))
               0))
    (assert (= (:exit-code (report-build (ref database)
                                         (ref id)
                                         "fixed"
                                         (vec "--head" second-sha)))
               0))
    (let (reply (review-build (ref database)
                              (ref id)
                              "r1" "approve" second-sha))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "reviewer-not-fresh")))
      (assert (= (error-field (ref reply) "reviewer")
                 (some (str "r1"))))
      (assert (= (error-field (ref reply) "reviewed_head")
                 (some (str first-sha))))
      (assert (= (error-field (ref reply) "tried_head")
                 (some (str second-sha))))
      (assert (= (review-count (ref database) (ref id))
                 1)))))

(deftest pr-show-and-item-show-carry-the-pull-request
  (let (database (database-with-roadmap "e2e-pr-show")
        id (build-id (ref database)))
    (approved-on-first-head (ref database) (ref id))
    (let (shown (run-rmap (clone database)
                          (vec "pr" "show" (as-str id)))
          item (run-rmap (clone database)
                         (vec "item" "show" (as-str id))))
      (assert (= (len (unwrap (json->items (ref (pull-request-field
                                                  (ref shown)
                                                  "reviews")))))
                 1))
      (assert (= (json->int (ref (pull-request-field (ref item) "number")))
                 (some 1))))))

(deftest an-item-without-a-pull-request-shows-null
  (let (database (database-with-roadmap "e2e-pr-null")
        id (build-id (ref database))
        item (run-rmap (clone database)
                       (vec "item" "show" (as-str id))))
    (assert (null? (ref (unwrap (field (ref (:json item)) "pull_request")))))))

(deftest a-head-recorded-while-merging-sends-the-build-back-to-review
  (let (database (database-with-roadmap "e2e-pr-head")
        id (build-id (ref database)))
    (approved-on-first-head (ref database) (ref id))
    (assert (= (:exit-code (advance (ref database) (ref id) "merging"))
               0))
    (let (reply (run-rmap (clone database)
                          (vec "pr" "head" (as-str id) second-sha)))
      (assert (= (:exit-code reply) 0))
      (assert (= (text-at (ref reply) "item" "status")
                 (str "in_review")))
      (assert (= (text-at (ref reply) "pull_request" "head")
                 (str second-sha))))
    (assert (= (error-code (ref (advance (ref database) (ref id) "merging")))
               (str "not-approved")))))

(deftest a-review-off-the-ledger-head-is-refused
  (let (database (database-with-roadmap "e2e-pr-review-head")
        id (build-id (ref database)))
    (approved-on-first-head (ref database) (ref id))
    (assert (= (error-code (ref (review-build (ref database)
                                              (ref id)
                                              "r2" "approve"
                                              second-sha)))
               (str "head-not-current")))))

(deftest a-change-request-while-merging-blocks-item-close
  (let (database (database-with-roadmap "e2e-pr-close-held")
        id (build-id (ref database)))
    (approved-on-first-head (ref database) (ref id))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r2"))
               0))
    (assert (= (:exit-code (advance (ref database) (ref id) "merging"))
               0))
    (assert (= (:exit-code (run-rmap (clone database)
                                     (vec
                                       "pr" "review"
                                       (as-str id)
                                       "--verdict" "changes"
                                       "--kind" "behavior"
                                       "--head" first-sha
                                       "--reviewer" "r2")))
               0))
    (assert (= (error-code (ref (run-rmap (clone database)
                                          (vec "item" "close" (as-str id)))))
               (str "not-approved")))))

(deftest review-start-outside-in-review-is-refused
  (let (database (database-with-roadmap "e2e-review-start-open")
        id (build-id (ref database))
        reply (review-start (ref database) (ref id) "r1"))
    (assert (= (:exit-code reply) 1))
    (assert (= (error-code (ref reply))
               (str "review-not-in-review")))))

(deftest review-start-records-a-live-review-session
  (let (database (database-with-roadmap "e2e-review-start")
        id (build-id (ref database)))
    (report-build (ref database)
                  (ref id)
                  "done"
                  (vec "--pr" "7" "--head" first-sha))
    (let (reply (review-start (ref database) (ref id) "r1"))
      (assert (= (:exit-code reply) 0))
      (assert (= (text-at (ref reply) "session" "name")
                 (str "r1")))
      (assert (= (text-at (ref reply) "session" "kind")
                 (str "review")))
      (assert (= (text-at (ref reply) "item" "claimed_by")
                 (str "s1"))))))

(deftest a-second-live-review-session-is-refused
  (let (database (database-with-roadmap "e2e-review-start-second")
        id (build-id (ref database)))
    (report-build (ref database)
                  (ref id)
                  "done"
                  (vec "--pr" "7" "--head" first-sha))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r1"))
               0))
    (let (reply (review-start (ref database) (ref id) "r2"))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "review-already-live"))))))

(deftest review-start-by-the-items-live-worker-is-refused
  (let (database (database-with-roadmap "e2e-review-start-worker")
        id (build-id (ref database)))
    (report-build (ref database)
                  (ref id)
                  "done"
                  (vec "--pr" "7" "--head" first-sha))
    (let (reply (review-start (ref database) (ref id) "s1"))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "reviewer-is-worker"))))))

(deftest review-start-by-a-reviewer-of-another-head-is-refused
  (let (database (database-with-roadmap "e2e-review-start-stale")
        id (build-id (ref database)))
    (approved-on-first-head (ref database) (ref id))
    (assert (= (:exit-code (run-rmap (clone database)
                                     (vec "pr" "head" (as-str id) second-sha)))
               0))
    (let (reply (review-start (ref database) (ref id) "r1"))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "reviewer-not-fresh"))))))

(deftest a-recorded-head-supersedes-a-live-review-session
  (let (database (database-with-roadmap "e2e-review-start-head")
        id (build-id (ref database)))
    (report-build (ref database)
                  (ref id)
                  "done"
                  (vec "--pr" "7" "--head" first-sha))
    (assert (= (:exit-code (review-start (ref database) (ref id) "r1"))
               0))
    (assert (= (:exit-code (run-rmap (clone database)
                                     (vec "pr" "head" (as-str id) second-sha)))
               0))
    (let (reply (review-build (ref database)
                              (ref id)
                              "r1" "approve" first-sha))
      (assert (= (:exit-code reply) 1))
      (assert (= (error-code (ref reply))
                 (str "head-not-current"))))))
