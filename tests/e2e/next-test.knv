(use json/value array copy-of field json json->int
                json->items json->text object same?)

(use support/rmap database-with-roadmap reply reported-done
                  research-id run-rmap text-at)

(use support/pr-commands build-id first-sha report-build
                         review-build review-start
                         second-sha verify-and-review-build)

(use support/scratch scratch-database)

(def write-file
  (rust "std::fs::write({0}, {1}).map_err(|failure| failure.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(def proposal
  "{\"title\": \"Where do sessions live?\", \"context\": \"Sessions must survive a restart.\", \"options\": [{\"title\": \"Postgres\"}, {\"title\": \"Redis\"}], \"recommendation\": {\"option\": 1, \"reason\": \"Postgres already runs.\"}}")

(defstruct ledger-in-progress
  :database string
  :claimed string
  :blocked string)

(defn entry-for (reply key id)
  (-> (unwrap (json->items (unwrap (field reply key))))
      iter
      (find (fn (entry)
              (= (entry-id entry) (some (str id)))))
      unwrap copy-of))

(defn first-action (entry)
  (copy-of (unwrap (first (unwrap (json->items (unwrap (field entry
                                                              "actions"))))))))

(defn text-of (value key)
  (unwrap (json->text (unwrap (field value key)))))

(defn listed? (reply id)
  (any? (iter (unwrap (json->items (unwrap (field reply "next")))))
    (fn (entry)
      (= (entry-id entry) (some (str id))))))

(defn entry-id (entry)
  (then-some (field entry "item") item-id-of))

(defn item-id-of (item)
  (match (json->text (ref item))
    ((some id) (some id))
    (none (then-some (field (ref item) "id")
            (fn (id) (json->text (ref id)))))))

(defn reported-research-ledger (name)
  (let (ledger (ledger-in-progress name))
    (reported-done (ref (:database ledger))
                   (ref (:claimed ledger)))
    ledger))

(defn ledger-in-progress (name)
  (let (database (database-with-roadmap name)
        claimed (research-id (clone database))
        blocked (run-rmap (clone database)
                          (vec "item" "add" "--roadmap"
                               "road" "--title" "b" "--kind"
                               "design" "--description"
                               "a spec" "--criterion"
                               "a criterion" "--after"
                               (as-str claimed))))
    (assert (= (:exit-code
                 (run-rmap
                   (clone database)
                   (vec "item" "claim" (as-str claimed) "--session" "s1")))
               0))
    (->ledger-in-progress :database database
                          :claimed claimed
                          :blocked (text-at (ref blocked) "item" "id"))))

(type proposed
  (fn (string (ref str)
              (iterator (ref string)))
    string))

(defn proposed (database name extras)
  (let (args (vec (str "decision")
                  (str "propose")
                  (str "--roadmap")
                  (str "road")
                  (str "--file")
                  (clone (document-file name))))
    (for-each extras
      (fn (extra) (push! args (clone extra))))
    (let (reply (run-rmap (clone database) args))
      (assert (= (:exit-code reply) 0))
      (text-at (ref reply) "decision" "id"))))

(defn document-file (name)
  (let (path (str (scratch-database name) ".json"))
    (unwrap-ok (write-file (as-str path) proposal))
    path))

(defn reported-design (database)
  (let (design (added (clone database)
                      (vec "item" "add" "--roadmap" "road"
                           "--title" "d" "--kind" "design"
                           "--description" "a spec"
                           "--criterion" "a criterion")))
    (assert (= (:exit-code
                 (run-rmap
                   (clone database)
                   (vec "item" "claim" (as-str design) "--session" "s1")))
               0))
    (reported-done (clone database) (clone design))
    design))

(defn added (database args)
  (text-at (ref (run-rmap database args)) "item" "id"))

(defn listed-action (database id)
  (copy-of (unwrap (first (actions-listed (clone database) id)))))

(defn actions-listed (database id)
  (let (reply (run-rmap (clone database) (vec "next"))
        entry (entry-named (ref reply) "item" (clone id)))
    (unwrap (json->items (unwrap (field entry "actions"))))))

(type entry-named
  (fn ((ref reply) (ref str) string) json))

(defn entry-named (reply key id)
  (-> (next-entries reply)
      iter
      (find (fn (entry)
              (= (entry-text entry key)
                 (some (clone id)))))
      (map-some copy-of)
      unwrap))

(defn entry-text (entry key)
  (match (field entry key)
    ((some value) (json->text value))
    (none none)))

(defn next-entries (reply)
  (unwrap (json->items (unwrap (field (:json reply) "next")))))

(defn action-of (entry)
  (copy-of (unwrap (first (unwrap (json->items (unwrap (field entry
                                                              "actions"))))))))

(defn blocking-decisions (action)
  (let (reasons (unwrap-or (field action "reasons")
                           (object (vec)))
        listed (unwrap-or (field reasons "blocking_decisions")
                          (array (vec))))
    (collect (map (iter (unwrap-or (json->items listed) (vec)))
               (fn (id) (unwrap (json->text id)))))))

(deftest next-lists-each-item-with-its-action-actor-and-session
  (let (ledger (ledger-in-progress "e2e-next-shape")
        reply (run-rmap (clone (:database ledger))
                        (vec "next"))
        entry (entry-for (ref (:json reply))
                         "next"
                         (as-str (:claimed ledger)))
        action (first-action (ref entry)))
    (assert (= (:exit-code reply) 0))
    (assert (= (json->int (unwrap (field (ref (:json reply)) "schema_version")))
               (some 4)))
    (assert (= (text-of (ref entry) "roadmap")
               (str "road")))
    (assert (= (text-of (ref entry) "status")
               (str "dispatched")))
    (assert (= (text-of (ref entry) "kind")
               (str "research")))
    (assert (= (text-of (ref entry) "title")
               (str "r")))
    (assert (= (text-of (ref action) "action")
               (str "work")))
    (assert (= (text-of (ref action) "actor")
               (str "worker")))
    (assert (= (text-of (ref action) "session")
               (str "s1")))))

(deftest a-waiting-item-gives-the-reasons-rmap-ready-gives
  (let (ledger (ledger-in-progress "e2e-next-reasons")
        next (run-rmap (clone (:database ledger))
                       (vec "next"))
        ready (run-rmap (clone (:database ledger))
                        (vec "ready"))
        reasons (unwrap (field
                          (ref (first-action (ref (entry-for (ref (:json next))
                                                             "next"
                                                             (as-str (:blocked ledger))))))
                          "reasons"))
        blocked (entry-for (ref (:json ready))
                           "blocked"
                           (as-str (:blocked ledger))))
    (for-each (vec "blockers" "dropped_blockers")
      (fn (key)
        (assert (same? (ref (unwrap (field (ref reasons) (deref key))))
                       (ref (unwrap (field (ref blocked) (deref key))))))))))

(deftest a-reported-item-is-listed-for-accept-report
  (let (ledger (reported-research-ledger "e2e-next-reported")
        reply (run-rmap (clone (:database ledger))
                        (vec "next")))
    (assert (= (text-of (ref (first-action (ref (entry-for (ref (:json reply))
                                                           "next"
                                                           (as-str (:claimed ledger))))))
                        "action")
               (str "accept-report")))))

(deftest an-accepted-item-leaves-next
  (let (ledger (reported-research-ledger "e2e-next-accepted"))
    (assert (= (:exit-code (run-rmap (clone (:database ledger))
                                     (vec "item" "close"
                                          (as-str (:claimed ledger)))))
               0))
    (assert (not (listed? (ref (:json (run-rmap (clone (:database ledger))
                                                (vec "next"))))
                          (as-str (:claimed ledger)))))))

(deftest a-proposed-decision-is-asked-before-the-item-it-holds
  (let (database (database-with-roadmap "e2e-next-asks")
        build (added (clone database)
                     (vec "item" "add" "--roadmap" "road"
                          "--title" "b" "--kind" "build"
                          "--description" "a spec"
                          "--criterion" "a criterion"))
        decision (proposed (clone database)
                           "e2e-next-asks-doc"
                           (vec (str "--blocks") (clone build)))
        reply (run-rmap (clone database) (vec "next"))
        listed (next-entries (ref reply))
        decision-entry (entry-named (ref reply) "decision" (clone decision))
        item-entry (entry-named (ref reply) "item" (clone build))
        asked (action-of decision-entry)
        waiting (action-of item-entry))
    (assert (= (len listed) 2))
    (assert (= (text-of (ref decision-entry) "kind")
               (str "decision")))
    (assert (= (text-of (ref decision-entry) "status")
               (str "proposed")))
    (assert (= (text-of (ref asked) "action")
               (str "ask")))
    (assert (= (text-of (ref asked) "actor")
               (str "agent")))
    (assert (= (text-of (ref waiting) "action")
               (str "wait")))
    (assert (= (blocking-decisions waiting)
               (vec (clone decision))))))

(deftest asking-a-decision-awaits-the-user
  (let (database (database-with-roadmap "e2e-next-awaits")
        build (added (clone database)
                     (vec "item" "add" "--roadmap" "road"
                          "--title" "b" "--kind" "build"
                          "--description" "a spec"
                          "--criterion" "a criterion"))
        decision (proposed (clone database)
                           "e2e-next-awaits-doc"
                           (vec (str "--blocks") (clone build)))
        _ (run-rmap (clone database)
                    (vec "decision" "ask" (as-str decision)))
        reply (run-rmap (clone database) (vec "next"))
        asked (action-of
                (ref (entry-named (ref reply) "decision" (clone decision)))))
    (assert (= (text-of (ref asked) "action")
               (str "await-decision")))
    (assert (= (text-of (ref asked) "actor")
               (str "user")))))

(deftest a-rejected-decision-sends-its-blocked-item-to-a-replan
  (let (database (database-with-roadmap "e2e-next-replan")
        build (added (clone database)
                     (vec "item" "add" "--roadmap" "road"
                          "--title" "b" "--kind" "build"
                          "--description" "a spec"
                          "--criterion" "a criterion"))
        decision (proposed (clone database)
                           "e2e-next-replan-doc"
                           (vec (str "--blocks") (clone build)))
        _ (run-rmap
            (clone database)
            (vec "decision" "reject" (as-str decision) "--reason" "No."))
        reply (run-rmap (clone database) (vec "next"))
        item-entry (entry-named (ref reply) "item" (clone build))
        replan (action-of item-entry))
    (assert (= (text-of (ref replan) "action")
               (str "replan")))
    (assert (= (text-of (ref replan) "actor")
               (str "agent")))))

(deftest a-rejected-raised-decision-replans-the-design
  (let (database (database-with-roadmap "e2e-next-raised-replan")
        design (reported-design (clone database))
        decision (proposed (clone database)
                           "e2e-next-raised-replan-doc"
                           (vec (str "--item") (clone design)))
        _ (run-rmap
            (clone database)
            (vec "decision" "reject" (as-str decision) "--reason" "No."))
        reply (run-rmap (clone database) (vec "next"))
        item-entry (entry-named (ref reply) "item" (clone design))
        replan (action-of item-entry))
    (assert (= (text-of (ref replan) "action")
               (str "replan")))
    (assert (= (text-of (ref replan) "actor")
               (str "agent")))))

(deftest a-proposed-decision-raised-by-a-reported-design-waits-on-it
  (let (database (database-with-roadmap "e2e-next-raised-wait")
        design (reported-design (clone database))
        decision (proposed (clone database)
                           "e2e-next-raised-wait-doc"
                           (vec (str "--item") (clone design)))
        reply (run-rmap (clone database) (vec "next"))
        item-entry (entry-named (ref reply) "item" (clone design))
        waiting (action-of item-entry))
    (assert (= (text-of (ref waiting) "action")
               (str "wait")))
    (assert (= (blocking-decisions waiting)
               (vec (clone decision))))))

(deftest a-dispatched-build-keeps-working-when-it-raised-a-proposed-decision
  (let (database (database-with-roadmap "e2e-next-dispatched-raised")
        build (added (clone database)
                     (vec "item" "add" "--roadmap" "road"
                          "--title" "b" "--kind" "build"
                          "--description" "a spec"
                          "--criterion" "a criterion"))
        _claim (run-rmap (clone database)
                         (vec "item" "claim" (as-str build) "--session" "s1"))
        _decision (proposed (clone database)
                            "e2e-next-dispatched-raised-doc"
                            (vec (str "--item") (clone build)))
        reply (run-rmap (clone database) (vec "next"))
        item-entry (entry-named (ref reply) "item" (clone build))
        working (action-of item-entry))
    (assert (= (text-of (ref working) "action")
               (str "work")))
    (assert (= (text-of (ref working) "actor")
               (str "worker")))))

(deftest a-dispatched-build-keeps-working-and-replans-a-raised-rejection
  (let (database (database-with-roadmap "e2e-next-dispatched-rejected")
        build (added (clone database)
                     (vec "item" "add" "--roadmap" "road"
                          "--title" "b" "--kind" "build"
                          "--description" "a spec"
                          "--criterion" "a criterion"))
        _claim (run-rmap (clone database)
                         (vec "item" "claim" (as-str build) "--session" "s1"))
        decision (proposed (clone database)
                           "e2e-next-dispatched-rejected-doc"
                           (vec (str "--item") (clone build)))
        _reject (run-rmap
                  (clone database)
                  (vec "decision" "reject" (as-str decision) "--reason" "No."))
        reply (run-rmap (clone database) (vec "next"))
        item-entry (entry-named (ref reply) "item" (clone build))
        listed (collect (map (iter (unwrap (json->items (unwrap (field
                                                                  item-entry
                                                                  "actions")))))
                             (fn (action) (text-of action "action")))))
    (assert (= listed
               (vec (str "work") (str "replan"))))))

(deftest an-approved-in-review-build-waits-on-a-proposed-decision-it-raised
  (let (database (database-with-roadmap "e2e-next-approved-raised")
        build (build-id (ref database))
        _done (assert (= (:exit-code (report-build (ref database)
                                                   build
                                                   "done"
                                                   (vec (str "--pr")
                                                        (str "1")
                                                        (str "--head")
                                                        (str first-sha))))
                         0))
        _review (assert (= (:exit-code (verify-and-review-build (ref database)
                                                                build
                                                                "r1"
                                                                "approve"
                                                                first-sha))
                           0))
        before (run-rmap (clone database) (vec "next"))
        before-action (action-of
                        (entry-named (ref before) "item" (clone build)))
        _decision (proposed (clone database)
                            "e2e-next-approved-raised-doc"
                            (vec (str "--item") (clone build)))
        after (run-rmap (clone database) (vec "next"))
        waiting (action-of (entry-named (ref after) "item" (clone build))))
    (assert (= (text-of (ref before-action) "action")
               (str "merge")))
    (assert (= (text-of (ref waiting) "action")
               (str "wait")))))

(deftest a-live-review-session-is-listed-for-that-reviewer
  (let (database (database-with-roadmap "e2e-next-live-review")
        id (build-id (ref database)))
    (report-build (ref database)
                  id "done"
                  (vec "--pr" "1" "--head" first-sha))
    (assert (= (:exit-code (review-start (ref database) id "r1"))
               0))
    (let (action (listed-action (ref database) id))
      (assert (= (text-of (ref action) "action")
                 (str "review")))
      (assert (= (text-of (ref action) "actor")
                 (str "worker")))
      (assert (= (text-of (ref action) "session")
                 (str "r1"))))))

(deftest a-changes-verdict-on-the-current-head-is-listed-for-send-fixes
  (let (database (database-with-roadmap "e2e-next-send-fixes")
        id (build-id (ref database)))
    (report-build (ref database)
                  id "done"
                  (vec "--pr" "1" "--head" first-sha))
    (assert (= (:exit-code
                 (review-build (ref database) id "r1" "changes" first-sha))
               0))
    (let (action (listed-action (ref database) id))
      (assert (= (text-of (ref action) "action")
                 (str "send-fixes")))
      (assert (= (text-of (ref action) "actor")
                 (str "agent")))
      (assert (= (text-of (ref action) "session")
                 (str "s1"))))))

(deftest a-new-head-after-a-changes-verdict-is-listed-for-review
  (let (database (database-with-roadmap "e2e-next-new-head")
        id (build-id (ref database)))
    (report-build (ref database)
                  id "done"
                  (vec "--pr" "1" "--head" first-sha))
    (assert (= (:exit-code
                 (review-build (ref database) id "r1" "changes" first-sha))
               0))
    (assert (= (:exit-code (run-rmap (clone database)
                                     (vec "pr" "head" (as-str id) second-sha)))
               0))
    (let (action (listed-action (ref database) id))
      (assert (= (text-of (ref action) "action")
                 (str "review")))
      (assert (= (text-of (ref action) "actor")
                 (str "agent")))
      (assert (= (text-of (ref action) "session")
                 (str "s1"))))))

(deftest a-build-waiting-for-verdicts-with-a-live-review-session-is-listed-for-that-reviewer
  (let (database (database-with-roadmap "e2e-next-live-verify")
        id (build-id (ref database)))
    (report-build (ref database)
                  id "done"
                  (vec "--pr" "1" "--head" first-sha))
    (assert (= (:exit-code
                 (review-build (ref database) id "r1" "approve" first-sha))
               0))
    (assert (= (text-of (ref (listed-action (ref database) id))
                        "action")
               (str "verify")))
    (assert (= (:exit-code (review-start (ref database) id "r2"))
               0))
    (let (actions (actions-listed (ref database) id)
          action (copy-of (unwrap (first actions))))
      (assert (= (len actions) 1))
      (assert (= (text-of (ref action) "action")
                 (str "review")))
      (assert (= (text-of (ref action) "actor")
                 (str "worker")))
      (assert (= (text-of (ref action) "session")
                 (str "r2"))))))
