(use json/value field json->text)

(use support/rmap blocked-design-id database-with-roadmap
                  error-code research-id run-rmap
                  run-rmap-text)

(deftest graph-prints-raw-mermaid-without-a-code-fence
  (let (database (database-with-roadmap "graph-text")
        output (run-rmap-text (vec "--db" (as-str database) "graph")))
    (assert (= (:code output) 0))
    (assert (starts-with? (as-str (:stdout output)) "flowchart LR\n"))
    (assert (not (contains? (as-str (:stdout output)) "```")))))

(deftest graph-json-holds-the-format-and-the-source
  (let (reply (run-rmap (database-with-roadmap "graph-json")
                        (vec "graph")))
    (assert (= (:exit-code reply) 0))
    (assert (= (json->text (unwrap (field (:json reply) "format")))
               (some (str "mermaid"))))
    (assert (some? (json->text (unwrap (field (:json reply) "source")))))))

(deftest a-graph-format-other-than-mermaid-exits-two
  (let (reply (run-rmap (database-with-roadmap "graph-dot")
                        (vec "graph" "--format" "dot")))
    (assert (= (:exit-code reply) 2))
    (assert (= (error-code (ref reply)) "usage"))))

(defn ledger-with-a-dependency (name)
  (let (database (database-with-roadmap name)
        blocker (research-id (clone database)))
    (blocked-design-id (clone database) blocker)
    database))

(type graph-text
  (fn (string (vec (ref str))) string))

(defn graph-text (database extra)
  (let (args (vec "--db" (as-str database) "graph"))
    (for-each extra
      (fn (arg) (push! args (deref arg))))
    (clone (:stdout (run-rmap-text args)))))

(deftest level-item-prints-what-graph-prints-without-a-level
  (let (database (ledger-with-a-dependency "graph-level-item"))
    (assert (= (graph-text (clone database) (vec "--level" "item"))
               (graph-text database (vec))))))

(deftest two-runs-at-each-level-print-the-same-graph
  (let (database (ledger-with-a-dependency "graph-level-twice"))
    (for-each (vec "item" "epic" "roadmap")
      (fn (level)
        (assert (= (graph-text (clone database)
                               (vec "--level" (deref level)))
                   (graph-text (clone database)
                               (vec "--level" (deref level)))))))))

(deftest level-roadmap-draws-one-node-per-roadmap
  (let (database (ledger-with-a-dependency "graph-level-roadmap"))
    (assert (contains? (as-str (graph-text database
                                           (vec "--level" "roadmap" "--all")))
                       "[\"road<br/><i>0/2 merged</i>\"]"))))

(deftest an-unknown-graph-level-exits-two
  (let (reply (run-rmap (database-with-roadmap "graph-level-module")
                        (vec "graph" "--level" "module")))
    (assert (= (:exit-code reply) 2))
    (assert (= (error-code (ref reply)) "usage"))))
