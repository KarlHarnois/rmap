(use json/value field json->items)

(use support/rmap blocked-design-id database-with-roadmap
                  research-id run-rmap text-at
                  top-level-keys)

(defn build-id (database)
  (text-at (ref (run-rmap (clone database)
                          (vec "item" "add" "--roadmap"
                               "road" "--title" "b" "--kind"
                               "build" "--description"
                               "a spec")))
           "item" "id"))

(defn list-at (reply key)
  (unwrap (json->items (unwrap (field (:json reply) key)))))

(deftest a-limited-ready-reply-holds-picked-and-blocked
  (let (database (database-with-roadmap "ready-limit-json")
        _first-build (build-id (clone database))
        _second-build (build-id (clone database))
        _blocked (blocked-design-id (clone database)
                                    (research-id (clone database)))
        reply (run-rmap database (vec "ready" "--limit" "2")))
    (assert (= (:exit-code reply) 0))
    (assert (= (top-level-keys (ref reply))
               (vec (str "blocked")
                    (str "picked")
                    (str "schema_version"))))
    (assert (= (len (list-at (ref reply) "picked"))
               2))
    (assert (= (len (list-at (ref reply) "blocked"))
               1))))
