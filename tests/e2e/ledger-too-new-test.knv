(use json/value field json->int)
(use ledger/sqlite/connection open query run-batch)
(use ledger/sqlite/migrations migrate schema-version)
(use ledger/sqlite/migration-sources migration-sources)
(use ledger/sqlite/rows int-cell single-row)

(use support/rmap database-with-roadmap error-code
                  research-id run-rmap)

(use support/scratch scratch-database)

(def ledger-state-columns 4)

(defn ledger-state (database)
  (let (connection (unwrap-ok (open (as-str database)))
        rows (unwrap-ok (query (ref connection)
                               "SELECT (SELECT user_version FROM pragma_user_version), (SELECT count(*) FROM events), (SELECT count(*) FROM items), (SELECT count(*) FROM roadmaps)"
                               (ref (vec))))
        row (unwrap-ok (single-row (ref rows))))
    (collect (map (range 0 ledger-state-columns)
               (fn (index)
                 (unwrap-ok (int-cell row index)))))))

(defn too-new-ledger (name)
  (let (database (database-with-roadmap name)
        item (research-id (clone database)))
    (set-stored-version (clone database)
                        (inc (newest-version)))
    (pair database item)))

(defn newest-version ()
  (-> (migration-sources) iter (map :version) max unwrap))

(defn set-stored-version (database version)
  (let (connection (unwrap-ok (open (as-str database))))
    (unwrap-ok (run-batch (ref connection)
                          (as-str (str "PRAGMA user_version = "
                                       version ";"))))))

(defn every-command (item)
  (vec (vec (str "init"))
       (vec (str "new")
            (str "other")
            (str "--manager")
            (str "m2"))
       (vec (str "list"))
       (vec (str "ready"))
       (vec (str "ready")
            (str "--limit")
            (str "2"))
       (vec (str "next"))
       (vec (str "log"))
       (vec (str "item")
            (str "add")
            (str "--roadmap")
            (str "road")
            (str "--title")
            (str "x")
            (str "--kind")
            (str "research"))
       (vec (str "item") (str "list"))
       (vec (str "item")
            (str "show")
            (clone item))
       (vec (str "item")
            (str "claim")
            (clone item)
            (str "--session")
            (str "s1"))
       (vec (str "item")
            (str "advance")
            (clone item)
            (str "reported"))
       (vec (str "item")
            (str "close")
            (clone item))
       (vec (str "item")
            (str "drop")
            (clone item)
            (str "--reason")
            (str "gone"))
       (vec (str "dep")
            (str "add")
            (clone item)
            (clone item))
       (vec (str "dep")
            (str "rm")
            (clone item)
            (clone item))
       (vec (str "graph"))))

(defn run-args (database args)
  (run-rmap database
            (collect (map (iter args) as-str))))

(defn error-int (reply key)
  (json->int (unwrap (field (unwrap (field (:json reply) "error"))
                            key))))

(defn all-but-newest-migration ()
  (let (older (migration-sources))
    (pop! older)
    older))

(defn stored-version (database)
  (let (connection (unwrap-ok (open (as-str database))))
    (unwrap-ok (schema-version (ref connection)))))

(deftest every-command-on-a-ledger-from-a-newer-rmap-exits-three-with-ledger-too-new
  (let-match ((pair database item) (too-new-ledger "too-new-every-command"))
    (for-each (every-command item)
      (fn (args)
        (let (reply (run-args (clone database) args))
          (assert (= (:exit-code reply) 3))
          (assert (= (error-code (ref reply)) "ledger-too-new")))))))

(deftest every-command-on-a-ledger-from-a-newer-rmap-changes-nothing
  (let-match ((pair database item) (too-new-ledger "too-new-unchanged"))
    (let (before (ledger-state (clone database)))
      (for-each (every-command item)
        (fn (args)
          (run-args (clone database) args)
          (do)))
      (assert (= (ledger-state database) before)))))

(deftest the-json-error-names-the-ledger-and-binary-versions
  (let-match ((pair database _) (too-new-ledger "too-new-json"))
    (let (reply (run-rmap database (vec "list")))
      (assert (= (error-int (ref reply) "ledger_version")
                 (some (inc (newest-version)))))
      (assert (= (error-int (ref reply) "binary_version")
                 (some (newest-version)))))))

(deftest a-ledger-at-an-older-version-migrates-and-runs
  (let (database (scratch-database "too-new-older"))
    (let (connection (unwrap-ok (open (as-str database))))
      (unwrap-ok (migrate (ref connection) (all-but-newest-migration))))
    (assert (= (:exit-code (run-rmap (clone database) (vec "list")))
               0))
    (assert (= (stored-version database) (newest-version)))))
