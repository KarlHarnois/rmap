(module
  "Tells whether a file is present at a path, or why that could not be checked.")

(export file-presence file-presence-at)

(defenum file-presence
  present
  absent)

(def path-exists
  (rust "std::path::Path::new({0}).try_exists().map_err(|failure| failure.to_string())"
    (fn ((ref str)) (result bool string))))

(defn file-presence-at (path)
  (map-ok (path-exists path) exists->presence))

(defn exists->presence (exists)
  (if exists file-presence/present file-presence/absent))
