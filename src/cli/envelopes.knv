(module
  "Wraps command results and errors in the JSON object the CLI prints, with its output schema version.")

(use json/value array int->json json object text->json)
(use ledger/api item-detail)
(use cli/replies reply)

(use cli/ledger-json blocked->json dep->json event->json
                     globs->json item->json roadmap->json)

(export envelope error-envelope reply-envelope)

(def output-schema-version 1)

(defn envelope (fields)
  (let (all fields)
    (push! all
           (pair (str "schema_version")
                 (int->json output-schema-version)))
    (object all)))

(defn error-envelope (code message details)
  (let (fields details)
    (push! fields
           (pair (str "code") (text->json code)))
    (push! fields
           (pair (str "message") (text->json message)))
    (envelope (vec (pair (str "error") (object fields))))))

(defn reply-envelope (reply)
  (match reply
    ((reply/roadmap-created roadmap) (roadmap-envelope roadmap))
    ((reply/roadmaps-listed roadmaps)
     (roadmaps-envelope roadmaps))
    ((reply/readiness-checked readiness)
     (readiness-envelope readiness))
    ((reply/log-read events) (events-envelope events))
    ((reply/item-added item) (item-envelope item))
    ((reply/item-moved item) (item-envelope item))
    ((reply/items-listed items) (items-envelope items))
    ((reply/item-shown detail) (detail-envelope detail))
    ((reply/dep-added dep) (dep-envelope dep))
    ((reply/dep-removed dep) (dep-envelope dep))))

(defn roadmap-envelope (roadmap)
  (envelope (vec (pair (str "roadmap")
                       (roadmap->json (ref roadmap))))))

(defn roadmaps-envelope (roadmaps)
  (envelope (vec (pair (str "roadmaps")
                       (array (collect (map (iter roadmaps) roadmap->json)))))))

(defn item-envelope (item)
  (envelope (vec (pair (str "item")
                       (item->json (ref item))))))

(defn items-envelope (items)
  (envelope (vec (pair (str "items")
                       (array (collect (map (iter items) item->json)))))))

(defn events-envelope (events)
  (envelope (vec (pair (str "events")
                       (array (collect (map (iter events) event->json)))))))

(defn dep-envelope (dep)
  (envelope (vec (pair (str "dep") (dep->json (ref dep))))))

(type detail-envelope (fn (item-detail) json))

(defn detail-envelope (detail)
  (envelope (vec (pair (str "item")
                       (item->json (ref (:item detail))))
                 (pair (str "deps")
                       (array (collect (map (iter (:deps detail)) dep->json))))
                 (pair (str "paths")
                       (globs->json (ref (:globs detail)))))))

(defn readiness-envelope (readiness)
  (envelope (vec (pair (str "ready")
                       (array (collect (map (iter (:ready readiness))
                                            item->json))))
                 (pair (str "blocked")
                       (array (collect (map (iter (:blocked readiness))
                                            blocked->json)))))))
