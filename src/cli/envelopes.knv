(module
  "Wraps each command result in the JSON object the CLI prints.")

(use json/value array json object text->json)

(use ledger/api case-name graph-format-names graph-source
                init-outcome-names init-report item-detail)

(use cli/replies reply)

(use cli/ledger-json blocked->json dep->json event->json
                     item->json roadmap->json)

(use cli/next-json next-item->json)
(use cli/decision-json decision->json)
(use cli/report-json report-reply-fields)
(use cli/schema-envelope envelope)

(export reply-envelope)

(defn reply-envelope (reply)
  (match reply
    ((reply/ledger-initialized report)
     (init-report-envelope report))
    ((reply/roadmap-created roadmap) (roadmap-envelope roadmap))
    ((reply/roadmap-status-changed roadmap)
     (roadmap-envelope roadmap))
    ((reply/roadmaps-listed roadmaps)
     (roadmaps-envelope roadmaps))
    ((reply/readiness-checked readiness)
     (readiness-envelope readiness))
    ((reply/next-listed items) (next-envelope items))
    ((reply/batch-picked batch) (batch-envelope batch))
    ((reply/log-read events) (events-envelope events))
    ((reply/item-added item) (item-envelope item))
    ((reply/item-edited item) (item-envelope item))
    ((reply/item-moved item) (item-envelope item))
    ((reply/items-listed items) (items-envelope items))
    ((reply/item-shown detail) (detail-envelope detail))
    ((reply/dep-added dep) (dep-envelope dep))
    ((reply/dep-removed dep) (dep-envelope dep))
    ((reply/graph-drawn graph) (graph-envelope graph))
    ((reply/decision-proposed decision)
     (decision-envelope decision))
    ((reply/decision-revised decision)
     (decision-envelope decision))
    ((reply/decision-shown decision)
     (decision-envelope decision))
    ((reply/decisions-listed decisions)
     (decisions-envelope decisions))
    ((reply/decision-asked decision)
     (decision-envelope decision))
    ((reply/decision-accepted decision)
     (decision-envelope decision))
    ((reply/decision-rejected decision)
     (decision-envelope decision))
    ((reply/decision-deprecated decision)
     (decision-envelope decision))
    ((reply/reported answer)
     (envelope (report-reply-fields answer)))))

(defn decision-envelope (decision)
  (envelope (vec (pair (str "decision")
                       (decision->json (ref decision))))))

(defn decisions-envelope (decisions)
  (envelope (vec (pair (str "decisions")
                       (array (collect (map (iter decisions)
                                            decision->json)))))))

(type graph-envelope (fn (graph-source) json))

(defn graph-envelope (graph)
  (envelope (vec (pair (str "format")
                       (text->json (case-name graph-format-names
                                              (:format graph))))
                 (pair (str "source")
                       (text->json (as-str (:source graph)))))))

(defn init-report-envelope (report)
  (envelope (vec (pair (str "ledger")
                       (init-report->json (ref report))))))

(type init-report->json
  (fn ((ref init-report)) json))

(defn init-report->json (report)
  (let (outcome (case-name init-outcome-names (:outcome report)))
    (object (vec (pair (str "path")
                       (text->json (:database-path report)))
                 (pair (str "outcome") (text->json outcome))))))

(defn roadmap-envelope (roadmap)
  (envelope (vec (pair (str "roadmap")
                       (roadmap->json (ref roadmap))))))

(defn roadmaps-envelope (roadmaps)
  (envelope (vec (pair (str "roadmaps")
                       (array (collect (map (iter roadmaps) roadmap->json)))))))

(defn item-envelope (item)
  (envelope (vec (pair (str "item")
                       (item->json (ref item))))))

(defn items-envelope (items)
  (envelope (vec (pair (str "items")
                       (array (collect (map (iter items) item->json)))))))

(defn events-envelope (events)
  (envelope (vec (pair (str "events")
                       (array (collect (map (iter events) event->json)))))))

(defn next-envelope (items)
  (envelope (vec (pair (str "next")
                       (array (collect (map (iter items) next-item->json)))))))

(defn dep-envelope (dep)
  (envelope (vec (pair (str "dep") (dep->json (ref dep))))))

(type detail-envelope (fn (item-detail) json))

(defn detail-envelope (detail)
  (envelope (vec (pair (str "item")
                       (item->json (ref (:item detail))))
                 (pair (str "deps")
                       (array (collect (map (iter (:deps detail)) dep->json))))
                 (pair (str "children")
                       (array (collect (map (iter (:children detail))
                                            item->json)))))))

(defn readiness-envelope (readiness)
  (envelope (vec (pair (str "ready")
                       (array (collect (map (iter (:ready readiness))
                                            item->json))))
                 (pair (str "blocked")
                       (array (collect (map (iter (:blocked readiness))
                                            blocked->json)))))))

(defn batch-envelope (batch)
  (envelope
    (vec (pair (str "picked")
               (array (collect (map (iter (:picked batch)) item->json))))
         (pair (str "blocked")
               (array (collect (map (iter (:blocked batch)) blocked->json)))))))
