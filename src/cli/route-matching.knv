(module
  "Finds the route a command line names and checks its operands and flags against it.")

(use cli/routes route route-name word-count)
(use cli/commands routes)
(use cli/flag-specs global-flags required?)
(use cli/arguments arguments)
(use cli/flags optional-text)

(export check-flags-without-command check-shape
        help-routes-of route-of)

(defn help-routes-of (arguments)
  (match (route-of arguments)
    ((ok route) (ok (vec route)))
    ((err _) (command-group-of arguments))))

(defn route-of (arguments)
  (ok-or (map-some (find (iter (routes))
                     (fn (route) (route-matches? route arguments)))
                   clone)
         (unknown-command arguments)))

(defn check-shape (arguments route)
  (let (operand-count (- (len (:words arguments))
                         (word-count route))
        expected (len (:operands route))
        unknown (unknown-flags arguments route)
        missing (missing-flags arguments route))
    (cond
      ((not= operand-count expected)
       (err (str (route-name route)
                 " takes " expected " operands, got "
                 operand-count)))
      ((not (empty? unknown))
       (err (str (route-name route)
                 " does not take --"
                 (join unknown ", --"))))
      ((not (empty? missing))
       (err (str (route-name route) " needs --" (join missing ", --"))))
      (else (ok (do))))))

(defn check-flags-without-command (arguments)
  (let (command-flags (unlisted-flags arguments
                                      (flag-names (ref (global-flags)))))
    (if (empty? command-flags)
      (ok (do))
      (err (str "--" (join command-flags ", --") " needs a command")))))

(defn command-group-of (arguments)
  (let (group (-> (iter (routes))
                  (filter (fn (route) (in-group? route arguments)))
                  (map clone)
                  collect))
    (if (empty? group)
      (err (unknown-command arguments))
      (ok group))))

(defn unknown-command (arguments)
  (str "unknown command: " (join (:words arguments) " ")))

(defn in-group? (route arguments)
  (starts-with-words? (ref (:words route))
                      (ref (:words arguments))))

(defn starts-with-words? (words prefix)
  (and (<= (len prefix) (len words))
       (= (collect (map (take (iter words) (len prefix))
                        clone))
          (clone prefix))))

(type route-matches?
  (fn ((ref route) (ref arguments)) bool))

(defn route-matches? (route arguments)
  (= (collect (map (take (iter (:words arguments))
                         (word-count route))
                   clone))
     (clone (:words route))))

(defn unknown-flags (arguments route)
  (unlisted-flags arguments (known-flag-names route)))

(defn unlisted-flags (arguments listed)
  (collect (map (filter (iter (given-flag-names arguments))
                  (fn (name)
                    (not (contains? listed (clone name)))))
                clone)))

(type given-flag-names
  (fn ((ref arguments)) (vec string)))

(defn given-flag-names (arguments)
  (let (names (collect (map (iter (:flags arguments))
                         (fn (entry) (clone (first entry))))))
    (for-each (:switches arguments)
      (fn (name) (push! names (clone name))))
    names))

(defn known-flag-names (route)
  (let (names (flag-names (ref (:flags route))))
    (for-each (flag-names (ref (global-flags)))
      (fn (name) (push! names (clone name))))
    names))

(defn flag-names (specs)
  (collect (map (iter specs)
             (fn (spec) (clone (:name spec))))))

(defn missing-flags (arguments route)
  (collect (map (filter (iter (:flags route))
                  (fn (spec)
                    (and (required? spec)
                         (none? (optional-text arguments
                                               (as-str (:name spec)))))))
                (fn (spec) (clone (:name spec))))))
