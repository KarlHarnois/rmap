(module
  "Names each decision request the CLI can make, builds it from the command line, and completes a proposal or revision once its document is read.")

(use ledger/api ->acceptance ->decision-id ->decision-query
                ->decision-revision ->item-id ->new-decision
                acceptance decision-id decision-query
                decision-revision decision-status-names
                item-id new-decision proposal
                supersedes-change)

(use cli/arguments operand)

(use cli/flags id-list optional-choice optional-text
               required-number required-text switch-on?)

(export decision-accept-request decision-ask-request
        decision-block-request decision-deprecate-request
        decision-list-request decision-reject-request
        decision-request decision-show-request
        decision-unblock-request document-source
        document-source-of pending-decision proposal-pending
        revision-pending text->decision-id with-proposal)

(defenum decision-request
  (propose new-decision)
  (revise decision-revision)
  (show decision-id)
  (list decision-query)
  (ask decision-id)
  (accept decision-id acceptance)
  (reject decision-id string)
  (deprecate decision-id string)
  (block decision-id item-id)
  (unblock decision-id item-id))

(defenum document-source
  (file string)
  stdin)

(defenum pending-decision
  (propose placement)
  (revise decision-id supersedes-change))

(defstruct placement
  :roadmap string
  :item (option item-id)
  :blocks (vec item-id)
  :supersedes (option decision-id))

(defn proposal-pending (arguments)
  (let-try (roadmap (required-text arguments "roadmap"))
    (ok (pending-decision/propose
          (->placement
            :roadmap roadmap
            :item (map-some (optional-text arguments "item") text->item-id)
            :blocks (id-list arguments "blocks")
            :supersedes (map-some (optional-text arguments "supersedes")
                                  text->decision-id))))))

(defn revision-pending (arguments id)
  (map-ok (supersedes-change-of arguments)
    (fn (change)
      (pending-decision/revise (text->decision-id id) change))))

(defn decision-show-request (id)
  (decision-request/show (text->decision-id id)))

(defn decision-list-request (arguments)
  (let-try (status (optional-choice arguments "status" decision-status-names))
    (ok (decision-request/list
          (->decision-query :roadmap (optional-text arguments "roadmap")
                            :status status
                            :item (map-some (optional-text arguments "item")
                                            text->item-id))))))

(type with-proposal
  (fn (pending-decision proposal) decision-request))

(defn with-proposal (pending proposal)
  (match pending
    ((propose placement)
     (decision-request/propose (->new-decision
                                 :roadmap (clone (:roadmap placement))
                                 :item (clone (:item placement))
                                 :blocks (clone (:blocks placement))
                                 :supersedes (clone (:supersedes placement))
                                 :proposal proposal)))
    ((revise id change)
     (decision-request/revise (->decision-revision :id id
                                                   :proposal proposal
                                                   :supersedes change)))))

(defn decision-ask-request (id)
  (decision-request/ask (text->decision-id id)))

(defn decision-accept-request (arguments id)
  (let-try (option (required-number arguments "option")
            justification (required-text arguments "justification")
            consequences (required-text arguments "consequences"))
    (ok (decision-request/accept (text->decision-id id)
                                 (->acceptance :option option
                                               :justification justification
                                               :consequences consequences)))))

(defn decision-reject-request (arguments id)
  (let-try (reason (required-text arguments "reason"))
    (ok (decision-request/reject (text->decision-id id) reason))))

(defn decision-deprecate-request (arguments id)
  (let-try (reason (required-text arguments "reason"))
    (ok (decision-request/deprecate (text->decision-id id) reason))))

(defn decision-block-request (arguments route)
  (decision-request/block
    (text->decision-id (operand arguments route 0))
    (text->item-id (operand arguments route 1))))

(defn decision-unblock-request (arguments route)
  (decision-request/unblock
    (text->decision-id (operand arguments route 0))
    (text->item-id (operand arguments route 1))))

(defn text->decision-id (text) (->decision-id :value text))

(defn document-source-of (arguments)
  (let-try (path (required-text arguments "file"))
    (ok (if (= (as-str path) "-")
          document-source/stdin
          (document-source/file path)))))

(defn supersedes-change-of (arguments)
  (if (switch-on? arguments "no-supersedes")
    (cleared-supersedes arguments)
    (retargeted-supersedes arguments)))

(defn cleared-supersedes (arguments)
  (if (some? (optional-text arguments "supersedes"))
    (err (str "--supersedes and --no-supersedes cannot be used together"))
    (ok supersedes-change/clear)))

(defn retargeted-supersedes (arguments)
  (match (optional-text arguments "supersedes")
    ((some id)
     (ok (supersedes-change/retarget (text->decision-id id))))
    (none (ok supersedes-change/keep))))

(defn text->item-id (text) (->item-id :value text))
