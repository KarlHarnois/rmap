(module
  "Turns ledger values into JSON objects.")

(use json/value copy-of int->json json object text->json)

(use ledger/api case-name claim dep dep-type-names event
                event-type-names item kind-names
                origin-names roadmap roadmap-status-names
                status-names)

(export dep->json event->json glob->json item->json
        roadmap->json)

(defn glob->json (glob)
  (text->json (as-str (:pattern glob))))

(defn optional-text->json (text)
  (match text
    ((some present) (text->json (as-str present)))
    (none json/null)))

(type roadmap->json
  (fn ((ref roadmap)) json))

(defn roadmap->json (roadmap)
  (object (vec (pair (str "id")
                     (text->json (as-str (:value (:id roadmap)))))
               (pair (str "name")
                     (text->json (as-str (:name roadmap))))
               (pair (str "manager")
                     (text->json (as-str (:name (:manager roadmap)))))
               (pair (str "status")
                     (text->json (case-name roadmap-status-names
                                            (:status roadmap))))
               (pair (str "created_at")
                     (text->json (as-str (:value (:created-at roadmap))))))))

(type item->json (fn ((ref item)) json))

(defn item->json (item)
  (object (vec (pair (str "id")
                     (text->json (as-str (:value (:id item)))))
               (pair (str "roadmap_id")
                     (text->json (as-str (:value (:roadmap-id item)))))
               (pair (str "parent_id")
                     (optional-text->json (map-some (clone (:parent item))
                                            (fn (id) (clone (:value id))))))
               (pair (str "title")
                     (text->json (as-str (:title item))))
               (pair (str "kind")
                     (text->json (case-name kind-names (:kind item))))
               (pair (str "status")
                     (text->json (case-name status-names (:status item))))
               (pair (str "origin")
                     (text->json (case-name origin-names (:origin item))))
               (pair (str "priority")
                     (int->json (:priority item)))
               (pair (str "claimed_by")
                     (claim->json (ref (:claim item))))
               (pair (str "created_at")
                     (text->json (as-str (:value (:created-at item)))))
               (pair (str "closed_at")
                     (optional-text->json (map-some (clone (:closed-at item))
                                            (fn (at) (clone (:value at)))))))))

(defn claim->json (claim)
  (match claim
    ((claimed-by session) (text->json (as-str (:name session))))
    (unclaimed json/null)))

(type event->json
  (fn ((ref event)) json))

(defn event->json (event)
  (object (vec (pair (str "id")
                     (int->json (:id event)))
               (pair (str "at")
                     (text->json (as-str (:value (:at event)))))
               (pair (str "actor")
                     (text->json (as-str (:actor event))))
               (pair (str "roadmap_id")
                     (optional-text->json (map-some (clone (:roadmap-id event))
                                            (fn (id) (clone (:value id))))))
               (pair (str "item_id")
                     (optional-text->json (map-some (clone (:item-id event))
                                            (fn (id) (clone (:value id))))))
               (pair (str "type")
                     (text->json (case-name event-type-names (:type event))))
               (pair (str "payload")
                     (copy-of (ref (:payload event)))))))

(type dep->json (fn ((ref dep)) json))

(defn dep->json (dep)
  (object (vec (pair (str "item")
                     (text->json (as-str (:value (:item dep)))))
               (pair (str "on")
                     (text->json (as-str (:value (:on dep)))))
               (pair (str "type")
                     (text->json (case-name dep-type-names (:type dep)))))))
