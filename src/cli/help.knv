(module
  "Describes the CLI as JSON: its commands and flags, its environment variables, its exit codes and its refusal codes.")

(use json/value array bool->json int->json json object
                text->json)

(use ledger/api refusal-catalog refusal-description)
(use cli/routes route-name)
(use cli/commands routes)

(use cli/flag-specs boolean? flag-input flag-spec
                    global-flags required?)

(use cli/exit-codes exit-code->meaning exit-code->number
                    exit-codes)

(use cli/environment-variables environment-variable
                               environment-variables)

(use cli/envelopes envelope)
(use cli/usage usage-line)

(export command-help-document help-document)

(defn help-document ()
  (envelope (vec (pair (str "usage")
                       (text->json (as-str (usage-line))))
                 (pair (str "commands")
                       (array (collect (map (iter (routes)) route->json))))
                 (pair (str "global_flags")
                       (array (collect (map (iter (global-flags)) flag->json))))
                 (pair (str "environment")
                       (array (collect (map (iter (environment-variables))
                                            environment-variable->json))))
                 (pair (str "exit_codes")
                       (array (collect (map (iter (exit-codes))
                                            exit-code->json))))
                 (pair (str "refusal_codes")
                       (array (collect (map (iter (refusal-catalog))
                                            refusal->json)))))))

(defn command-help-document (routes)
  (envelope (vec (pair (str "commands")
                       (array (collect (map (iter routes) route->json)))))))

(defn route->json (route)
  (object (vec
            (pair (str "command")
                  (text->json (as-str (route-name route))))
            (pair (str "summary")
                  (text->json (as-str (:summary route))))
            (pair (str "operands")
                  (array (collect (map (iter (:operands route))
                                    (fn (name) (text->json (as-str name)))))))
            (pair (str "flags")
                  (array (collect (map (iter (:flags route)) flag->json)))))))

(type flag->json
  (fn ((ref flag-spec)) json))

(defn flag->json (spec)
  (object (vec (pair (str "name")
                     (text->json (as-str (:name spec))))
               (pair (str "required")
                     (bool->json (required? spec)))
               (pair (str "value")
                     (placeholder->json (ref (:input spec))))
               (pair (str "boolean")
                     (bool->json (boolean? spec))))))

(defn placeholder->json (input)
  (match input
    ((flag-input/value placeholder)
     (text->json (as-str placeholder)))
    (flag-input/boolean (text->json ""))))

(type environment-variable->json
  (fn ((ref environment-variable)) json))

(defn environment-variable->json (variable)
  (object (vec (pair (str "name")
                     (text->json (as-str (:name variable))))
               (pair (str "meaning")
                     (text->json (as-str (:meaning variable)))))))

(defn exit-code->json (code)
  (object (vec (pair (str "code")
                     (int->json (exit-code->number (deref code))))
               (pair (str "meaning")
                     (text->json (exit-code->meaning (deref code)))))))

(type refusal->json
  (fn ((ref refusal-description)) json))

(defn refusal->json (description)
  (object (vec (pair (str "code")
                     (text->json (as-str (:code description))))
               (pair (str "meaning")
                     (text->json (as-str (:meaning description)))))))
