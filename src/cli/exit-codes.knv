(module
  "Names each exit code of the CLI and what it means.")

(export exit-code exit-code->meaning exit-code->number
        exit-codes)

(defenum exit-code
  done
  refused
  usage
  database)

(defn exit-codes ()
  (vec exit-code/done exit-code/refused exit-code/usage
       exit-code/database))

(defn exit-code->number (code)
  (match code
    (done 0)
    (refused 1)
    (usage 2)
    (database 3)))

(defn exit-code->meaning (code)
  (match code
    (done "The command ran.")
    (refused
      "The ledger refused the command. The error holds a code and a message.")
    (usage "The call is incomplete. The error has the code usage when the arguments match no command, no-repository when no --db was given outside a git repository, or no-ledger when no ledger exists at the path yet.")
    (database "The database could not be opened, read or written. The error has the code busy when the wait for the lock timed out, otherwise database.")))
