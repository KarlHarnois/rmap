(module
  "Describes in plain text the next actions: one line per action, with its actor, the session that holds the item, and the item or decision.")

(use ledger/api action-names actor-names case-name
                next-entry report-id)

(use cli/tables table)

(export next-text)

(defn next-text (items)
  (if (empty? items)
    (str "Nothing to do.")
    (table (action-rows items))))

(type action-rows
  (fn ((ref (vec next-entry)))
    (vec (vec string))))

(defn action-rows (items)
  (let (rows (vec))
    (for-each items
      (fn (entry)
        (for-each (entry-rows entry)
          (fn (cells) (push! rows (clone cells))))))
    rows))

(defn entry-rows (entry)
  (match entry
    ((next-entry/listed-item item) (item-rows item))
    ((next-entry/listed-decision decision)
     (decision-rows decision))))

(defn item-rows (entry)
  (collect (map (iter (:actions entry))
             (fn (planned)
               (action-cells planned
                             (clone (:value (:id (:item entry))))
                             (clone (:title (:item entry))))))))

(defn decision-rows (entry)
  (collect (map (iter (:actions entry))
             (fn (planned)
               (action-cells planned
                             (clone (:value (:decision entry)))
                             (clone (:title entry)))))))

(defn action-cells (planned id title)
  (vec (action-text planned)
       (str (case-name actor-names (:actor planned)))
       (session-text (ref (:session planned)))
       id title))

(defn action-text (planned)
  (str (case-name action-names (:action planned))
       (report-suffix (ref (:report planned)))))

(type report-suffix
  (fn ((ref (option report-id))) string))

(defn report-suffix (report)
  (match report
    ((some id) (str " (report " (:value id) ")"))
    (none (str ""))))

(defn session-text (session)
  (match session
    ((some present) (clone (:name present)))
    (none (str "-"))))
