(module
  "Describes in plain text the next actions: one line per action, with its actor, the session that holds the item, and the item.")

(use ledger/api action-names actor-names case-name
                next-action next-item report-id session)

(use cli/tables table)

(export next-text)

(defn next-text (items)
  (if (empty? items)
    (str "Nothing to do.")
    (table (action-rows items))))

(type action-rows
  (fn ((ref (vec next-item)))
    (vec (vec string))))

(defn action-rows (items)
  (let (rows (vec))
    (for-each items
      (fn (entry)
        (for-each (:actions entry)
          (fn (planned)
            (push! rows (action-cells entry planned))))))
    rows))

(type action-cells
  (fn ((ref next-item) (ref next-action))
    (vec string)))

(defn action-cells (entry planned)
  (vec (action-text planned)
       (str (case-name actor-names (:actor planned)))
       (session-text (ref (:session planned)))
       (clone (:value (:id (:item entry))))
       (clone (:title (:item entry)))))

(defn action-text (planned)
  (str (case-name action-names (:action planned))
       (report-suffix (ref (:report planned)))))

(type report-suffix
  (fn ((ref (option report-id))) string))

(defn report-suffix (report)
  (match report
    ((some id) (str " (report " (:value id) ")"))
    (none (str ""))))

(type session-text
  (fn ((ref (option session))) string))

(defn session-text (session)
  (match session
    ((some present) (clone (:name present)))
    (none (str "-"))))
