(module
  "Describes items in plain text: a sentence about one item and a table of items.")

(use ledger/api case-name item item-id kind-names
                status-names)

(use cli/tables headed table)

(export item-added-text item-edited-text item-moved-text
        item-table items-text optional-id-text)

(defn items-text (items)
  (if (empty? items)
    (str "No items.")
    (item-table items)))

(type item-table
  (fn ((ref (vec item))) string))

(defn item-table (items)
  (let (rows (headed (vec "ID" "ROADMAP" "KIND" "STATUS" "PRIORITY" "TITLE")))
    (for-each items
      (fn (item)
        (push! rows (item-cells item))))
    (table rows)))

(type item-added-text
  (fn ((ref item)) string))

(defn item-added-text (item)
  (str "Added "
       (:value (:id item))
       " ("
       (case-name kind-names (:kind item))
       "): "
       (:title item)))

(type item-edited-text
  (fn ((ref item)) string))

(defn item-edited-text (item)
  (str "Edited "
       (:value (:id item))
       ": "
       (:title item)))

(type item-moved-text
  (fn ((ref item)) string))

(defn item-moved-text (item)
  (str (:value (:id item))
       " is now "
       (case-name status-names (:status item))
       ": "
       (:title item)))

(type optional-id-text
  (fn ((ref (option item-id))) string))

(defn optional-id-text (id)
  (match id
    ((some present) (clone (:value present)))
    (none (str "-"))))

(type item-cells
  (fn ((ref item)) (vec string)))

(defn item-cells (item)
  (vec (clone (:value (:id item)))
       (clone (:roadmap-name item))
       (str (case-name kind-names (:kind item)))
       (str (case-name status-names (:status item)))
       (str (:priority item))
       (clone (:title item))))
