(module
  "Lists the commands that work on roadmaps and their items.")

(use ledger/api graph-format-names graph-level-names
                kind-names origin-names status-names)

(use cli/flag-specs boolean-flag choices optional required)
(use cli/routes ->route operands subcommand words)

(export item-routes)

(defn item-routes ()
  (vec (->route :subcommand subcommand/help
                :words (words "help")
                :summary (str "Prints this help.")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/init
                :words (words "init")
                :summary (str "Creates the ledger for this repository, as ledger.db in its git directory. Pass --db to keep it elsewhere, and pass the same --db to every command.")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/new
                :words (words "new")
                :summary (str "Creates a roadmap that a manager session runs.")
                :operands (operands (vec "name"))
                :flags (vec (required "manager" "<session>")))
       (->route :subcommand subcommand/list
                :words (words "list")
                :summary (str "Lists the roadmaps.")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/ready
                :words (words "ready")
                :summary (str "Lists the items that can start, and what holds back the others. With --limit, picks up to that many ready items.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (optional "limit" "<whole number, at least 1>")))
       (->route :subcommand subcommand/next
                :words (words "next")
                :summary (str "Lists the next action for each open item and proposed decision, and who takes it: an agent asks an unanswered decision, the user answers an asked one, and a rejected decision that holds an item sends it back for a replan. A manager with no roadmaps gives an empty list, not an error.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (optional "manager" "<session>")))
       (->route :subcommand subcommand/log
                :words (words "log")
                :summary (str "Prints the events, for one item, for one decision or after one event id when given.")
                :operands (vec)
                :flags (vec (optional "item" "<id>")
                            (optional "decision" "<id>")
                            (optional "since" "<event id>")))
       (->route :subcommand subcommand/item-add
                :words (words "item add")
                :summary (str "Adds an item to a roadmap. Every item needs a description and at least one acceptance criterion, for example \"WHEN I run item show, rmap SHALL print the acceptance criteria.\" Repeat --criterion for each one, or read one per non-blank line from --criteria-file.")
                :operands (vec)
                :flags (vec (required "roadmap" "<name>")
                            (required "title" "<text>")
                            (optional "description" "<text>")
                            (optional "description-file" "<path|->")
                            (optional "criterion" "<text>")
                            (optional "criteria-file" "<path|->")
                            (required "kind" (choices kind-names))
                            (optional "parent" "<epic id>")
                            (optional "after" "<ids, comma-separated>")
                            (optional "from" "<id>")
                            (optional "origin" (choices origin-names))
                            (optional
                              "priority"
                              "<0 (highest) to 4 (lowest), default 2>")))
       (->route :subcommand subcommand/item-list
                :words (words "item list")
                :summary (str "Lists the items.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")))
       (->route :subcommand subcommand/item-show
                :words (words "item show")
                :summary (str "Shows one item with its dependencies.")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/item-edit
                :words (words "item edit")
                :summary (str "Changes an item's title, priority, description or acceptance criteria. Give at least one of the flags. --criterion and --criteria-file replace the whole list. A finished item takes only a description or criteria change.")
                :operands (operands (vec "id"))
                :flags (vec (optional "title" "<text>")
                            (optional "priority" "<0 (highest) to 4 (lowest)>")
                            (optional "description" "<text>")
                            (optional "description-file" "<path|->")
                            (optional "criterion" "<text>")
                            (optional "criteria-file" "<path|->")))
       (->route :subcommand subcommand/item-verify
                :words (words "item verify")
                :summary (str "Records a reviewer session's verdict on one acceptance criterion: --met or --failed, by a live review session of the item that is not the item's work or fix session and not the roadmap's manager. A build needs --head, the pull request's current head. The latest verdict on each criterion counts, and a verdict on an older head stops counting when the head moves.")
                :operands (operands (vec "id" "position"))
                :flags (vec (boolean-flag "met")
                            (boolean-flag "failed")
                            (required "reviewer" "<session>")
                            (optional "head" "<commit sha>")
                            (optional "note" "<text>")))
       (->route :subcommand subcommand/item-claim
                :words (words "item claim")
                :summary (str "Gives a ready item with at least one acceptance criterion to a new session and marks it dispatched. The branch defaults to the session name and the base to the repository's default branch.")
                :operands (operands (vec "id"))
                :flags (vec (required "session" "<name>")
                            (optional "branch" "<name>")
                            (optional "base" "<branch>")))
       (->route :subcommand subcommand/item-advance
                :words (words "item advance")
                :summary (str "Moves an item to another status. A research or design item reaches reported only through a done report, and a build reaches in_review only through a done or fixed report or pr head. A build moves to merging only when, among each reviewer's latest verdict on its pull request's head, one approves and none asks for changes, and every acceptance criterion has a met verdict on that head. It closes as merged only when those reviews still approve and every acceptance criterion still has a met verdict on that head.")
                :operands (vec (str "id") (choices status-names))
                :flags (vec (optional "kind" "build")))
       (->route :subcommand subcommand/item-close
                :words (words "item close")
                :summary (str "Marks a merging build merged once the reviews on its pull request's head still approve it and every acceptance criterion still has a met verdict on that head, or a reported research or design item accepted.")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/item-drop
                :words (words "item drop")
                :summary (str "Drops an item and records the reason.")
                :operands (operands (vec "id"))
                :flags (vec (required "reason" "<text>")))
       (->route :subcommand subcommand/dep-add
                :words (words "dep add")
                :summary (str "Makes an item come after another.")
                :operands (operands (vec "item" "on"))
                :flags (vec))
       (->route :subcommand subcommand/dep-rm
                :words (words "dep rm")
                :summary (str "Removes the dependency between two items.")
                :operands (operands (vec "item" "on"))
                :flags (vec))
       (->route :subcommand subcommand/graph
                :words (words "graph")
                :summary (str "Prints the roadmaps, their items and dependencies as a Mermaid flowchart. Merged items show only with --all. --level epic or roadmap draws one node per epic or roadmap.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (boolean-flag "all")
                            (optional "level" (choices graph-level-names))
                            (optional "format" (choices graph-format-names))))))
