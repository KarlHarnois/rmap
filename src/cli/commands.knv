(module
  "Lists each command the CLI accepts, and the boolean flags any of them takes.")

(use ledger/api graph-format-names graph-level-names
                kind-names origin-names status-names)

(use cli/flag-specs boolean-flag boolean? choices
                    global-flags optional required)

(use cli/routes ->route operands subcommand words)
(use cli/decision-commands decision-routes)
(use cli/lifecycle-commands lifecycle-routes)
(use cli/report-commands report-routes)

(export boolean-flag-names routes)

(defn boolean-flag-names ()
  (let (specs (global-flags))
    (for-each (routes)
      (fn (route)
        (for-each (:flags route)
          (fn (spec) (push! specs (clone spec))))))
    (collect (map (filter (iter specs)
                    (fn (spec) (boolean? spec)))
                  (fn (spec) (clone (:name spec)))))))

(defn routes ()
  (let (all (item-routes))
    (for-each (lifecycle-routes)
      (fn (route) (push! all (clone route))))
    (for-each (decision-routes)
      (fn (route) (push! all (clone route))))
    (for-each (report-routes)
      (fn (route) (push! all (clone route))))
    all))

(defn item-routes ()
  (vec (->route :subcommand subcommand/help
                :words (words "help")
                :summary (str "Prints this help.")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/init
                :words (words "init")
                :summary (str "Creates the ledger for this repository, as ledger.db in its git directory. Pass --db to keep it elsewhere, and pass the same --db to every command.")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/new
                :words (words "new")
                :summary (str "Creates a roadmap that a manager session runs.")
                :operands (operands (vec "name"))
                :flags (vec (required "manager" "<session>")))
       (->route :subcommand subcommand/list
                :words (words "list")
                :summary (str "Lists the roadmaps.")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/ready
                :words (words "ready")
                :summary (str "Lists the items that can start, and what holds back the others. With --limit, picks up to that many ready items.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (optional "limit" "<whole number, at least 1>")))
       (->route :subcommand subcommand/next
                :words (words "next")
                :summary (str "Lists the next action for each open item and who takes it. A manager with no roadmaps gives an empty list, not an error.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (optional "manager" "<session>")))
       (->route :subcommand subcommand/log
                :words (words "log")
                :summary (str "Prints the events, for one item, for one decision or after one event id when given.")
                :operands (vec)
                :flags (vec (optional "item" "<id>")
                            (optional "decision" "<id>")
                            (optional "since" "<event id>")))
       (->route :subcommand subcommand/item-add
                :words (words "item add")
                :summary (str "Adds an item to a roadmap.")
                :operands (vec)
                :flags (vec (required "roadmap" "<name>")
                            (required "title" "<text>")
                            (optional "description" "<text>")
                            (optional "description-file" "<path|->")
                            (required "kind" (choices kind-names))
                            (optional "parent" "<epic id>")
                            (optional "after" "<ids, comma-separated>")
                            (optional "from" "<id>")
                            (optional "origin" (choices origin-names))
                            (optional
                              "priority"
                              "<0 (highest) to 4 (lowest), default 2>")))
       (->route :subcommand subcommand/item-list
                :words (words "item list")
                :summary (str "Lists the items.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")))
       (->route :subcommand subcommand/item-show
                :words (words "item show")
                :summary (str "Shows one item with its dependencies.")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/item-edit
                :words (words "item edit")
                :summary (str "Changes an item's title, priority or description. Give at least one of the flags, and only while the item is open.")
                :operands (operands (vec "id"))
                :flags (vec (optional "title" "<text>")
                            (optional "priority" "<0 (highest) to 4 (lowest)>")
                            (optional "description" "<text>")
                            (optional "description-file" "<path|->")))
       (->route :subcommand subcommand/item-claim
                :words (words "item claim")
                :summary (str "Gives a ready item to a new session and marks it dispatched. The branch defaults to the session name and the base to the repository's default branch.")
                :operands (operands (vec "id"))
                :flags (vec (required "session" "<name>")
                            (optional "branch" "<name>")
                            (optional "base" "<branch>")))
       (->route :subcommand subcommand/item-advance
                :words (words "item advance")
                :summary (str "Moves an item to another status.")
                :operands (vec (str "id") (choices status-names))
                :flags (vec (optional "kind" "build")))
       (->route :subcommand subcommand/item-close
                :words (words "item close")
                :summary (str "Marks a build merged, or a reported research or design item accepted.")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/item-drop
                :words (words "item drop")
                :summary (str "Drops an item and records the reason.")
                :operands (operands (vec "id"))
                :flags (vec (required "reason" "<text>")))
       (->route :subcommand subcommand/dep-add
                :words (words "dep add")
                :summary (str "Makes an item come after another.")
                :operands (operands (vec "item" "on"))
                :flags (vec))
       (->route :subcommand subcommand/dep-rm
                :words (words "dep rm")
                :summary (str "Removes the dependency between two items.")
                :operands (operands (vec "item" "on"))
                :flags (vec))
       (->route :subcommand subcommand/graph
                :words (words "graph")
                :summary (str "Prints the roadmaps, their items and dependencies as a Mermaid flowchart. Merged items show only with --all. --level epic or roadmap draws one node per epic or roadmap.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (boolean-flag "all")
                            (optional "level" (choices graph-level-names))
                            (optional "format" (choices graph-format-names))))))
