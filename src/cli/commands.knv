(module
  "Lists each command the CLI accepts.")

(use cli/item-commands item-routes)
(use cli/decision-commands decision-routes)
(use cli/export-commands export-routes)
(use cli/lifecycle-commands lifecycle-routes)
(use cli/report-commands report-routes)
(use cli/pr-commands pr-routes)
(use cli/session-commands session-routes)

(export routes)

(defn routes ()
  (let (all (item-routes))
    (for-each (vec (lifecycle-routes)
                   (decision-routes)
                   (export-routes)
                   (report-routes)
                   (pr-routes)
                   (session-routes))
              (fn (group)
                (for-each group
                  (fn (route) (push! all (clone route))))))
    all))
