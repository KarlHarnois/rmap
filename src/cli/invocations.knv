(module
  "Parses the command line into an invocation: help, or a call to the ledger.")

(use ledger/api ->advancement ->item-id ->new-item
                ->session)

(use cli/routes subcommand)
(use cli/arguments operand split-arguments)
(use cli/route-matching check-shape route-of)
(use cli/flags optional-text)

(use cli/requests add-item-request advance-request
                  claim-request drop-request log-request
                  new-roadmap-request request text->id)

(export invocation ledger-call parse-invocation)

(defstruct ledger-call
  :database (option string)
  :actor (option string)
  :request request)

(defenum invocation
  help
  (on-ledger ledger-call))

(defn parse-invocation (args)
  (let-try (arguments (split-arguments args)
            route (route-of (ref arguments))
            _ (check-shape (ref arguments) (ref route)))
    (invocation-of (ref route) (ref arguments))))

(defn on-ledger (arguments requested)
  (map-ok requested
    (fn (request)
      (invocation/on-ledger (->ledger-call
                              :database (optional-text arguments "db")
                              :actor (optional-text arguments "actor")
                              :request request)))))

(defn invocation-of (route arguments)
  (match (:subcommand route)
    (subcommand/help (ok invocation/help))
    (subcommand/new
      (on-ledger arguments
                 (new-roadmap-request arguments (operand arguments route 0))))
    (subcommand/list (on-ledger arguments (ok request/list-roadmaps)))
    (subcommand/ready (on-ledger arguments
                                 (ok (request/ready
                                       (optional-text arguments "roadmap")))))
    (subcommand/log (on-ledger arguments (log-request arguments)))
    (subcommand/item-add (on-ledger arguments (add-item-request arguments)))
    (subcommand/item-list
      (on-ledger arguments
                 (ok (request/list-items (optional-text arguments "roadmap")))))
    (subcommand/item-show (on-ledger arguments
                                     (ok (request/show-item
                                           (text->id
                                             (operand arguments route 0))))))
    (subcommand/item-claim
      (on-ledger arguments
                 (claim-request arguments (operand arguments route 0))))
    (subcommand/item-advance (on-ledger arguments
                                        (advance-request
                                          arguments
                                          (operand arguments route 0)
                                          (operand arguments route 1))))
    (subcommand/item-close
      (on-ledger arguments
                 (ok (request/close (text->id (operand arguments route 0))))))
    (subcommand/item-drop
      (on-ledger arguments
                 (drop-request arguments (operand arguments route 0))))
    (subcommand/dep-add
      (on-ledger arguments
                 (ok (request/add-dep (text->id (operand arguments route 0))
                                      (text->id (operand arguments route 1))))))
    (subcommand/dep-rm (on-ledger arguments
                                  (ok (request/remove-dep
                                        (text->id (operand arguments route 0))
                                        (text->id
                                          (operand arguments route 1))))))))
