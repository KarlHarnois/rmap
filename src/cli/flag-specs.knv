(module
  "Describes a flag a command takes: its name, whether it is required, and a placeholder for its value.")

(export choices flag-spec global-flags optional presence
        required required?)

(defenum presence
  required
  optional)

(defstruct flag-spec
  :name string
  :presence presence
  :placeholder string)

(defn required (name value)
  (->flag-spec :name (str name)
               :presence presence/required
               :placeholder (str value)))

(defn optional (name value)
  (->flag-spec :name (str name)
               :presence presence/optional
               :placeholder (str value)))

(defn required? (spec)
  (= (:presence spec) presence/required))

(type choices
  (where ((a copy))
    (fn ((ref (vec (pair a (ref str)))))
      string)))

(defn choices (names)
  (join (collect (map (iter names)
                   (fn (entry)
                     (let-match ((pair _ name) (deref entry))
                       name))))
        "|"))

(defn global-flags ()
  (vec (optional "db" "<path>") (optional "actor" "<name>")))
