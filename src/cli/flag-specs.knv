(module
  "Describes a flag a command takes: its name, whether it is required, and whether it takes a value.")

(export boolean-flag boolean? choices flag-input flag-spec
        global-flags help-flag json-flag optional presence
        required required?)

(def json-flag "json")

(def help-flag "help")

(defstruct flag-spec
  :name string
  :presence presence
  :input flag-input)

(defenum presence
  required
  optional)

(defenum flag-input
  (value string)
  boolean)

(defn required (name placeholder)
  (->flag-spec :name (str name)
               :presence presence/required
               :input (flag-input/value (str placeholder))))

(defn required? (spec)
  (= (:presence spec) presence/required))

(defn boolean? (spec)
  (= (:input spec) flag-input/boolean))

(type choices
  (where ((a copy))
    (fn ((ref (vec (pair a (ref str)))))
      string)))

(defn choices (names)
  (join (collect (map (iter names)
                   (fn (entry)
                     (let-match ((pair _ name) (deref entry))
                       name))))
        "|"))

(defn global-flags ()
  (vec (optional "db" "<path>")
       (optional "actor" "<name>")
       (boolean-flag json-flag)
       (boolean-flag help-flag)))

(defn optional (name placeholder)
  (->flag-spec :name (str name)
               :presence presence/optional
               :input (flag-input/value (str placeholder))))

(defn boolean-flag (name)
  (->flag-spec :name (str name)
               :presence presence/optional
               :input flag-input/boolean))
