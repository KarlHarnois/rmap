(module
  "Calls the ledger for each decision request and names the reply it gives.")

(use ledger/api accept-decision add-decision-block
                ask-decision deprecate-decision
                list-decisions propose-decision reject-decision
                remove-decision-block revise-decision
                show-decision)

(use cli/decision-requests decision-request)
(use cli/replies reply)

(export perform-decision)

(defn perform-decision (settings request)
  (match request
    ((decision-request/propose draft)
     (map-ok (propose-decision settings draft)
       (fn (decision) (reply/decision-proposed decision))))
    ((decision-request/revise revision)
     (map-ok (revise-decision settings revision)
       (fn (decision) (reply/decision-revised decision))))
    ((decision-request/show id)
     (map-ok (show-decision settings id)
       (fn (decision) (reply/decision-shown decision))))
    ((decision-request/list query)
     (map-ok (list-decisions settings query)
       (fn (decisions) (reply/decisions-listed decisions))))
    ((decision-request/ask id)
     (map-ok (ask-decision settings id)
       (fn (decision) (reply/decision-asked decision))))
    ((decision-request/accept id acceptance)
     (map-ok (accept-decision settings id acceptance)
       (fn (decision) (reply/decision-accepted decision))))
    ((decision-request/reject id reason)
     (map-ok (reject-decision settings id reason)
       (fn (decision) (reply/decision-rejected decision))))
    ((decision-request/deprecate id reason)
     (map-ok (deprecate-decision settings id reason)
       (fn (decision) (reply/decision-deprecated decision))))
    ((decision-request/block id item)
     (map-ok (add-decision-block settings (clone id) (clone item))
       (fn (decision) (reply/decision-shown decision))))
    ((decision-request/unblock id item)
     (map-ok (remove-decision-block settings (clone id) (clone item))
       (fn (decision) (reply/decision-shown decision))))))
