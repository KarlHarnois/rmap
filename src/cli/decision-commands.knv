(module
  "Lists the commands that record and read decisions.")

(use ledger/api decision-status-names)
(use cli/proposal-json proposal-document-shape)
(use cli/flag-specs boolean-flag choices optional required)
(use cli/routes ->route operands subcommand words)

(export decision-routes route-document)

(defn decision-routes ()
  (vec (->route :subcommand subcommand/decision-propose
                :words (words "decision propose")
                :summary (str "Proposes a decision for the owner to settle, read from the JSON document in --file (- reads stdin). It needs at least 2 options. description, pros and cons may be left out, and keys the document shape does not list are ignored. --item names the item that raised it, --blocks the open items or unfinished epics of its roadmap that wait on it, --supersedes the decision it would replace: accepted, or rejected in the same roadmap.")
                :operands (vec)
                :flags (vec (required "roadmap" "<name>")
                            (required "file" "<path|->")
                            (optional "item" "<id>")
                            (optional "blocks" "<ids, comma-separated>")
                            (optional "supersedes" "<decision id>")))
       (->route :subcommand subcommand/decision-revise
                :words (words "decision revise")
                :summary (str "Replaces the title, context, options and recommendation of a proposed decision with the JSON document in --file (- reads stdin), the same shape propose takes, and clears when it was asked. The output of `decision show --json` is accepted as is. --supersedes retargets the decision it would replace, under the same rule, and --no-supersedes removes the link. The two flags cannot be given together.")
                :operands (operands (vec "id"))
                :flags (vec (required "file" "<path|->")
                            (optional "supersedes" "<decision id>")
                            (boolean-flag "no-supersedes")))
       (->route :subcommand subcommand/decision-show
                :words (words "decision show")
                :summary (str "Shows one decision with its options, recommendation and outcome.")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/decision-list
                :words (words "decision list")
                :summary (str "Lists the decisions in every status, oldest first. --item keeps those the item raised or that block it.")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (optional "status" (choices decision-status-names))
                            (optional "item" "<id>")))
       (->route :subcommand subcommand/decision-ask
                :words (words "decision ask")
                :summary (str "Puts a proposed decision to the owner. It needs at least 2 options and can be asked once, until a revision clears the ask.")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/decision-accept
                :words (words "decision accept")
                :summary (str "Accepts a proposed decision with one of its options and records who decided and why. When the decision supersedes another, that one becomes superseded in the same call.")
                :operands (operands (vec "id"))
                :flags (vec (required "option" "<number>")
                            (required "justification" "<text>")
                            (required "consequences" "<text>")))
       (->route :subcommand subcommand/decision-reject
                :words (words "decision reject")
                :summary (str "Rejects a proposed decision and records the reason.")
                :operands (operands (vec "id"))
                :flags (vec (required "reason" "<text>")))
       (->route :subcommand subcommand/decision-deprecate
                :words (words "decision deprecate")
                :summary (str "Deprecates an accepted decision and records the reason.")
                :operands (operands (vec "id"))
                :flags (vec (required "reason" "<text>")))
       (->route :subcommand subcommand/decision-block
                :words (words "decision block")
                :summary (str "Makes a proposed decision hold an open item or an unfinished epic of its roadmap; an epic holds all its open children, including ones added later.")
                :operands (operands (vec "id" "item"))
                :flags (vec))
       (->route :subcommand subcommand/decision-unblock
                :words (words "decision unblock")
                :summary (str "Removes an item from what a decision blocks, in any decision status.")
                :operands (operands (vec "id" "item"))
                :flags (vec))))

(defn route-document (route)
  (match (:subcommand route)
    (subcommand/decision-propose (some (proposal-document-shape)))
    (subcommand/decision-revise (some (proposal-document-shape)))
    (_ none)))
