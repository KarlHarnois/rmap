(module
  "Maps a route and its arguments to the invocation the CLI runs.")

(use cli/invocation invocation)
(use cli/decision-invocations decision-invocation-of)
(use cli/proposal-document-call proposal-add-document-call)
(use cli/route-ledger on-ledger)
(use cli/routes subcommand)
(use cli/arguments operand)
(use cli/flags optional-text)

(use cli/requests add-item-request advance-request
                  claim-request drop-request
                  edit-item-request graph-request
                  log-request new-roadmap-request
                  ready-request request text->id)

(use cli/max-active-requests roadmap-settings-request)

(use cli/external-blocker-requests block-item-request
                                   unblock-item-request)

(use cli/next-request next-request)
(use cli/verify-request verify-request-of)

(use cli/operation-invocations pr-invocation
                               report-invocation
                               review-start-invocation
                               session-invocation)

(export invocation-of)

(defn invocation-of (route arguments)
  (match (:subcommand route)
    (subcommand/help (ok invocation/help))
    (subcommand/init (on-ledger arguments (ok request/init)))
    (subcommand/new
      (on-ledger arguments
                 (new-roadmap-request arguments (operand arguments route 0))))
    (subcommand/list (on-ledger arguments (ok request/list-roadmaps)))
    (subcommand/pause (on-ledger arguments
                                 (ok (request/pause
                                       (operand arguments route 0)))))
    (subcommand/resume (on-ledger arguments
                                  (ok (request/resume
                                        (operand arguments route 0)))))
    (subcommand/roadmap-set (on-ledger arguments
                                       (roadmap-settings-request
                                         arguments
                                         (operand arguments route 0))))
    (subcommand/ready (on-ledger arguments (ready-request arguments)))
    (subcommand/next (on-ledger arguments (next-request arguments)))
    (subcommand/log (on-ledger arguments (log-request arguments)))
    (subcommand/item-add (on-ledger arguments (add-item-request arguments)))
    (subcommand/item-list
      (on-ledger arguments
                 (ok (request/list-items (optional-text arguments "roadmap")))))
    (subcommand/item-show (on-ledger arguments
                                     (ok (request/show-item
                                           (text->id
                                             (operand arguments route 0))))))
    (subcommand/item-edit
      (on-ledger arguments
                 (edit-item-request arguments (operand arguments route 0))))
    (subcommand/item-block
      (on-ledger arguments
                 (block-item-request arguments (operand arguments route 0))))
    (subcommand/item-unblock
      (on-ledger arguments
                 (unblock-item-request arguments (operand arguments route 0))))
    (subcommand/item-verify (on-ledger arguments
                                       (verify-request-of
                                         arguments
                                         (operand arguments route 0)
                                         (operand arguments route 1))))
    (subcommand/item-claim
      (on-ledger arguments
                 (claim-request arguments (operand arguments route 0))))
    (subcommand/item-advance (on-ledger arguments
                                        (advance-request
                                          arguments
                                          (operand arguments route 0)
                                          (operand arguments route 1))))
    (subcommand/item-close
      (on-ledger arguments
                 (ok (request/close (text->id (operand arguments route 0))))))
    (subcommand/item-drop
      (on-ledger arguments
                 (drop-request arguments (operand arguments route 0))))
    (subcommand/dep-add
      (on-ledger arguments
                 (ok (request/add-dep (text->id (operand arguments route 0))
                                      (text->id (operand arguments route 1))))))
    (subcommand/graph (on-ledger arguments (graph-request arguments)))
    (subcommand/export (on-ledger arguments (ok request/export)))
    (subcommand/dep-rm (on-ledger arguments
                                  (ok (request/remove-dep
                                        (text->id (operand arguments route 0))
                                        (text->id
                                          (operand arguments route 1))))))
    (subcommand/proposal-add
      (map-ok (proposal-add-document-call arguments
                                          (operand arguments route 0))
              (fn (call) (invocation/on-proposal-document call))))
    (subcommand/proposal-list (on-ledger
                                arguments
                                (ok (request/proposal-list
                                      (text->id (operand arguments route 0))))))
    (subcommand/decision-propose (decision-invocation-of route arguments))
    (subcommand/decision-revise (decision-invocation-of route arguments))
    (subcommand/decision-show (decision-invocation-of route arguments))
    (subcommand/decision-list (decision-invocation-of route arguments))
    (subcommand/decision-ask (decision-invocation-of route arguments))
    (subcommand/decision-accept (decision-invocation-of route arguments))
    (subcommand/decision-reject (decision-invocation-of route arguments))
    (subcommand/decision-deprecate (decision-invocation-of route arguments))
    (subcommand/decision-block (decision-invocation-of route arguments))
    (subcommand/decision-unblock (decision-invocation-of route arguments))
    ((subcommand/report command)
     (report-invocation arguments route command))
    (subcommand/review-start (review-start-invocation arguments route))
    ((subcommand/pull-request command)
     (pr-invocation arguments route command))
    ((subcommand/session command)
     (session-invocation arguments route command))))
