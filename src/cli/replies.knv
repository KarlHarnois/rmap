(module
  "Names each result a ledger call hands back to the CLI.")

(use ledger/api batch decision dep event graph-source
                init-report item item-detail next-item
                readiness roadmap)

(use cli/report-replies report-reply)

(export reply)

(defenum reply
  (ledger-initialized init-report)
  (roadmap-created roadmap)
  (roadmap-status-changed roadmap)
  (roadmaps-listed (vec roadmap))
  (readiness-checked readiness)
  (next-listed (vec next-item))
  (batch-picked batch)
  (log-read (vec event))
  (item-added item)
  (item-edited item)
  (item-moved item)
  (items-listed (vec item))
  (item-shown item-detail)
  (dep-added dep)
  (dep-removed dep)
  (graph-drawn graph-source)
  (decision-proposed decision)
  (decision-revised decision)
  (decision-shown decision)
  (decisions-listed (vec decision))
  (reported report-reply))
