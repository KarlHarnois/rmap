(module
  "Names each result a ledger call hands back to the CLI.")

(use ledger/api batch cap-result criterion-verdict decision
                dep ended-session event follow-up
                graph-source init-report item item-detail
                item-id ledger-export next-entry readiness
                roadmap)

(use cli/report-replies report-reply)
(use cli/pr-replies pr-reply)

(export reply)

(defenum reply
  (ledger-initialized init-report)
  (roadmap-created roadmap)
  (roadmap-status-changed roadmap)
  (roadmap-max-active-changed cap-result)
  (roadmaps-listed (vec roadmap))
  (readiness-checked readiness)
  (next-listed (vec next-entry))
  (batch-picked batch)
  (log-read (vec event))
  (item-added item)
  (item-edited item)
  (item-moved item)
  (criterion-verified criterion-verdict)
  (items-listed (vec item))
  (item-shown item-detail)
  (dep-added dep)
  (dep-removed dep)
  (graph-drawn graph-source)
  (exported ledger-export)
  (proposals-recorded item-id (vec follow-up))
  (proposals-listed item-id (vec follow-up))
  (decision-proposed decision)
  (decision-revised decision)
  (decision-shown decision)
  (decisions-listed (vec decision))
  (decision-asked decision)
  (decision-accepted decision)
  (decision-rejected decision)
  (decision-deprecated decision)
  (reported report-reply)
  (pull-request pr-reply)
  (session-ended ended-session))
