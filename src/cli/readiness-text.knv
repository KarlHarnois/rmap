(module
  "Describes in plain text which items are ready and what holds back the others.")

(use ledger/api blocked-item decision-id exclusive-hold
                item-id roadmap-pause)

(use cli/tables indented)
(use cli/item-text item-table)

(export blockage-lines blocked-section readiness-text)

(defn readiness-text (readiness)
  (let (sections (vec (ready-section (ref (:ready readiness)))))
    (when (not (empty? (:blocked readiness)))
      (push! sections
             (blocked-section (ref (:blocked readiness)))))
    (join sections "\n\n")))

(defn blocked-section (blocked)
  (str "Blocked:\n"
       (indented (join (collect (map (iter blocked) blocked-text))
                       "\n"))))

(defn blockage-lines (blockage)
  (let (lines (vec))
    (when (= (:pause blockage) roadmap-pause/paused)
      (push! lines (str "paused")))
    (when (not (empty? (:blockers blockage)))
      (push! lines
             (str "waits on "
                  (ids-text (ref (:blockers blockage))))))
    (when (not (empty? (:dropped-blockers blockage)))
      (push! lines
             (str "waits on dropped "
                  (ids-text (ref (:dropped-blockers blockage))))))
    (when (not (empty? (:decisions blockage)))
      (push! lines
             (str "waits on decisions "
                  (decision-ids-text (ref (:decisions blockage))))))
    (for-each (exclusive-lines (:exclusive blockage))
      (fn (line) (push! lines (clone line))))
    (for-each (:external-blockers blockage)
      (fn (blocker)
        (push! lines
               (str "waits on external "
                    (:value (:id blocker))
                    ": "
                    (:text blocker)))))
    (for-each (capacity-lines (:capacity blockage))
      (fn (line) (push! lines (clone line))))
    lines))

(defn exclusive-lines (hold)
  (match hold
    ((some present) (vec (exclusive-line present)))
    (none (vec))))

(defn exclusive-line (hold)
  (match hold
    ((exclusive-hold/held-by item)
     (str "waits for exclusive "
          (:value (:id item))
          " in "
          (:roadmap-name item)))
    ((exclusive-hold/waits-on item ids)
     (str "exclusive "
          (:value (:id item))
          " waits for in-progress "
          (ids-text (ref ids))))))

(defn capacity-lines (capacity)
  (match capacity
    ((some present)
     (vec (str "at capacity: "
               (:active present)
               " of "
               (:max-active present)
               " active")))
    (none (vec))))

(defn ready-section (items)
  (if (empty? items)
    (str "Nothing is ready.")
    (str "Ready:\n" (indented (item-table items)))))

(type blocked-text
  (fn ((ref blocked-item)) string))

(defn blocked-text (blocked)
  (let (item (ref (:item blocked)))
    (str (:value (:id item))
         "  "
         (:title item)
         "\n"
         (indented (join (blockage-lines (ref (:blockage blocked)))
                         "\n")))))

(type decision-ids-text
  (fn ((ref (vec decision-id))) string))

(defn decision-ids-text (ids)
  (join (collect (map (iter ids)
                   (fn (id) (clone (:value id)))))
        ", "))

(type ids-text
  (fn ((ref (vec item-id))) string))

(defn ids-text (ids)
  (join (collect (map (iter ids)
                   (fn (id) (clone (:value id)))))
        ", "))
