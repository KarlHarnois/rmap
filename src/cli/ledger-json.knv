(module
  "Turns ledger values into the JSON objects the CLI prints.")

(use json/value array copy-of int->json json object
                optional-int->json text->json)

(use cli/session-json claim->json claim->session-json)

(use ledger/api case-name dep dep-type-names event
                event-type-names item kind-names
                optional-decision-id->json optional-id->json
                optional-text->json origin-names roadmap
                roadmap-status-names status-names)

(use cli/blockage-json blockage-fields)

(export blocked->json dep->json event->json item->json
        item-fields item-id->json roadmap->json)

(type roadmap->json
  (fn ((ref roadmap)) json))

(defn roadmap->json (roadmap)
  (object (vec (pair (str "id")
                     (roadmap-id->json (ref (:id roadmap))))
               (pair (str "name")
                     (text->json (as-str (:name roadmap))))
               (pair (str "manager")
                     (text->json (as-str (:name (:manager roadmap)))))
               (pair (str "status")
                     (text->json (case-name roadmap-status-names
                                            (:status roadmap))))
               (pair (str "max_active")
                     (optional-int->json (clone (:max-active roadmap))))
               (pair (str "created_at")
                     (timestamp->json (ref (:created-at roadmap)))))))

(type event->json
  (fn ((ref event)) json))

(defn event->json (event)
  (object (vec (pair (str "id")
                     (int->json (:id event)))
               (pair (str "at")
                     (timestamp->json (ref (:at event))))
               (pair (str "actor")
                     (text->json (as-str (:actor event))))
               (pair (str "roadmap_id")
                     (optional-roadmap-id->json (ref (:roadmap-id event))))
               (pair (str "item_id")
                     (optional-id->json (ref (:item-id event))))
               (pair (str "decision_id")
                     (optional-decision-id->json (ref (:decision-id event))))
               (pair (str "type")
                     (text->json (case-name event-type-names (:type event))))
               (pair (str "payload")
                     (copy-of (ref (:payload event)))))))

(type dep->json (fn ((ref dep)) json))

(defn dep->json (dep)
  (object (vec (pair (str "item")
                     (item-id->json (ref (:item dep))))
               (pair (str "on")
                     (item-id->json (ref (:on dep))))
               (pair (str "type")
                     (text->json (case-name dep-type-names (:type dep)))))))

(defn blocked->json (blocked)
  (let (fields (blockage-fields (ref (:blockage blocked))))
    (push! fields
           (pair (str "item")
                 (item->json (ref (:item blocked)))))
    (object fields)))

(defn item->json (item)
  (let (fields (item-fields item))
    (push! fields
           (pair (str "criteria")
                 (array (collect (map (iter (:criteria item)) text->json)))))
    (push! fields
           (pair (str "session")
                 (claim->session-json (ref (:claim item)))))
    (object fields)))

(type item-fields
  (fn ((ref item))
    (vec (pair string json))))

(defn item-fields (item)
  (vec (pair (str "id")
             (item-id->json (ref (:id item))))
       (pair (str "roadmap_id")
             (roadmap-id->json (ref (:roadmap-id item))))
       (pair (str "roadmap")
             (text->json (as-str (:roadmap-name item))))
       (pair (str "parent_id")
             (optional-id->json (ref (:parent item))))
       (pair (str "title")
             (text->json (as-str (:title item))))
       (pair (str "description")
             (optional-text->json (ref (:description item))))
       (pair (str "kind")
             (text->json (case-name kind-names (:kind item))))
       (pair (str "status")
             (text->json (case-name status-names (:status item))))
       (pair (str "origin")
             (text->json (case-name origin-names (:origin item))))
       (pair (str "priority")
             (int->json (:priority item)))
       (pair (str "claimed_by")
             (claim->json (ref (:claim item))))
       (pair (str "created_at")
             (timestamp->json (ref (:created-at item))))
       (pair (str "closed_at")
             (optional-timestamp->json (ref (:closed-at item))))))

(defn item-id->json (id)
  (text->json (as-str (:value id))))

(defn optional-roadmap-id->json (id)
  (match id
    ((some present) (roadmap-id->json present))
    (none json/null)))

(defn roadmap-id->json (id)
  (text->json (as-str (:value id))))

(defn optional-timestamp->json (at)
  (match at
    ((some present) (timestamp->json present))
    (none json/null)))

(defn timestamp->json (at)
  (text->json (as-str (:value at))))
