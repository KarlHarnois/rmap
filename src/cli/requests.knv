(module
  "Names each ledger request the CLI can make and builds it from the command line.")

(use ledger/api ->advancement ->claim-request
                ->graph-request ->item-id ->log-query
                ->session ->verify-request actor advancement
                batch-size batch-size-of case-named
                claim-request end-reason follow-up-draft
                graph-format graph-format-names graph-level
                graph-level-names graph-request history
                item-edit item-id kind-change log-query
                new-item session status-names
                verify-request)

(use cli/item-flags item-edit-of new-item-of)
(use cli/report-requests report-operation)
(use cli/pr-requests pr-operation)

(use cli/decision-requests decision-request
                           text->decision-id)

(use cli/flags optional-choice optional-number optional-text
               required-text switch-on?)

(export add-item-request advance-request claim-request
        drop-request edit-item-request graph-request
        log-request new-roadmap-request ready-request
        request text->id)

(defenum request
  init
  (new-roadmap string session)
  list-roadmaps
  (pause string)
  (resume string)
  (set-max-active string (option int))
  (ready (option string))
  (next (option string)
        (option session)
        (option actor))
  (ready-batch (option string) batch-size)
  (log log-query)
  (add-item string new-item)
  (list-items (option string))
  (show-item item-id)
  (edit-item item-id item-edit)
  (block-item item-id string)
  (unblock-item item-id string (option string))
  (claim item-id claim-request)
  (advance item-id advancement)
  (close item-id)
  (verify verify-request)
  (drop item-id string)
  (add-dep item-id item-id)
  (remove-dep item-id item-id)
  (graph graph-request)
  export
  (decision decision-request)
  (proposal-add item-id session (vec follow-up-draft))
  (proposal-list item-id)
  (report report-operation)
  (pull-request pr-operation)
  (end-session session end-reason))

(defn new-roadmap-request (arguments name)
  (let-try (manager (required-text arguments "manager"))
    (ok (request/new-roadmap name (->session :name manager)))))

(defn ready-request (arguments)
  (let-try (limit (optional-number arguments "limit"))
    (match limit
      ((some count) (batch-request arguments count))
      (none (ok (request/ready (optional-text arguments "roadmap")))))))

(defn log-request (arguments)
  (let-try (since (optional-number arguments "since"))
    (ok (request/log (->log-query
                       :item (map-some (optional-text arguments "item")
                                       text->id)
                       :decision (map-some (optional-text arguments "decision")
                                           text->decision-id)
                       :after-id (unwrap-or since 0))))))

(defn add-item-request (arguments)
  (let-try (roadmap (required-text arguments "roadmap")
            draft (new-item-of arguments))
    (ok (request/add-item roadmap draft))))

(defn edit-item-request (arguments id)
  (map-ok (item-edit-of arguments)
    (fn (edit)
      (request/edit-item (text->id id) edit))))

(defn graph-request (arguments)
  (let-try (format (optional-choice arguments "format" graph-format-names)
            level (optional-choice arguments "level" graph-level-names))
    (ok (request/graph (->graph-request
                         :roadmap (optional-text arguments "roadmap")
                         :history (history-of arguments)
                         :level (unwrap-or level graph-level/item)
                         :format (unwrap-or format graph-format/mermaid))))))

(defn claim-request (arguments id)
  (let-try (session (required-text arguments "session"))
    (ok (request/claim (text->id id)
                       (->claim-request
                         :session (->session :name session)
                         :branch (optional-text arguments "branch")
                         :base (optional-text arguments "base"))))))

(defn drop-request (arguments id)
  (let-try (reason (required-text arguments "reason"))
    (ok (request/drop (text->id id) reason))))

(defn advance-request (arguments id status-text)
  (let-try (target (ok-or (case-named status-names (as-str status-text))
                          (str "unknown status: " status-text))
            change (kind-change-of arguments))
    (ok (request/advance (text->id id)
                         (->advancement :to target :kind-change change)))))

(defn text->id (text) (->item-id :value text))

(defn batch-request (arguments count)
  (let-try (size (ok-or (batch-size-of count)
                        (str "--limit takes a whole number of at least 1, got "
                             count)))
    (ok (request/ready-batch (optional-text arguments "roadmap")
                             size))))

(defn history-of (arguments)
  (if (switch-on? arguments "all")
    history/with-merged history/without-merged))

(defn kind-change-of (arguments)
  (match (optional-text arguments "kind")
    ((some kind) (build-change (as-str kind)))
    (none (ok kind-change/keep-kind))))

(defn build-change (kind)
  (if (= kind "build")
    (ok kind-change/become-build)
    (err (str "--kind takes only build, got " kind))))
