(module
  "Names each ledger request the CLI can make and builds it from the command line.")

(use ledger/api ->advancement ->item-id ->new-item ->session
                advancement case-named item-id kind-change
                kind-names new-item origin origin-names
                session status-names)

(use cli/arguments flag required-flag)

(use cli/flags list-flag list-flag-globs named-flag
               optional-named-flag optional-number)

(export add-item-request advance-request claim-request
        drop-request log-request new-roadmap-request request
        text->id)

(defenum request
  (new-roadmap string session)
  list-roadmaps
  (ready (option string))
  (log (option item-id) int)
  (add-item string new-item)
  (list-items (option string))
  (show-item item-id)
  (claim item-id session)
  (advance item-id advancement)
  (close item-id)
  (drop item-id string)
  (add-dep item-id item-id)
  (remove-dep item-id item-id))

(defn new-roadmap-request (arguments name)
  (let-try (manager (required-flag arguments "manager"))
    (ok (request/new-roadmap name (->session :name manager)))))

(defn log-request (arguments)
  (let-try (since (optional-number arguments "since"))
    (ok (request/log (map-some (flag arguments "item") text->id)
                     (unwrap-or since 0)))))

(defn text->id (text) (->item-id :value text))

(defn add-item-request (arguments)
  (let-try (roadmap (required-flag arguments "roadmap")
            title (required-flag arguments "title")
            kind (named-flag arguments "kind" kind-names)
            origin (optional-named-flag arguments "origin" origin-names)
            priority (optional-number arguments "priority"))
    (ok (request/add-item
          roadmap
          (->new-item
            :parent (map-some (flag arguments "parent") text->id)
            :title title
            :kind kind
            :origin (unwrap-or origin origin/planned)
            :priority (unwrap-or priority 0)
            :globs (list-flag-globs arguments)
            :blocked-by (collect (map (iter (list-flag arguments "after"))
                                   (fn (text) (text->id (clone text)))))
            :discovered-from (map-some (flag arguments "from") text->id))))))

(defn claim-request (arguments id)
  (let-try (session (required-flag arguments "session"))
    (ok (request/claim (text->id id) (->session :name session)))))

(defn drop-request (arguments id)
  (let-try (reason (required-flag arguments "reason"))
    (ok (request/drop (text->id id) reason))))

(defn advance-request (arguments id status-text)
  (let-try (target (ok-or (case-named status-names (as-str status-text))
                          (str "unknown status: " status-text))
            change (kind-change-of arguments))
    (ok (request/advance (text->id id)
                         (->advancement :to target :kind-change change)))))

(defn kind-change-of (arguments)
  (match (flag arguments "kind")
    ((some kind) (build-change arguments (as-str kind)))
    (none (unchanged-kind arguments))))

(defn build-change (arguments kind)
  (if (= kind "build")
    (ok (kind-change/become-build (list-flag-globs arguments)))
    (err (str "--kind takes only build, got " kind))))

(defn unchanged-kind (arguments)
  (if (some? (flag arguments "paths"))
    (err (str "--paths needs --kind build"))
    (ok kind-change/keep-kind)))
