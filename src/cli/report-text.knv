(module
  "Describes reports in plain text: a sentence about a report recorded or read, a table of reports, and one report with its body.")

(use ledger/api case-name report report-kind-names
                status-names)

(use cli/report-replies report-reply)
(use cli/tables headed indented table)

(export report-reply->text)

(defn report-reply->text (reply)
  (match reply
    ((recorded recorded) (recorded-text (ref recorded)))
    ((listed reports) (reports-text (ref reports)))
    ((shown report) (report-detail-text (ref report)))
    ((read report) (read-text (ref report)))))

(defn recorded-text (recorded)
  (let (report (ref (:report recorded))
        item (ref (:item recorded)))
    (str "Recorded "
         (kind-text report)
         " report "
         (:value (:id report))
         " on "
         (:value (:id item))
         ", which is "
         (case-name status-names (:status item))
         ".")))

(defn reports-text (reports)
  (if (empty? reports)
    (str "No reports.")
    (report-table reports)))

(defn report-detail-text (report)
  (str "Report "
       (:value (:id report))
       "  "
       (kind-text report)
       " on "
       (:value (:item report))
       "\n"
       (indented (table (detail-rows report)))
       "\n\n"
       (:body report)))

(defn read-text (report)
  (str "Read report "
       (:value (:id report))
       " on "
       (:value (:item report))
       "."))

(type report-table
  (fn ((ref (vec report))) string))

(defn report-table (reports)
  (let (rows (headed (vec "ID" "ITEM" "SESSION" "KIND" "CREATED" "READ")))
    (for-each reports
      (fn (report)
        (push! rows (report-cells report))))
    (table rows)))

(type report-cells
  (fn ((ref report)) (vec string)))

(defn report-cells (report)
  (vec (str (:value (:id report)))
       (clone (:value (:item report)))
       (clone (:name (:session report)))
       (str (kind-text report))
       (clone (:value (:created-at report)))
       (read-at-text (ref (:read-at report)))))

(type detail-rows
  (fn ((ref report)) (vec (vec string))))

(defn detail-rows (report)
  (vec (vec (str "session")
            (clone (:name (:session report))))
       (vec (str "created")
            (clone (:value (:created-at report))))
       (vec (str "read")
            (read-at-text (ref (:read-at report))))))

(defn kind-text (report)
  (case-name report-kind-names (:kind report)))

(defn read-at-text (at)
  (match at
    ((some present) (clone (:value present)))
    (none (str "-"))))
