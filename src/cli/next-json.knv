(module
  "Turns the next entries for items and proposed decisions into the JSON objects `rmap next` prints.")

(use json/value array int->json json object text->json)

(use ledger/api action-names actor-names case-name
                decision-next decision-status-names
                kind-names next-entry next-item report-id
                session status-names)

(use cli/blockage-json blockage-fields)

(export next-entry->json)

(defn next-entry->json (entry)
  (match entry
    ((next-entry/listed-item item) (next-item->json item))
    ((next-entry/listed-decision decision)
     (decision-next->json decision))))

(type next-item->json
  (fn ((ref next-item)) json))

(defn next-item->json (entry)
  (let (item (ref (:item entry)))
    (object (vec (pair (str "item")
                       (text->json (as-str (:value (:id item)))))
                 (pair (str "roadmap")
                       (text->json (as-str (:name (:roadmap entry)))))
                 (pair (str "status")
                       (text->json (case-name status-names (:status item))))
                 (pair (str "kind")
                       (text->json (case-name kind-names (:kind item))))
                 (pair (str "title")
                       (text->json (as-str (:title item))))
                 (pair (str "actions")
                       (array (collect (map (iter (:actions entry))
                                            next-action->json))))))))

(type decision-next->json
  (fn ((ref decision-next)) json))

(defn decision-next->json (entry)
  (object (vec (pair (str "decision")
                     (text->json (as-str (:value (:decision entry)))))
               (pair (str "roadmap")
                     (text->json (as-str (:name (:roadmap entry)))))
               (pair (str "status")
                     (text->json (case-name decision-status-names
                                            (:status entry))))
               (pair (str "kind")
                     (text->json (str "decision")))
               (pair (str "title")
                     (text->json (as-str (:title entry))))
               (pair (str "actions")
                     (array (collect (map (iter (:actions entry))
                                          next-action->json)))))))

(defn next-action->json (planned)
  (object (-> (vec (pair (str "action")
                         (text->json (case-name action-names
                                                (:action planned))))
                   (pair (str "actor")
                         (text->json (case-name actor-names (:actor planned)))))
              (with-session (ref (:session planned)))
              (with-reasons (ref (:reasons planned)))
              (with-report (ref (:report planned))))))

(type with-session
  (fn ((vec (pair string json))
       (ref (option session)))
    (vec (pair string json))))

(defn with-session (fields session)
  (match session
    ((some present)
     (appended fields
               (pair (str "session")
                     (text->json (as-str (:name present))))))
    (none fields)))

(defn with-reasons (fields reasons)
  (match reasons
    ((some blockage)
     (appended fields
               (pair (str "reasons")
                     (object (blockage-fields blockage)))))
    (none fields)))

(type with-report
  (fn ((vec (pair string json))
       (ref (option report-id)))
    (vec (pair string json))))

(defn with-report (fields report)
  (match report
    ((some id)
     (appended fields
               (pair (str "report")
                     (int->json (:value id)))))
    (none fields)))

(defn appended (fields field)
  (let (all fields) (push! all field) all))
