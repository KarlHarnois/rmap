(module
  "Lists each command the CLI accepts, with its operands and its flags.")

(use ledger/api graph-format-names kind-names origin-names
                status-names)

(use cli/flag-specs boolean-flag boolean? choices flag-spec
                    global-flags optional required)

(export ->route boolean-flag-names route route-name routes
        subcommand word-count)

(defenum subcommand
  help
  init
  new
  list
  ready
  next
  log
  item-add
  item-list
  item-show
  item-claim
  item-advance
  item-close
  item-drop
  dep-add
  dep-rm
  graph)

(defstruct route
  :subcommand subcommand
  :words (vec string)
  :operands (vec string)
  :flags (vec flag-spec))

(type word-count
  (fn ((ref route)) usize))

(defn word-count (route)
  (len (:words route)))

(type route-name
  (fn ((ref route)) string))

(defn route-name (route)
  (join (:words route) " "))

(defn words (text)
  (collect (map (split text " ") str)))

(defn operands (names)
  (collect (map (iter names) str)))

(defn routes ()
  (vec (->route :subcommand subcommand/help
                :words (words "help")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/init
                :words (words "init")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/new
                :words (words "new")
                :operands (operands (vec "name"))
                :flags (vec (required "manager" "<session>")))
       (->route :subcommand subcommand/list
                :words (words "list")
                :operands (vec)
                :flags (vec))
       (->route :subcommand subcommand/ready
                :words (words "ready")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")))
       (->route :subcommand subcommand/next
                :words (words "next")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (optional "manager" "<session>")))
       (->route :subcommand subcommand/log
                :words (words "log")
                :operands (vec)
                :flags (vec (optional "item" "<id>")
                            (optional "since" "<event id>")))
       (->route :subcommand subcommand/item-add
                :words (words "item add")
                :operands (vec)
                :flags (vec (required "roadmap" "<name>")
                            (required "title" "<text>")
                            (required "kind" (choices kind-names))
                            (optional "parent" "<epic id>")
                            (optional "after" "<ids, comma-separated>")
                            (optional "paths" "<globs, comma-separated>")
                            (optional "from" "<id>")
                            (optional "origin" (choices origin-names))
                            (optional "priority" "<whole number>")))
       (->route :subcommand subcommand/item-list
                :words (words "item list")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")))
       (->route :subcommand subcommand/item-show
                :words (words "item show")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/item-claim
                :words (words "item claim")
                :operands (operands (vec "id"))
                :flags (vec (required "session" "<name>")))
       (->route :subcommand subcommand/item-advance
                :words (words "item advance")
                :operands (vec (str "id") (choices status-names))
                :flags (vec (optional "kind" "build")
                            (optional "paths" "<globs, comma-separated>")))
       (->route :subcommand subcommand/item-close
                :words (words "item close")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :subcommand subcommand/item-drop
                :words (words "item drop")
                :operands (operands (vec "id"))
                :flags (vec (required "reason" "<text>")))
       (->route :subcommand subcommand/dep-add
                :words (words "dep add")
                :operands (operands (vec "item" "on"))
                :flags (vec))
       (->route :subcommand subcommand/dep-rm
                :words (words "dep rm")
                :operands (operands (vec "item" "on"))
                :flags (vec))
       (->route :subcommand subcommand/graph
                :words (words "graph")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")
                            (boolean-flag "all")
                            (optional "format" (choices graph-format-names))))))

(defn boolean-flag-names ()
  (let (specs (global-flags))
    (for-each (routes)
      (fn (route)
        (for-each (:flags route)
          (fn (spec) (push! specs (clone spec))))))
    (collect (map (filter (iter specs)
                    (fn (spec) (boolean? spec)))
                  (fn (spec) (clone (:name spec)))))))
