(module
  "Lists each command the CLI accepts, with its operands and its flags.")

(use ledger/api kind-names origin-names status-names)

(export ->route flag-spec global-flags presence route routes
        word-count)

(defenum presence
  required
  optional)

(defstruct flag-spec
  :name string
  :presence presence
  :value string)

(defstruct route
  :name string
  :operands (vec string)
  :flags (vec flag-spec))

(defn required (name value)
  (->flag-spec :name (str name)
               :presence presence/required
               :value (str value)))

(defn optional (name value)
  (->flag-spec :name (str name)
               :presence presence/optional
               :value (str value)))

(type choices
  (where ((a copy))
    (fn ((ref (vec (pair a (ref str)))))
      string)))

(defn choices (names)
  (join (collect (map (iter names)
                   (fn (entry)
                     (let-match ((pair _ name) (deref entry))
                       name))))
        "|"))

(type word-count
  (fn ((ref route)) usize))

(defn word-count (route)
  (len (collect (split (as-str (:name route)) " "))))

(defn global-flags ()
  (vec (optional "db" "<path>")))

(defn operands (names)
  (collect (map (iter names) str)))

(defn routes ()
  (vec (->route :name (str "help")
                :operands (vec)
                :flags (vec))
       (->route :name (str "new")
                :operands (operands (vec "name"))
                :flags (vec (required "manager" "<session>")))
       (->route :name (str "list")
                :operands (vec)
                :flags (vec))
       (->route :name (str "ready")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")))
       (->route :name (str "log")
                :operands (vec)
                :flags (vec (optional "item" "<id>")
                            (optional "since" "<event id>")))
       (->route :name (str "item add")
                :operands (vec)
                :flags (vec (required "roadmap" "<name>")
                            (required "title" "<text>")
                            (required "kind" (choices kind-names))
                            (optional "parent" "<epic id>")
                            (optional "after" "<ids, comma-separated>")
                            (optional "paths" "<globs, comma-separated>")
                            (optional "from" "<id>")
                            (optional "origin" (choices origin-names))
                            (optional "priority" "<whole number>")))
       (->route :name (str "item list")
                :operands (vec)
                :flags (vec (optional "roadmap" "<name>")))
       (->route :name (str "item show")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :name (str "item claim")
                :operands (operands (vec "id"))
                :flags (vec (required "session" "<name>")))
       (->route :name (str "item advance")
                :operands (vec (str "id") (choices status-names))
                :flags (vec (optional "kind" "build")
                            (optional "paths" "<globs, comma-separated>")))
       (->route :name (str "item close")
                :operands (operands (vec "id"))
                :flags (vec))
       (->route :name (str "item drop")
                :operands (operands (vec "id"))
                :flags (vec (required "reason" "<text>")))
       (->route :name (str "dep add")
                :operands (operands (vec "item" "on"))
                :flags (vec))
       (->route :name (str "dep rm")
                :operands (operands (vec "item" "on"))
                :flags (vec))))
