(module
  "Names a command the CLI accepts: its words, its summary, its operands and its flags.")

(use cli/flag-specs flag-spec)

(export ->route route route-name subcommand word-count)

(defenum subcommand
  help
  init
  new
  list
  ready
  next
  log
  item-add
  item-list
  item-show
  item-claim
  item-advance
  item-close
  item-drop
  dep-add
  dep-rm
  graph)

(defstruct route
  :subcommand subcommand
  :words (vec string)
  :summary string
  :operands (vec string)
  :flags (vec flag-spec))

(type word-count (fn ((ref route)) int))

(defn word-count (route)
  (len (:words route)))

(type route-name
  (fn ((ref route)) string))

(defn route-name (route)
  (join (:words route) " "))
