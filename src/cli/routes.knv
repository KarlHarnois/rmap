(module
  "Names a command the CLI accepts: its words, its summary, its operands and its flags.")

(use cli/flag-specs flag-spec)

(export ->route operands pr-command report-command route
        route-name session-command subcommand word-count
        words)

(defstruct route
  :subcommand subcommand
  :words (vec string)
  :summary string
  :operands (vec string)
  :flags (vec flag-spec))

(defenum subcommand
  help
  init
  new
  list
  pause
  resume
  roadmap-set
  ready
  next
  log
  item-add
  item-list
  item-show
  item-edit
  item-verify
  item-claim
  item-advance
  item-close
  item-drop
  dep-add
  dep-rm
  graph
  export
  review-start
  (session session-command)
  decision-propose
  decision-revise
  decision-show
  decision-list
  decision-ask
  decision-accept
  decision-reject
  decision-deprecate
  decision-block
  decision-unblock
  proposal-add
  proposal-list
  (report report-command)
  (pull-request pr-command))

(defenum report-command
  record
  list
  show
  read)

(defenum pr-command
  review
  head
  show)

(defenum session-command end)

(type word-count (fn ((ref route)) int))

(defn word-count (route)
  (len (:words route)))

(type route-name
  (fn ((ref route)) string))

(defn route-name (route)
  (join (:words route) " "))

(defn words (text)
  (collect (map (split text " ") str)))

(defn operands (names)
  (collect (map (iter names) str)))
