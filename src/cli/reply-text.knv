(module
  "Describes each ledger result in plain text.")

(use ledger/api case-name dep init-outcome init-report
                roadmap roadmap-status-names)

(use cli/replies reply)
(use cli/tables headed table)

(use cli/item-text item-added-text item-edited-text
                   item-moved-text items-text)

(use cli/item-detail-text item-detail-text)
(use cli/readiness-text readiness-text)
(use cli/next-text next-text)
(use cli/batch-text batch-text)
(use cli/event-text events-text)

(export reply->text)

(defn reply->text (reply)
  (match reply
    ((reply/ledger-initialized report)
     (init-report-text report))
    ((reply/roadmap-created roadmap)
     (roadmap-created-text roadmap))
    ((reply/roadmaps-listed roadmaps) (roadmaps-text roadmaps))
    ((reply/readiness-checked readiness)
     (readiness-text readiness))
    ((reply/next-listed items) (next-text (ref items)))
    ((reply/batch-picked batch) (batch-text batch))
    ((reply/log-read events) (events-text (ref events)))
    ((reply/item-added item) (item-added-text item))
    ((reply/item-edited item) (item-edited-text item))
    ((reply/item-moved item) (item-moved-text item))
    ((reply/items-listed items) (items-text (ref items)))
    ((reply/item-shown detail) (item-detail-text detail))
    ((reply/dep-added dep) (dep-text dep "now comes after"))
    ((reply/dep-removed dep)
     (dep-text dep "no longer comes after"))
    ((reply/graph-drawn graph) (clone (:source graph)))))

(type init-report-text
  (fn ((ref init-report)) string))

(defn init-report-text (report)
  (let (path (:database-path report))
    (match (:outcome report)
      (init-outcome/created (str "Created ledger " path "."))
      (init-outcome/existing (str "Ledger already exists at " path ".")))))

(type roadmap-created-text
  (fn ((ref roadmap)) string))

(defn roadmap-created-text (roadmap)
  (str "Created roadmap "
       (:name roadmap)
       ", managed by "
       (:name (:manager roadmap))
       "."))

(defn roadmaps-text (roadmaps)
  (if (empty? roadmaps)
    (str "No roadmaps.")
    (roadmap-table roadmaps)))

(type roadmap-table
  (fn ((ref (vec roadmap))) string))

(defn roadmap-table (roadmaps)
  (let (rows (headed (vec "ID" "NAME" "STATUS" "MANAGER" "CREATED")))
    (for-each roadmaps
      (fn (roadmap)
        (push! rows (roadmap-cells roadmap))))
    (table rows)))

(type roadmap-cells
  (fn ((ref roadmap)) (vec string)))

(defn roadmap-cells (roadmap)
  (vec (clone (:value (:id roadmap)))
       (clone (:name roadmap))
       (str (case-name roadmap-status-names (:status roadmap)))
       (clone (:name (:manager roadmap)))
       (clone (:value (:created-at roadmap)))))

(type dep-text
  (fn ((ref dep) (ref str)) string))

(defn dep-text (dep relation)
  (str (:value (:item dep))
       " " relation " "
       (:value (:on dep))
       "."))
