(module
  "Describes each ledger result in plain text.")

(use json/value json->source)
(use ledger/api case-name init-outcome-names)
(use cli/session-ended-text session-ended-text)

(use cli/follow-up-text proposals-list-text
                        proposals-recorded-text)

(use cli/replies reply)

(use cli/item-text item-added-text item-edited-text
                   item-moved-text items-text)

(use cli/item-detail-text item-detail-text)
(use cli/external-blocker-text external-blocker-changed-text)
(use cli/criterion-verdict-text criterion-verified-text)

(use cli/roadmap-text roadmap-created-text
                      roadmap-max-active-changed-text
                      roadmap-status-text roadmaps-text)

(use cli/readiness-text readiness-text)
(use cli/next-text next-text)
(use cli/batch-text batch-text)
(use cli/event-text events-text)
(use cli/report-text report-reply->text)
(use cli/pr-text pr-reply->text)

(use cli/decision-text decision-accepted-text
                       decision-asked-text
                       decision-deprecated-text
                       decision-detail-text
                       decision-proposed-text
                       decision-rejected-text
                       decision-revised-text decisions-text)

(export reply->text)

(defn reply->text (reply)
  (match reply
    ((reply/ledger-initialized report)
     (init-report-text report))
    ((reply/roadmap-created roadmap)
     (roadmap-created-text roadmap))
    ((reply/roadmap-status-changed roadmap)
     (roadmap-status-text roadmap))
    ((reply/roadmap-max-active-changed roadmap)
     (roadmap-max-active-changed-text roadmap))
    ((reply/roadmaps-listed roadmaps) (roadmaps-text roadmaps))
    ((reply/readiness-checked readiness)
     (readiness-text readiness))
    ((reply/next-listed items) (next-text (ref items)))
    ((reply/batch-picked batch) (batch-text batch))
    ((reply/log-read events) (events-text (ref events)))
    ((reply/item-added item) (item-added-text item))
    ((reply/item-edited item) (item-edited-text item))
    ((reply/item-moved item) (item-moved-text item))
    ((reply/external-blocker-changed blocker)
     (external-blocker-changed-text (ref blocker)))
    ((reply/criterion-verified verdict)
     (criterion-verified-text verdict))
    ((reply/items-listed items) (items-text (ref items)))
    ((reply/item-shown detail) (item-detail-text detail))
    ((reply/dep-added dep) (dep-text dep "now comes after"))
    ((reply/dep-removed dep)
     (dep-text dep "no longer comes after"))
    ((reply/graph-drawn graph) (clone (:source graph)))
    ((reply/exported document) (json->source (ref document)))
    ((reply/proposals-recorded id follow-ups)
     (proposals-recorded-text id follow-ups))
    ((reply/proposals-listed id follow-ups)
     (proposals-list-text id follow-ups))
    ((reply/decision-proposed decision)
     (decision-proposed-text (ref decision)))
    ((reply/decision-revised decision)
     (decision-revised-text (ref decision)))
    ((reply/decision-shown decision)
     (decision-detail-text (ref decision)))
    ((reply/decisions-listed decisions)
     (decisions-text (ref decisions)))
    ((reply/decision-asked decision)
     (decision-asked-text (ref decision)))
    ((reply/decision-accepted decision)
     (decision-accepted-text (ref decision)))
    ((reply/decision-rejected decision)
     (decision-rejected-text (ref decision)))
    ((reply/decision-deprecated decision)
     (decision-deprecated-text (ref decision)))
    ((reply/reported answer) (report-reply->text answer))
    ((reply/pull-request answer) (pr-reply->text answer))
    ((reply/session-ended ended)
     (session-ended-text (ref ended)))))

(defn init-report-text (report)
  (let (path (:database-path report))
    (match (case-name init-outcome-names (:outcome report))
      ("created" (str "Created ledger " path "."))
      (_ (str "Ledger already exists at " path ".")))))

(defn dep-text (dep relation)
  (str (:value (:item dep))
       " " relation " "
       (:value (:on dep))
       "."))
