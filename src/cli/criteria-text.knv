(module
  "Prints an item's acceptance criteria as a numbered section, each with its latest verdict.")

(use ledger/api case-name criterion-result-names
                criterion-status)

(use cli/tables indented)

(export criteria-text)

(defn criteria-text (statuses)
  (if (empty? statuses)
    (str "\n\nAcceptance criteria: -")
    (str "\n\nAcceptance criteria:\n"
         (indented (numbered (ref statuses))))))

(defn numbered (statuses)
  (join (collect (map (iter statuses) status-line))
        "\n"))

(type status-line
  (fn ((ref criterion-status)) string))

(defn status-line (status)
  (str (:position status)
       ". "
       (:text status)
       (verdict-suffix (ref (:verdict status)))))

(defn verdict-suffix (verdict)
  (match verdict
    ((some present)
     (str " ["
          (case-name criterion-result-names (:verdict present))
          " by "
          (:name (:reviewer present))
          (head-suffix (ref (:head present)))
          "]"))
    (none (str ""))))

(defn head-suffix (head)
  (match head
    ((some present) (str " on " (:sha present)))
    (none (str ""))))
