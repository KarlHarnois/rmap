(module
  "Calls the ledger for each pull request request and names the reply it gives.")

(use ledger/api record-review show-pull-request)
(use cli/pr-requests pr-operation)
(use cli/pr-replies pr-reply)
(use cli/replies reply)

(export perform-pull-request)

(defn perform-pull-request (settings operation)
  (map-ok (pr-result settings operation)
    (fn (answer) (reply/pull-request answer))))

(defn pr-result (settings operation)
  (match operation
    ((pr-operation/review request)
     (map-ok (record-review settings request)
       (fn (recorded) (pr-reply/reviewed recorded))))
    ((pr-operation/show id)
     (map-ok (show-pull-request settings id)
       (fn (pull-request) (pr-reply/shown pull-request))))))
