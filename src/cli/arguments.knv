(module
  "Splits the command line into words and flags, and reads a command's operands.")

(use cli/routes route word-count)

(export ->arguments arguments operand split-arguments)

(defstruct arguments
  :words (vec string)
  :flags (vec (pair string string)))

(defn split-arguments (args boolean-flag-names)
  (loop (index 0
         words (vec)
         flags (vec))
    (cond
      ((>= index (len args))
       (ok (->arguments :words words :flags flags)))
      ((boolean-flag-token? (at args index)
                            (ref boolean-flag-names))
       (recur (inc index) words flags))
      ((flag-name? (at args index))
       (let-try (value (flag-value (ref args) index (ref boolean-flag-names)))
         (recur (+ index 2)
                words
                (appended flags
                          (pair (flag-name (at args index)) value)))))
      (else (recur (inc index)
                   (appended words (clone (at args index)))
                   flags)))))

(defn flag-name? (arg)
  (starts-with? (as-str arg) "--"))

(defn flag-name (arg)
  (str (subs (as-str arg) 2 (len arg))))

(defn boolean-flag-token? (arg boolean-flag-names)
  (and (flag-name? arg)
       (contains? boolean-flag-names (flag-name arg))))

(defn flag-value (args index boolean-flag-names)
  (ok-or (then-some (get args (inc index))
           (fn (value) (unless-boolean-flag value boolean-flag-names)))
         (str (at args index) " needs a value")))

(defn unless-boolean-flag (value boolean-flag-names)
  (if (boolean-flag-token? value boolean-flag-names)
    none
    (some (clone value))))

(defn appended (items extra)
  (let (all items) (push! all extra) all))

(type operand
  (fn ((ref arguments) (ref route) usize)
    string))

(defn operand (arguments route index)
  (clone (at (:words arguments)
             (+ (word-count route) index))))
