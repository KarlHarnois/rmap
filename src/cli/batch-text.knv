(module
  "Describes in plain text which ready items were picked to start together and what holds back the others.")

(use cli/tables indented)
(use cli/item-text item-table)
(use cli/readiness-text blocked-section)

(export batch-text)

(defn batch-text (batch)
  (let (sections (vec (picked-section (ref batch))))
    (when (not (empty? (:blocked batch)))
      (push! sections
             (blocked-section (ref (:blocked batch)))))
    (join sections "\n\n")))

(defn picked-section (batch)
  (if (empty? (:picked batch))
    (str "Nothing is ready.")
    (str "Picked "
         (len (:picked batch))
         " of "
         (:count (:size batch))
         ":\n"
         (indented (item-table (ref (:picked batch)))))))
