(module
  "Describes the CLI in plain text: its usage, its commands, its environment variables, its exit codes and its refusal codes.")

(use ledger/api refusal-catalog)
(use cli/routes route)
(use cli/commands routes)
(use cli/decision-commands route-document)
(use json/value json->pretty-source)

(use cli/exit-codes exit-code->meaning exit-code->number
                    exit-codes)

(use cli/environment-variables environment-variables)
(use cli/tables indented table)
(use cli/usage command-usage usage-line)

(export command-help-text help-text)

(def full-help-pointer
  "Run `rmap help` for the global flags, environment variables, exit codes and refusal codes.")

(defn help-text ()
  (join (vec (str "Usage: " (usage-line))
             (section "Commands" (entries (routes) command-entry))
             (section "Environment" (table (environment-rows)))
             (section "Exit codes" (table (exit-code-rows)))
             (section "Refusal codes" (table (refusal-rows))))
        "\n\n"))

(defn command-help-text (routes)
  (join (vec (section "Usage" (entries routes rmap-command-entry))
             (str full-help-pointer))
        "\n\n"))

(type entries
  (fn ((ref (vec route))
       (fn ((ref route)) string))
    string))

(defn entries (routes entry)
  (join (collect (map (iter routes) entry))
        "\n"))

(defn rmap-command-entry (route)
  (str "rmap " (command-entry route)))

(defn command-entry (route)
  (str (command-usage route)
       "\n"
       (indented (:summary route))
       (document-text route)))

(defn document-text (route)
  (match (route-document route)
    ((some shape)
     (str "\n"
          (indented (str "Document:\n"
                         (indented (json->pretty-source (ref shape)))))))
    (none (str ""))))

(defn section (title body)
  (str title ":\n" (indented body)))

(defn environment-rows ()
  (collect (map (iter (environment-variables))
             (fn (variable)
               (vec (clone (:name variable))
                    (clone (:meaning variable)))))))

(defn exit-code-rows ()
  (collect (map (iter (exit-codes))
             (fn (code)
               (vec (str (exit-code->number (deref code)))
                    (str (exit-code->meaning (deref code))))))))

(defn refusal-rows ()
  (collect (map (iter (refusal-catalog))
             (fn (description)
               (vec (clone (:code description))
                    (clone (:meaning description)))))))
