(module
  "Lists the commands that record a build's pull request reviews and head, and show the pull request.")

(use ledger/api review-kind-names verdict-names)
(use cli/flag-specs choices required)

(use cli/routes ->route operands pr-command subcommand
                words)

(export pr-routes)

(defn pr-routes ()
  (vec (->route :subcommand (subcommand/pull-request pr-command/review)
                :words (words "pr review")
                :summary (str "Records a review of the build's pull request at --head, which must be the pull request's current head in the ledger, by the reviewer session, as a finished review session. It never moves the item. The build moves to merging, and closes as merged, only when, among each reviewer's latest verdict on the pull request's head, one approves and none asks for changes.")
                :operands (operands (vec "item"))
                :flags (vec (required "verdict" (choices verdict-names))
                            (required "kind" (choices review-kind-names))
                            (required "head" "<commit sha>")
                            (required "reviewer" "<session>")))
       (->route :subcommand (subcommand/pull-request pr-command/head)
                :words (words "pr head")
                :summary (str "Records a new head for the build's pull request when its branch moved without a fixed report, and moves an in_review or merging build back to in_review. Reviews on older heads stop counting toward its approval.")
                :operands (operands (vec "item" "commit sha"))
                :flags (vec))
       (->route :subcommand (subcommand/pull-request pr-command/show)
                :words (words "pr show")
                :summary (str "Shows the build's pull request with its reviews and whether they approve its head.")
                :operands (operands (vec "item"))
                :flags (vec))))
