(module
  "Describes roadmaps in plain text: a sentence about one change and a table of roadmaps.")

(use ledger/api case-name roadmap roadmap-status
                roadmap-status-names)

(use cli/tables headed table)

(export roadmap-created-text roadmap-max-active-changed-text
        roadmap-status-text roadmaps-text)

(defn roadmap-created-text (roadmap)
  (str "Created roadmap "
       (:name roadmap)
       ", managed by "
       (:name (:manager roadmap))
       "."))

(defn roadmap-max-active-changed-text (result)
  (match (:changed-at result)
    ((some _) (max-active-changed-text (ref (:roadmap result))))
    (none (max-active-unchanged-text (ref (:roadmap result))))))

(type roadmap-status-text
  (fn ((ref roadmap)) string))

(defn roadmap-status-text (roadmap)
  (match (:status roadmap)
    (roadmap-status/paused (str "Paused roadmap " (:name roadmap) "."))
    (roadmap-status/active (str "Resumed roadmap " (:name roadmap) "."))
    (roadmap-status/done (str "Marked roadmap " (:name roadmap) " done."))))

(defn roadmaps-text (roadmaps)
  (if (empty? roadmaps)
    (str "No roadmaps.")
    (roadmap-table roadmaps)))

(defn max-active-changed-text (roadmap)
  (match (:max-active roadmap)
    ((some count)
     (str "Set the max active of roadmap "
          (:name roadmap)
          " to " count "."))
    (none (str "Cleared the max active of roadmap "
               (:name roadmap)
               "."))))

(defn max-active-unchanged-text (roadmap)
  (match (:max-active roadmap)
    ((some count)
     (str "The max active of roadmap "
          (:name roadmap)
          " is already " count "."))
    (none (str "The max active of roadmap "
               (:name roadmap)
               " is already cleared."))))

(type roadmap-table
  (fn ((ref (vec roadmap))) string))

(defn roadmap-table (roadmaps)
  (let (rows (headed (vec "ID" "NAME" "STATUS" "MAX ACTIVE"
                          "MANAGER" "CREATED")))
    (for-each roadmaps
      (fn (roadmap)
        (push! rows (roadmap-cells roadmap))))
    (table rows)))

(type roadmap-cells
  (fn ((ref roadmap)) (vec string)))

(defn roadmap-cells (roadmap)
  (vec (clone (:value (:id roadmap)))
       (clone (:name roadmap))
       (str (case-name roadmap-status-names (:status roadmap)))
       (max-active-text (ref (:max-active roadmap)))
       (clone (:name (:manager roadmap)))
       (clone (:value (:created-at roadmap)))))

(type max-active-text
  (fn ((ref (option int))) string))

(defn max-active-text (max-active)
  (match max-active
    ((some count) (str count))
    (none (str "-"))))
