(module
  "Describes decisions in plain text: a sentence about each change and a table of decisions.")

(use ledger/api case-name decision decision-status-names
                timestamp)

(use cli/tables headed table)
(use cli/decision-detail-text decision-detail-text)

(export decision-accepted-text decision-asked-text
        decision-deprecated-text decision-detail-text
        decision-proposed-text decision-rejected-text
        decision-revised-text decisions-text)

(type decision-proposed-text
  (fn ((ref decision)) string))

(defn decision-proposed-text (decision)
  (str "Proposed "
       (:value (:id decision))
       " in "
       (:roadmap-name decision)
       ": "
       (:title decision)))

(type decision-revised-text
  (fn ((ref decision)) string))

(defn decision-revised-text (decision)
  (str "Revised "
       (:value (:id decision))
       ": "
       (:title decision)))

(type decision-asked-text
  (fn ((ref decision)) string))

(defn decision-asked-text (decision)
  (str "Asked "
       (:value (:id decision))
       ": "
       (:title decision)))

(type decision-accepted-text
  (fn ((ref decision)) string))

(defn decision-accepted-text (decision)
  (str "Accepted " (:value (:id decision)) "."))

(type decision-rejected-text
  (fn ((ref decision)) string))

(defn decision-rejected-text (decision)
  (str "Rejected " (:value (:id decision)) "."))

(type decision-deprecated-text
  (fn ((ref decision)) string))

(defn decision-deprecated-text (decision)
  (str "Deprecated " (:value (:id decision)) "."))

(defn decisions-text (decisions)
  (if (empty? decisions)
    (str "No decisions.")
    (decision-table decisions)))

(type decision-table
  (fn ((ref (vec decision))) string))

(defn decision-table (decisions)
  (let (rows (headed (vec "ID" "ROADMAP" "STATUS" "ASKED" "TITLE")))
    (for-each decisions
      (fn (decision)
        (push! rows (decision-cells decision))))
    (table rows)))

(type decision-cells
  (fn ((ref decision)) (vec string)))

(defn decision-cells (decision)
  (vec (clone (:value (:id decision)))
       (clone (:roadmap-name decision))
       (str (case-name decision-status-names (:status decision)))
       (optional-timestamp-text (ref (:asked-at decision)))
       (clone (:title decision))))

(type optional-timestamp-text
  (fn ((ref (option timestamp))) string))

(defn optional-timestamp-text (at)
  (match at
    ((some present) (clone (:value present)))
    (none (str "-"))))
