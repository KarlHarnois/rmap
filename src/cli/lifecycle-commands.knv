(module
  "Lists the commands that change a roadmap.")

(use cli/flag-specs boolean-flag optional)
(use cli/routes ->route operands subcommand words)

(export lifecycle-routes)

(defn lifecycle-routes ()
  (vec (->route :subcommand subcommand/pause
                :words (words "pause")
                :summary (str "Pauses a roadmap: its open items wait, while work already started continues.")
                :operands (operands (vec "name"))
                :flags (vec))
       (->route :subcommand subcommand/resume
                :words (words "resume")
                :summary (str "Resumes a paused roadmap.")
                :operands (operands (vec "name"))
                :flags (vec))
       (->route :subcommand subcommand/roadmap-set
                :words (words "roadmap set")
                :summary (str "Caps how many of a roadmap's items may be active at once, or clears the cap with --no-max-active. Active means dispatched, reported, in review, fixing or merging, and epics never count. While a roadmap has that many active items, rmap ready lists its other startable items as blocked at capacity and rmap item claim refuses them.")
                :operands (operands (vec "name"))
                :flags (vec (optional "max-active" "<whole number, at least 1>")
                            (boolean-flag "no-max-active")))))
