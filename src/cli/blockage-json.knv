(module
  "Turns a blockage into the JSON fields the CLI prints.")

(use json/value array bool->json int->json json object
                text->json)

(use ledger/api decision-id ids->json roadmap-pause)
(use cli/external-blocker-json blocking-external-blocker->json)

(export blockage-fields)

(defn blockage-fields (blockage)
  (with-capacity (vec (pair (str "paused")
                            (bool->json (paused? blockage)))
                      (pair (str "blockers")
                            (ids->json (ref (:blockers blockage))))
                      (pair (str "dropped_blockers")
                            (ids->json (ref (:dropped-blockers blockage))))
                      (pair (str "blocking_decisions")
                            (decision-ids->json (ref (:decisions blockage))))
                      (pair (str "external_blockers")
                            (blocking-external-blockers->json (ref (:external-blockers
                                                                     blockage)))))
                 (:capacity blockage)))

(defn with-capacity (fields capacity)
  (match capacity
    ((some present)
     (appended fields
               (pair (str "capacity") (capacity->json present))))
    (none fields)))

(defn capacity->json (capacity)
  (object (vec (pair (str "active")
                     (int->json (:active capacity)))
               (pair (str "max_active")
                     (int->json (:max-active capacity))))))

(defn appended (fields field)
  (let (all fields) (push! all field) all))

(type decision-ids->json
  (fn ((ref (vec decision-id))) json))

(defn decision-ids->json (ids)
  (array (collect (map (iter ids)
                    (fn (id)
                      (text->json (as-str (:value id))))))))

(defn blocking-external-blockers->json (blockers)
  (array (collect (map (iter blockers) blocking-external-blocker->json))))

(defn paused? (blockage)
  (= (:pause blockage) roadmap-pause/paused))
