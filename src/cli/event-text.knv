(module
  "Describes ledger events in plain text: one row per event, with its roadmap and the details its payload records, with each recorded change as `column=old->new`.")

(use json/value field json->entries json->source json->text
                null?)

(use ledger/api case-name event event-type-names roadmap-id)
(use cli/tables headed table)
(use cli/item-text optional-id-text)

(export events-text)

(defn events-text (events)
  (if (empty? events)
    (str "No events.")
    (event-table events)))

(type event-table
  (fn ((ref (vec event))) string))

(defn event-table (events)
  (let (rows (headed (vec "ID" "AT" "ACTOR" "EVENT"
                          "ROADMAP" "ITEM" "DETAILS")))
    (for-each events
      (fn (event)
        (push! rows (event-cells event))))
    (table rows)))

(type event-cells
  (fn ((ref event)) (vec string)))

(defn event-cells (event)
  (vec (str (:id event))
       (clone (:value (:at event)))
       (clone (:actor event))
       (str (case-name event-type-names (:type event)))
       (optional-roadmap-id-text (ref (:roadmap-id event)))
       (optional-id-text (ref (:item-id event)))
       (payload-text (ref (:payload event)))))

(type optional-roadmap-id-text
  (fn ((ref (option roadmap-id))) string))

(defn optional-roadmap-id-text (id)
  (match id
    ((some present) (clone (:value present)))
    (none (str "-"))))

(defn payload-text (payload)
  (let (parts (vec))
    (for-each (json->entries payload)
      (fn (entry)
        (let-match ((pair key value) entry)
          (for-each (entry-texts (as-str key) value)
            (fn (text) (push! parts (clone text)))))))
    (join parts " ")))

(defn entry-texts (key value)
  (cond
    ((= key "changes") (changes-texts value))
    ((null? value) (vec))
    (else (vec (str key "=" (value-text value))))))

(defn changes-texts (changes)
  (-> (json->entries changes)
      iter
      (filter (fn (entry)
                (let-match ((pair _ change) (deref entry))
                  (recorded? change))))
      (map change-text)
      collect))

(defn recorded? (change)
  (not (and (null-side? change "old") (null-side? change "new"))))

(defn null-side? (change side)
  (match (field change side)
    ((some value) (null? (ref value)))
    (none true)))

(defn change-text (entry)
  (let-match ((pair column change) entry)
    (str column "="
         (side-text change "old")
         "->"
         (side-text change "new"))))

(defn side-text (change side)
  (match (field change side)
    ((some value) (nullable-text (ref value)))
    (none (str "-"))))

(defn nullable-text (value)
  (if (null? value)
    (str "-")
    (value-text value)))

(defn value-text (value)
  (match (json->text value)
    ((some text) text)
    (none (json->source value))))
