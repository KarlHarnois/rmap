(module
  "Renders a response as the JSON object the CLI prints.")

(use ledger/api case-name criterion-gap criterion-result
                criterion-result-names database-problem
                decision-id failure failure-code
                failure-message pull-request-refusal refusal
                session)

(use cli/responses response)
(use cli/help command-help-document help-document)
(use cli/envelopes reply-envelope)
(use cli/schema-envelope error-envelope)
(use json/value array int->json json object text->json)
(use cli/blockage-json blockage-fields)
(use cli/approval-json approval-fields)

(export response->json)

(defn response->json (response)
  (match response
    (response/help (help-document))
    ((response/command-help routes)
     (command-help-document routes))
    ((response/replied reply) (reply-envelope reply))
    ((response/failed failure) (failure-envelope (ref failure)))
    ((response/misused message) (usage-envelope message))))

(defn usage-envelope (message)
  (error-envelope "usage"
                  (as-str (str message
                               "; run `rmap help` to list the commands"))
                  (vec)))

(defn failure-envelope (failure)
  (error-envelope (as-str (failure-code failure))
                  (as-str (failure-message failure))
                  (failure-fields failure)))

(defn failure-fields (failure)
  (match failure
    ((failure/refused refusal) (refusal-fields refusal))
    ((failure/database error)
     (database-fields (:problem error)))
    (_ (vec))))

(defn database-fields (problem)
  (match problem
    ((database-problem/too-new versions)
     (vec (pair (str "ledger_version")
                (int->json (:ledger versions)))
          (pair (str "binary_version")
                (int->json (:binary versions)))))
    (_ (vec))))

(defn refusal-fields (refusal)
  (match refusal
    ((refusal/not-ready blockage) (blockage-fields blockage))
    ((refusal/decisions-pending ids)
     (vec (pair (str "decisions") (decision-ids->json ids))))
    ((refusal/pull-request (pull-request-refusal/reviewer-is-worker reviewer))
     (vec (pair (str "reviewer")
                (text->json (as-str (:name reviewer))))))
    ((refusal/pull-request (pull-request-refusal/reviewer-not-fresh
                             reviewer reviewed tried))
     (vec (pair (str "reviewer")
                (text->json (as-str (:name reviewer))))
          (pair (str "reviewed_head")
                (text->json (as-str (:sha reviewed))))
          (pair (str "tried_head")
                (text->json (as-str (:sha tried))))))
    ((refusal/pull-request (pull-request-refusal/not-approved approval))
     (approval-fields approval))
    ((refusal/criteria-unmet gaps) (criterion-gap-fields gaps))
    ((refusal/verifier-not-reviewer reviewer)
     (verifier-fields reviewer))
    ((refusal/verifier-is-worker reviewer)
     (verifier-fields reviewer))
    ((refusal/verifier-is-manager reviewer)
     (verifier-fields reviewer))
    ((refusal/criterion-not-found id position)
     (vec (pair (str "item")
                (text->json (as-str (:value id))))
          (pair (str "position") (int->json position))))
    ((refusal/verdict-head-not-current current named)
     (vec (pair (str "current_head")
                (text->json (as-str (:sha current))))
          (pair (str "head")
                (text->json (as-str (:sha named))))))
    (_ (vec))))

(type verifier-fields
  (fn ((ref session))
    (vec (pair string json))))

(defn verifier-fields (reviewer)
  (vec (pair (str "verifier")
             (text->json (as-str (:name reviewer))))))

(type decision-ids->json
  (fn ((ref (vec decision-id))) json))

(defn decision-ids->json (ids)
  (array (collect (map (iter ids)
                    (fn (id)
                      (text->json (as-str (:value id))))))))

(defn criterion-gap-fields (gaps)
  (vec (pair (str "criteria")
             (array (collect (map (iter gaps) criterion-gap->json))))))

(type criterion-gap->json
  (fn ((ref criterion-gap)) json))

(defn criterion-gap->json (gap)
  (object (vec (pair (str "position")
                     (int->json (:position gap)))
               (pair (str "text")
                     (text->json (as-str (:text gap))))
               (pair (str "verdict")
                     (criterion-result-json (ref (:verdict gap)))))))

(type criterion-result-json
  (fn ((ref (option criterion-result)))
    json))

(defn criterion-result-json (verdict)
  (match verdict
    ((some present)
     (text->json (case-name criterion-result-names present)))
    (none json/null)))
