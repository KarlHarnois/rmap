(use json/value json->source)

(use ledger/api add-dep add-item advance-item claim-item
                close-item draw-graph drop-item edit-item
                failure init-ledger list-items list-roadmaps
                new-roadmap next-actions read-log
                ready-batch ready-items remove-dep
                show-item)

(use process/environment variable)
(use cli/requests request)
(use cli/environment-variables json-variable)
(use cli/invocations invocation parse-invocation)

(use cli/ledger-calls document-call
                      document-call->ledger-call
                      ledger-call)

(use cli/ledger-settings settings-for)
(use cli/proposal-files read-proposal)
(use cli/decision-calls perform-decision)
(use cli/exit-codes exit-code->number)
(use cli/replies reply)
(use cli/responses response response-exit-code)
(use cli/output-formats output-format output-format-of)
(use cli/json-output response->json)
(use cli/text-output response->printed stream)

(defn main ()
  (let (args (command-line-args)
        format (output-format-of (ref args) (variable json-variable))
        response (run args)
        code (exit-code->number (response-exit-code (ref response))))
    (print-response format response)
    (exit (convert code))))

(defn print-response (format response)
  (match format
    (output-format/json (println (json->source (ref (response->json
                                                      response)))))
    (output-format/text (print-text (response->printed response)))))

(defn print-text (printed)
  (match (:stream printed)
    (stream/standard-output (println (:text printed)))
    (stream/standard-error (eprintln (:text printed)))))

(defn run (args)
  (match (parse-invocation args)
    ((ok invocation) (execute invocation))
    ((err message) (response/misused message))))

(defn execute (invocation)
  (match invocation
    (invocation/help response/help)
    ((invocation/command-help routes)
     (response/command-help routes))
    ((invocation/on-ledger call) (call-ledger call))
    ((invocation/on-document call) (call-with-document call))))

(type call-with-document (fn (document-call) response))

(defn call-with-document (call)
  (match (read-proposal (ref (:source call)))
    ((ok proposal)
     (call-ledger (document-call->ledger-call call proposal)))
    ((err message) (response/misused message))))

(defn call-ledger (call)
  (match (ledger-result call)
    ((ok reply) (response/replied reply))
    ((err failure) (response/failed failure))))

(type ledger-result
  (fn (ledger-call) (result reply failure)))

(defn ledger-result (call)
  (let-try (settings (settings-for (ref call)))
    (perform (ref settings)
             (clone (:request call)))))

(defn perform (settings request)
  (match request
    (init (map-ok (init-ledger settings)
            (fn (report) (reply/ledger-initialized report))))
    ((new-roadmap name manager)
     (map-ok (new-roadmap settings name manager)
       (fn (roadmap) (reply/roadmap-created roadmap))))
    (list-roadmaps (map-ok (list-roadmaps settings)
                     (fn (roadmaps) (reply/roadmaps-listed roadmaps))))
    ((ready roadmap)
     (map-ok (ready-items settings roadmap)
       (fn (readiness) (reply/readiness-checked readiness))))
    ((next roadmap manager)
     (map-ok (next-actions settings roadmap manager)
       (fn (items) (reply/next-listed items))))
    ((ready-batch roadmap size)
     (map-ok (ready-batch settings roadmap size)
       (fn (batch) (reply/batch-picked batch))))
    ((log query)
     (map-ok (read-log settings (ref query))
       (fn (events) (reply/log-read events))))
    ((add-item roadmap draft)
     (map-ok (add-item settings roadmap draft)
       (fn (item) (reply/item-added item))))
    ((list-items roadmap)
     (map-ok (list-items settings roadmap)
       (fn (items) (reply/items-listed items))))
    ((show-item id)
     (map-ok (show-item settings id)
       (fn (detail) (reply/item-shown detail))))
    ((edit-item id edit)
     (map-ok (edit-item settings id edit)
       (fn (item) (reply/item-edited item))))
    ((claim id request)
     (map-ok (claim-item settings id request)
       (fn (item) (reply/item-moved item))))
    ((advance id advancement)
     (map-ok (advance-item settings id advancement)
       (fn (item) (reply/item-moved item))))
    ((close id)
     (map-ok (close-item settings id)
       (fn (item) (reply/item-moved item))))
    ((drop id reason)
     (map-ok (drop-item settings id reason)
       (fn (item) (reply/item-moved item))))
    ((add-dep item on)
     (map-ok (add-dep settings item on)
       (fn (dep) (reply/dep-added dep))))
    ((remove-dep item on)
     (map-ok (remove-dep settings item on)
       (fn (dep) (reply/dep-removed dep))))
    ((graph graph)
     (map-ok (draw-graph settings graph)
       (fn (source) (reply/graph-drawn source))))
    ((decision request) (perform-decision settings request))))
