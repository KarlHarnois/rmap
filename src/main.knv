(use json/value json json->string)

(use ledger/api ->settings add-dep add-item advance-item
                claim-item clock close-item
                default-database-path drop-item failure
                list-items list-roadmaps new-roadmap
                read-log ready-items refusal
                refusal->message refusal-code-text
                remove-dep show-item)

(use cli/requests parse-invocation request)
(use cli/exit-codes exit-code exit-code->number)
(use cli/help help)

(use cli/envelopes blockage-fields conflicts->json
                   dep-envelope detail-envelope
                   error-envelope events-envelope
                   item-envelope items-envelope
                   readiness-envelope roadmap-envelope
                   roadmaps-envelope)

(defstruct outcome
  :exit-code exit-code
  :output json)

(defn main ()
  (let (outcome (run (command-line-args)))
    (println (json->string (ref (:output outcome))))
    (when (= (:exit-code outcome) exit-code/usage)
      (eprintln "run `rmap help` to list the commands and their flags"))
    (exit (convert (exit-code->number (:exit-code outcome))))))

(defn run (args)
  (match (parse-invocation args)
    ((ok invocation) (execute invocation))
    ((err message) (usage-outcome message))))

(defn usage-outcome (message)
  (->outcome :exit-code exit-code/usage
             :output (error-envelope "usage" (as-str message) (vec))))

(defn execute (invocation)
  (match (:request invocation)
    (request/help (->outcome :exit-code exit-code/done :output (help)))
    (_ (execute-on-ledger invocation))))

(defn execute-on-ledger (invocation)
  (match (settings-for (ref invocation))
    ((ok settings)
     (failure-or-done (perform (ref settings)
                               (clone (:request invocation)))))
    ((err failure) (failure->outcome failure))))

(defn settings-for (invocation)
  (let-try (path (database-path (ref (:database invocation))))
    (ok (->settings :database-path path :clock clock/system))))

(defn database-path (database)
  (match database
    ((some path) (ok (clone path)))
    (none (default-database-path))))

(defn failure-or-done (result)
  (match result
    ((ok output)
     (->outcome :exit-code exit-code/done :output output))
    ((err failure) (failure->outcome failure))))

(defn perform (settings request)
  (match request
    (help (ok (help)))
    ((new-roadmap name manager)
     (map-ok (new-roadmap settings name manager)
             roadmap-envelope))
    (list-roadmaps (map-ok (list-roadmaps settings) roadmaps-envelope))
    ((ready roadmap)
     (map-ok (ready-items settings roadmap) readiness-envelope))
    ((log item since)
     (map-ok (read-log settings item since) events-envelope))
    ((add-item roadmap draft)
     (map-ok (add-item settings roadmap draft) item-envelope))
    ((list-items roadmap)
     (map-ok (list-items settings roadmap) items-envelope))
    ((show-item id)
     (map-ok (show-item settings id) detail-envelope))
    ((claim id session)
     (map-ok (claim-item settings id session) item-envelope))
    ((advance id advancement)
     (map-ok (advance-item settings id advancement)
             item-envelope))
    ((close id) (map-ok (close-item settings id) item-envelope))
    ((drop id reason)
     (map-ok (drop-item settings id reason) item-envelope))
    ((add-dep item on)
     (map-ok (add-dep settings item on) dep-envelope))
    ((remove-dep item on)
     (map-ok (remove-dep settings item on) dep-envelope))))

(defn failure->outcome (failure)
  (match failure
    ((failure/refused refusal)
     (->outcome :exit-code exit-code/refused
                :output (error-envelope (refusal-code-text (ref refusal))
                                        (as-str (refusal->message (ref
                                                                    refusal)))
                                        (refusal-details (ref refusal)))))
    ((failure/database problem)
     (->outcome :exit-code exit-code/database
                :output (error-envelope "database"
                                        (as-str (:message problem))
                                        (vec))))))

(defn refusal-details (refusal)
  (match refusal
    ((not-ready blockage) (blockage-fields blockage))
    ((paths-conflict conflicts)
     (vec (pair (str "path_conflicts") (conflicts->json conflicts))))
    (_ (vec))))
