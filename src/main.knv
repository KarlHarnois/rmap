(use json/value json json->source)

(use ledger/api ->settings add-dep add-item advance-item
                claim-item clock close-item
                default-database-path drop-item failure
                list-items list-roadmaps new-roadmap
                read-log ready-items remove-dep settings
                show-item)

(use process/environment variable)

(use cli/requests invocation ledger-call parse-invocation
                  request)

(use cli/exit-codes exit-code exit-code->number)
(use cli/help help-document)
(use cli/outcomes ->outcome result->outcome usage-outcome)

(use cli/envelopes dep-envelope detail-envelope
                   events-envelope item-envelope
                   items-envelope readiness-envelope
                   roadmap-envelope roadmaps-envelope)

(defn main ()
  (let (outcome (run (command-line-args)))
    (println (json->source (ref (:output outcome))))
    (exit (convert (exit-code->number (:exit-code outcome))))))

(defn run (args)
  (match (parse-invocation args)
    ((ok invocation) (execute invocation))
    ((err message) (usage-outcome message))))

(defn execute (invocation)
  (match invocation
    (invocation/help (->outcome :exit-code exit-code/done
                                :output (help-document)))
    ((invocation/on-ledger call) (call-ledger call))))

(defn call-ledger (call)
  (result->outcome (ledger-result call)))

(type ledger-result
  (fn (ledger-call) (result json failure)))

(defn ledger-result (call)
  (let-try (settings (settings-for (ref call)))
    (perform (ref settings)
             (clone (:request call)))))

(type settings-for
  (fn ((ref ledger-call))
    (result settings failure)))

(defn settings-for (call)
  (let-try (path (database-path (ref (:database call))))
    (ok (->settings :database-path path
                    :clock clock/system
                    :actor (actor-for (ref (:actor call)))))))

(defn actor-for (given)
  (match given
    ((some actor) (clone actor))
    (none (unwrap-or (or-else (variable "RMAP_ACTOR") (variable "USER"))
                     (str "unknown")))))

(defn or-else (first-choice second-choice)
  (match first-choice
    ((some value) (some value))
    (none second-choice)))

(defn database-path (database)
  (match database
    ((some path) (ok (clone path)))
    (none (default-database-path))))

(defn perform (settings request)
  (match request
    ((new-roadmap name manager)
     (map-ok (new-roadmap settings name manager)
             roadmap-envelope))
    (list-roadmaps (map-ok (list-roadmaps settings) roadmaps-envelope))
    ((ready roadmap)
     (map-ok (ready-items settings roadmap) readiness-envelope))
    ((log item since)
     (map-ok (read-log settings item since) events-envelope))
    ((add-item roadmap draft)
     (map-ok (add-item settings roadmap draft) item-envelope))
    ((list-items roadmap)
     (map-ok (list-items settings roadmap) items-envelope))
    ((show-item id)
     (map-ok (show-item settings id) detail-envelope))
    ((claim id session)
     (map-ok (claim-item settings id session) item-envelope))
    ((advance id advancement)
     (map-ok (advance-item settings id advancement)
             item-envelope))
    ((close id) (map-ok (close-item settings id) item-envelope))
    ((drop id reason)
     (map-ok (drop-item settings id reason) item-envelope))
    ((add-dep item on)
     (map-ok (add-dep settings item on) dep-envelope))
    ((remove-dep item on)
     (map-ok (remove-dep settings item on) dep-envelope))))
