(module
  "Builds, reads, parses and prints JSON values, over `serde_json::Value`.")

(export array bool->json copy-of error->message field
        float->json int->json json json->bool json->float
        json->int json->items json->string json->text
        json-error null? object parse same? text->json)

(rust-type json-number "serde_json::Number")

(rust-type json-map
  "serde_json::Map<String, serde_json::Value>")

(defenum json
  (rust "serde_json::Value")
  null
  (bool bool)
  (number json-number)
  (string string)
  (array (vec json))
  (object json-map))

(defstruct json-error
  :cause string)

(defn error->message (failure)
  (str "invalid JSON: " (:cause failure)))

(def object
  (rust "serde_json::Value::Object({0}.into_iter().collect())"
    (fn ((vec (pair string json))) json)))

(defn array (items) (json/array items))

(defn text->json (text)
  (json/string (str text)))

(def int->json
  (rust "serde_json::Value::from({0})" (fn (int) json)))

(def float->json
  (rust "serde_json::Value::from({0})" (fn (float) json)))

(defn bool->json (flag) (json/bool flag))

(def entry
  (rust "{0}.get({1}).cloned()"
    (fn ((ref json-map) (ref str))
      (option json))))

(defn field (value key)
  (match value
    ((object entries) (entry entries key))
    (_ none)))

(defn json->text (value)
  (match value
    ((string text) (some (clone text)))
    (_ none)))

(def number->int
  (rust "{0}.as_i64()"
    (fn ((ref json-number)) (option int))))

(defn json->int (value)
  (match value
    ((number number) (number->int number))
    (_ none)))

(def number->float
  (rust "{0}.as_f64()"
    (fn ((ref json-number)) (option float))))

(defn json->float (value)
  (match value
    ((number number) (number->float number))
    (_ none)))

(defn json->bool (value)
  (match value
    ((bool flag) (some flag))
    (_ none)))

(defn json->items (value)
  (match value
    ((array items) (some (collect (map (iter items) copy-of))))
    (_ none)))

(defn null? (value)
  (match value (null true) (_ false)))

(def same?
  (rust "{0} == {1}"
    (fn ((ref json) (ref json)) bool)))

(def parse-raw
  (rust "serde_json::from_str::<serde_json::Value>({0}).map_err(|failure| failure.to_string())"
    (fn ((ref str)) (result json string))))

(defn parse (text)
  (map-err (parse-raw text)
    (fn (message) (->json-error :cause message))))

(def json->string
  (rust "{0}.to_string()"
    (fn ((ref json)) string)))

(def copy-of
  (rust "{0}.clone()"
    (fn ((ref json)) json)))
