(module
  "Builds, reads, parses and prints JSON values, over `serde_json::Value`.")

(export array bool->json error->message field float->json
        int->json json json->bool json->float json->int
        json->items json->string json->text json-error null
        null? object parse same? text->json)

(rust-type json "serde_json::Value")

(defstruct json-error
  :message string)

(defn error->message (failure)
  (str "invalid JSON: " (:message failure)))

(def object
  (rust "serde_json::Value::Object({0}.into_iter().collect())"
    (fn ((vec (pair string json))) json)))

(def array
  (rust "serde_json::Value::Array({0})"
    (fn ((vec json)) json)))

(def text->json
  (rust "serde_json::Value::String({0}.to_string())"
    (fn ((ref str)) json)))

(def int->json
  (rust "serde_json::Value::from({0})" (fn (int) json)))

(def float->json
  (rust "serde_json::Value::from({0})" (fn (float) json)))

(def bool->json
  (rust "serde_json::Value::Bool({0})" (fn (bool) json)))

(def null (rust "serde_json::Value::Null" json))

(def field
  (rust "{0}.get({1}).cloned()"
    (fn ((ref json) (ref str))
      (option json))))

(def json->text
  (rust "{0}.as_str().map(|text| text.to_string())"
    (fn ((ref json)) (option string))))

(def json->int
  (rust "{0}.as_i64()"
    (fn ((ref json)) (option int))))

(def json->float
  (rust "{0}.as_f64()"
    (fn ((ref json)) (option float))))

(def json->bool
  (rust "{0}.as_bool()"
    (fn ((ref json)) (option bool))))

(def json->items
  (rust "{0}.as_array().cloned()"
    (fn ((ref json)) (option (vec json)))))

(def null?
  (rust "{0}.is_null()"
    (fn ((ref json)) bool)))

(def same?
  (rust "{0} == {1}"
    (fn ((ref json) (ref json)) bool)))

(def parse-raw
  (rust "serde_json::from_str::<serde_json::Value>({0}).map_err(|failure| failure.to_string())"
    (fn ((ref str)) (result json string))))

(defn parse (text)
  (map-err (parse-raw text)
    (fn (message) (->json-error :message message))))

(def json->string
  (rust "{0}.to_string()"
    (fn ((ref json)) string)))
