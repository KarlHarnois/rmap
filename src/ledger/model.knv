(module
  "Holds the ledger's values: roadmaps, items, dependencies, globs and blockages.")

(export ->blockage ->dep ->glob ->item ->item-glob ->item-id
        ->path-conflict ->path-lock ->roadmap ->roadmap-id
        ->session ->snapshot ->timestamp blockage claim
        decision-id dep dep-type glob graph-format history
        item item-glob item-id kind origin path-conflict
        path-lock roadmap roadmap-id roadmap-status session
        snapshot status timestamp)

(defstruct roadmap-id
  :value string)

(defstruct item-id
  :value string)

(defstruct session
  :name string)

(defstruct glob
  :pattern string)

(defstruct timestamp
  :value string)

(defstruct decision-id
  :value string)

(defenum roadmap-status
  active
  paused
  done)

(defstruct roadmap
  :id roadmap-id
  :name string
  :manager session
  :status roadmap-status
  :created-at timestamp)

(defenum kind
  epic
  research
  design
  build)

(defenum status
  open
  dispatched
  reported
  in-review
  fixing
  merging
  merged
  accepted
  dropped)

(defenum origin
  planned
  user-bug
  follow-up)

(defenum claim
  unclaimed
  (claimed-by session))

(defstruct item
  :id item-id
  :roadmap-id roadmap-id
  :roadmap-name string
  :parent (option item-id)
  :title string
  :kind kind
  :status status
  :origin origin
  :priority int
  :claim claim
  :created-at timestamp
  :closed-at (option timestamp))

(defenum dep-type
  blocks
  discovered-from)

(defstruct dep
  :item item-id
  :on item-id
  :type dep-type)

(defstruct item-glob
  :item item-id
  :glob glob)

(defstruct path-lock
  :item item-id
  :kind kind
  :globs (vec glob))

(defstruct snapshot
  :items (vec item)
  :deps (vec dep)
  :globs (vec item-glob))

(defenum graph-format mermaid)

(defenum history
  without-merged
  with-merged)

(defstruct blockage
  :blockers (vec item-id)
  :dropped-blockers (vec item-id)
  :path-conflicts (vec path-conflict))

(defstruct path-conflict
  :with item-id
  :glob glob
  :other-glob glob)
