(module
  "Holds the ledger's values: roadmaps, items, dependencies and blockages.")

(export ->blockage ->decision-id ->dep ->item ->item-id
        ->roadmap ->roadmap-id ->session ->snapshot
        ->timestamp blockage claim decision-id dep dep-type
        graph-format history item item-id kind origin
        roadmap roadmap-id roadmap-status session snapshot
        status timestamp)

(defstruct decision-id
  :value string)

(defstruct roadmap
  :id roadmap-id
  :name string
  :manager session
  :status roadmap-status
  :created-at timestamp)

(defenum roadmap-status
  active
  paused
  done)

(defstruct snapshot
  :items (vec item)
  :deps (vec dep))

(defstruct item
  :id item-id
  :roadmap-id roadmap-id
  :roadmap-name string
  :parent (option item-id)
  :title string
  :description (option string)
  :kind kind
  :status status
  :origin origin
  :priority int
  :claim claim
  :created-at timestamp
  :closed-at (option timestamp))

(defstruct roadmap-id
  :value string)

(defstruct timestamp
  :value string)

(defenum kind
  epic
  research
  design
  build)

(defenum status
  open
  dispatched
  reported
  in-review
  fixing
  merging
  merged
  accepted
  dropped)

(defenum origin
  planned
  user-bug
  follow-up)

(defenum claim
  unclaimed
  (claimed-by session))

(defstruct session
  :name string)

(defstruct dep
  :item item-id
  :on item-id
  :type dep-type)

(defenum dep-type
  blocks
  discovered-from)

(defenum graph-format mermaid)

(defenum history
  without-merged
  with-merged)

(defstruct blockage
  :blockers (vec item-id)
  :dropped-blockers (vec item-id))

(defstruct item-id
  :value string)
