(module
  "Holds the ledger's values: roadmaps, items, their sessions, dependencies, decisions and blockages.")

(export ->blockage ->decision-block ->decision-id ->dep
        ->item ->item-id ->roadmap ->roadmap-id ->session
        ->snapshot ->timestamp ->work-session blockage claim
        decision-block decision-id decision-status dep
        dep-type graph-format history item item-id kind
        origin roadmap roadmap-id roadmap-pause
        roadmap-status runtime session session-kind snapshot
        status timestamp work-session)

(defstruct snapshot
  :roadmaps (vec roadmap)
  :items (vec item)
  :deps (vec dep)
  :decision-blocks (vec decision-block))

(defstruct decision-block
  :decision decision-id
  :item item-id
  :status decision-status)

(defstruct decision-id
  :value string)

(defenum decision-status
  proposed
  accepted
  rejected
  deprecated
  superseded)

(defstruct roadmap
  :id roadmap-id
  :name string
  :manager session
  :status roadmap-status
  :created-at timestamp)

(defenum roadmap-status
  active
  paused
  done)

(defstruct item
  :id item-id
  :roadmap-id roadmap-id
  :roadmap-name string
  :parent (option item-id)
  :title string
  :description (option string)
  :kind kind
  :status status
  :origin origin
  :priority int
  :claim claim
  :created-at timestamp
  :closed-at (option timestamp))

(defstruct roadmap-id
  :value string)

(defstruct timestamp
  :value string)

(defenum kind
  epic
  research
  design
  build)

(defenum status
  open
  dispatched
  reported
  in-review
  fixing
  merging
  merged
  accepted
  dropped)

(defenum origin
  planned
  user-bug
  follow-up)

(defenum claim
  unclaimed
  (claimed-by work-session))

(defstruct work-session
  :session session
  :kind session-kind
  :runtime runtime
  :branch (option string)
  :base (option string)
  :started-at timestamp)

(defenum session-kind
  work
  fix
  review)

(defenum runtime ringleader)

(defstruct session
  :name string)

(defstruct dep
  :item item-id
  :on item-id
  :type dep-type)

(defenum dep-type
  blocks
  discovered-from)

(defenum graph-format mermaid)

(defenum history
  without-merged
  with-merged)

(defstruct blockage
  :pause roadmap-pause
  :blockers (vec item-id)
  :dropped-blockers (vec item-id)
  :decisions (vec decision-id))

(defenum roadmap-pause
  not-paused
  paused)

(defstruct item-id
  :value string)
