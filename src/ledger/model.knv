(module
  "Holds the ledger's values: roadmaps, items, their sessions, dependencies, decisions and blockages.")

(use ledger/model/capacity capacity)

(use ledger/model/decision-refs ->decision-block
                                ->decision-id decision-block
                                decision-id decision-status)

(use ledger/model/exclusive-items ->exclusive-item
                                  exclusive-hold
                                  exclusive-item)

(use ledger/model/items ->item ->item-id ->roadmap-id
                        ->session ->timestamp ->work-session
                        claim exclusivity item item-id kind
                        origin roadmap-id runtime session
                        session-kind status timestamp
                        work-session)

(use ledger/model/roadmap-pauses roadmap-pause)

(export ->blockage ->decision-block ->decision-id ->dep
        ->exclusive-item ->external-blocker
        ->external-blocker-id ->item ->item-id ->roadmap
        ->roadmap-id ->session ->snapshot ->timestamp
        ->work-session blockage claim decision-block
        decision-id decision-status dep dep-type
        exclusive-hold exclusive-item exclusivity
        external-blocker external-blocker-id item item-id
        kind origin roadmap roadmap-id roadmap-status
        runtime session session-kind snapshot status
        timestamp work-session)

(defstruct snapshot
  :roadmaps (vec roadmap)
  :items (vec item)
  :deps (vec dep)
  :decision-blocks (vec decision-block)
  :external-blockers (vec external-blocker))

(defstruct external-blocker
  :id external-blocker-id
  :item item-id
  :text string
  :created-at timestamp
  :created-by string
  :cleared-at (option timestamp)
  :cleared-by (option string)
  :clear-note (option string))

(defstruct external-blocker-id
  :value string)

(defstruct blockage
  :pause roadmap-pause
  :blockers (vec item-id)
  :dropped-blockers (vec item-id)
  :decisions (vec decision-id)
  :capacity (option capacity)
  :external-blockers (vec external-blocker)
  :exclusive (option exclusive-hold))

(defstruct roadmap
  :id roadmap-id
  :name string
  :manager session
  :status roadmap-status
  :max-active (option int)
  :created-at timestamp)

(defenum roadmap-status
  active
  paused
  done)

(defstruct dep
  :item item-id
  :on item-id
  :type dep-type)

(defenum dep-type
  blocks
  discovered-from)
