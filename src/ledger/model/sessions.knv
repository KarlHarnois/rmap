(module
  "Holds what a claim asks for, a live session with its id, and why and when a session ends.")

(use ledger/model session timestamp)

(export ->claim-request ->live-session ->session-end
        ->session-id ->session-start claim-request
        end-reason live-session session-end session-id
        session-start)

(defstruct claim-request
  :session session
  :branch (option string)
  :base (option string))

(defstruct session-start
  :session session
  :branch string
  :base string)

(defstruct live-session
  :id session-id
  :session session)

(defstruct session-end
  :reason end-reason
  :at timestamp)

(defenum end-reason
  reopened
  replaced
  finished
  superseded)

(defstruct session-id
  :value int)
