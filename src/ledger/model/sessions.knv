(module
  "Holds what a claim asks for, a live session with its id, and why and when a session ends.")

(use ledger/model item item-id session session-kind
                  timestamp)

(export ->claim-request ->ended-session ->live-session
        ->session-end ->session-id ->session-start
        claim-request end-reason ended-session live-session
        session-end session-id session-start)

(defstruct claim-request
  :session session
  :branch (option string)
  :base (option string))

(defstruct session-start
  :session session
  :branch string
  :base string)

(defstruct live-session
  :id session-id
  :session session
  :item item-id
  :kind session-kind)

(defstruct ended-session
  :item item
  :session session
  :kind session-kind
  :reason string
  :end session-end)

(defstruct session-end
  :reason end-reason
  :at timestamp)

(defenum end-reason
  reopened
  replaced
  finished
  superseded
  abandoned)

(defstruct session-id
  :value int)
