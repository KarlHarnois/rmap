(module
  "Holds what a claim asks for, why and when a session ends, and a session recorded as already finished.")

(use ledger/model session timestamp work-session)

(export ->claim-request ->finished-session ->session-end
        ->session-id ->session-start claim-request
        end-reason finished-session session-end session-id
        session-start)

(defstruct claim-request
  :session session
  :branch (option string)
  :base (option string))

(defstruct session-start
  :session session
  :branch string
  :base string)

(defstruct finished-session
  :id session-id
  :session work-session
  :end session-end)

(defstruct session-end
  :reason end-reason
  :at timestamp)

(defenum end-reason
  reopened
  replaced
  finished)

(defstruct session-id
  :value int)
