(module
  "Holds the ledger's events: what changed, who changed it and when.")

(export ->event ->event-draft ->event-stamp event
        event-draft event-stamp event-type)

(use json/value json)
(use ledger/model decision-id item-id roadmap-id timestamp)

(defstruct event-stamp
  :at timestamp
  :actor string)

(defstruct event-draft
  :roadmap-id (option roadmap-id)
  :item-id (option item-id)
  :decision-id (option decision-id)
  :type event-type
  :payload json)

(defstruct event
  :id int
  :at timestamp
  :actor string
  :roadmap-id (option roadmap-id)
  :item-id (option item-id)
  :decision-id (option decision-id)
  :type event-type
  :payload json)

(defenum event-type
  roadmap-created
  roadmap-paused
  roadmap-resumed
  item-added
  item-claimed
  item-advanced
  item-closed
  item-dropped
  edited
  dep-added
  dep-removed
  decision-proposed
  decision-revised
  decision-asked
  decision-accepted
  decision-rejected
  decision-deprecated
  decision-block-added
  decision-block-removed
  item-reported
  report-read
  item-reviewed
  criterion-verified
  head-recorded
  review-started
  session-ended
  proposals-recorded)
