(module
  "Holds the ledger's reports: what a worker's session tells the manager about its item, and whether the manager read it.")

(use ledger/model item item-id session timestamp)

(export ->recorded-report ->report ->report-id
        ->report-query ->report-request ->session-id
        body-source recorded-report report report-id
        report-kind report-query report-reading
        report-request session-id)

(defstruct recorded-report
  :report report
  :item item)

(defstruct report-request
  :item item-id
  :session session
  :kind report-kind
  :body body-source)

(defstruct report
  :id report-id
  :item item-id
  :session-id session-id
  :session session
  :kind report-kind
  :body string
  :created-at timestamp
  :read-at (option timestamp))

(defstruct report-query
  :item (option item-id)
  :reading report-reading)

(defenum report-reading
  every-report
  unread-only)

(defstruct report-id
  :value int)

(defstruct session-id
  :value int)

(defenum report-kind
  done
  fixed
  question)

(defenum body-source
  (text string)
  (file string)
  stdin)
