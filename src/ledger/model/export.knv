(module
  "Holds one snapshot of the whole ledger: every record kind the export document lists.")

(use ledger/model ->item-id blockage decision-id dep
                  external-blocker item item-id kind roadmap
                  timestamp)

(use ledger/model/criteria criterion-verdict)
(use json/value json)
(use ledger/model/events event)
(use ledger/model/sessions session-record)
(use ledger/model/decisions decision decision-option-record)

(use ledger/model/pull-requests approval pull-request
                                review)

(use ledger/model/reports report)

(export ->export-item ->export-item-proposal
        ->export-option-skip ->export-proposal-criterion
        ->export-proposal-dep ->export-pull-request
        ->ledger-export export-item export-item-proposal
        export-option-skip export-proposal-criterion
        export-proposal-dep export-pull-request
        ledger-export)

(defstruct ledger-export
  :exported-at timestamp
  :export-roadmaps (vec roadmap)
  :export-items (vec export-item)
  :export-criteria (vec json)
  :export-criterion-verdicts (vec criterion-verdict)
  :export-deps (vec dep)
  :export-sessions (vec session-record)
  :export-reports (vec report)
  :export-pull-requests (vec export-pull-request)
  :export-reviews (vec review)
  :export-decisions (vec decision)
  :export-decision-options (vec decision-option-record)
  :export-decision-option-points (vec json)
  :export-decision-blocks (vec json)
  :export-external-blockers (vec external-blocker)
  :export-rulings (vec json)
  :export-events (vec event)
  :export-item-proposals (vec json)
  :export-proposal-criteria (vec json)
  :export-proposal-deps (vec json)
  :export-option-skips (vec json))

(defstruct export-item
  :exported-item item
  :item-ready bool
  :item-blockage (option blockage))

(defstruct export-pull-request
  :exported-pull-request pull-request
  :request-approved bool
  :request-approval approval)

(defstruct export-item-proposal
  :item item-id
  :proposal string
  :position int
  :title string
  :kind kind
  :priority int
  :description string
  :decision (option decision-id)
  :decision-option (option int)
  :created-item (option item-id))

(defstruct export-proposal-criterion
  :item item-id
  :proposal string
  :position int
  :text string)

(defstruct export-proposal-dep
  :item item-id
  :proposal string
  :position int
  :on-id string)

(defstruct export-option-skip
  :decision decision-id
  :option int
  :position int
  :proposal string)
