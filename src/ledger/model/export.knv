(module
  "Holds one snapshot of the whole ledger: every record kind the export document lists.")

(use ledger/model blockage decision-block dep item roadmap
                  timestamp)

(use ledger/model/criteria criterion)
(use ledger/model/events event)
(use ledger/model/sessions session-record)
(use ledger/model/decisions decision decision-option-record)

(use ledger/model/pull-requests approval pull-request
                                review)

(use ledger/model/reports report)
(use ledger/model/rulings ruling)

(export ->export-item ->export-pull-request ->ledger-export
        export-item export-pull-request ledger-export)

(defstruct ledger-export
  :exported-at timestamp
  :export-roadmaps (vec roadmap)
  :export-items (vec export-item)
  :export-criteria (vec criterion)
  :export-deps (vec dep)
  :export-sessions (vec session-record)
  :export-reports (vec report)
  :export-pull-requests (vec export-pull-request)
  :export-reviews (vec review)
  :export-decisions (vec decision)
  :export-decision-options (vec decision-option-record)
  :export-decision-blocks (vec decision-block)
  :export-rulings (vec ruling)
  :export-events (vec event))

(defstruct export-item
  :exported-item item
  :item-ready bool
  :item-blockage (option blockage))

(defstruct export-pull-request
  :exported-pull-request pull-request
  :request-approved bool
  :request-approval approval)
