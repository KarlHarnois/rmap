(module
  "Holds the ledger's decisions: a question for the owner, the options it weighs and the option recommended.")

(use ledger/model decision-id decision-status item-id
                  roadmap-id timestamp)

(export ->decision ->decision-option ->decision-option-point
        ->decision-option-record ->option-draft ->outcome
        ->proposal ->recommendation decision decision-option
        decision-option-point decision-option-record
        option-draft outcome proposal recommendation)

(defstruct proposal
  :title string
  :context string
  :options (vec option-draft)
  :recommendation recommendation)

(defstruct option-draft
  :title string
  :description string
  :pros (vec string)
  :cons (vec string))

(defstruct recommendation
  :option int
  :reason string)

(defstruct decision
  :id decision-id
  :roadmap-id roadmap-id
  :roadmap-name string
  :item (option item-id)
  :title string
  :context string
  :status decision-status
  :options (vec decision-option)
  :recommendation recommendation
  :outcome (option outcome)
  :deprecation-reason (option string)
  :supersedes (option decision-id)
  :superseded-by (option decision-id)
  :blocks (vec item-id)
  :asked-at (option timestamp)
  :created-at timestamp)

(defstruct decision-option
  :number int
  :title string
  :description string
  :pros (vec string)
  :cons (vec string))

(defstruct decision-option-record
  :decision decision-id
  :option decision-option)

(defstruct decision-option-point
  :point-decision decision-id
  :point-number int
  :point-side string
  :point-position int
  :point-text string)

(defstruct outcome
  :option (option int)
  :justification string
  :consequences (option string)
  :decided-by string
  :decided-at timestamp)
