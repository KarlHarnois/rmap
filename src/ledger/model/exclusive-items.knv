(module
  "Holds whether an item runs alone across the repository, and the exclusive item another item waits for.")

(use ledger/model/items ->item-id exclusivity item-id)

(export ->exclusive-item exclusive-hold exclusive-item
        exclusivity-names)

(def exclusivity-names
  (vec (pair exclusivity/not-exclusive "not-exclusive")
       (pair exclusivity/exclusive "exclusive")))

(defenum exclusive-hold
  (held-by exclusive-item)
  (waits-on exclusive-item (vec item-id)))

(defstruct exclusive-item
  :id item-id
  :roadmap-name string)
