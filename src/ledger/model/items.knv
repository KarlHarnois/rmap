(module
  "Holds an item, its identifier, roadmap and times, and the values it takes.")

(export ->item ->item-id ->roadmap-id ->session ->timestamp
        ->work-session claim exclusivity item item-id kind
        origin roadmap-id runtime session session-kind
        status timestamp work-session)

(defstruct item
  :id item-id
  :roadmap-id roadmap-id
  :roadmap-name string
  :parent (option item-id)
  :title string
  :description (option string)
  :criteria (vec string)
  :kind kind
  :status status
  :origin origin
  :priority int
  :exclusive exclusivity
  :claim claim
  :created-at timestamp
  :closed-at (option timestamp))

(defenum claim
  unclaimed
  (claimed-by work-session))

(defstruct work-session
  :session session
  :kind session-kind
  :runtime runtime
  :branch (option string)
  :base (option string)
  :started-at timestamp)

(defenum session-kind
  work
  fix
  review)

(defenum runtime ringleader)

(defstruct session
  :name string)

(defstruct timestamp
  :value string)

(defstruct item-id
  :value string)

(defstruct roadmap-id
  :value string)

(defenum kind
  epic
  research
  design
  build)

(defenum status
  open
  dispatched
  reported
  in-review
  fixing
  merging
  merged
  accepted
  dropped)

(defenum origin
  planned
  user-bug
  follow-up)

(defenum exclusivity
  not-exclusive
  exclusive)
