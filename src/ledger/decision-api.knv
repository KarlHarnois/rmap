(module
  "Holds the decisions part of the ledger's public surface: the values, the proposal and settlement operations, the queries and the JSON helpers.")

(use ledger/model ->decision-id decision-id decision-status)

(use ledger/model/decisions ->option-draft ->proposal
                            ->recommendation decision
                            decision-option option-draft outcome
                            proposal recommendation)

(use ledger/core/decisions ->decision-revision
                           ->new-decision decision-revision
                           new-decision supersedes-change)

(use ledger/operations/decisions propose-decision
                                 revise-decision)

(use ledger/operations/decision-blocks add-decision-block
                                        remove-decision-block)

(use ledger/core/decision-moves ->acceptance acceptance)

(use ledger/operations/decision-moves accept-decision
                                      ask-decision
                                      deprecate-decision
                                      reject-decision)

(use ledger/operations/decision-queries ->decision-query
                                        decision-query
                                        list-decisions
                                        show-decision)

(use ledger/decision-columns optional-decision-id->json
                             options->json)

(use ledger/names decision-status-names)

(export ->acceptance ->decision-id ->decision-query
        ->decision-revision ->new-decision ->option-draft
        ->proposal ->recommendation accept-decision
        acceptance add-decision-block ask-decision decision
        decision-id
        decision-option decision-query decision-revision
        decision-status decision-status-names
        deprecate-decision list-decisions new-decision
        option-draft optional-decision-id->json
        options->json outcome proposal propose-decision
        recommendation reject-decision remove-decision-block
        revise-decision show-decision supersedes-change)
