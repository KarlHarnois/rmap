(module
  "Describes each refusal code in a sentence and catalogs them.")

(use ledger/refusal-code-of code-of)
(use ledger/refusal-description refusal-description)
(use ledger/pull-request-refusal-codes pull-request-catalog)
(use ledger/criterion-refusal-text criterion-refusal-catalog)
(use ledger/proposal-refusal-text proposal-refusal-catalog)

(use ledger/general-refusal-text general-refusal-catalog
                                 general-refusal-description)

(export refusal-catalog refusal-code-text
        refusal-description)

(defn refusal-code-text (refused)
  (clone (:code (general-refusal-description (code-of refused)))))

(defn refusal-catalog ()
  (let (catalog (general-refusal-catalog))
    (for-each (pull-request-catalog)
      (fn (description)
        (push! catalog (clone description))))
    (for-each (criterion-refusal-catalog)
      (fn (description)
        (push! catalog (clone description))))
    (for-each (proposal-refusal-catalog)
      (fn (description)
        (push! catalog (clone description))))
    catalog))
