(module
  "Describes what a pull request and its reviews add to events: the pull request a report opens or the head it pushes, and the event of a review.")

(use json/value int->json json text->json)
(use ledger/model item timestamp)
(use ledger/model/sessions finished-session)

(use ledger/model/events ->event-draft event-draft
                         event-type)

(use ledger/model/pull-requests pull-request review)

(use ledger/names case-name end-reason-names
                  review-kind-names runtime-names
                  session-kind-names verdict-names)

(use ledger/core/pull-requests pr-change)
(use ledger/json-values id->json)

(use ledger/changes column-change copy-change inserted
                    payload-with-changes updated)

(export item-reviewed pr-change-columns)

(defn pr-change-columns (existing change opened-at)
  (match change
    (unchanged (vec))
    ((opened number head)
     (vec (inserted "pr_number" (int->json (:value number)))
          (inserted "head_sha" (head->json head))
          (inserted "opened_at" (opened-at->json opened-at))))
    ((pushed head)
     (vec (updated "head_sha"
                   (previous-head->json existing)
                   (head->json head))))))

(type item-reviewed
  (fn ((ref item)
       (ref review)
       (ref finished-session)
       (ref pull-request))
    event-draft))

(defn item-reviewed (item review session pull-request)
  (let (changes (review-columns review))
    (for-each (session-columns session)
      (fn (change)
        (push! changes (copy-change change))))
    (->event-draft :roadmap-id (some (clone (:roadmap-id item)))
                   :item-id (some (clone (:id item)))
                   :decision-id none
                   :type event-type/item-reviewed
                   :payload (payload-with-changes
                              (ref changes)
                              (review-context review pull-request)))))

(type review-columns
  (fn ((ref review)) (vec column-change)))

(defn review-columns (review)
  (vec (inserted "item_id"
                 (id->json (ref (:item review))))
       (inserted "session_id"
                 (int->json (:value (:session-id review))))
       (inserted "review_kind"
                 (text->json (case-name review-kind-names (:kind review))))
       (inserted "head_sha"
                 (head->json (ref (:head review))))
       (inserted "verdict"
                 (text->json (case-name verdict-names (:verdict review))))
       (inserted "created_at"
                 (text->json (as-str (:value (:created-at review)))))))

(type session-columns
  (fn ((ref finished-session))
    (vec column-change)))

(defn session-columns (finished)
  (let (session (ref (:session finished)))
    (vec (inserted "session"
                   (text->json (as-str (:name (:session session)))))
         (inserted "session_kind"
                   (text->json (case-name session-kind-names (:kind session))))
         (inserted "runtime"
                   (text->json (case-name runtime-names (:runtime session))))
         (inserted "started_at"
                   (text->json (as-str (:value (:started-at session)))))
         (inserted "ended_at"
                   (text->json (as-str (:value (:at (:end finished))))))
         (inserted "end_reason"
                   (text->json (case-name end-reason-names
                                          (:reason (:end finished))))))))

(type review-context
  (fn ((ref review) (ref pull-request))
    (vec (pair string json))))

(defn review-context (review pull-request)
  (vec (pair (str "review_id")
             (int->json (:value (:id review))))
       (pair (str "pr_number")
             (int->json (:value (:pr-number pull-request))))))

(defn head->json (head)
  (text->json (as-str (:sha head))))

(type previous-head->json
  (fn ((ref (option pull-request))) json))

(defn previous-head->json (existing)
  (match existing
    ((some pull-request)
     (head->json (ref (:head pull-request))))
    (none json/null)))

(type opened-at->json
  (fn ((ref timestamp)) json))

(defn opened-at->json (at)
  (text->json (as-str (:value at))))
