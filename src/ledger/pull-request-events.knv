(module
  "Describes what a pull request adds to events: the pull request a report opens or the head it pushes, and the event of a head the manager records.")

(use json/value int->json json text->json)
(use ledger/model timestamp)

(use ledger/model/events ->event-draft event-draft
                         event-type)

(use ledger/model/sessions session-end)
(use ledger/model/pull-requests pull-request)
(use ledger/core/pull-requests pr-change)
(use ledger/move-events applied-move move-changes)

(use ledger/changes column-change copy-change inserted
                    payload-with-changes updated)

(use ledger/session-columns optional-ended-session-columns)
(use ledger/json-values head->json pr-number->json)

(export head-recorded pr-change-columns)

(defn pr-change-columns (existing change opened-at)
  (match change
    (unchanged (vec))
    ((opened number head)
     (vec (inserted "pr_number" (int->json (:value number)))
          (inserted "head_sha" (head->json head))
          (inserted "opened_at" (opened-at->json opened-at))))
    ((pushed head)
     (vec (updated "head_sha"
                   (previous-head->json existing)
                   (head->json head))))))

(type head-recorded
  (fn ((ref applied-move)
       (ref (vec column-change))
       (ref (option session-end))
       (ref pull-request))
    event-draft))

(defn head-recorded (applied pr-changes review-end pull-request)
  (let (changes (move-changes applied))
    (for-each pr-changes
      (fn (change)
        (push! changes (copy-change change))))
    (for-each (optional-ended-session-columns review-end)
      (fn (change)
        (push! changes (copy-change change))))
    (->event-draft :roadmap-id (some (clone (:roadmap-id (:after applied))))
                   :item-id (some (clone (:id (:after applied))))
                   :decision-id none
                   :type event-type/head-recorded
                   :payload (payload-with-changes (ref changes)
                                                  (pr-number-context
                                                    pull-request)))))

(defn pr-number-context (pull-request)
  (vec (pair (str "pr_number")
             (pr-number->json (:pr-number pull-request)))))

(type previous-head->json
  (fn ((ref (option pull-request))) json))

(defn previous-head->json (existing)
  (match existing
    ((some pull-request)
     (head->json (ref (:head pull-request))))
    (none json/null)))

(type opened-at->json
  (fn ((ref timestamp)) json))

(defn opened-at->json (at)
  (text->json (as-str (:value at))))
