(module
  "Holds the reviews part of the ledger's public surface: a build's pull request, the head it points at, and the reviews that approve it.")

(use ledger/model/pull-requests ->review-request
                                ->review-start-request
                                approval head pull-request
                                recorded-head
                                recorded-review review
                                review-request
                                review-start-request)

(use ledger/operations/head-records record-head)
(use ledger/operations/pull-requests show-pull-request)
(use ledger/operations/review-starts start-review)
(use ledger/operations/reviews record-review)
(use ledger/core/requirements approval-of approved?)
(use ledger/names review-kind-names verdict-names)

(export ->review-request ->review-start-request approval
        approval-of approved? head pull-request record-head
        record-review recorded-head recorded-review review
        review-kind-names review-request
        review-start-request show-pull-request start-review
        verdict-names)
