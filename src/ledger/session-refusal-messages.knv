(module
  "Gives each session refusal its one-line sentence for the user.")

(use ledger/refusal refusal)

(export session-refusal->message)

(defn session-refusal->message (failure)
  (match failure
    ((session-busy session)
     (str "a live session is already named " (:name session)))
    ((session-not-live session)
     (str "the session " (:name session) " is not live"))
    ((session-not-claimant session item)
     (str "the session "
          (:name session)
          " is not the live session of "
          (:value item)))
    (_ (str "not a session refusal"))))
