(module
  "Describes each ledger change as an event to record.")

(use json/value text->json)
(use ledger/model dep glob item roadmap)

(use ledger/model/events ->event-draft event-draft
                         event-type)

(use ledger/names case-name dep-type-names
                  roadmap-status-names)

(use ledger/core/move move)

(use ledger/json-values globs->json id->json ids->json
                        item->columns optional-ids->json)

(use ledger/changes column-change deleted inserted
                    inserted-columns only-changed
                    payload-with-changes updated
                    updated-columns)

(use ledger/core/new-items new-item)
(use ledger/core/deps dep-change)

(export ->applied-move applied-move dep-changed item-added
        item-moved roadmap-created)

(defstruct applied-move
  :before item
  :after item
  :globs-before (vec glob)
  :globs-after (vec glob)
  :move move)

(type roadmap-created
  (fn ((ref roadmap)) event-draft))

(defn roadmap-created (roadmap)
  (->event-draft :roadmap-id (some (clone (:id roadmap)))
                 :item-id none
                 :type event-type/roadmap-created
                 :payload (payload-with-changes (ref (roadmap-insert-changes
                                                       roadmap))
                                                (vec))))

(type item-added
  (fn ((ref item) (ref new-item))
    event-draft))

(defn item-added (item request)
  (->event-draft :roadmap-id (some (clone (:roadmap-id item)))
                 :item-id (some (clone (:id item)))
                 :type event-type/item-added
                 :payload (payload-with-changes
                            (ref (item-insert-changes item request))
                            (vec))))

(type dep-changed
  (fn ((ref item) (ref dep) dep-change)
    event-draft))

(defn dep-changed (owner dep change)
  (->event-draft :roadmap-id (some (clone (:roadmap-id owner)))
                 :item-id (some (clone (:item dep)))
                 :type (dep-change->event-type change)
                 :payload (payload-with-changes (ref (dep-row-changes dep
                                                                      change))
                                                (vec))))

(defn item-moved (applied)
  (->event-draft :roadmap-id (some (clone (:roadmap-id (:after applied))))
                 :item-id (some (clone (:id (:after applied))))
                 :type (event-type-of (ref (:move applied)))
                 :payload (payload-with-changes (ref (move-changes applied))
                                                (move-context (ref (:move applied))))))

(type roadmap-insert-changes
  (fn ((ref roadmap)) (vec column-change)))

(defn roadmap-insert-changes (roadmap)
  (vec (inserted "name"
                 (text->json (as-str (:name roadmap))))
       (inserted "manager_session"
                 (text->json (as-str (:name (:manager roadmap)))))
       (inserted "status"
                 (text->json (case-name roadmap-status-names
                                        (:status roadmap))))))

(type item-insert-changes
  (fn ((ref item) (ref new-item))
    (vec column-change)))

(defn item-insert-changes (item request)
  (let (changes (inserted-columns (ref (item->columns item))))
    (push! changes
           (inserted "paths"
                     (globs->json (ref (:globs request)))))
    (push! changes
           (inserted "blocked_by"
                     (ids->json (ref (:blocked-by request)))))
    (push! changes
           (inserted "discovered_from"
                     (optional-ids->json (ref (:discovered-from request)))))
    changes))

(defn dep-row-changes (dep change)
  (let (on (id->json (ref (:on dep)))
        type (text->json (case-name dep-type-names (:type dep))))
    (match change
      (add (vec (inserted "on_id" on) (inserted "type" type)))
      (remove (vec (deleted "on_id" on) (deleted "type" type))))))

(defn dep-change->event-type (change)
  (match change
    (add event-type/dep-added)
    (remove event-type/dep-removed)))

(defn event-type-of (move)
  (match move
    ((claim _) event-type/item-claimed)
    ((advance _) event-type/item-advanced)
    ((advance-to-build _) event-type/item-advanced)
    (close event-type/item-closed)
    ((drop _) event-type/item-dropped)))

(defn move-changes (applied)
  (let (changes (updated-columns (ref (item->columns (ref (:before applied))))
                                 (ref (item->columns (ref (:after applied))))))
    (push! changes
           (updated "paths"
                    (globs->json (ref (:globs-before applied)))
                    (globs->json (ref (:globs-after applied)))))
    (only-changed changes)))

(defn move-context (move)
  (match move
    ((drop reason)
     (vec (pair (str "reason")
                (text->json (as-str reason)))))
    (_ (vec))))
