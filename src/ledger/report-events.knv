(module
  "Describes the events of a report: the report a session records with the move it makes, and the manager reading it.")

(use json/value int->json json text->json)
(use ledger/model/reports report)
(use ledger/model/sessions session-end)

(use ledger/model/events ->event-draft event-draft
                         event-type)

(use ledger/names case-name report-kind-names)
(use ledger/move-events applied-move move-changes)

(use ledger/session-columns optional-ended-session-columns
                            session-changes)

(use ledger/json-values id->json optional-timestamp->json)

(use ledger/changes column-change copy-change inserted
                    payload-with-changes updated)

(export item-reported report-read)

(type item-reported
  (fn ((ref applied-move)
       (ref report)
       (ref (option session-end))
       (ref (vec column-change)))
    event-draft))

(defn item-reported (applied report review-end pr-changes)
  (let (changes (report-insert-changes report))
    (for-each (move-changes applied)
      (fn (change)
        (push! changes (copy-change change))))
    (for-each (optional-ended-session-columns review-end)
      (fn (change)
        (push! changes (copy-change change))))
    (for-each pr-changes
      (fn (change)
        (push! changes (copy-change change))))
    (report-event (ref (:after applied))
                  report event-type/item-reported
                  (ref changes))))

(defn report-read (before report change)
  (let (changes (vec (updated "read_at" json/null
                              (optional-timestamp->json (ref (:read-at
                                                               report))))))
    (for-each (session-changes before change)
      (fn (change)
        (push! changes (copy-change change))))
    (report-event before report event-type/report-read
                  (ref changes))))

(type report-insert-changes
  (fn ((ref report)) (vec column-change)))

(defn report-insert-changes (report)
  (vec (inserted "item_id"
                 (id->json (ref (:item report))))
       (inserted "session_id"
                 (int->json (:value (:session-id report))))
       (inserted "report_kind"
                 (text->json (case-name report-kind-names (:kind report))))
       (inserted "body"
                 (text->json (as-str (:body report))))
       (inserted "created_at"
                 (text->json (as-str (:value (:created-at report)))))
       (inserted "read_at"
                 (optional-timestamp->json (ref (:read-at report))))))

(defn report-event (item report type changes)
  (->event-draft :roadmap-id (some (clone (:roadmap-id item)))
                 :item-id (some (clone (:id item)))
                 :decision-id none
                 :type type
                 :payload (payload-with-changes changes
                                                (report-context report))))

(defn report-context (report)
  (vec (pair (str "report_id")
             (int->json (:value (:id report))))))
