(module
  "Names each way a ledger operation can fail, with its stable code and a message for the user.")

(use ledger/refusal refusal refusal->message)
(use ledger/refusal-text refusal-code-text)

(use ledger/sqlite/connection database-error
                              database-problem)

(export failure failure-code failure-message)

(defenum failure
  (refused refusal)
  (database database-error)
  (description-unreadable string)
  (no-repository string)
  (no-ledger string))

(defn failure-code (failure)
  (match failure
    ((refused refusal) (refusal-code-text refusal))
    ((database problem) (database-code problem))
    ((description-unreadable _) (str "description-unreadable"))
    ((no-repository _) (str "no-repository"))
    ((no-ledger _) (str "no-ledger"))))

(defn failure-message (failure)
  (match failure
    ((refused refusal) (refusal->message refusal))
    ((database problem) (clone (:message problem)))
    ((description-unreadable message) (clone message))
    ((no-repository detail)
     (str "rmap needs a git repository or --db: " detail))
    ((no-ledger path)
     (str "no ledger at " path "; run `rmap init` to create it"))))

(defn database-code (problem)
  (match (:problem problem)
    (database-problem/busy (str "busy"))
    ((database-problem/too-new _) (str "ledger-too-new"))
    (database-problem/failed (str "database"))))
