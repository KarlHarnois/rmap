(module
  "Describes each change to a decision as an event to record.")

(use json/value array json object text->json)
(use ledger/model/decisions decision)
(use ledger/model/events ->event-draft event-type)
(use ledger/names case-name decision-status-names)
(use ledger/json-values ids->json)

(use ledger/decision-columns decision->columns
                             options->json)

(use ledger/changes inserted-columns only-changed
                    payload-with-changes updated-columns)

(export decision-accepted decision-asked decision-deprecated
        decision-proposed decision-rejected
        decision-revised)

(defn decision-proposed (decision)
  (decision-event decision event-type/decision-proposed
                  (payload-with-changes
                    (ref (inserted-columns (ref (decision->columns decision))))
                    (vec (old-and-new "options"
                                      (array (vec))
                                      (options->json (ref (:options decision))))
                         (old-and-new "blocks"
                                      (array (vec))
                                      (ids->json (ref (:blocks decision))))))))

(defn decision-revised (before after)
  (decision-event after event-type/decision-revised
                  (payload-with-changes (ref (changed-columns before after))
                                        (option-changes before after))))

(defn decision-asked (before after)
  (decision-event after event-type/decision-asked
                  (payload-with-changes (ref (changed-columns before after))
                                        (vec))))

(defn decision-accepted (before after superseded)
  (decision-event after event-type/decision-accepted
                  (payload-with-changes
                    (ref (changed-columns before after))
                    (accepted-context before after superseded))))

(defn decision-rejected (before after)
  (decision-event after event-type/decision-rejected
                  (payload-with-changes (ref (changed-columns before after))
                                        (vec))))

(defn decision-deprecated (before after)
  (decision-event after event-type/decision-deprecated
                  (payload-with-changes (ref (changed-columns before after))
                                        (vec))))

(defn changed-columns (before after)
  (only-changed (updated-columns (ref (decision->columns before))
                                 (ref (decision->columns after)))))

(defn option-changes (before after)
  (if (= (:options before) (:options after))
    (vec)
    (vec (old-and-new "options"
                      (options->json (ref (:options before)))
                      (options->json (ref (:options after)))))))

(defn accepted-context (before after superseded)
  (match superseded
    ((some target)
     (vec (blocks-change before after)
          (pair (str "superseded") (superseded-json target))))
    (none (vec))))

(defn blocks-change (before after)
  (old-and-new "blocks"
               (ids->json (ref (:blocks before)))
               (ids->json (ref (:blocks after)))))

(defn decision-event (decision type payload)
  (->event-draft :roadmap-id (some (clone (:roadmap-id decision)))
                 :item-id (clone (:item decision))
                 :decision-id (some (clone (:id decision)))
                 :type type
                 :payload payload))

(type superseded-json
  (fn ((ref decision)) json))

(defn superseded-json (before)
  (object (vec (pair (str "decision")
                     (text->json (as-str (:value (:id before)))))
               (pair (str "changes")
                     (object (vec (old-and-new "status"
                                               (status-json before)
                                               (text->json (str
                                                             "superseded"))))))
               (pair (str "blocks")
                     (object (vec (pair (str "old")
                                        (ids->json (ref (:blocks before))))
                                  (pair (str "new") (array (vec)))))))))

(defn status-json (decision)
  (text->json (case-name decision-status-names (:status decision))))

(defn old-and-new (key old new)
  (pair (str key)
        (object (vec (pair (str "old") old)
                     (pair (str "new") new)))))
