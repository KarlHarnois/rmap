(module
  "Gives each ledger refusal its one-line sentence for the user.")

(use ledger/refusal refusal)
(use ledger/pull-request-refusals pull-request-refusal->message)

(use ledger/names case-name decision-status-names
                  status-names)

(use ledger/criterion-refusal-messages criterion-refusal->message)
(use ledger/proposal-refusal-messages proposal-refusal->message)
(use ledger/session-refusal-messages session-refusal->message)
(use ledger/refusal-details not-ready-message)

(export refusal->message)

(defn refusal->message (failure)
  (match failure
    ((roadmap-not-found name) (str "no roadmap is named " name))
    ((roadmap-exists name)
     (str "a roadmap named " name " already exists"))
    ((roadmap-already-paused name)
     (str "the roadmap " name " is already paused"))
    ((roadmap-not-paused name)
     (str "the roadmap " name " is not paused"))
    ((max-active-out-of-range count)
     (str "a max active must be at least 1, got " count))
    ((item-not-found id)
     (str "no item has the id " (:value id)))
    ((item-closed id)
     (str "the item " (:value id) " is closed"))
    ((exclusive-not-open status)
     (str "the item is "
          (case-name status-names status)
          ", and only an open item can become exclusive"))
    (description-required (str "an item needs a description"))
    (criteria-required (str "an item needs at least one acceptance criterion"))
    (blank-criterion (str "an acceptance criterion cannot be blank"))
    ((parent-not-epic id)
     (str "the parent " (:value id) " is not an epic"))
    ((parent-in-other-roadmap id)
     (str "the parent "
          (:value id)
          " belongs to another roadmap"))
    (epic-has-parent (str "an epic cannot have a parent"))
    ((priority-out-of-range priority)
     (str "a priority must be from 0 (highest) to 4 (lowest), got "
          priority))
    (epic-status-computed (str
                            "an epic's status is computed from its children"))
    (invalid-kind-change (str "only an advance to dispatched can turn an item into a build"))
    ((invalid-transition from to)
     (str "an item cannot move from "
          (case-name status-names from)
          " to "
          (case-name status-names to)))
    ((not-ready blockage) (not-ready-message blockage))
    ((cycle item on)
     (str (:value item)
          " after "
          (:value on)
          " would close a cycle"))
    ((dep-exists item on)
     (str (:value item) " already depends on " (:value on)))
    ((dep-not-found item on)
     (str (:value item) " does not depend on " (:value on)))
    ((decision-not-found id)
     (str "no decision has the id " (:value id)))
    ((decision-frozen id status)
     (str "the decision "
          (:value id)
          " is "
          (case-name decision-status-names status)
          ", and only a proposed decision can change"))
    ((decision-incomplete missing)
     (str "the proposal is incomplete: " missing))
    ((invalid-decision-transition id from to)
     (str "the decision "
          (:value id)
          " cannot move from "
          (case-name decision-status-names from)
          " to "
          (case-name decision-status-names to)))
    ((option-not-found id number)
     (str "the decision " (:value id) " has no option " number))
    ((already-asked id)
     (str "the decision " (:value id) " is already asked"))
    ((not-blockable id)
     (str "only an open item or an unfinished epic can take a blocker, and "
          (:value id)
          " is not one"))
    ((decision-in-other-roadmap id)
     (str (:value id)
          " belongs to another roadmap than the decision"))
    ((decision-block-exists decision item)
     (str "the decision "
          (:value decision)
          " already blocks "
          (:value item)))
    ((decision-block-not-found decision item)
     (str "the decision "
          (:value decision)
          " does not block "
          (:value item)))
    (blank-external-blocker (str "an external blocker needs a text"))
    ((external-blocker-not-found id)
     (str "no external blocker has the id " (:value id)))
    ((external-blocker-cleared id)
     (str "the external blocker "
          (:value id)
          " is already cleared"))
    ((external-blocker-in-other-item id item)
     (str "the external blocker "
          (:value id)
          " belongs to another item than "
          (:value item)))
    ((supersede-target-not-accepted id)
     (str "only an accepted decision, or a rejected one in the same roadmap, can be superseded, and "
          (:value id)
          " is neither"))
    ((ruling-not-found id)
     (str "no ruling has the id " (:value id)))
    ((ruling-superseded id)
     (str "the ruling " (:value id) " is already superseded"))
    ((session-busy _) (session-refusal->message failure))
    ((session-not-live _) (session-refusal->message failure))
    ((session-not-claimant _ _)
     (session-refusal->message failure))
    (report-empty (str "a report needs a body"))
    ((report-not-found id)
     (str "no report has the id " (:value id)))
    ((report-already-read id)
     (str "the report " (:value id) " was already read"))
    ((criteria-unmet _) (criterion-refusal->message failure))
    ((verifier-not-reviewer _)
     (criterion-refusal->message failure))
    ((verifier-is-worker _)
     (criterion-refusal->message failure))
    ((verifier-is-manager _)
     (criterion-refusal->message failure))
    ((criterion-not-found _ _)
     (criterion-refusal->message failure))
    (verdict-head-required (criterion-refusal->message failure))
    ((verdict-head-not-current _ _)
     (criterion-refusal->message failure))
    ((pull-request refused)
     (pull-request-refusal->message refused))
    (_ (proposal-refusal->message failure))))
