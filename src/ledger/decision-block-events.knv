(module
  "Describes each change to the items a decision blocks as an event to record.")

(use json/value text->json)
(use ledger/model item-id)
(use ledger/model/decisions decision)

(use ledger/model/events ->event-draft event-draft
                         event-type)

(use ledger/changes column-change deleted inserted-columns
                    payload-with-changes)

(export decision-block-added decision-block-removed)

(defn decision-block-added (decision item)
  (decision-block-event
    decision item event-type/decision-block-added
    (inserted-columns (ref (block-columns (ref (:id decision)) item)))))

(defn decision-block-removed (decision item)
  (decision-block-event decision item
                        event-type/decision-block-removed
                        (vec (deleted (str "decision_id")
                                      (text->json (as-str (:value (:id decision)))))
                             (deleted (str "item_id")
                                      (text->json (as-str (:value item)))))))

(type decision-block-event
  (fn ((ref decision)
       (ref item-id)
       event-type
       (ref (vec column-change)))
    event-draft))

(defn decision-block-event (decision item type changes)
  (->event-draft :roadmap-id (some (clone (:roadmap-id decision)))
                 :item-id (some (clone item))
                 :decision-id (some (clone (:id decision)))
                 :type type
                 :payload (payload-with-changes changes (vec))))

(defn block-columns (decision item)
  (vec (pair (str "decision_id")
             (text->json (as-str (:value decision))))
       (pair (str "item_id")
             (text->json (as-str (:value item))))))
