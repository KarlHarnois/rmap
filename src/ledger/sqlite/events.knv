(module
  "Appends to and reads the `events` table.")

(use ledger/sqlite/values int->sql sql-value text->sql)
(use json/value json->string parse)

(use ledger/model ->event ->item-id ->roadmap-id ->timestamp
                  event event-draft event-stamp item-id
                  roadmap-id)

(use ledger/names event-type-names name-of)

(use ledger/sqlite/connection connection database-error
                              database-failure execute
                              query)

(use ledger/sqlite/rows int-cell named-cell
                        optional-text-cell rows->values
                        text-cell)

(export ->event-filter append-event event-filter
        events-matching)

(defstruct event-filter
  :item-id (option item-id)
  :after-id int)

(type append-event
  (fn ((ref connection)
       (ref event-stamp)
       (ref event-draft))
    (result int database-error)))

(defn append-event (connection stamp draft)
  (execute connection
           "INSERT INTO events (at, actor, roadmap_id, item_id, type, payload_json) VALUES (?1, ?2, ?3, ?4, ?5, ?6)"
           (ref (vec (text->sql (as-str (:value (:at stamp))))
                     (text->sql (as-str (:actor stamp)))
                     (optional-roadmap->sql (ref (:roadmap-id draft)))
                     (optional-item->sql (ref (:item-id draft)))
                     (text->sql (name-of event-type-names (:type draft)))
                     (text->sql (as-str (json->string (ref (:payload
                                                             draft)))))))))

(type optional-roadmap->sql
  (fn ((ref (option roadmap-id)))
    sql-value))

(defn optional-roadmap->sql (id)
  (match id
    ((some present) (text->sql (as-str (:value present))))
    (none sql-value/null)))

(type optional-item->sql
  (fn ((ref (option item-id))) sql-value))

(defn optional-item->sql (id)
  (match id
    ((some present) (text->sql (as-str (:value present))))
    (none sql-value/null)))

(type events-matching
  (fn ((ref connection) (ref event-filter))
    (result (vec event) database-error)))

(defn events-matching (connection filter)
  (let-try (rows (query connection
                        "SELECT id, at, actor, roadmap_id, item_id, type, payload_json FROM events WHERE (?1 IS NULL OR item_id = ?1) AND id > ?2 ORDER BY id"
                        (ref (vec (optional-item->sql (ref (:item-id filter)))
                                  (int->sql (:after-id filter))))))
    (rows->values (ref rows) row->event)))

(defn row->event (row)
  (let-try (id (int-cell row 0)
            at (text-cell row 1)
            actor (text-cell row 2)
            roadmap-id (optional-text-cell row 3)
            item-id (optional-text-cell row 4)
            type (named-cell row 5 event-type-names)
            payload-text (text-cell row 6)
            payload (map-err (parse (as-str payload-text))
                      (fn (_)
                        (database-failure (str "event " id
                                               " holds invalid JSON")))))
    (ok (->event :id id
                 :at (->timestamp :value at)
                 :actor actor
                 :roadmap-id (map-some roadmap-id
                               (fn (value) (->roadmap-id :value value)))
                 :item-id (map-some item-id
                            (fn (value) (->item-id :value value)))
                 :type type
                 :payload payload))))
