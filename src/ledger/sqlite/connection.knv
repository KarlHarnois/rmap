(module
  "Opens the ledger database and runs SQL with JSON values as parameters and cells.")

(use ledger/sqlite/values json->sql-value sql-value
                          sql-value->json)

(export ->database-error begin commit connection
        database-error execute in-write-transaction open
        query rollback run-batch)

(rust-type connection "rusqlite::Connection")

(defstruct database-error
  :message string)

(def busy-timeout-milliseconds 5000)

(def open-raw
  (rust "rusqlite::Connection::open({0}).map_err(|failure| failure.to_string())"
    (fn ((ref str))
      (result connection string))))

(defn open (path)
  (let-try (connection (map-err (open-raw path) message->error)
            _ (run-batch (ref connection)
                         (as-str (str "PRAGMA busy_timeout = "
                                      busy-timeout-milliseconds
                                      ";")))
            _ (switch-to-wal (ref connection))
            _ (run-batch (ref connection) "PRAGMA foreign_keys = ON;"))
    (ok connection)))

(def wal-switch-attempts 100)

(def wal-switch-pause-milliseconds 20)

(def pause
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}))"
    (fn (u64) unit)))

(defn switch-to-wal (connection)
  (loop (attempt 1)
    (let (outcome (query connection "PRAGMA journal_mode = WAL" (ref (vec))))
      (cond
        ((ok? outcome) (ok (do)))
        ((< attempt wal-switch-attempts)
         (pause wal-switch-pause-milliseconds)
         (recur (inc attempt)))
        (else (map-ok outcome (fn (_) (do))))))))

(defn message->error (message)
  (->database-error :message message))

(def run-batch-raw
  (rust "{0}.execute_batch({1}).map_err(|failure| failure.to_string())"
    (fn ((ref connection) (ref str))
      (result unit string))))

(defn run-batch (connection sql)
  (map-err (run-batch-raw connection sql) message->error))

(def execute-raw
  (rust "{0}.execute({1}, rusqlite::params_from_iter({2}.iter())).map(|changed| changed as i64).map_err(|failure| failure.to_string())"
    (fn ((ref connection)
         (ref str)
         (ref (vec sql-value)))
      (result int string))))

(defn execute (connection sql parameters)
  (map-err (execute-raw connection sql
                        (ref (json->sql-values parameters)))
           message->error))

(def query-raw
  (rust "(|| -> Result<Vec<Vec<rusqlite::types::Value>>, String> {{ let mut statement = {0}.prepare({1}).map_err(|failure| failure.to_string())?; let width = statement.column_count(); let rows = statement.query_map(rusqlite::params_from_iter({2}.iter()), |row| (0..width).map(|index| row.get::<_, rusqlite::types::Value>(index)).collect::<Result<Vec<_>, _>>()).map_err(|failure| failure.to_string())?; rows.collect::<Result<Vec<_>, _>>().map_err(|failure| failure.to_string()) }})()"
    (fn ((ref connection)
         (ref str)
         (ref (vec sql-value)))
      (result (vec (vec sql-value)) string))))

(defn query (connection sql parameters)
  (map-ok (map-err (query-raw connection sql
                              (ref (json->sql-values parameters)))
                   message->error)
          rows->json))

(defn json->sql-values (parameters)
  (collect (map (iter parameters) json->sql-value)))

(defn rows->json (rows)
  (collect (map (iter rows)
             (fn (row)
               (collect (map (iter row) sql-value->json))))))

(type in-write-transaction
  (where (a)
    (fn ((ref connection)
         (fn ((ref connection))
           (result a database-error)))
      (result a database-error))))

(defn in-write-transaction (connection work)
  (let-try (_ (begin connection))
    (finish-transaction connection (work connection))))

(defn finish-transaction (connection outcome)
  (match outcome
    ((ok value) (map-ok (commit connection) (fn (_) value)))
    ((err failure) (rollback-after connection failure))))

(defn begin (connection)
  (run-batch connection "BEGIN IMMEDIATE"))

(defn rollback (connection)
  (run-batch connection "ROLLBACK"))

(defn commit (connection) (run-batch connection "COMMIT"))

(defn rollback-after (connection failure)
  (match (rollback connection)
    (_ (err failure))))
