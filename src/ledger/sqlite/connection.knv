(module
  "Opens the ledger database and runs SQL with SQLite values as parameters and cells.")

(use ledger/sqlite/values sql-value)

(export ->database-error begin begin-read connection
        database-error database-failure database-problem
        execute finish in-write-transaction open
        open-existing query run-batch)

(rust-type connection "rusqlite::Connection")

(defenum database-problem
  busy
  failed)

(defstruct database-error
  :problem database-problem
  :message string)

(def busy-timeout-milliseconds 5000)

(def open-raw
  (rust "rusqlite::Connection::open({0}).map_err(|failure| (matches!(failure.sqlite_error_code(), Some(rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)), failure.to_string()))"
    (fn ((ref str))
      (result connection (pair bool string)))))

(def open-existing-raw
  (rust "rusqlite::Connection::open_with_flags({0}, rusqlite::OpenFlags::SQLITE_OPEN_READ_WRITE | rusqlite::OpenFlags::SQLITE_OPEN_URI | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX).map_err(|failure| (matches!(failure.sqlite_error_code(), Some(rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)), failure.to_string()))"
    (fn ((ref str))
      (result connection (pair bool string)))))

(defn open (path)
  (let-try (connection (map-err (open-raw path) raw->error))
    (configured connection)))

(defn open-existing (path)
  (let-try (connection (map-err (open-existing-raw path) raw->error))
    (configured connection)))

(defn configured (connection)
  (let-try (_ (run-batch (ref connection)
                         (as-str (str "PRAGMA busy_timeout = "
                                      busy-timeout-milliseconds
                                      ";")))
            _ (switch-to-wal (ref connection))
            _ (run-batch (ref connection) "PRAGMA foreign_keys = ON;"))
    (ok connection)))

(def wal-switch-attempts 100)

(def wal-switch-pause-milliseconds 20)

(def pause
  (rust "std::thread::sleep(std::time::Duration::from_millis({0}))"
    (fn (u64) unit)))

(defn switch-to-wal (connection)
  (loop (attempt 1)
    (let (outcome (query connection "PRAGMA journal_mode = WAL" (ref (vec))))
      (cond
        ((ok? outcome) (ok (do)))
        ((< attempt wal-switch-attempts)
         (pause wal-switch-pause-milliseconds)
         (recur (inc attempt)))
        (else (map-ok outcome (fn (_) (do))))))))

(defn raw->error (raw)
  (let-match ((pair locked message) raw)
    (->database-error :problem (problem-of locked)
                      :message message)))

(defn database-failure (message)
  (->database-error :problem database-problem/failed
                    :message message))

(defn problem-of (locked)
  (if locked database-problem/busy database-problem/failed))

(def run-batch-raw
  (rust "{0}.execute_batch({1}).map_err(|failure| (matches!(failure.sqlite_error_code(), Some(rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)), failure.to_string()))"
    (fn ((ref connection) (ref str))
      (result unit (pair bool string)))))

(defn run-batch (connection sql)
  (map-err (run-batch-raw connection sql) raw->error))

(def execute-raw
  (rust "{0}.execute({1}, rusqlite::params_from_iter({2}.iter())).map(|changed| changed as i64).map_err(|failure| (matches!(failure.sqlite_error_code(), Some(rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)), failure.to_string()))"
    (fn ((ref connection)
         (ref str)
         (ref (vec sql-value)))
      (result int (pair bool string)))))

(defn execute (connection sql parameters)
  (map-err (execute-raw connection sql parameters) raw->error))

(def query-raw
  (rust "(|| -> Result<Vec<Vec<rusqlite::types::Value>>, (bool, String)> {{ let mut statement = {0}.prepare({1}).map_err(|failure| (matches!(failure.sqlite_error_code(), Some(rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)), failure.to_string()))?; let width = statement.column_count(); let rows = statement.query_map(rusqlite::params_from_iter({2}.iter()), |row| (0..width).map(|index| row.get::<_, rusqlite::types::Value>(index)).collect::<Result<Vec<_>, _>>()).map_err(|failure| (matches!(failure.sqlite_error_code(), Some(rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)), failure.to_string()))?; rows.collect::<Result<Vec<_>, _>>().map_err(|failure| (matches!(failure.sqlite_error_code(), Some(rusqlite::ErrorCode::DatabaseBusy | rusqlite::ErrorCode::DatabaseLocked)), failure.to_string())) }})()"
    (fn ((ref connection)
         (ref str)
         (ref (vec sql-value)))
      (result (vec (vec sql-value))
              (pair bool string)))))

(defn query (connection sql parameters)
  (map-err (query-raw connection sql parameters) raw->error))

(type in-write-transaction
  (where (a)
    (fn ((ref connection)
         (fn ((ref connection))
           (result a database-error)))
      (result a database-error))))

(defn in-write-transaction (connection work)
  (let-try (_ (begin connection)
            outcome (finish connection (work connection)))
    outcome))

(type finish
  (where (a e)
    (fn ((ref connection) (result a e))
      (result (result a e) database-error))))

(defn finish (connection outcome)
  (match outcome
    ((ok value)
     (map-ok (commit connection)
       (fn (_) (ok value))))
    ((err failure) (rolled-back connection failure))))

(defn rolled-back (connection failure)
  (match (rollback connection)
    (_ (ok (err failure)))))

(defn begin-read (connection)
  (run-batch connection "BEGIN"))

(defn begin (connection)
  (run-batch connection "BEGIN IMMEDIATE"))

(defn rollback (connection)
  (run-batch connection "ROLLBACK"))

(defn commit (connection) (run-batch connection "COMMIT"))
