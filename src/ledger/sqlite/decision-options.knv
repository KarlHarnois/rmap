(module
  "Reads and writes the options of a decision, their pros and cons, and the proposals each option skips.")

(use ledger/sqlite/values int->sql text->sql)
(use ledger/model decision-id)

(use ledger/model/decisions ->decision-option
                            decision-option)

(use ledger/sqlite/connection connection database-error
                              execute query)

(use ledger/sqlite/rows int-cell rows->values text-cell
                        try-each)

(use ledger/sqlite/decision-points delete-points
                                   insert-points point-texts
                                   points-of side)

(use ledger/sqlite/decision-skips delete-skips insert-skips
                                  skips-of)

(export delete-options insert-options options-of)

(defn insert-options (connection decision options)
  (try-each options
    (fn (option) (insert-option connection decision option))))

(defn delete-options (connection decision)
  (let-try (_ (delete-points connection decision)
            _ (delete-skips connection decision)
            _ (execute connection
                       "DELETE FROM decision_options WHERE decision_id = ?1"
                       (ref (vec (text->sql (as-str (:value decision)))))))
    (ok (do))))

(type options-of
  (fn ((ref connection) (ref decision-id))
    (result (vec decision-option) database-error)))

(defn options-of (connection decision)
  (let-try (option-rows (query connection
                               "SELECT number, title, description FROM decision_options WHERE decision_id = ?1 ORDER BY number"
                               (ref (vec (text->sql (as-str (:value
                                                              decision))))))
            points (points-of connection decision)
            skips (skips-of connection decision))
    (rows->values (ref option-rows)
      (fn (row)
        (row->option row (ref points) (ref skips))))))

(type insert-option
  (fn ((ref connection)
       (ref decision-id)
       (ref decision-option))
    (result unit database-error)))

(defn insert-option (connection decision option)
  (let-try (_ (execute connection
                       "INSERT INTO decision_options (decision_id, number, title, description) VALUES (?1, ?2, ?3, ?4)"
                       (ref (vec (text->sql (as-str (:value decision)))
                                 (int->sql (:number option))
                                 (text->sql (as-str (:title option)))
                                 (text->sql (as-str (:description option))))))
            _ (insert-points connection decision option
                             side/pro
                             (ref (:pros option)))
            _ (insert-points connection decision option
                             side/con
                             (ref (:cons option))))
    (insert-skips connection decision option)))

(defn row->option (row points skips)
  (let-try (number (int-cell row 0)
            title (text-cell row 1)
            description (text-cell row 2))
    (ok (->decision-option :number number
                           :title title
                           :description description
                           :pros (point-texts points number side/pro)
                           :cons (point-texts points number side/con)
                           :skips (skip-proposals skips number)))))

(defn skip-proposals (skips number)
  (collect (map (filter (iter skips)
                  (fn (skip) (= (:option skip) number)))
                (fn (skip) (clone (:proposal skip))))))
