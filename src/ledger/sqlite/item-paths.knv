(module
  "Reads and writes the `item_paths` table.")

(use json/value text->json)

(use ledger/model ->glob ->item-id ->item-path glob item-id
                  item-path)

(use ledger/sqlite/connection connection database-error
                              execute query)

(use ledger/sqlite/rows text-cell)

(export all-item-paths insert-globs replace-globs)

(type insert-item-path
  (fn ((ref connection) (ref item-path))
    (result int database-error)))

(defn insert-item-path (connection path)
  (execute connection
           "INSERT INTO item_paths (item_id, glob) VALUES (?1, ?2)"
           (ref (vec (text->json (as-str (:value (:item path))))
                     (text->json (as-str (:pattern (:glob path))))))))

(defn all-item-paths (connection)
  (let-try (rows (query
                   connection
                   "SELECT item_id, glob FROM item_paths ORDER BY item_id, glob"
                   (ref (vec))))
    (rows->paths rows)))

(defn rows->paths (rows)
  (loop (index 0
         paths (vec))
    (if (< index (len rows))
      (let-try (path (row->path (at rows index)))
        (recur (inc index) (appended paths path)))
      (ok paths))))

(defn appended (items extra)
  (let (all items) (push! all extra) all))

(defn row->path (row)
  (let-try (item (text-cell row 0)
            pattern (text-cell row 1))
    (ok (->item-path :item (->item-id :value item)
                     :glob (->glob :pattern pattern)))))

(defn insert-globs (connection id globs)
  (loop (index 0)
    (if (< index (len globs))
      (let-try (_ (insert-item-path connection
                                    (ref (->item-path
                                           :item (clone id)
                                           :glob (clone (at globs index))))))
        (recur (inc index)))
      (ok (do)))))

(type replace-globs
  (fn ((ref connection)
       (ref item-id)
       (ref (vec glob)))
    (result unit database-error)))

(defn replace-globs (connection id globs)
  (let-try (_ (execute connection
                       "DELETE FROM item_paths WHERE item_id = ?1"
                       (ref (vec (text->json (as-str (:value id)))))))
    (insert-globs connection id globs)))
