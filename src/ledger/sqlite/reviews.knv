(module
  "Reads and writes the `reviews` table, with the name of the reviewer session that gave each review.")

(use ledger/sqlite/values int->sql text->sql)
(use ledger/model ->item-id ->session ->timestamp)
(use ledger/model/sessions ->session-id)

(use ledger/model/pull-requests ->head ->review ->review-id
                                review)

(use ledger/names case-name review-kind-names verdict-names)

(use ledger/sqlite/connection connection database-error
                              execute query)

(use ledger/sqlite/rows int-cell named-cell rows->values
                        single-row text-cell)

(export all-reviews insert-review next-review-id)

(defn next-review-id (connection)
  (let-try (rows (query connection
                        "SELECT COALESCE((SELECT seq FROM sqlite_sequence WHERE name = 'reviews'), 0) + 1"
                        (ref (vec)))
            row (single-row (ref rows))
            id (int-cell row 0))
    (ok (->review-id :value id))))

(type insert-review
  (fn ((ref connection) (ref review))
    (result int database-error)))

(defn insert-review (connection review)
  (execute connection
           "INSERT INTO reviews (id, item_id, session_id, kind, head_sha, verdict, created_at) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)"
           (ref (vec (int->sql (:value (:id review)))
                     (text->sql (as-str (:value (:item review))))
                     (int->sql (:value (:session-id review)))
                     (text->sql (case-name review-kind-names (:kind review)))
                     (text->sql (as-str (:sha (:head review))))
                     (text->sql (case-name verdict-names (:verdict review)))
                     (text->sql (as-str (:value (:created-at review))))))))

(defn all-reviews (connection)
  (let-try (rows (query connection
                        "SELECT r.id, r.item_id, r.session_id, s.name, r.kind, r.head_sha, r.verdict, r.created_at FROM reviews r JOIN sessions s ON s.id = r.session_id ORDER BY r.id"
                        (ref (vec))))
    (rows->values (ref rows) row->review)))

(defn row->review (row)
  (let-try (id (int-cell row 0)
            item (text-cell row 1)
            session-id (int-cell row 2)
            reviewer (text-cell row 3)
            kind (named-cell row 4 review-kind-names)
            head (text-cell row 5)
            verdict (named-cell row 6 verdict-names)
            created-at (text-cell row 7))
    (ok (->review :id (->review-id :value id)
                  :item (->item-id :value item)
                  :session-id (->session-id :value session-id)
                  :reviewer (->session :name reviewer)
                  :kind kind
                  :head (->head :sha head)
                  :verdict verdict
                  :created-at (->timestamp :value created-at)))))
