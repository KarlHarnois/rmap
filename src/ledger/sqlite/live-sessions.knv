(module
  "Reads live sessions: every live review session, the live review session of an item, the live review session a named reviewer started on it, and any live session by name.")

(use ledger/model ->item-id ->session item-id session)

(use ledger/model/sessions ->live-session ->session-id
                           live-session session-id)

(use ledger/names session-kind-names)
(use ledger/sqlite/values text->sql)

(use ledger/sqlite/connection connection database-error
                              query)

(use ledger/sqlite/rows int-cell named-cell rows->values
                        text-cell)

(export live-review-session live-review-session-id
        live-review-sessions live-session-named)

(defn live-review-sessions (connection)
  (let-try (rows (query connection
                        "SELECT id, name, item_id, kind FROM sessions WHERE kind = 'review' AND ended_at IS NULL ORDER BY id"
                        (ref (vec)))
            lives (rows->values (ref rows) row->live-session))
    (ok lives)))

(type live-review-session
  (fn ((ref connection) (ref item-id))
    (result (option live-session) database-error)))

(defn live-review-session (connection item)
  (let-try (rows (query connection
                        "SELECT id, name, item_id, kind FROM sessions WHERE item_id = ?1 AND kind = 'review' AND ended_at IS NULL"
                        (ref (vec (text->sql (as-str (:value item))))))
            lives (rows->values (ref rows) row->live-session))
    (ok (map-some (first lives) own-live-session))))

(type live-review-session-id
  (fn ((ref connection)
       (ref item-id)
       (ref session))
    (result (option session-id) database-error)))

(defn live-review-session-id (connection item reviewer)
  (let-try (rows (query connection
                        "SELECT id FROM sessions WHERE item_id = ?1 AND name = ?2 AND kind = 'review' AND ended_at IS NULL"
                        (ref (vec (text->sql (as-str (:value item)))
                                  (text->sql (as-str (:name reviewer))))))
            ids (rows->values (ref rows)
                  (fn (row) (int-cell row 0))))
    (ok (map-some (first ids)
          (fn (id)
            (->session-id :value (deref id)))))))

(type live-session-named
  (fn ((ref connection) (ref session))
    (result (option live-session) database-error)))

(defn live-session-named (connection session)
  (let-try (rows (query connection
                        "SELECT id, name, item_id, kind FROM sessions WHERE name = ?1 AND ended_at IS NULL"
                        (ref (vec (text->sql (as-str (:name session))))))
            lives (rows->values (ref rows) row->live-session))
    (ok (map-some (first lives) own-live-session))))

(defn own-live-session (live)
  (->live-session :id (clone (:id live))
                  :session (clone (:session live))
                  :item (clone (:item live))
                  :kind (:kind live)))

(defn row->live-session (row)
  (let-try (id (int-cell row 0)
            name (text-cell row 1)
            item (text-cell row 2)
            kind (named-cell row 3 session-kind-names))
    (ok (->live-session :id (->session-id :value id)
                        :session (->session :name name)
                        :item (->item-id :value item)
                        :kind kind))))
