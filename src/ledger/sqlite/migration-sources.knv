(module
  "Holds the SQL of each migration, generated from `migrations/` by `knave task embed-migrations`.")

(use ledger/sqlite/migrations ->migration)

(export migration-sources)

(defn migration-sources ()
  (vec (->migration :version 1
                    :file (str "0001-init.sql")
                    :sql (str "CREATE TABLE roadmaps (\n  id TEXT PRIMARY KEY,\n  name TEXT NOT NULL UNIQUE,\n  manager_session TEXT NOT NULL,\n  status TEXT NOT NULL DEFAULT 'active' CHECK (status IN ('active', 'paused', 'done')),\n  created_at TEXT NOT NULL\n);\n\nCREATE TABLE items (\n  id TEXT PRIMARY KEY,\n  roadmap_id TEXT NOT NULL REFERENCES roadmaps (id),\n  parent_id TEXT REFERENCES items (id),\n  title TEXT NOT NULL,\n  kind TEXT NOT NULL CHECK (kind IN ('epic', 'research', 'design', 'build')),\n  status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'dispatched', 'reported', 'in_review', 'fixing', 'merging', 'merged', 'dropped')),\n  origin TEXT NOT NULL DEFAULT 'planned' CHECK (origin IN ('planned', 'user-bug', 'follow-up')),\n  priority INTEGER NOT NULL DEFAULT 0,\n  claimed_by TEXT,\n  created_at TEXT NOT NULL,\n  closed_at TEXT\n);\n\nCREATE INDEX items_roadmap ON items (roadmap_id);\n\nCREATE TABLE deps (\n  item_id TEXT NOT NULL REFERENCES items (id),\n  on_id TEXT NOT NULL REFERENCES items (id),\n  type TEXT NOT NULL CHECK (type IN ('blocks', 'discovered_from')),\n  PRIMARY KEY (item_id, on_id, type)\n);\n\nCREATE TABLE item_paths (\n  item_id TEXT NOT NULL REFERENCES items (id),\n  glob TEXT NOT NULL,\n  PRIMARY KEY (item_id, glob)\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  at TEXT NOT NULL,\n  actor TEXT NOT NULL,\n  roadmap_id TEXT REFERENCES roadmaps (id),\n  item_id TEXT REFERENCES items (id),\n  type TEXT NOT NULL,\n  payload_json TEXT NOT NULL\n);\n\nCREATE INDEX events_item ON events (item_id);\n"))
       (->migration :version 2
                    :file (str "0002-accepted-status.sql")
                    :sql (str "CREATE TEMP TABLE saved_items AS SELECT * FROM items;\nCREATE TEMP TABLE saved_deps AS SELECT * FROM deps;\nCREATE TEMP TABLE saved_item_paths AS SELECT * FROM item_paths;\nCREATE TEMP TABLE saved_events AS SELECT * FROM events;\n\nDROP TABLE events;\nDROP TABLE item_paths;\nDROP TABLE deps;\nDROP TABLE items;\n\nCREATE TABLE items (\n  id TEXT PRIMARY KEY,\n  roadmap_id TEXT NOT NULL REFERENCES roadmaps (id),\n  parent_id TEXT REFERENCES items (id),\n  title TEXT NOT NULL,\n  kind TEXT NOT NULL CHECK (kind IN ('epic', 'research', 'design', 'build')),\n  status TEXT NOT NULL DEFAULT 'open' CHECK (status IN ('open', 'dispatched', 'reported', 'in_review', 'fixing', 'merging', 'merged', 'accepted', 'dropped')),\n  origin TEXT NOT NULL DEFAULT 'planned' CHECK (origin IN ('planned', 'user-bug', 'follow-up')),\n  priority INTEGER NOT NULL DEFAULT 0,\n  claimed_by TEXT,\n  created_at TEXT NOT NULL,\n  closed_at TEXT\n);\n\nCREATE INDEX items_roadmap ON items (roadmap_id);\n\nCREATE TABLE deps (\n  item_id TEXT NOT NULL REFERENCES items (id),\n  on_id TEXT NOT NULL REFERENCES items (id),\n  type TEXT NOT NULL CHECK (type IN ('blocks', 'discovered_from')),\n  PRIMARY KEY (item_id, on_id, type)\n);\n\nCREATE TABLE item_paths (\n  item_id TEXT NOT NULL REFERENCES items (id),\n  glob TEXT NOT NULL,\n  PRIMARY KEY (item_id, glob)\n);\n\nCREATE TABLE events (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  at TEXT NOT NULL,\n  actor TEXT NOT NULL,\n  roadmap_id TEXT REFERENCES roadmaps (id),\n  item_id TEXT REFERENCES items (id),\n  type TEXT NOT NULL,\n  payload_json TEXT NOT NULL\n);\n\nCREATE INDEX events_item ON events (item_id);\n\nINSERT INTO items (id, roadmap_id, parent_id, title, kind, status, origin, priority, claimed_by, created_at, closed_at)\n  SELECT id, roadmap_id, parent_id, title, kind, status, origin, priority, claimed_by, created_at, closed_at FROM saved_items;\nINSERT INTO deps (item_id, on_id, type) SELECT item_id, on_id, type FROM saved_deps;\nINSERT INTO item_paths (item_id, glob) SELECT item_id, glob FROM saved_item_paths;\nINSERT INTO events (id, at, actor, roadmap_id, item_id, type, payload_json)\n  SELECT id, at, actor, roadmap_id, item_id, type, payload_json FROM saved_events;\n\nDROP TABLE saved_items;\nDROP TABLE saved_deps;\nDROP TABLE saved_item_paths;\nDROP TABLE saved_events;\n"))
       (->migration :version 3
                    :file (str "0003-priority-scale.sql")
                    :sql (str "UPDATE items SET priority = MIN(4, MAX(0, 3 - priority));\n"))
       (->migration :version 4
                    :file (str "0004-item-description.sql")
                    :sql (str
                           "ALTER TABLE items ADD COLUMN description TEXT;\n"))
       (->migration :version 5
                    :file (str "0005-remove-item-paths.sql")
                    :sql (str "DROP TABLE item_paths;\n"))
       (->migration :version 6
                    :file (str "0006-decisions.sql")
                    :sql (str "CREATE TABLE decisions (\n  id TEXT PRIMARY KEY,\n  roadmap_id TEXT NOT NULL REFERENCES roadmaps (id),\n  item_id TEXT REFERENCES items (id),\n  title TEXT NOT NULL,\n  context TEXT NOT NULL,\n  status TEXT NOT NULL DEFAULT 'proposed' CHECK (status IN ('proposed', 'accepted', 'rejected', 'deprecated', 'superseded')),\n  recommended_option INTEGER NOT NULL,\n  recommendation_reason TEXT NOT NULL,\n  chosen_option INTEGER,\n  justification TEXT,\n  consequences TEXT,\n  deprecation_reason TEXT,\n  supersedes_id TEXT REFERENCES decisions (id),\n  asked_at TEXT,\n  decided_by TEXT,\n  decided_at TEXT,\n  created_at TEXT NOT NULL,\n  FOREIGN KEY (id, recommended_option) REFERENCES decision_options (decision_id, number) DEFERRABLE INITIALLY DEFERRED,\n  FOREIGN KEY (id, chosen_option) REFERENCES decision_options (decision_id, number) DEFERRABLE INITIALLY DEFERRED\n);\n\nCREATE INDEX decisions_roadmap ON decisions (roadmap_id);\n\nCREATE TABLE decision_options (\n  decision_id TEXT NOT NULL REFERENCES decisions (id),\n  number INTEGER NOT NULL,\n  title TEXT NOT NULL,\n  description TEXT NOT NULL DEFAULT '',\n  PRIMARY KEY (decision_id, number)\n);\n\nCREATE TABLE decision_option_points (\n  decision_id TEXT NOT NULL,\n  option_number INTEGER NOT NULL,\n  side TEXT NOT NULL CHECK (side IN ('pro', 'con')),\n  position INTEGER NOT NULL,\n  text TEXT NOT NULL,\n  PRIMARY KEY (decision_id, option_number, side, position),\n  FOREIGN KEY (decision_id, option_number) REFERENCES decision_options (decision_id, number)\n);\n\nCREATE TABLE decision_blocks (\n  decision_id TEXT NOT NULL REFERENCES decisions (id),\n  item_id TEXT NOT NULL REFERENCES items (id),\n  PRIMARY KEY (decision_id, item_id)\n);\n\nCREATE INDEX decision_blocks_item ON decision_blocks (item_id);\n\nCREATE TABLE rulings (\n  id TEXT PRIMARY KEY,\n  item_id TEXT NOT NULL REFERENCES items (id),\n  question TEXT NOT NULL,\n  choice TEXT NOT NULL,\n  reason TEXT NOT NULL,\n  supersedes_id TEXT UNIQUE REFERENCES rulings (id),\n  ruled_by TEXT NOT NULL,\n  created_at TEXT NOT NULL\n);\n\nCREATE INDEX rulings_item ON rulings (item_id);\n\nALTER TABLE events ADD COLUMN decision_id TEXT REFERENCES decisions (id);\n\nCREATE INDEX events_decision ON events (decision_id);\n"))
       (->migration :version 7
                    :file (str "0007-sessions.sql")
                    :sql (str "CREATE TABLE sessions (\n  id INTEGER PRIMARY KEY AUTOINCREMENT,\n  name TEXT NOT NULL,\n  item_id TEXT REFERENCES items (id),\n  kind TEXT CHECK (kind IN ('work', 'fix')),\n  runtime TEXT NOT NULL DEFAULT 'ringleader',\n  branch TEXT,\n  base TEXT,\n  started_at TEXT NOT NULL,\n  ended_at TEXT,\n  end_reason TEXT CHECK (end_reason IN ('reopened', 'replaced', 'finished'))\n);\n\nCREATE UNIQUE INDEX sessions_live_item ON sessions (item_id) WHERE ended_at IS NULL;\n\nCREATE UNIQUE INDEX sessions_live_name ON sessions (name) WHERE ended_at IS NULL;\n\nWITH claims AS (\n  SELECT items.id AS item_id,\n         items.claimed_by AS name,\n         items.status IN ('merged', 'accepted', 'dropped') AS finished,\n         items.closed_at AS closed_at,\n         COALESCE((SELECT MAX(events.at) FROM events WHERE events.item_id = items.id AND events.type = 'item-claimed'), items.created_at) AS started_at\n  FROM items\n  WHERE items.claimed_by IS NOT NULL\n),\nranked AS (\n  SELECT claims.*,\n         ROW_NUMBER() OVER (PARTITION BY name, finished ORDER BY started_at DESC, item_id DESC) AS recency,\n         MAX(started_at) OVER (PARTITION BY name, finished) AS newest_start\n  FROM claims\n)\nINSERT INTO sessions (name, item_id, kind, branch, base, started_at, ended_at, end_reason)\n  SELECT name, item_id, 'work', NULL, NULL, started_at,\n         CASE WHEN finished THEN COALESCE(closed_at, started_at) WHEN recency > 1 THEN newest_start END,\n         CASE WHEN finished THEN 'finished' WHEN recency > 1 THEN 'replaced' END\n  FROM ranked\n  ORDER BY started_at, item_id;\n\nALTER TABLE items DROP COLUMN claimed_by;\n"))))
