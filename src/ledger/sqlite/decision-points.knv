(module
  "Reads and writes the pros and cons of each decision option, in `decision_option_points`.")

(use ledger/model decision-id)
(use ledger/names case-name)
(use ledger/sqlite/values int->sql text->sql)

(use ledger/sqlite/connection connection database-error
                              execute query)

(use ledger/sqlite/rows int-cell named-cell rows->values
                        text-cell)

(export delete-points insert-points point point-texts
        points-of side)

(def side-names
  (vec (pair side/pro "pro") (pair side/con "con")))

(defstruct point
  :option int
  :side side
  :text string)

(defenum side
  pro
  con)

(type points-of
  (fn ((ref connection) (ref decision-id))
    (result (vec point) database-error)))

(defn points-of (connection decision)
  (let-try (rows (query connection
                        "SELECT option_number, side, text FROM decision_option_points WHERE decision_id = ?1 ORDER BY option_number, side, position"
                        (ref (vec (text->sql (as-str (:value decision)))))))
    (rows->values (ref rows) row->point)))

(type delete-points
  (fn ((ref connection) (ref decision-id))
    (result unit database-error)))

(defn delete-points (connection decision)
  (map-ok (execute connection
                   "DELETE FROM decision_option_points WHERE decision_id = ?1"
                   (ref (vec (text->sql (as-str (:value decision))))))
          (fn (_) (do))))

(defn insert-points (connection decision option side texts)
  (loop (position 0)
    (if (< position (len texts))
      (let-try (_ (insert-point connection decision
                                (->point :option (:number option)
                                         :side side
                                         :text (clone (at texts position)))
                                position))
        (recur (inc position)))
      (ok (do)))))

(type point-texts
  (fn ((ref (vec point)) int side)
    (vec string)))

(defn point-texts (points number wanted)
  (collect (map (filter (iter points)
                  (fn (point)
                    (and (= (:option point) number)
                         (= (:side point) wanted))))
                (fn (point) (clone (:text point))))))

(type insert-point
  (fn ((ref connection) (ref decision-id) point int)
    (result int database-error)))

(defn insert-point (connection decision point position)
  (execute connection
           "INSERT INTO decision_option_points (decision_id, option_number, side, position, text) VALUES (?1, ?2, ?3, ?4, ?5)"
           (ref (vec (text->sql (as-str (:value decision)))
                     (int->sql (:option point))
                     (text->sql (case-name side-names (:side point)))
                     (int->sql position)
                     (text->sql (as-str (:text point)))))))

(defn row->point (row)
  (let-try (option (int-cell row 0)
            side (named-cell row 1 side-names)
            text (text-cell row 2))
    (ok (->point :option option :side side :text text))))
