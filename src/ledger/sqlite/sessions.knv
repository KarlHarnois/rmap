(module
  "Reads and writes the `sessions` table: starts an item's live session, ends it, reads it back as the item's claim, and lists the item's worker sessions.")

(use ledger/sqlite/values int->sql optional-text->sql
                          text->sql)

(use ledger/model ->session ->timestamp ->work-session claim
                  item-id session work-session)

(use ledger/model/sessions ->session-id session-end
                           session-id)

(use ledger/names case-name end-reason-names runtime-names
                  session-kind-names)

(use ledger/sqlite/connection connection database-error
                              execute query)

(use ledger/sqlite/rows int-cell named-cell
                        optional-text-cell rows->values
                        text-cell)

(export end-session end-session-id end-session-named
        item-worker-sessions live-session-columns
        live-session-id live-session-join
        live-session-named? row->claim start-session)

(def live-session-columns
  "sessions.name, sessions.kind, sessions.runtime, sessions.branch, sessions.base, sessions.started_at")

(def live-session-join
  " LEFT JOIN sessions ON sessions.item_id = items.id AND sessions.kind IN ('work', 'fix') AND sessions.ended_at IS NULL")

(type item-worker-sessions
  (fn ((ref connection) (ref item-id))
    (result (vec session) database-error)))

(defn item-worker-sessions (connection item)
  (let-try (rows (query connection
                        "SELECT name FROM sessions WHERE item_id = ?1 AND kind IN ('work', 'fix') ORDER BY id"
                        (ref (vec (text->sql (as-str (:value item))))))
            names (rows->values (ref rows)
                    (fn (row) (text-cell row 0))))
    (ok (collect (map (iter names)
                   (fn (name)
                     (->session :name (clone name))))))))

(type start-session
  (fn ((ref connection)
       (ref item-id)
       (ref work-session))
    (result int database-error)))

(defn start-session (connection item session)
  (execute connection
           "INSERT INTO sessions (name, item_id, kind, runtime, branch, base, started_at) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)"
           (ref (vec (text->sql (as-str (:name (:session session))))
                     (text->sql (as-str (:value item)))
                     (text->sql (case-name session-kind-names (:kind session)))
                     (text->sql (case-name runtime-names (:runtime session)))
                     (optional-text->sql (ref (:branch session)))
                     (optional-text->sql (ref (:base session)))
                     (text->sql (as-str (:value (:started-at session))))))))

(type end-session
  (fn ((ref connection)
       (ref item-id)
       (ref session-end))
    (result int database-error)))

(defn end-session (connection item end)
  (execute connection
           "UPDATE sessions SET ended_at = ?2, end_reason = ?3 WHERE item_id = ?1 AND ended_at IS NULL"
           (ref (vec (text->sql (as-str (:value item)))
                     (text->sql (as-str (:value (:at end))))
                     (text->sql (case-name end-reason-names (:reason end)))))))

(type end-session-id
  (fn ((ref connection)
       (ref session-id)
       (ref session-end))
    (result int database-error)))

(defn end-session-id (connection id end)
  (execute connection
           "UPDATE sessions SET ended_at = ?2, end_reason = ?3 WHERE id = ?1 AND ended_at IS NULL"
           (ref (vec (int->sql (:value id))
                     (text->sql (as-str (:value (:at end))))
                     (text->sql (case-name end-reason-names (:reason end)))))))

(type end-session-named
  (fn ((ref connection)
       (ref session)
       (ref session-end))
    (result int database-error)))

(defn end-session-named (connection session end)
  (execute connection
           "UPDATE sessions SET ended_at = ?2, end_reason = ?3 WHERE name = ?1 AND ended_at IS NULL"
           (ref (vec (text->sql (as-str (:name session)))
                     (text->sql (as-str (:value (:at end))))
                     (text->sql (case-name end-reason-names (:reason end)))))))

(type live-session-named?
  (fn ((ref connection) (ref session))
    (result bool database-error)))

(defn live-session-named? (connection session)
  (let-try (rows (query connection
                        "SELECT id FROM sessions WHERE name = ?1 AND ended_at IS NULL"
                        (ref (vec (text->sql (as-str (:name session)))))))
    (ok (not (empty? rows)))))

(type live-session-id
  (fn ((ref connection) (ref item-id))
    (result (option session-id) database-error)))

(defn live-session-id (connection item)
  (let-try (rows (query connection
                        "SELECT id FROM sessions WHERE item_id = ?1 AND kind IN ('work', 'fix') AND ended_at IS NULL"
                        (ref (vec (text->sql (as-str (:value item))))))
            ids (rows->values (ref rows)
                  (fn (row) (int-cell row 0))))
    (ok (map-some (first ids)
          (fn (id)
            (->session-id :value (deref id)))))))

(defn row->claim (row first-column)
  (let-try (name (optional-text-cell row first-column))
    (match name
      ((some present) (claimed-by row first-column present))
      (none (ok claim/unclaimed)))))

(defn claimed-by (row first-column name)
  (let-try (kind (named-cell row (+ first-column 1) session-kind-names)
            runtime (named-cell row (+ first-column 2) runtime-names)
            branch (optional-text-cell row (+ first-column 3))
            base (optional-text-cell row (+ first-column 4))
            started-at (text-cell row (+ first-column 5)))
    (ok (claim/claimed-by (->work-session :session (->session :name name)
                                          :kind kind
                                          :runtime runtime
                                          :branch branch
                                          :base base
                                          :started-at (->timestamp
                                                        :value started-at))))))
