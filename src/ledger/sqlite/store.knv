(module
  "Loads the ledger snapshot and makes fresh ids and timestamps from the database.")

(use json/value text->json)
(use ledger/model ->snapshot ->timestamp)
(use ledger/sqlite/connection database-failure query)
(use ledger/sqlite/rows single-row text-cell)
(use ledger/sqlite/items all-items)
(use ledger/sqlite/deps all-deps)
(use ledger/sqlite/item-paths all-item-paths)

(export database-now fresh-id load-snapshot)

(defn load-snapshot (connection)
  (let-try (items (all-items connection)
            deps (all-deps connection)
            paths (all-item-paths connection))
    (ok (->snapshot :items items :deps deps :paths paths))))

(def id-attempts 1000)

(defn fresh-id (connection)
  (loop (attempt 0)
    (let-try (candidate (random-id connection)
              taken (id-taken? connection (as-str candidate)))
      (cond
        ((not taken) (ok candidate))
        ((< attempt id-attempts) (recur (inc attempt)))
        (else (err (database-failure
                     (str "no free id after " id-attempts " attempts"))))))))

(defn random-id (connection)
  (let-try (rows (query connection
                        "SELECT 'rm-' || lower(hex(randomblob(2)))"
                        (ref (vec)))
            row (single-row (ref rows)))
    (text-cell row 0)))

(defn id-taken? (connection candidate)
  (let-try (rows (query connection
                        "SELECT id FROM items WHERE id = ?1 UNION SELECT id FROM roadmaps WHERE id = ?1"
                        (ref (vec (text->json candidate)))))
    (ok (not (empty? rows)))))

(defn database-now (connection)
  (let-try (rows (query connection
                        "SELECT strftime('%Y-%m-%dT%H:%M:%fZ', 'now')"
                        (ref (vec)))
            row (single-row (ref rows))
            text (text-cell row 0))
    (ok (->timestamp :value text))))
