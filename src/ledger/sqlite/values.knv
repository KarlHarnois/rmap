(module
  "Names the values SQLite stores and builds them from text and numbers.")

(export int->sql optional-text->sql sql-value text->sql)

(defenum sql-value
  (rust "rusqlite::types::Value")
  null
  (integer int)
  (real float)
  (text string)
  (blob (vec u8)))

(defn int->sql (number) (sql-value/integer number))

(defn optional-text->sql (text)
  (match text
    ((some present) (text->sql (as-str present)))
    (none sql-value/null)))

(defn text->sql (text)
  (sql-value/text (str text)))
