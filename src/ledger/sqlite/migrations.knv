(module
  "Applies pending migrations in version order, records each version in `PRAGMA user_version` and reports the version it started from.")

(use ledger/sqlite/rows int-cell single-row try-each)

(use ledger/sqlite/schema-versions ->schema-versions
                                   ledger-newer?)

(use ledger/sqlite/connection ->database-error
                              database-failure
                              database-problem
                              in-write-transaction query
                              run-batch)

(export ->migration empty-schema-version migrate migration
        schema-version)

(def empty-schema-version 0)

(defstruct migration
  :version int
  :file string
  :sql string)

(defn migrate (connection migrations)
  (in-write-transaction connection
    (fn (locked)
      (apply-pending-after-version locked migrations))))

(defn schema-version (connection)
  (let-try (rows (query connection "PRAGMA user_version" (ref (vec)))
            row (single-row (ref rows)))
    (int-cell row 0)))

(defn apply-pending-after-version (connection migrations)
  (let-try (_ (check-unique-versions migrations)
            current (schema-version connection)
            _ (check-not-newer current migrations)
            _ (apply-pending connection
                             (pending-after migrations current)))
    (ok current)))

(defn check-not-newer (current migrations)
  (let (versions (->schema-versions :ledger current
                                    :binary (newest-version migrations)))
    (if (ledger-newer? versions)
      (err (too-new-failure versions))
      (ok (do)))))

(defn newest-version (migrations)
  (-> migrations iter
      (map :version)
      max
      (unwrap-or empty-schema-version)))

(defn too-new-failure (versions)
  (->database-error :message (str "the ledger has schema version "
                                  (:ledger versions)
                                  " but this rmap knows only up to version "
                                  (:binary versions)
                                  "; upgrade rmap to open it")
                    :problem (database-problem/too-new versions)))

(defn pending-after (migrations current)
  (let (pending (-> migrations iter
                    (filter (fn (migration)
                              (> (:version migration) current)))
                    (map clone)
                    collect))
    (sort-by! pending :version)
    pending))

(defn apply-pending (connection pending)
  (try-each pending
    (fn (migration) (apply-one connection migration))))

(defn apply-one (connection migration)
  (run-batch connection
             (as-str (str (:sql migration)
                          "\nPRAGMA user_version = "
                          (:version migration)
                          ";"))))

(defn check-unique-versions (migrations)
  (match (find (iter migrations)
           (fn (migration) (shares-version? migrations migration)))
    ((some migration)
     (err (database-failure (str "two migrations share version "
                                 (:version migration)))))
    (none (ok (do)))))

(defn shares-version? (migrations migration)
  (> (count (filter (iter migrations)
              (fn (other)
                (= (:version other) (:version migration)))))
     1))
