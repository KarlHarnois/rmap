(module
  "Reads and writes the `decision_blocks` table: the items each decision blocks.")

(use ledger/sqlite/values text->sql)
(use ledger/model ->decision-block ->decision-id ->item-id
                  decision-id item-id)
(use ledger/names decision-status-names)

(use ledger/sqlite/connection connection database-error
                              execute query)

(use ledger/sqlite/rows named-cell rows->values text-cell try-each)

(export all-blocks block-exists? blocks-of delete-block insert-block
        insert-blocks move-blocks)

(def take-over-sql
  "INSERT OR IGNORE INTO decision_blocks (decision_id, item_id) SELECT ?2, item_id FROM decision_blocks WHERE decision_id = ?1")

(def drop-blocks-sql
  "DELETE FROM decision_blocks WHERE decision_id = ?1")

(defn insert-blocks (connection decision items)
  (try-each items
    (fn (item) (insert-block connection decision item))))

(type blocks-of
  (fn ((ref connection) (ref decision-id))
    (result (vec item-id) database-error)))

(defn blocks-of (connection decision)
  (let-try (rows (query connection
                        "SELECT item_id FROM decision_blocks WHERE decision_id = ?1 ORDER BY item_id"
                        (ref (vec (text->sql (as-str (:value decision)))))))
    (rows->values (ref rows) row->item-id)))

(defn all-blocks (connection)
  (let-try (rows (query connection
                        "SELECT b.decision_id, b.item_id, d.status FROM decision_blocks b JOIN decisions d ON d.id = b.decision_id ORDER BY b.decision_id, b.item_id"
                        (ref (vec))))
    (rows->values (ref rows) row->decision-block)))

(type block-exists?
  (fn ((ref connection)
       (ref decision-id)
       (ref item-id))
    (result bool database-error)))

(defn block-exists? (connection decision item)
  (let-try (rows (query connection
                        "SELECT decision_id FROM decision_blocks WHERE decision_id = ?1 AND item_id = ?2"
                        (ref (vec (text->sql (as-str (:value decision)))
                                  (text->sql (as-str (:value item)))))))
    (ok (not (empty? rows)))))

(type delete-block
  (fn ((ref connection)
       (ref decision-id)
       (ref item-id))
    (result int database-error)))

(defn delete-block (connection decision item)
  (execute connection
           "DELETE FROM decision_blocks WHERE decision_id = ?1 AND item_id = ?2"
           (ref (vec (text->sql (as-str (:value decision)))
                     (text->sql (as-str (:value item)))))))

(type move-blocks
  (fn ((ref connection)
       (ref decision-id)
       (ref decision-id))
    (result unit database-error)))

(defn move-blocks (connection from to)
  (let (from-id (text->sql (as-str (:value from)))
        to-id (text->sql (as-str (:value to))))
    (let-try (_ (execute connection take-over-sql (ref (vec from-id to-id))))
      (let-try (_ (execute connection drop-blocks-sql
                           (ref (vec (text->sql (as-str (:value from)))))))
        (ok (do))))))

(type insert-block
  (fn ((ref connection)
       (ref decision-id)
       (ref item-id))
    (result int database-error)))

(defn insert-block (connection decision item)
  (execute connection
           "INSERT INTO decision_blocks (decision_id, item_id) VALUES (?1, ?2)"
           (ref (vec (text->sql (as-str (:value decision)))
                     (text->sql (as-str (:value item)))))))

(defn row->item-id (row)
  (let-try (id (text-cell row 0))
    (ok (->item-id :value id))))

(defn row->decision-block (row)
  (let-try (decision (text-cell row 0)
            item (text-cell row 1)
            status (named-cell row 2 decision-status-names))
    (ok (->decision-block :decision (->decision-id :value decision)
                          :item (->item-id :value item)
                          :status status))))
