(module
  "Reads and writes the `roadmaps` table.")

(use ledger/sqlite/values text->sql)

(use ledger/model ->roadmap ->roadmap-id ->session
                  ->timestamp roadmap)

(use ledger/names case-name roadmap-status-names)

(use ledger/sqlite/connection connection database-error
                              execute query)

(use ledger/sqlite/rows named-cell rows->values text-cell)

(export all-roadmaps insert-roadmap roadmap-named
        update-roadmap-status)

(def columns
  "id, name, manager_session, status, created_at")

(type insert-roadmap
  (fn ((ref connection) (ref roadmap))
    (result int database-error)))

(defn insert-roadmap (connection roadmap)
  (execute connection
           (as-str (str "INSERT INTO roadmaps (" columns
                        ") VALUES (?1, ?2, ?3, ?4, ?5)"))
           (ref (vec (text->sql (as-str (:value (:id roadmap))))
                     (text->sql (as-str (:name roadmap)))
                     (text->sql (as-str (:name (:manager roadmap))))
                     (text->sql (case-name roadmap-status-names
                                           (:status roadmap)))
                     (text->sql (as-str (:value (:created-at roadmap))))))))

(type update-roadmap-status
  (fn ((ref connection) (ref roadmap))
    (result int database-error)))

(defn update-roadmap-status (connection roadmap)
  (execute connection
           "UPDATE roadmaps SET status = ?2 WHERE id = ?1"
           (ref (vec (text->sql (as-str (:value (:id roadmap))))
                     (text->sql (case-name roadmap-status-names
                                           (:status roadmap)))))))

(defn all-roadmaps (connection)
  (let-try (rows (query connection
                        (as-str (str "SELECT " columns
                                     " FROM roadmaps ORDER BY created_at, id"))
                        (ref (vec))))
    (rows->values (ref rows) row->roadmap)))

(defn roadmap-named (connection name)
  (let-try (rows (query connection
                        (as-str (str "SELECT " columns
                                     " FROM roadmaps WHERE name = ?1"))
                        (ref (vec (text->sql name))))
            roadmaps (rows->values (ref rows) row->roadmap))
    (ok (first-owned roadmaps))))

(defn first-owned (items)
  (map-some (first items) clone))

(defn row->roadmap (row)
  (let-try (id (text-cell row 0)
            name (text-cell row 1)
            manager (text-cell row 2)
            status (named-cell row 3 roadmap-status-names)
            created-at (text-cell row 4))
    (ok (->roadmap :id (->roadmap-id :value id)
                   :name name
                   :manager (->session :name manager)
                   :status status
                   :created-at (->timestamp :value created-at)))))
