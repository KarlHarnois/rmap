(module
  "Turns ledger ids, claims, timestamps and the columns of an item into JSON values.")

(use json/value array bool->json int->json json text->json)
(use ledger/model claim exclusivity item item-id timestamp)
(use ledger/model/pull-requests pr-number)

(use ledger/names case-name kind-names origin-names
                  status-names)

(export claim->json criteria->json head->json id->json
        ids->json item->columns optional-id->json
        optional-ids->json optional-text->json
        optional-timestamp->json pr-number->json)

(defn head->json (head)
  (text->json (as-str (:sha head))))

(type pr-number->json
  (fn ((ref pr-number)) json))

(defn pr-number->json (number)
  (int->json (:value number)))

(defn ids->json (ids)
  (array (collect (map (iter ids) id->json))))

(defn optional-ids->json (id)
  (match id
    ((some present) (array (vec (id->json present))))
    (none (array (vec)))))

(type item->columns
  (fn ((ref item))
    (vec (pair string json))))

(defn item->columns (item)
  (vec (pair (str "title")
             (text->json (as-str (:title item))))
       (pair (str "kind")
             (text->json (case-name kind-names (:kind item))))
       (pair (str "status")
             (text->json (case-name status-names (:status item))))
       (pair (str "origin")
             (text->json (case-name origin-names (:origin item))))
       (pair (str "priority")
             (int->json (:priority item)))
       (pair (str "exclusive")
             (bool->json (exclusive? item)))
       (pair (str "parent_id")
             (optional-id->json (ref (:parent item))))
       (pair (str "closed_at")
             (optional-timestamp->json (ref (:closed-at item))))
       (pair (str "description")
             (optional-text->json (ref (:description item))))
       (pair (str "criteria")
             (criteria->json (ref (:criteria item))))))

(defn criteria->json (criteria)
  (array (collect (map (iter criteria) text->json))))

(defn optional-id->json (id)
  (match id
    ((some present) (id->json present))
    (none json/null)))

(type id->json
  (fn ((ref item-id)) json))

(defn id->json (id)
  (text->json (as-str (:value id))))

(defn optional-text->json (text)
  (match text
    ((some present) (text->json (as-str present)))
    (none json/null)))

(defn claim->json (claim)
  (match claim
    ((claimed-by session)
     (text->json (as-str (:name (:session session)))))
    (unclaimed json/null)))

(type optional-timestamp->json
  (fn ((ref (option timestamp))) json))

(defn optional-timestamp->json (at)
  (match at
    ((some present) (text->json (as-str (:value present))))
    (none json/null)))

(type exclusive? (fn ((ref item)) bool))

(defn exclusive? (item)
  (= (:exclusive item) exclusivity/exclusive))
