(module
  "Lists items and shows one item with its dependencies and globs.")

(use ledger/model dep glob item item-id)
(use ledger/core/index index-of with-shown-status)

(use ledger/core/snapshot deps-of existing globs-of
                          in-scope?)

(use ledger/sqlite/events ->event-filter)
(use ledger/sqlite/snapshot load-snapshot)

(use ledger/operations/transaction in-read-transaction
                                   settings)

(use ledger/failure failure)
(use ledger/operations/lookups scope-named)
(use ledger/sqlite/connection connection)

(export item-detail list-items show-item)

(defstruct item-detail
  :item item
  :deps (vec dep)
  :globs (vec glob))

(type list-items
  (fn ((ref settings) (option string))
    (result (vec item) failure)))

(defn list-items (settings roadmap)
  (in-read-transaction settings
    (fn (transaction)
      (items-within (ref (:connection transaction))
                    (ref roadmap)))))

(type items-within
  (fn ((ref connection) (ref (option string)))
    (result (vec item) failure)))

(defn items-within (connection roadmap)
  (let-try (scope (scope-named connection roadmap)
            snapshot (load-snapshot connection))
    (ok (shown-items (ref snapshot) (ref scope)))))

(defn shown-items (snapshot scope)
  (let (index (index-of snapshot))
    (collect (map (filter (iter (:items snapshot))
                    (fn (item) (in-scope? item scope)))
                  (fn (item)
                    (with-shown-status (ref index) item))))))

(type show-item
  (fn ((ref settings) item-id)
    (result item-detail failure)))

(defn show-item (settings id)
  (in-read-transaction settings
    (fn (transaction)
      (detail-within (ref (:connection transaction))
                     (ref id)))))

(type detail-within
  (fn ((ref connection) (ref item-id))
    (result item-detail failure)))

(defn detail-within (connection id)
  (let-try (snapshot (load-snapshot connection)
            item (existing (ref snapshot) id))
    (ok (->item-detail :item (with-shown-status (ref (index-of (ref snapshot)))
                                                (ref item))
                       :deps (deps-of (ref snapshot) id)
                       :globs (globs-of (ref snapshot) id)))))
