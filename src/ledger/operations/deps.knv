(module
  "Adds and removes `blocks` dependencies.")

(use ledger/model ->dep dep dep-type event-type snapshot)
(use ledger/refusal refusal)
(use ledger/core/schema check-dep-removal check-new-dep)
(use ledger/sqlite/deps delete-dep insert-dep)
(use ledger/sqlite/store load-snapshot)

(use ledger/operations/transaction in-transaction record
                                   transaction)

(use ledger/failure failure)
(use ledger/core/snapshot existing)
(use ledger/events dep-changed)

(export add-dep remove-dep)

(defn add-dep (settings item on)
  (change-dep settings
              (->dep :item item :on on :type dep-type/blocks)
              event-type/dep-added))

(defn remove-dep (settings item on)
  (change-dep settings
              (->dep :item item :on on :type dep-type/blocks)
              event-type/dep-removed))

(defn change-dep (settings dep type)
  (in-transaction settings
    (fn (transaction) (write-dep transaction dep type))))

(type write-dep
  (fn ((ref transaction) dep event-type)
    (result dep failure)))

(defn write-dep (transaction dep type)
  (let-try (snapshot (load-snapshot (ref (:connection transaction)))
            _ (check-dep-change (ref snapshot) (ref dep) type)
            _ (write-dep-change (ref (:connection transaction))
                                (ref dep)
                                type)
            owner (existing (ref snapshot)
                            (ref (:item dep)))
            _ (record transaction
                      (dep-changed (ref owner) (ref dep) type)))
    (ok (clone dep))))

(type check-dep-change
  (fn ((ref snapshot) (ref dep) event-type)
    (result unit refusal)))

(defn check-dep-change (snapshot dep type)
  (match type
    (dep-added (check-new-dep snapshot
                              (ref (:item dep))
                              (ref (:on dep))))
    (_ (check-dep-removal snapshot
                          (ref (:item dep))
                          (ref (:on dep))))))

(defn write-dep-change (connection dep type)
  (let-try (changed (match type
                      (dep-added (insert-dep connection dep))
                      (_ (delete-dep connection dep))))
    (ok changed)))
