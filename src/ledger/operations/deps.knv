(module
  "Adds and removes `blocks` dependencies.")

(use ledger/model ->dep dep dep-type)
(use ledger/core/deps check-dep-change dep-change)
(use ledger/sqlite/deps delete-dep insert-dep)
(use ledger/sqlite/snapshot load-snapshot)

(use ledger/operations/transaction in-transaction record
                                   transaction)

(use ledger/failure failure)
(use ledger/core/snapshot existing)
(use ledger/events dep-changed)
(use ledger/sqlite/connection connection database-error)

(export add-dep remove-dep)

(defn add-dep (settings item on)
  (change-dep settings
              (->dep :item item :on on :type dep-type/blocks)
              dep-change/add))

(defn remove-dep (settings item on)
  (change-dep settings
              (->dep :item item :on on :type dep-type/blocks)
              dep-change/remove))

(defn change-dep (settings dep change)
  (in-transaction settings
    (fn (transaction) (write-dep transaction dep change))))

(type write-dep
  (fn ((ref transaction) dep dep-change)
    (result dep failure)))

(defn write-dep (transaction dep change)
  (let-try (snapshot (load-snapshot (ref (:connection transaction)))
            _ (check-dep-change (ref snapshot) (ref dep) change)
            owner (existing (ref snapshot)
                            (ref (:item dep)))
            _ (write-dep-change (ref (:connection transaction))
                                (ref dep)
                                change)
            _ (record transaction
                      (dep-changed (ref owner) (ref dep) change)))
    (ok (clone dep))))

(type write-dep-change
  (fn ((ref connection) (ref dep) dep-change)
    (result int database-error)))

(defn write-dep-change (connection dep change)
  (match change
    (add (insert-dep connection dep))
    (remove (delete-dep connection dep))))
