(module
  "Records a reviewer session's review of a build's pull request while ending that session, in one transaction with its event. It never moves the item.")

(use ledger/model/pull-requests ->recorded-review
                                recorded-review
                                review-request)

(use ledger/model/sessions session-id)

(use ledger/core/reviews ->review-stamp approved-head
                         check-live-review review-end
                         review-stamp stamped-review)

(use ledger/core/snapshot existing)
(use ledger/review-events item-reviewed)
(use ledger/operations/pull-requests pull-request-for)

(use ledger/operations/transaction in-transaction now record
                                   settings transaction)

(use ledger/sqlite/reviews insert-review next-review-id)
(use ledger/sqlite/live-sessions live-review-session-id)

(use ledger/sqlite/sessions end-session-id
                            item-worker-sessions)

(use ledger/sqlite/snapshot load-snapshot)
(use ledger/sqlite/connection database-failure)
(use ledger/failure failure)

(export record-review)

(type record-review
  (fn ((ref settings) review-request)
    (result recorded-review failure)))

(defn record-review (settings request)
  (in-transaction settings
    (fn (transaction)
      (store-review transaction (ref request)))))

(type store-review
  (fn ((ref transaction) (ref review-request))
    (result recorded-review failure)))

(defn store-review (transaction request)
  (let (connection (ref (:connection transaction)))
    (let-try (snapshot (load-snapshot connection)
              item (existing (ref snapshot)
                             (ref (:item request)))
              before (pull-request-for connection (ref (:id item)))
              workers (item-worker-sessions connection (ref (:id item)))
              live (live-review-session-id connection
                                           (ref (:id item))
                                           (ref (:reviewer request)))
              head (approved-head (ref item)
                                  (ref before)
                                  request
                                  (ref workers))
              session-id (check-live-review (ref live)
                                            (ref (:reviewer request)))
              stamp (review-stamp-of transaction (ref session-id)))
      (let (review (stamped-review request head stamp)
            end (review-end (now transaction)))
        (let-try (_ (end-session-id connection (ref session-id) (ref end))
                  _ (insert-review connection (ref review))
                  after (pull-request-for connection (ref (:id item)))
                  pull-request (ok-or after
                                      (failure/database (database-failure (str "the reviewed pull request is gone"))))
                  _ (record transaction
                            (item-reviewed (ref item)
                                           (ref review)
                                           (ref end)
                                           (ref pull-request))))
          (ok (->recorded-review :review review
                                 :pull-request pull-request)))))))

(type review-stamp-of
  (fn ((ref transaction) (ref session-id))
    (result review-stamp failure)))

(defn review-stamp-of (transaction session-id)
  (let (connection (ref (:connection transaction)))
    (let-try (id (next-review-id connection))
      (ok (->review-stamp :id id
                          :session-id (clone session-id)
                          :created-at (now transaction))))))
