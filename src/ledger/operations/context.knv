(module
  "Opens the ledger, runs writes in one transaction and records their events.")

(use json/value json)

(use ledger/model ->dep ->glob ->item ->item-id ->item-path
                  ->roadmap ->roadmap-id ->session
                  event-type item-id roadmap-id timestamp)

(use ledger/refusal refusal)
(use ledger/core/ready scope)
(use ledger/core/statuses find-item)
(use ledger/core/schema ->new-item)

(use ledger/sqlite/connection ->database-error begin commit
                              connection database-error open
                              rollback)

(use ledger/sqlite/migrations migrate)
(use process/command ->command)
(use ledger/sqlite/migration-sources migration-sources)
(use ledger/sqlite/roadmaps roadmap-named)

(use ledger/sqlite/events ->event-filter ->new-event
                          append-event)

(use ledger/sqlite/store database-now)

(export ->event-draft ->settings cli-actor clock connect
        event-draft existing-item failure in-transaction now
        record roadmap-id-named scope-named settings
        transaction)

(defenum clock
  system
  (fixed timestamp))

(defstruct settings
  :database-path string
  :clock clock)

(defstruct transaction
  :connection connection
  :clock clock)

(defstruct event-draft
  :actor string
  :roadmap-id (option roadmap-id)
  :item-id (option item-id)
  :type event-type
  :payload json)

(defenum failure
  (refused refusal)
  (database database-error))

(def cli-actor "cli")

(defn connect (settings)
  (let-try (connection (open (as-str (:database-path settings)))
            _ (migrate (ref connection) (migration-sources)))
    (ok connection)))

(type in-transaction
  (where (a)
    (fn ((ref settings)
         (fn ((ref transaction))
           (result a failure)))
      (result a failure))))

(defn in-transaction (settings work)
  (let-try (connection (connect settings)
            _ (begin (ref connection)))
    (let (transaction (->transaction :connection connection
                                     :clock (clone (:clock settings))))
      (finish (ref (:connection transaction))
              (work (ref transaction))))))

(type finish
  (where (a)
    (fn ((ref connection) (result a failure))
      (result a failure))))

(defn finish (connection outcome)
  (match outcome
    ((ok value) (let-try (_ (commit connection)) (ok value)))
    ((err failure)
     (match (rollback connection)
       (_ (err failure))))))

(type now
  (fn ((ref transaction))
    (result timestamp failure)))

(defn now (transaction)
  (match (ref (:clock transaction))
    (system (let-try (at (database-now (ref (:connection transaction))))
              (ok at)))
    ((fixed at) (ok (clone at)))))

(defn record (transaction draft)
  (let-try (at (now transaction)
            _ (append-event (ref (:connection transaction))
                            (ref (draft->event draft at))))
    (ok (do))))

(defn draft->event (draft at)
  (let-match ((event-draft :actor actor
                           :roadmap-id roadmap-id
                           :item-id item-id
                           :type type
                           :payload payload) draft)
    (->new-event :at at
                 :actor actor
                 :roadmap-id roadmap-id
                 :item-id item-id
                 :type type
                 :payload payload)))

(type roadmap-id-named
  (fn ((ref connection) (ref str))
    (result roadmap-id failure)))

(defn roadmap-id-named (connection name)
  (let-try (found (roadmap-named connection name))
    (match found
      ((some roadmap) (ok (clone (:id roadmap))))
      (none (err (failure/refused (refusal/roadmap-not-found (str name))))))))

(defn scope-named (connection name)
  (match name
    ((some present)
     (map-ok (roadmap-id-named connection (as-str present))
       (fn (id) (scope/one-roadmap id))))
    (none (ok scope/every-roadmap))))

(defn existing-item (snapshot id)
  (ok-or (find-item snapshot id)
         (failure/refused (refusal/item-not-found (clone id)))))
