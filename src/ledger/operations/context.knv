(module
  "Opens the ledger, runs writes in one transaction and records their events.")

(use ledger/model ->dep ->glob ->item ->item-id ->item-path
                  ->roadmap ->roadmap-id ->session
                  roadmap-id timestamp)

(use ledger/refusal refusal)
(use ledger/core/ready scope)
(use ledger/core/statuses find-item)
(use ledger/core/schema ->new-item)

(use ledger/sqlite/connection begin commit connection
                              database-error git-common-dir
                              open rollback)

(use ledger/sqlite/migrations migrate)
(use ledger/sqlite/migration-sources migration-sources)
(use ledger/sqlite/roadmaps roadmap-named)

(use ledger/sqlite/events ->event-filter ->new-event
                          append-event)

(use ledger/sqlite/store database-now)

(export ->settings cli-actor clock connect
        default-database-path existing-item failure
        in-transaction now record roadmap-id-named
        scope-named settings)

(defenum clock
  system
  (fixed timestamp))

(defstruct settings
  :database-path string
  :clock clock)

(defenum failure
  (refused refusal)
  (database database-error))

(def cli-actor "cli")

(type default-database-path
  (fn () (result string failure)))

(defn default-database-path ()
  (let-try (common-dir (git-common-dir))
    (ok (str common-dir "/ledger.db"))))

(defn connect (settings)
  (let-try (connection (open (as-str (:database-path settings)))
            _ (migrate (ref connection) (migration-sources)))
    (ok connection)))

(type in-transaction
  (where (a)
    (fn ((ref settings)
         (fn ((ref connection))
           (result a failure)))
      (result a failure))))

(defn in-transaction (settings work)
  (let-try (connection (connect settings)
            _ (begin (ref connection)))
    (finish (ref connection)
            (work (ref connection)))))

(type finish
  (where (a)
    (fn ((ref connection) (result a failure))
      (result a failure))))

(defn finish (connection outcome)
  (match outcome
    ((ok value) (let-try (_ (commit connection)) (ok value)))
    ((err failure)
     (match (rollback connection)
       (_ (err failure))))))

(defn now (connection settings)
  (match (:clock settings)
    (system (let-try (at (database-now connection)) (ok at)))
    ((fixed at) (ok (clone at)))))

(defn record (connection settings actor roadmap-id item-id type payload)
  (let-try (at (now connection settings)
            _ (append-event connection
                            (ref (->new-event :at at
                                              :actor actor
                                              :roadmap-id roadmap-id
                                              :item-id item-id
                                              :type type
                                              :payload payload))))
    (ok (do))))

(type roadmap-id-named
  (fn ((ref connection) (ref str))
    (result roadmap-id failure)))

(defn roadmap-id-named (connection name)
  (let-try (found (roadmap-named connection name))
    (match found
      ((some roadmap) (ok (clone (:id roadmap))))
      (none (err (failure/refused (refusal/roadmap-not-found (str name))))))))

(defn scope-named (connection name)
  (match name
    ((some present)
     (map-ok (roadmap-id-named connection (as-str present))
       (fn (id) (scope/one-roadmap id))))
    (none (ok scope/every-roadmap))))

(defn existing-item (snapshot id)
  (ok-or (find-item snapshot id)
         (failure/refused (refusal/item-not-found (clone id)))))
