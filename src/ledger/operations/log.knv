(module
  "Reads the events the ledger recorded.")

(use ledger/model decision-id item-id)
(use ledger/model/events event)

(use ledger/sqlite/events ->event-filter event-filter
                          events-matching)

(use ledger/operations/transaction in-read-transaction
                                   settings)

(use ledger/failure failure)
(use ledger/sqlite/connection connection)

(export ->log-query log-query read-log)

(defstruct log-query
  :item (option item-id)
  :decision (option decision-id)
  :after-id int)

(type read-log
  (fn ((ref settings) (ref log-query))
    (result (vec event) failure)))

(defn read-log (settings query)
  (in-read-transaction settings
    (fn (transaction)
      (events-within (ref (:connection transaction))
                     (ref (->event-filter :item-id (clone (:item query))
                                          :decision-id (clone (:decision query))
                                          :after-id (:after-id query)))))))

(type events-within
  (fn ((ref connection) (ref event-filter))
    (result (vec event) failure)))

(defn events-within (connection filter)
  (let-try (events (events-matching connection filter))
    (ok events)))
