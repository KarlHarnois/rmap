(module
  "Edits an item and records the change in one transaction.")

(use ledger/model item item-id)
(use ledger/core/criteria criteria-input)

(use ledger/core/item-edits ->item-edit apply-edit
                            check-criteria-edit
                            check-description-edit
                            check-edit criteria-edit
                            description-edit item-edit)

(use ledger/core/new-items description-input)
(use ledger/sqlite/criteria replace-criteria)
(use ledger/sqlite/criterion-verdicts delete-criterion-verdicts)
(use ledger/sqlite/items update-item)
(use ledger/sqlite/snapshot load-snapshot)
(use ledger/operations/criteria resolve-criteria)
(use ledger/operations/descriptions resolve-description)

(use ledger/operations/transaction in-transaction record
                                   settings transaction)

(use ledger/core/snapshot existing)
(use ledger/events edit-changes item-edited)
(use ledger/failure failure)

(export edit-item)

(type edit-item
  (fn ((ref settings) item-id item-edit)
    (result item failure)))

(defn edit-item (settings id edit)
  (let-try (description (resolved-edit-description (clone (:description edit)))
            criteria (resolved-edit-criteria (clone (:criteria edit))))
    (in-transaction settings
      (fn (transaction)
        (apply-edit-in transaction
                       (ref id)
                       edit description criteria)))))

(defn resolved-edit-description (input)
  (match (clone input)
    (description-input/unspecified (ok description-edit/keep))
    ((description-input/text value)
     (ok (description-edit/set (cleared (ref value)))))
    (_ (map-ok (resolve-description input)
         (fn (text)
           (description-edit/set (cleared-option text)))))))

(defn resolved-edit-criteria (input)
  (match (clone input)
    (criteria-input/unspecified (ok criteria-edit/keep))
    (_ (map-ok (resolve-criteria input)
         (fn (criteria)
           (criteria-edit/set (unwrap-or criteria (vec))))))))

(defn cleared-option (text)
  (match text
    ((some value) (cleared (ref value)))
    (none none)))

(defn cleared (text)
  (if (empty? text)
    none
    (some (clone text))))

(type apply-edit-in
  (fn ((ref transaction)
       (ref item-id)
       item-edit description-edit criteria-edit)
    (result item failure)))

(defn apply-edit-in (transaction id edit description criteria)
  (let-try (snapshot (load-snapshot (ref (:connection transaction)))
            item (existing (ref snapshot) id)
            _ (check-edit (ref item) (ref edit))
            _ (check-description-edit (ref description))
            _ (check-criteria-edit (ref criteria)))
    (store-edit transaction
                (ref item)
                (apply-edit (ref item) (ref edit) description criteria))))

(type store-edit
  (fn ((ref transaction) (ref item) item)
    (result item failure)))

(defn store-edit (transaction before after)
  (let-try (_ (update-item (ref (:connection transaction))
                           (ref after))
            _ (write-criteria (ref (:connection transaction))
                              before
                              (ref after))
            _ (record-edit transaction before (ref after)))
    (ok after)))

(defn write-criteria (connection before after)
  (if (= (:criteria before) (:criteria after))
    (ok (do))
    (let-try (_ (map-err (delete-criterion-verdicts connection
                                                    (ref (:id after)))
                         (fn (cause) (failure/database cause))))
      (map-err (replace-criteria connection
                                 (ref (:id after))
                                 (ref (:criteria after)))
               (fn (cause) (failure/database cause))))))

(defn record-edit (transaction before after)
  (let (changes (edit-changes before after))
    (if (empty? changes)
      (ok (do))
      (record transaction (item-edited after (ref changes))))))
