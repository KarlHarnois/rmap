(module
  "Creates and lists roadmaps.")

(use json/value object text->json)

(use ledger/model ->dep ->glob ->item ->item-id ->item-path
                  ->roadmap ->roadmap-id ->session
                  event-type roadmap roadmap-status)

(use ledger/refusal refusal)
(use ledger/core/schema ->new-item)
(use ledger/sqlite/connection connection)

(use ledger/sqlite/roadmaps all-roadmaps insert-roadmap
                            roadmap-named)

(use ledger/sqlite/events ->event-filter ->new-event)
(use ledger/sqlite/store fresh-id)

(use ledger/operations/context ->event-draft connect failure
                               in-transaction now record
                               settings transaction)

(export list-roadmaps new-roadmap)

(defn new-roadmap (settings name manager)
  (in-transaction settings
    (fn (transaction) (create-roadmap transaction name manager))))

(defn create-roadmap (transaction name manager)
  (let-try (_ (check-name-free (ref (:connection transaction))
                               (as-str name))
            id (fresh-id (ref (:connection transaction)))
            created-at (now transaction))
    (store-roadmap transaction
                   (->roadmap :id (->roadmap-id :value id)
                              :name name
                              :manager manager
                              :status roadmap-status/active
                              :created-at created-at))))

(type store-roadmap
  (fn ((ref transaction) roadmap)
    (result roadmap failure)))

(defn store-roadmap (transaction roadmap)
  (let-try (_ (insert-roadmap (ref (:connection transaction))
                              (ref roadmap))
            _ (record transaction (roadmap-created (ref roadmap))))
    (ok roadmap)))

(defn roadmap-created (roadmap)
  (->event-draft :actor (clone (:name (:manager roadmap)))
                 :roadmap-id (some (clone (:id roadmap)))
                 :item-id none
                 :type event-type/roadmap-created
                 :payload (object (vec
                                    (pair (str "name")
                                          (text->json (as-str (:name roadmap))))
                                    (pair (str "manager")
                                          (text->json (as-str (:name (:manager roadmap)))))))))

(type check-name-free
  (fn ((ref connection) (ref str))
    (result unit failure)))

(defn check-name-free (connection name)
  (let-try (existing (roadmap-named connection name))
    (match existing
      ((some _)
       (err (failure/refused (refusal/roadmap-exists (str name)))))
      (none (ok (do))))))

(type list-roadmaps
  (fn ((ref settings))
    (result (vec roadmap) failure)))

(defn list-roadmaps (settings)
  (let-try (connection (connect settings)
            roadmaps (all-roadmaps (ref connection)))
    (ok roadmaps)))
