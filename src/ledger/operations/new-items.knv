(module
  "Adds an item with its dependencies.")

(use ledger/model ->dep ->item ->item-id claim dep dep-type
                  item item-id roadmap-id status timestamp)

(use ledger/core/criteria check-criteria)

(use ledger/core/new-items check-description check-new-item
                           new-item normalized)

(use ledger/operations/criteria resolve-criteria)
(use ledger/operations/descriptions resolve-description)
(use ledger/sqlite/items insert-item)
(use ledger/sqlite/criteria insert-criteria)
(use ledger/sqlite/deps insert-deps)
(use ledger/sqlite/snapshot load-snapshot)
(use ledger/sqlite/generated fresh-id)

(use ledger/operations/transaction in-transaction now record
                                   settings transaction)

(use ledger/failure failure)
(use ledger/operations/lookups roadmap-id-named)
(use ledger/events item-added)

(export add-item)

(defstruct item-stamp
  :id item-id
  :roadmap-id roadmap-id
  :roadmap-name string
  :created-at timestamp)

(type add-item
  (fn ((ref settings) string new-item)
    (result item failure)))

(defn add-item (settings roadmap request)
  (let-try (description (resolve-description (clone (:description request)))
            criteria (add-criteria (clone (:criteria request))))
    (in-transaction settings
      (fn (transaction)
        (insert-new-item transaction roadmap
                         (normalized request)
                         description criteria)))))

(defn add-criteria (input)
  (map-ok (resolve-criteria input)
    (fn (resolved)
      (unwrap-or resolved (vec)))))

(defn insert-new-item (transaction roadmap request description criteria)
  (let-try (roadmap-id (roadmap-id-named (ref (:connection transaction))
                                         (as-str roadmap))
            snapshot (load-snapshot (ref (:connection transaction)))
            _ (check-new-item (ref snapshot)
                              (ref roadmap-id)
                              (ref request))
            _ (check-description (ref description))
            _ (check-criteria (ref criteria))
            id (fresh-id (ref (:connection transaction))))
    (store-item transaction
                (request->item (ref request)
                               (->item-stamp :id (->item-id :value id)
                                             :roadmap-id roadmap-id
                                             :roadmap-name (str roadmap)
                                             :created-at (now transaction))
                               description criteria)
                (ref request))))

(type store-item
  (fn ((ref transaction) item (ref new-item))
    (result item failure)))

(defn store-item (transaction item request)
  (let-try (_ (insert-item (ref (:connection transaction))
                           (ref item))
            _ (insert-criteria (ref (:connection transaction))
                               (ref (:id item))
                               (ref (:criteria item)))
            _ (insert-deps (ref (:connection transaction))
                           (ref (draft-deps (ref item) request)))
            _ (record transaction (item-added (ref item) request)))
    (ok item)))

(type request->item
  (fn ((ref new-item)
       item-stamp
       (option string)
       (vec string))
    item))

(defn request->item (request stamp description criteria)
  (let-match ((item-stamp :id id
                          :roadmap-id roadmap-id
                          :roadmap-name roadmap-name
                          :created-at created-at) stamp)
    (->item :id id
            :roadmap-id roadmap-id
            :roadmap-name roadmap-name
            :parent (clone (:parent request))
            :title (clone (:title request))
            :description description
            :criteria criteria
            :kind (:kind request)
            :status status/open
            :origin (:origin request)
            :priority (:priority request)
            :exclusive (:exclusive request)
            :claim claim/unclaimed
            :created-at created-at
            :closed-at none)))

(type draft-deps
  (fn ((ref item) (ref new-item))
    (vec dep)))

(defn draft-deps (item request)
  (let (deps (collect (map (iter (:blocked-by request))
                        (fn (on)
                          (->dep :item (clone (:id item))
                                 :on (clone on)
                                 :type dep-type/blocks)))))
    (match (ref (:discovered-from request))
      ((some from)
       (push! deps
              (->dep :item (clone (:id item))
                     :on (clone from)
                     :type dep-type/discovered-from)))
      (none (do)))
    deps))
