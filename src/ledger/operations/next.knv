(module
  "Reads the next actions for each open item. It changes nothing.")

(use ledger/model session)
(use ledger/core/next ->deliveries next-entry next-of)
(use ledger/core/selection selected-roadmaps)
(use ledger/sqlite/roadmaps all-roadmaps)
(use ledger/sqlite/snapshot load-snapshot)
(use ledger/sqlite/reports reports-matching)
(use ledger/sqlite/pull-requests all-pull-requests)
(use ledger/sqlite/criterion-verdicts all-criterion-verdicts)

(use ledger/sqlite/decisions ->decision-filter
                             decisions-matching)

(use ledger/model/reports ->report-query report-reading)

(use ledger/operations/transaction in-read-transaction
                                   settings)

(use ledger/failure failure)
(use ledger/operations/lookups scope-named)

(export next-actions)

(type next-actions
  (fn ((ref settings)
       (option string)
       (option session))
    (result (vec next-entry) failure)))

(defn next-actions (settings roadmap manager)
  (in-read-transaction settings
    (fn (transaction)
      (next-within (ref (:connection transaction))
                   (ref roadmap)
                   (ref manager)))))

(defn next-within (connection roadmap manager)
  (let-try (scope (scope-named connection roadmap)
            roadmaps (all-roadmaps connection)
            snapshot (load-snapshot connection)
            unread (reports-matching
                     connection
                     (ref (->report-query :item none
                                          :reading report-reading/unread-only)))
            pull-requests (all-pull-requests connection)
            verdicts (all-criterion-verdicts connection)
            decisions (decisions-matching connection
                                          (ref (->decision-filter
                                                 :roadmap-id none
                                                 :status none
                                                 :item none))))
    (ok (next-of (ref snapshot)
                 (ref (selected-roadmaps (ref roadmaps) (ref scope) manager))
                 (ref (->deliveries :reports unread
                                    :pull-requests pull-requests
                                    :criterion-verdicts verdicts))
                 (ref decisions)))))
