(module
  "Reads ready items, items and events.")

(use ledger/model dep event glob item item-id)
(use ledger/core/ready readiness readiness-of)
(use ledger/core/index index-of with-shown-status)

(use ledger/core/snapshot deps-of existing globs-of
                          in-scope?)

(use ledger/sqlite/events ->event-filter event-filter
                          events-matching)

(use ledger/sqlite/store load-snapshot)

(use ledger/operations/transaction failure
                                   in-read-transaction
                                   settings)

(use ledger/operations/lookups scope-named)
(use ledger/sqlite/connection connection)

(export item-detail list-items read-log ready-items
        show-item)

(defstruct item-detail
  :item item
  :deps (vec dep)
  :globs (vec glob))

(type ready-items
  (fn ((ref settings) (option string))
    (result readiness failure)))

(defn ready-items (settings roadmap)
  (in-read-transaction settings
    (fn (transaction)
      (readiness-within (ref (:connection transaction))
                        (ref roadmap)))))

(type readiness-within
  (fn ((ref connection) (ref (option string)))
    (result readiness failure)))

(defn readiness-within (connection roadmap)
  (let-try (scope (scope-named connection roadmap)
            snapshot (load-snapshot connection))
    (ok (readiness-of (ref snapshot) (ref scope)))))

(type read-log
  (fn ((ref settings) (option item-id) int)
    (result (vec event) failure)))

(defn read-log (settings item after-id)
  (in-read-transaction settings
    (fn (transaction)
      (events-within (ref (:connection transaction))
                     (ref (->event-filter :item-id (clone item)
                                          :after-id after-id))))))

(type events-within
  (fn ((ref connection) (ref event-filter))
    (result (vec event) failure)))

(defn events-within (connection filter)
  (let-try (events (events-matching connection filter))
    (ok events)))

(type list-items
  (fn ((ref settings) (option string))
    (result (vec item) failure)))

(defn list-items (settings roadmap)
  (in-read-transaction settings
    (fn (transaction)
      (items-within (ref (:connection transaction))
                    (ref roadmap)))))

(type items-within
  (fn ((ref connection) (ref (option string)))
    (result (vec item) failure)))

(defn items-within (connection roadmap)
  (let-try (scope (scope-named connection roadmap)
            snapshot (load-snapshot connection))
    (ok (shown-items (ref snapshot) (ref scope)))))

(defn shown-items (snapshot scope)
  (let (index (index-of snapshot))
    (collect (map (filter (iter (:items snapshot))
                    (fn (item) (in-scope? item scope)))
                  (fn (item)
                    (with-shown-status (ref index) item))))))

(type show-item
  (fn ((ref settings) item-id)
    (result item-detail failure)))

(defn show-item (settings id)
  (in-read-transaction settings
    (fn (transaction)
      (detail-within (ref (:connection transaction))
                     (ref id)))))

(type detail-within
  (fn ((ref connection) (ref item-id))
    (result item-detail failure)))

(defn detail-within (connection id)
  (let-try (snapshot (load-snapshot connection)
            item (existing (ref snapshot) id))
    (ok (->item-detail :item (with-shown-status (ref (index-of (ref snapshot)))
                                                (ref item))
                       :deps (deps-of (ref snapshot) id)
                       :globs (globs-of (ref snapshot) id)))))
