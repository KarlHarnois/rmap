(module
  "Reads which items can start, what blocks the others, and which of them can start together.")

(use ledger/core/ready readiness readiness-of)
(use ledger/core/batch batch batch-of batch-size)
(use ledger/sqlite/events ->event-filter)
(use ledger/sqlite/snapshot load-snapshot)

(use ledger/operations/transaction in-read-transaction
                                   settings)

(use ledger/failure failure)
(use ledger/operations/lookups scope-named)

(export ready-batch ready-items)

(type ready-items
  (fn ((ref settings) (option string))
    (result readiness failure)))

(defn ready-items (settings roadmap)
  (in-read-transaction settings
    (fn (transaction)
      (readiness-within (ref (:connection transaction))
                        (ref roadmap)))))

(type ready-batch
  (fn ((ref settings) (option string) batch-size)
    (result batch failure)))

(defn ready-batch (settings roadmap size)
  (in-read-transaction settings
    (fn (transaction)
      (batch-within (ref (:connection transaction))
                    (ref roadmap)
                    (clone size)))))

(defn readiness-within (connection roadmap)
  (let-try (scope (scope-named connection roadmap)
            snapshot (load-snapshot connection))
    (ok (readiness-of (ref snapshot) (ref scope)))))

(defn batch-within (connection roadmap size)
  (let-try (scope (scope-named connection roadmap)
            snapshot (load-snapshot connection))
    (ok (batch-of (ref (readiness-of (ref snapshot) (ref scope)))
                  (ref snapshot)
                  size))))
