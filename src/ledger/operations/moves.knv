(module
  "Claims, advances, closes and drops items, each in one transaction.")

(use ledger/model item item-id)

(use ledger/model/sessions ->session-start claim-request
                           session-start)

(use ledger/move-events applied-move
                        item-moved-with-context)

(use ledger/core/move advancement->move move)
(use ledger/core/transitions approved-move)
(use ledger/core/requirements check-requirements)
(use ledger/core/follow-up-creation close-application)
(use ledger/operations/follow-up-close prepare-close)
(use ledger/operations/follow-up-writes write-close-application)
(use ledger/follow-up-events close-context)
(use ledger/operations/pull-requests pull-request-for)
(use ledger/operations/move-writes applied write-move)

(use ledger/operations/review-sessions end-live-review-session
                                       superseded-review-end)

(use ledger/sqlite/criterion-verdicts criterion-verdicts-for)
(use git/branches default-branch)
(use ledger/sqlite/snapshot load-snapshot)

(use ledger/operations/transaction in-transaction now record
                                   settings transaction)

(use ledger/failure failure)
(use ledger/core/snapshot existing)

(export advance-item claim-item close-item drop-item)

(defn claim-item (settings id request)
  (perform-move settings id
                (move/claim (session-start-of settings request))))

(defn advance-item (settings id advancement)
  (match (advancement->move advancement)
    ((ok move) (perform-move settings id move))
    ((err refused) (err (failure/refused refused)))))

(defn close-item (settings id)
  (perform-move settings id move/close))

(defn drop-item (settings id reason)
  (perform-move settings id (move/drop reason)))

(type session-start-of
  (fn ((ref settings) (ref claim-request))
    session-start))

(defn session-start-of (settings request)
  (let (session (clone (:session request)))
    (->session-start :branch (unwrap-or (clone (:branch request))
                                        (clone (:name session)))
                     :base (base-of settings request)
                     :session session)))

(type base-of
  (fn ((ref settings) (ref claim-request))
    string))

(defn base-of (settings request)
  (match (:base request)
    ((some base) (clone base))
    (none (default-branch (ref (:repository settings))))))

(defn perform-move (settings id move)
  (in-transaction settings
    (fn (transaction)
      (apply-move transaction (ref id) move))))

(type apply-move
  (fn ((ref transaction) (ref item-id) move)
    (result item failure)))

(defn apply-move (transaction id requested)
  (let-try (snapshot (load-snapshot (ref (:connection transaction)))
            item (existing (ref snapshot) id)
            move (approved-move (ref snapshot) (ref item) requested)
            pull-request (pull-request-for (ref (:connection transaction)) id)
            verdicts (criterion-verdicts-for (ref (:connection transaction))
                                             (ref (:id item)))
            _ (check-requirements (ref item)
                                  (ref move)
                                  (ref pull-request)
                                  (ref verdicts))
            application (close-application-for transaction
                                               (ref item)
                                               (clone move)))
    (store-move transaction
                (applied (ref item) move (now transaction))
                application)))

(defn close-application-for (transaction item move)
  (if (= move move/close)
    (prepare-close transaction item)
    (ok none)))

(type store-move
  (fn ((ref transaction) applied-move (option close-application))
    (result item failure)))

(defn store-move (transaction applied application)
  (let (connection (ref (:connection transaction)))
    (let-try (review-end (end-review-for-move connection
                                              (ref (:id (:after applied)))
                                              (:move applied)
                                              (now transaction))
              _ (write-move transaction (ref applied))
              _ (write-close-application transaction (ref application))
              _ (record transaction
                        (item-moved-with-context (ref applied)
                                                 (ref review-end)
                                                 (ref (close-context (ref application))))))
      (ok (clone (:after applied))))))

(defn end-review-for-move (connection item move now)
  (match move
    (close (end-live-review-session connection item
                                    (superseded-review-end now)))
    ((drop _)
     (end-live-review-session connection item
                              (superseded-review-end now)))
    (_ (ok none))))
