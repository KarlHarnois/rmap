(module
  "Claims, advances, closes and drops items, each in one transaction.")

(use ledger/model item item-id)

(use ledger/events ->item-move cli-actor item-move
                   item-moved)

(use ledger/core/move added-globs advancement->move move
                      moved)

(use ledger/core/transitions approved-move)
(use ledger/sqlite/items update-item)
(use ledger/sqlite/store load-snapshot)

(use ledger/operations/transaction failure in-transaction
                                   now record transaction)

(use ledger/operations/lookups existing-item)
(use ledger/sqlite/item-paths insert-globs)

(export advance-item claim-item close-item drop-item)

(defstruct move-request
  :item item-id
  :move move
  :actor string)

(defn claim-item (settings id session)
  (perform-move settings
                (->move-request :item id
                                :move (move/claim (clone session))
                                :actor (clone (:name session)))))

(defn advance-item (settings id advancement)
  (perform-move settings
                (->move-request :item id
                                :move (advancement->move advancement)
                                :actor (str cli-actor))))

(defn close-item (settings id)
  (perform-move settings
                (->move-request :item id
                                :move move/close
                                :actor (str cli-actor))))

(defn drop-item (settings id reason)
  (perform-move settings
                (->move-request :item id
                                :move (move/drop reason)
                                :actor (str cli-actor))))

(defn perform-move (settings request)
  (in-transaction settings
    (fn (transaction) (apply-move transaction request))))

(type apply-move
  (fn ((ref transaction) move-request)
    (result item failure)))

(defn apply-move (transaction request)
  (let-match ((move-request :item id :move requested :actor actor) request)
    (let-try (snapshot (load-snapshot (ref (:connection transaction)))
              item (existing-item (ref snapshot) (ref id))
              move (approved-move (ref snapshot) (ref item) requested)
              at (now transaction))
      (store-move transaction
                  (->item-move :before (clone item)
                               :after (moved (ref item) (ref move) (ref at))
                               :move move
                               :actor actor)))))

(type store-move
  (fn ((ref transaction) item-move)
    (result item failure)))

(defn store-move (transaction change)
  (let-try (_ (update-item (ref (:connection transaction))
                           (ref (:after change)))
            _ (insert-globs (ref (:connection transaction))
                            (ref (:id (:after change)))
                            (ref (added-globs (ref (:move change)))))
            _ (record transaction (item-moved (ref change))))
    (ok (clone (:after change)))))
