(module
  "Adds an item with its paths and dependencies.")

(use json/value object text->json)

(use ledger/model ->dep ->glob ->item ->item-id ->item-path
                  ->roadmap ->roadmap-id ->session claim dep
                  dep-type event-type item item-id
                  roadmap-id status timestamp)

(use ledger/names kind-names name-of)
(use ledger/core/schema ->new-item check-new-item new-item)
(use ledger/sqlite/items insert-item)
(use ledger/sqlite/deps insert-dep)
(use ledger/sqlite/item-paths insert-item-path)
(use ledger/sqlite/events ->event-filter ->new-event)
(use ledger/sqlite/store fresh-id load-snapshot)

(use ledger/operations/context cli-actor failure
                               in-transaction now record
                               roadmap-id-named)

(use ledger/operations/context ->event-draft event-draft
                               transaction)

(use ledger/model item-id roadmap-id timestamp)

(export add-item insert-globs)

(defstruct item-stamp
  :id item-id
  :roadmap-id roadmap-id
  :created-at timestamp)

(defn add-item (settings roadmap request)
  (in-transaction settings
    (fn (transaction)
      (insert-new-item transaction roadmap request))))

(defn insert-new-item (transaction roadmap request)
  (let-try (roadmap-id (roadmap-id-named (ref (:connection transaction))
                                         (as-str roadmap))
            snapshot (load-snapshot (ref (:connection transaction)))
            _ (check-new-item (ref snapshot)
                              (ref roadmap-id)
                              (ref request))
            id (fresh-id (ref (:connection transaction)))
            created-at (now transaction))
    (store-item transaction
                (request->item (ref request)
                               (->item-stamp :id (->item-id :value id)
                                             :roadmap-id roadmap-id
                                             :created-at created-at))
                (ref request))))

(type store-item
  (fn ((ref transaction) item (ref new-item))
    (result item failure)))

(defn store-item (transaction item request)
  (let-try (_ (insert-item (ref (:connection transaction))
                           (ref item))
            _ (insert-globs (ref (:connection transaction))
                            (ref (:id item))
                            (ref (:globs request)))
            _ (insert-deps (ref (:connection transaction))
                           (ref (draft-deps (ref item) request)))
            _ (record transaction (item-added (ref item))))
    (ok item)))

(type item-added
  (fn ((ref item)) event-draft))

(defn item-added (item)
  (->event-draft :actor (str cli-actor)
                 :roadmap-id (some (clone (:roadmap-id item)))
                 :item-id (some (clone (:id item)))
                 :type event-type/item-added
                 :payload (object
                            (vec (pair (str "title")
                                       (text->json (as-str (:title item))))
                                 (pair (str "kind")
                                       (text->json (name-of kind-names
                                                            (:kind item))))))))

(type request->item
  (fn ((ref new-item) item-stamp) item))

(defn request->item (request stamp)
  (let-match ((item-stamp :id id
                          :roadmap-id roadmap-id
                          :created-at created-at) stamp)
    (->item :id id
            :roadmap-id roadmap-id
            :parent (clone (:parent request))
            :title (clone (:title request))
            :kind (:kind request)
            :status status/open
            :origin (:origin request)
            :priority (:priority request)
            :claim claim/unclaimed
            :created-at created-at
            :closed-at none)))

(type draft-deps
  (fn ((ref item) (ref new-item))
    (vec dep)))

(defn draft-deps (item request)
  (let (deps (collect (map (iter (:after request))
                        (fn (on)
                          (->dep :item (clone (:id item))
                                 :on (clone on)
                                 :type dep-type/blocks)))))
    (match (ref (:from request))
      ((some from)
       (push! deps
              (->dep :item (clone (:id item))
                     :on (clone from)
                     :type dep-type/discovered-from)))
      (none (do)))
    deps))

(defn insert-globs (connection id globs)
  (loop (index 0)
    (if (< index (len globs))
      (let-try (_ (insert-glob connection
                               (ref (->item-path :item (clone id)
                                                 :glob (clone (at globs
                                                                  index))))))
        (recur (inc index)))
      (ok (do)))))

(defn insert-glob (connection path)
  (let-try (_ (insert-item-path connection path))
    (ok (do))))

(defn insert-deps (connection deps)
  (loop (index 0)
    (if (< index (len deps))
      (let-try (_ (insert-one-dep connection (at deps index)))
        (recur (inc index)))
      (ok (do)))))

(defn insert-one-dep (connection dep)
  (let-try (_ (insert-dep connection dep))
    (ok (do))))
