(module
  "Reads every record kind in one read transaction, ordered by id, for `rmap export`.")

(use ledger/core/ready readiness-of)
(use ledger/core/snapshot scope)
(use ledger/model ->snapshot timestamp)
(use ledger/model/export ->ledger-export ledger-export)

(use ledger/operations/export-facts export-items
                                    export-pull-requests)

(use ledger/operations/export-records block-records
                                      criterion-records
                                      option-point-records
                                      ruling-records)

(use ledger/model/decisions ->decision-option-record)

(use ledger/operations/export-order decision-key item-key
                                    option-records ordered
                                    pull-request-key
                                    roadmap-key)

(use ledger/model/reports ->report-query report-reading)
(use ledger/sqlite/decisions ->decision-filter)
(use ledger/sqlite/events ->event-filter)
(use ledger/operations/transaction in-read-transaction now)
(use ledger/failure failure)
(use ledger/sqlite/connection connection)
(use ledger/sqlite/decision-blocks all-blocks)
(use ledger/sqlite/decision-option-points all-option-points)
(use ledger/sqlite/decisions decisions-matching)
(use ledger/sqlite/criteria all-criteria)
(use ledger/sqlite/criterion-verdicts all-criterion-verdicts)
(use ledger/sqlite/deps all-deps)
(use ledger/sqlite/events events-matching)

(use ledger/sqlite/export-proposals all-item-proposals
                                    all-option-skips
                                    all-proposal-criteria
                                    all-proposal-deps)

(use ledger/operations/export-proposal-records item-proposal-records
                                               option-skip-records
                                               proposal-criterion-records
                                               proposal-dep-records)

(use ledger/sqlite/items all-items)
(use ledger/sqlite/pull-requests all-pull-requests)
(use ledger/sqlite/reports reports-matching)
(use ledger/sqlite/reviews all-reviews)
(use ledger/sqlite/roadmaps all-roadmaps)
(use ledger/sqlite/rulings all-rulings)
(use ledger/sqlite/session-rows all-sessions)

(export export-ledger)

(def every-report
  (->report-query :item none
                  :reading report-reading/every-report))

(def any-decision
  (->decision-filter :roadmap-id none :status none :item none))

(def every-event
  (->event-filter :item-id none :decision-id none :after-id 0))

(defn export-ledger (settings)
  (in-read-transaction settings
    (fn (transaction)
      (export-within (ref (:connection transaction))
                     (now transaction)))))

(type export-within
  (fn ((ref connection) (ref timestamp))
    (result ledger-export failure)))

(defn export-within (connection at)
  (let-try (roadmaps (all-roadmaps connection)
            items (all-items connection)
            criteria (all-criteria connection)
            criterion-verdicts (all-criterion-verdicts connection)
            deps (all-deps connection)
            sessions (all-sessions connection)
            reports (reports-matching connection every-report)
            pull-requests (all-pull-requests connection)
            reviews (all-reviews connection)
            decisions (decisions-matching connection any-decision)
            option-points (all-option-points connection)
            blocks (all-blocks connection)
            rulings (all-rulings connection)
            events (events-matching connection every-event)
            item-proposals (all-item-proposals connection)
            proposal-criteria (all-proposal-criteria connection)
            proposal-deps (all-proposal-deps connection)
            option-skips (all-option-skips connection))
    (let (ordered-decisions (ordered decisions decision-key)
          ordered-items (ordered items item-key)
          ordered-pull-requests (ordered pull-requests pull-request-key)
          whole (->snapshot :roadmaps (clone roadmaps)
                            :items (clone items)
                            :deps (clone deps)
                            :decision-blocks (clone blocks))
          readiness (readiness-of (ref whole) (ref scope/every-roadmap)))
      (ok (->ledger-export
            :exported-at (clone at)
            :export-roadmaps (ordered roadmaps roadmap-key)
            :export-items (export-items (ref readiness) (ref ordered-items))
            :export-criteria (criterion-records (ref criteria))
            :export-criterion-verdicts criterion-verdicts
            :export-deps deps
            :export-sessions sessions
            :export-reports reports
            :export-pull-requests (export-pull-requests (ref ordered-pull-requests))
            :export-reviews reviews
            :export-decisions (clone ordered-decisions)
            :export-decision-options (option-records (ref ordered-decisions))
            :export-decision-option-points (option-point-records (ref option-points))
            :export-decision-blocks (block-records (ref blocks))
            :export-rulings (ruling-records (ref rulings))
            :export-events events
            :export-item-proposals (item-proposal-records item-proposals)
            :export-proposal-criteria (proposal-criterion-records
                                        proposal-criteria)
            :export-proposal-deps (proposal-dep-records proposal-deps)
            :export-option-skips (option-skip-records option-skips))))))
