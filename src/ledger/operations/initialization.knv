(module
  "Creates the ledger database, or reports the one already at its path.")

(use files/presence file-exists?)
(use ledger/failure failure)
(use ledger/operations/transaction open-ledger settings)

(export ->initialization init-ledger initialization
        initialization-outcome initialization-outcome-names)

(defenum initialization-outcome
  created
  existing)

(def initialization-outcome-names
  (vec (pair initialization-outcome/created "created")
       (pair initialization-outcome/existing "existing")))

(defstruct initialization
  :database-path string
  :outcome initialization-outcome)

(type init-ledger
  (fn ((ref settings))
    (result initialization failure)))

(defn init-ledger (settings)
  (let (path (clone (:database-path settings))
        outcome (outcome-before-opening (as-str path)))
    (let-try (_ (open-ledger settings))
      (ok (->initialization :database-path path :outcome outcome)))))

(defn outcome-before-opening (path)
  (if (file-exists? path)
    initialization-outcome/existing
    initialization-outcome/created))
