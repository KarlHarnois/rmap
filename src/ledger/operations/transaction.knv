(module
  "Opens the ledger and runs each write in one transaction that also records its event.")

(use ledger/model timestamp)
(use ledger/failure failure)
(use ledger/model ->event-stamp event-draft event-stamp)

(use ledger/sqlite/connection begin begin-read connection
                              database-error
                              database-failure finish open)

(use ledger/sqlite/migrations migrate)
(use ledger/sqlite/migration-sources migration-sources)
(use ledger/sqlite/events append-event)
(use ledger/sqlite/generated database-now)
(use files/presence file-presence file-presence-at)

(export ->settings clock connect in-read-transaction
        in-transaction now record settings transaction)

(defenum clock
  system
  (fixed timestamp))

(defstruct settings
  :database-path string
  :clock clock
  :actor string)

(defstruct transaction
  :connection connection
  :stamp event-stamp)

(type connect
  (fn ((ref settings))
    (result connection failure)))

(defn connect (settings)
  (let-try (presence (map-err (file-presence-at (as-str (:database-path
                                                          settings)))
                              database-failure))
    (match presence
      (file-presence/present (open-ledger settings))
      (file-presence/absent (err (failure/no-ledger (clone (:database-path
                                                             settings))))))))

(type open-ledger
  (fn ((ref settings))
    (result connection failure)))

(defn open-ledger (settings)
  (let-try (connection (open (as-str (:database-path settings)))
            _ (migrate (ref connection) (migration-sources)))
    (ok connection)))

(defn in-transaction (settings work)
  (run-transaction settings begin work))

(defn in-read-transaction (settings work)
  (run-transaction settings begin-read work))

(type run-transaction
  (where (a)
    (fn ((ref settings)
         (fn ((ref connection))
           (result unit database-error))
         (fn ((ref transaction))
           (result a failure)))
      (result a failure))))

(defn run-transaction (settings start work)
  (let-try (connection (connect settings)
            _ (start (ref connection))
            at (moment (ref connection)
                       (ref (:clock settings))))
    (let (transaction (->transaction :connection connection
                                     :stamp (->event-stamp :at at
                                                           :actor (clone (:actor
                                                                           settings)))))
      (let-try (outcome (finish (ref (:connection transaction))
                                (work (ref transaction))))
        outcome))))

(type moment
  (fn ((ref connection) (ref clock))
    (result timestamp failure)))

(defn moment (connection clock)
  (match clock
    (system (let-try (at (database-now connection)) (ok at)))
    ((fixed at) (ok (clone at)))))

(defn now (transaction)
  (clone (:at (:stamp transaction))))

(type record
  (fn ((ref transaction) event-draft)
    (result unit failure)))

(defn record (transaction draft)
  (let-try (_ (append-event (ref (:connection transaction))
                            (ref (:stamp transaction))
                            (ref draft)))
    (ok (do))))
