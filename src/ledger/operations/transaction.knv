(module
  "Opens the ledger and runs each write in one transaction that also records its event.")

(use ledger/model timestamp)
(use ledger/refusal refusal)
(use ledger/events event-draft)

(use ledger/sqlite/connection begin commit connection
                              database-error open rollback)

(use ledger/sqlite/migrations migrate)
(use ledger/sqlite/migration-sources migration-sources)
(use ledger/sqlite/events ->new-event append-event)
(use ledger/sqlite/store database-now)

(export ->settings clock connect failure in-transaction now
        record settings transaction)

(defenum clock
  system
  (fixed timestamp))

(defstruct settings
  :database-path string
  :clock clock)

(defstruct transaction
  :connection connection
  :clock clock)

(defenum failure
  (refused refusal)
  (database database-error))

(defn connect (settings)
  (let-try (connection (open (as-str (:database-path settings)))
            _ (migrate (ref connection) (migration-sources)))
    (ok connection)))

(type in-transaction
  (where (a)
    (fn ((ref settings)
         (fn ((ref transaction))
           (result a failure)))
      (result a failure))))

(defn in-transaction (settings work)
  (let-try (connection (connect settings)
            _ (begin (ref connection)))
    (let (transaction (->transaction :connection connection
                                     :clock (clone (:clock settings))))
      (finish (ref (:connection transaction))
              (work (ref transaction))))))

(type finish
  (where (a)
    (fn ((ref connection) (result a failure))
      (result a failure))))

(defn finish (connection outcome)
  (match outcome
    ((ok value) (let-try (_ (commit connection)) (ok value)))
    ((err failure)
     (match (rollback connection)
       (_ (err failure))))))

(type now
  (fn ((ref transaction))
    (result timestamp failure)))

(defn now (transaction)
  (match (ref (:clock transaction))
    (system (let-try (at (database-now (ref (:connection transaction))))
              (ok at)))
    ((fixed at) (ok (clone at)))))

(defn record (transaction draft)
  (let-try (at (now transaction)
            _ (append-event (ref (:connection transaction))
                            (ref (draft->event draft at))))
    (ok (do))))

(defn draft->event (draft at)
  (let-match ((event-draft :actor actor
                           :roadmap-id roadmap-id
                           :item-id item-id
                           :type type
                           :payload payload) draft)
    (->new-event :at at
                 :actor actor
                 :roadmap-id roadmap-id
                 :item-id item-id
                 :type type
                 :payload payload)))
