(module
  "The ledger's public functions. Code outside `src/ledger/` calls only these.")

(use json/value json object text->json)

(use ledger/model ->dep ->glob ->item ->item-id ->item-path
                  ->roadmap ->roadmap-id ->session claim dep
                  dep-type event event-type glob item
                  item-id kind origin path-conflict roadmap
                  roadmap-id roadmap-status session snapshot
                  status timestamp)

(use ledger/names dep-type-names event-type-names kind-names
                  name-of named origin-names
                  roadmap-status-names status-names)

(use ledger/refusal blockage refusal refusal->code
                    refusal->message)

(use ledger/core/states command move moved)
(use ledger/core/moves build-globs check-move-in)

(use ledger/core/ready blocked-item find-item globs-of
                       readiness readiness-of scope
                       with-computed-status)

(use ledger/core/schema ->new-item check-dep-removal
                        check-new-dep check-new-item
                        new-item)

(use ledger/sqlite/connection begin commit connection
                              database-error git-common-dir
                              open rollback)

(use ledger/sqlite/migrations migrate)
(use ledger/sqlite/migration-sources migration-sources)

(use ledger/sqlite/roadmaps all-roadmaps insert-roadmap
                            roadmap-named)

(use ledger/sqlite/items insert-item update-item)
(use ledger/sqlite/deps delete-dep insert-dep)
(use ledger/sqlite/item-paths insert-item-path)

(use ledger/sqlite/events ->event-filter ->new-event
                          append-event events-matching)

(use ledger/sqlite/store database-now fresh-id
                         load-snapshot)

(export ->glob ->item-id ->new-item ->session ->settings
        add-dep add-item advance-item blockage blocked-item
        claim claim-item clock close-item database-error
        default-database-path dep dep-type dep-type-names
        drop-item event event-type event-type-names failure
        glob item item-detail item-id kind kind-change
        kind-names list-items list-roadmaps name-of named
        new-item new-roadmap origin origin-names
        path-conflict read-log readiness ready-items refusal
        refusal->code refusal->message remove-dep roadmap
        roadmap-status-names session settings show-item
        status status-names)

(defenum clock
  system
  (fixed timestamp))

(defstruct settings
  :database-path string
  :clock clock)

(defenum failure
  (refused refusal)
  (database database-error))

(defenum kind-change
  keep-kind
  (become-build (vec glob)))

(defstruct applied-move
  :before item
  :after item
  :move move
  :globs (vec glob)
  :actor string)

(defstruct item-detail
  :item item
  :deps (vec dep)
  :globs (vec glob))

(def cli-actor "cli")

(type default-database-path
  (fn () (result string failure)))

(defn default-database-path ()
  (let-try (common-dir (git-common-dir))
    (ok (str common-dir "/ledger.db"))))

(defn connect (settings)
  (let-try (connection (open (as-str (:database-path settings)))
            _ (migrate (ref connection) (migration-sources)))
    (ok connection)))

(type in-transaction
  (where (a)
    (fn ((ref settings)
         (fn ((ref connection))
           (result a failure)))
      (result a failure))))

(defn in-transaction (settings work)
  (let-try (connection (connect settings)
            _ (begin (ref connection)))
    (finish (ref connection)
            (work (ref connection)))))

(type finish
  (where (a)
    (fn ((ref connection) (result a failure))
      (result a failure))))

(defn finish (connection outcome)
  (match outcome
    ((ok value) (let-try (_ (commit connection)) (ok value)))
    ((err failure)
     (match (rollback connection)
       (_ (err failure))))))

(defn now (connection settings)
  (match (:clock settings)
    (system (let-try (at (database-now connection)) (ok at)))
    ((fixed at) (ok (clone at)))))

(defn record (connection settings actor roadmap-id item-id type payload)
  (let-try (at (now connection settings)
            _ (append-event connection
                            (ref (->new-event :at at
                                              :actor actor
                                              :roadmap-id roadmap-id
                                              :item-id item-id
                                              :type type
                                              :payload payload))))
    (ok (do))))

(defn new-roadmap (settings name manager)
  (in-transaction settings
    (fn (connection)
      (create-roadmap connection settings name manager))))

(defn create-roadmap (connection settings name manager)
  (let-try (_ (check-name-free connection (as-str name))
            id (fresh-id connection)
            created-at (now connection settings))
    (store-roadmap connection settings
                   (->roadmap :id (->roadmap-id :value id)
                              :name name
                              :manager manager
                              :status roadmap-status/active
                              :created-at created-at))))

(type store-roadmap
  (fn ((ref connection) (ref settings) roadmap)
    (result roadmap failure)))

(defn store-roadmap (connection settings roadmap)
  (let-try (_ (insert-roadmap connection (ref roadmap))
            _ (record connection settings
                      (clone (:name (:manager roadmap)))
                      (some (clone (:id roadmap)))
                      none event-type/roadmap-created
                      (object (vec (pair (str "name")
                                         (text->json (as-str (:name roadmap))))
                                   (pair (str "manager")
                                         (text->json (as-str (:name (:manager roadmap)))))))))
    (ok roadmap)))

(type check-name-free
  (fn ((ref connection) (ref str))
    (result unit failure)))

(defn check-name-free (connection name)
  (let-try (existing (roadmap-named connection name))
    (match existing
      ((some _)
       (err (failure/refused (refusal/roadmap-exists (str name)))))
      (none (ok (do))))))

(type list-roadmaps
  (fn ((ref settings))
    (result (vec roadmap) failure)))

(defn list-roadmaps (settings)
  (let-try (connection (connect settings)
            roadmaps (all-roadmaps (ref connection)))
    (ok roadmaps)))

(type roadmap-id-named
  (fn ((ref connection) (ref str))
    (result roadmap-id failure)))

(defn roadmap-id-named (connection name)
  (let-try (found (roadmap-named connection name))
    (match found
      ((some roadmap) (ok (clone (:id roadmap))))
      (none (err (failure/refused (refusal/roadmap-not-found (str name))))))))

(defn scope-named (connection name)
  (match name
    ((some present)
     (map-ok (roadmap-id-named connection (as-str present))
       (fn (id) (scope/one-roadmap id))))
    (none (ok scope/every-roadmap))))

(type ready-items
  (fn ((ref settings) (option string))
    (result readiness failure)))

(defn ready-items (settings roadmap)
  (let-try (connection (connect settings)
            scope (scope-named (ref connection) (ref roadmap))
            snapshot (load-snapshot (ref connection)))
    (ok (readiness-of (ref snapshot) (ref scope)))))

(type read-log
  (fn ((ref settings) (option item-id) int)
    (result (vec event) failure)))

(defn read-log (settings item after-id)
  (let-try (connection (connect settings)
            events (events-matching (ref connection)
                                    (ref (->event-filter :item-id item
                                                         :after-id after-id))))
    (ok events)))

(defn add-item (settings roadmap request)
  (in-transaction settings
    (fn (connection)
      (insert-new-item connection settings roadmap request))))

(defn insert-new-item (connection settings roadmap request)
  (let-try (roadmap-id (roadmap-id-named connection (as-str roadmap))
            snapshot (load-snapshot connection)
            _ (check-new-item (ref snapshot)
                              (ref roadmap-id)
                              (ref request))
            id (fresh-id connection)
            created-at (now connection settings))
    (store-item connection settings
                (request->item (ref request)
                               roadmap-id
                               (->item-id :value id)
                               created-at)
                (ref request))))

(type store-item
  (fn ((ref connection)
       (ref settings)
       item
       (ref new-item))
    (result item failure)))

(defn store-item (connection settings item request)
  (let-try (_ (insert-item connection (ref item))
            _ (insert-globs connection
                            (ref (:id item))
                            (ref (:globs request)))
            _ (insert-deps connection
                           (ref (draft-deps (ref item) request)))
            _ (record connection settings
                      (str cli-actor)
                      (some (clone (:roadmap-id item)))
                      (some (clone (:id item)))
                      event-type/item-added
                      (object (vec (pair (str "title")
                                         (text->json (as-str (:title item))))
                                   (pair (str "kind")
                                         (text->json (name-of kind-names
                                                              (:kind
                                                                item))))))))
    (ok item)))

(type request->item
  (fn ((ref new-item) roadmap-id item-id timestamp) item))

(defn request->item (request roadmap-id id created-at)
  (->item :id id
          :roadmap-id roadmap-id
          :parent (clone (:parent request))
          :title (clone (:title request))
          :kind (:kind request)
          :status status/open
          :origin (:origin request)
          :priority (:priority request)
          :claim claim/unclaimed
          :created-at created-at
          :closed-at none))

(type draft-deps
  (fn ((ref item) (ref new-item))
    (vec dep)))

(defn draft-deps (item request)
  (let (deps (collect (map (iter (:after request))
                        (fn (on)
                          (->dep :item (clone (:id item))
                                 :on (clone on)
                                 :type dep-type/blocks)))))
    (match (ref (:from request))
      ((some from)
       (push! deps
              (->dep :item (clone (:id item))
                     :on (clone from)
                     :type dep-type/discovered-from)))
      (none (do)))
    deps))

(defn insert-globs (connection id globs)
  (loop (index 0)
    (if (< index (len globs))
      (let-try (_ (insert-glob connection
                               (ref (->item-path :item (clone id)
                                                 :glob (clone (at globs
                                                                  index))))))
        (recur (inc index)))
      (ok (do)))))

(defn insert-glob (connection path)
  (let-try (_ (insert-item-path connection path))
    (ok (do))))

(defn insert-deps (connection deps)
  (loop (index 0)
    (if (< index (len deps))
      (let-try (_ (insert-one-dep connection (at deps index)))
        (recur (inc index)))
      (ok (do)))))

(defn insert-one-dep (connection dep)
  (let-try (_ (insert-dep connection dep))
    (ok (do))))

(type list-items
  (fn ((ref settings) (option string))
    (result (vec item) failure)))

(defn list-items (settings roadmap)
  (let-try (connection (connect settings)
            scope (scope-named (ref connection) (ref roadmap))
            snapshot (load-snapshot (ref connection)))
    (ok (collect (map (filter (iter (:items snapshot))
                        (fn (item) (in-scope? item (ref scope))))
                      (fn (item)
                        (with-computed-status (ref snapshot) item)))))))

(type in-scope?
  (fn ((ref item) (ref scope)) bool))

(defn in-scope? (item scope)
  (match scope
    (every-roadmap true)
    ((one-roadmap id) (= (ref (:roadmap-id item)) id))))

(type show-item
  (fn ((ref settings) item-id)
    (result item-detail failure)))

(defn show-item (settings id)
  (let-try (connection (connect settings)
            snapshot (load-snapshot (ref connection))
            item (existing-item (ref snapshot) (ref id)))
    (ok (->item-detail :item (with-computed-status (ref snapshot) (ref item))
                       :deps (collect (map (filter (iter (:deps snapshot))
                                             (fn (dep) (= (:item dep) id)))
                                           clone))
                       :globs (globs-of (ref snapshot) (ref id))))))

(defn existing-item (snapshot id)
  (ok-or (find-item snapshot id)
         (failure/refused (refusal/item-not-found (clone id)))))

(defn claim-item (settings id session)
  (perform-move settings id
                (move/claim (clone session))
                (clone (:name session))))

(defn advance-item (settings id target change)
  (perform-move settings id
                (advance-move target change)
                (str cli-actor)))

(defn advance-move (target change)
  (match change
    (keep-kind (move/advance target))
    ((become-build globs) (build-move target globs))))

(defn build-move (target globs)
  (if (= target status/dispatched)
    (move/advance-to-build globs)
    (move/advance target)))

(defn close-item (settings id)
  (perform-move settings id move/close (str cli-actor)))

(defn drop-item (settings id reason)
  (perform-move settings id
                (move/drop reason)
                (str cli-actor)))

(defn perform-move (settings id move actor)
  (in-transaction settings
    (fn (connection)
      (apply-move connection settings id move actor))))

(type apply-move
  (fn ((ref connection) (ref settings) item-id move string)
    (result item failure)))

(defn apply-move (connection settings id move actor)
  (let-try (snapshot (load-snapshot connection)
            item (existing-item (ref snapshot) (ref id))
            _ (check-move-in (ref snapshot)
                             (ref item)
                             (ref move))
            at (now connection settings))
    (store-move connection settings
                (->applied-move :before (clone item)
                                :after (moved (ref item) (ref move) (ref at))
                                :globs (new-build-globs (ref snapshot)
                                                        (ref item)
                                                        (ref move))
                                :move move
                                :actor actor))))

(type store-move
  (fn ((ref connection) (ref settings) applied-move)
    (result item failure)))

(defn store-move (connection settings applied)
  (let-try (_ (update-item connection (ref (:after applied)))
            _ (insert-globs connection
                            (ref (:id (:after applied)))
                            (ref (:globs applied)))
            _ (record connection settings
                      (clone (:actor applied))
                      (some (clone (:roadmap-id (:after applied))))
                      (some (clone (:id (:after applied))))
                      (move->event-type (ref (:move applied)))
                      (move-payload (ref (:before applied))
                                    (ref (:after applied))
                                    (ref (:move applied)))))
    (ok (clone (:after applied)))))

(type new-build-globs
  (fn ((ref snapshot) (ref item) (ref move))
    (vec glob)))

(defn new-build-globs (snapshot item move)
  (match move
    ((advance-to-build globs) (build-globs snapshot item globs))
    (_ (vec))))

(type move->event-type
  (fn ((ref move)) event-type))

(defn move->event-type (move)
  (match move
    ((claim _) event-type/item-claimed)
    ((advance _) event-type/item-advanced)
    ((advance-to-build _) event-type/item-advanced)
    (close event-type/item-closed)
    ((drop _) event-type/item-dropped)))

(type move-payload
  (fn ((ref item) (ref item) (ref move))
    json))

(defn move-payload (before after move)
  (object (vec (pair (str "from")
                     (text->json (name-of status-names (:status before))))
               (pair (str "to")
                     (text->json (name-of status-names (:status after))))
               (pair (str "kind")
                     (text->json (name-of kind-names (:kind after))))
               (pair (str "detail")
                     (text->json (as-str (move-detail move)))))))

(type move-detail
  (fn ((ref move)) string))

(defn move-detail (move)
  (match move
    ((claim session) (clone (:name session)))
    ((drop reason) (clone reason))
    (_ (str ""))))

(defn add-dep (settings item on)
  (change-dep settings
              (->dep :item item :on on :type dep-type/blocks)
              event-type/dep-added))

(defn remove-dep (settings item on)
  (change-dep settings
              (->dep :item item :on on :type dep-type/blocks)
              event-type/dep-removed))

(defn change-dep (settings dep type)
  (in-transaction settings
    (fn (connection) (write-dep connection settings dep type))))

(type write-dep
  (fn ((ref connection) (ref settings) dep event-type)
    (result dep failure)))

(defn write-dep (connection settings dep type)
  (let-try (snapshot (load-snapshot connection)
            _ (check-dep-change (ref snapshot) (ref dep) type)
            _ (write-dep-change connection (ref dep) type)
            owner (existing-item (ref snapshot)
                                 (ref (:item dep)))
            _ (record connection settings
                      (str cli-actor)
                      (some (clone (:roadmap-id owner)))
                      (some (clone (:item dep)))
                      type
                      (object (vec (pair (str "on")
                                         (text->json (as-str (:value (:on dep)))))))))
    (ok (clone dep))))

(type check-dep-change
  (fn ((ref snapshot) (ref dep) event-type)
    (result unit refusal)))

(defn check-dep-change (snapshot dep type)
  (match type
    (dep-added (check-new-dep snapshot
                              (ref (:item dep))
                              (ref (:on dep))))
    (_ (check-dep-removal snapshot
                          (ref (:item dep))
                          (ref (:on dep))))))

(defn write-dep-change (connection dep type)
  (let-try (changed (match type
                      (dep-added (insert-dep connection dep))
                      (_ (delete-dep connection dep))))
    (ok changed)))
