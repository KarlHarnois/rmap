(module
  "Holds an item edit and computes the item it leaves.")

(use ledger/model exclusivity item)
(use ledger/core/criteria criteria-input)
(use ledger/core/new-items description-input)

(export ->item-edit apply-edit criteria-edit
        description-edit item-edit)

(defstruct item-edit
  :title (option string)
  :priority (option int)
  :description description-input
  :criteria criteria-input
  :exclusive (option exclusivity))

(defenum description-edit
  keep
  (set (option string)))

(defenum criteria-edit
  keep
  (set (vec string)))

(type apply-edit
  (fn ((ref item) (ref item-edit) description-edit criteria-edit)
    item))

(defn apply-edit (item edit description criteria)
  (let (titled (with-title (clone item)
                           (ref (:title edit)))
        prioritized (with-priority titled (:priority edit))
        described (with-description prioritized description)
        exclusive (with-exclusive described (:exclusive edit)))
    (with-criteria exclusive criteria)))

(type with-title
  (fn (item (ref (option string))) item))

(defn with-title (item title)
  (match title
    ((some value) (assoc item :title (clone value)))
    (none item)))

(type with-priority
  (fn (item (option int)) item))

(defn with-priority (item priority)
  (match priority
    ((some value) (assoc item :priority value))
    (none item)))

(type with-exclusive
  (fn (item (ref (option exclusivity)))
    item))

(defn with-exclusive (item exclusive)
  (match exclusive
    ((some value) (assoc item :exclusive (clone value)))
    (none item)))

(type with-description (fn (item description-edit) item))

(defn with-description (item description)
  (match description
    (description-edit/keep item)
    ((description-edit/set value)
     (assoc item :description (clone value)))))

(type with-criteria (fn (item criteria-edit) item))

(defn with-criteria (item criteria)
  (match criteria
    (criteria-edit/keep item)
    ((criteria-edit/set values)
     (assoc item :criteria (clone values)))))
