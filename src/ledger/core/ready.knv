(module
  "Computes which items can start and what blocks the others.")

(use ledger/model blockage item item-id)
(use ledger/core/index index-of)
(use ledger/core/snapshot in-scope?)

(use ledger/core/blockages base-blockage-of candidate?
                           unblocked? with-exclusive)

(use ledger/core/exclusivity exclusive-context-of
                             exclusive-hold-for)

(use ledger/core/order ordered)

(export ->blocked-item ->readiness blockage-in blockage-of
        blocked-item readiness readiness-of ready-in?
        unblocked?)

(defstruct readiness
  :ready (vec item)
  :blocked (vec blocked-item))

(defstruct blocked-item
  :item item
  :blockage blockage)

(defn readiness-of (snapshot scope)
  (let (index (index-of snapshot)
        context (exclusive-context-of snapshot (ref index))
        assessed (collect (map (filter (iter (:items snapshot))
                                 (fn (item)
                                   (and (candidate? item)
                                        (in-scope? item scope))))
                               (fn (item)
                                 (->blocked-item :item (clone item)
                                                 :blockage (blockage-under
                                                             (clone context)
                                                             snapshot
                                                             (ref index)
                                                             item))))))
    (->readiness :ready (ordered (startable-items (ref assessed)))
                 :blocked (waiting-items assessed))))

(defn blockage-of (snapshot index item)
  (blockage-under (exclusive-context-of snapshot index)
                  snapshot index item))

(type ready-in?
  (fn ((ref readiness) (ref item-id))
    bool))

(defn ready-in? (readiness id)
  (any? (iter (:ready readiness))
    (fn (ready) (= (ref (:id ready)) id))))

(type blockage-in
  (fn ((ref readiness) (ref item-id))
    (option blockage)))

(defn blockage-in (readiness id)
  (-> (:blocked readiness)
      iter
      (find (fn (held)
              (= (ref (:id (:item held))) id)))
      (map-some (fn (held) (clone (:blockage held))))))

(defn blockage-under (context snapshot index item)
  (with-exclusive (base-blockage-of snapshot index item)
                  (exclusive-hold-for context item)))

(defn startable-items (assessed)
  (collect (map (filter (iter assessed)
                  (fn (entry) (startable? entry)))
                (fn (entry) (clone (:item entry))))))

(type waiting-items
  (fn ((vec blocked-item))
    (vec blocked-item)))

(defn waiting-items (assessed)
  (collect (map (filter (iter assessed)
                  (fn (entry) (not (startable? entry))))
                clone)))

(defn startable? (entry)
  (unblocked? (ref (:blockage entry))))
