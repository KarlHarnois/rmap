(module
  "Computes which items can start and what blocks the others.")

(use ledger/model claim decision-id dep-type item item-id
                  kind roadmap-id snapshot status)

(use ledger/refusal ->blockage blockage)
(use ledger/core/index index-of indexed-status ledger-index)

(use ledger/core/locks conflicts-with-active-builds
                       globs-of)

(use ledger/core/order ordered)

(export blockage-of blocked-item blocking-decisions
        readiness readiness-of scope unblocked?)

(defenum scope
  every-roadmap
  (one-roadmap roadmap-id))

(defstruct blocked-item
  :item item
  :blockage blockage)

(defstruct readiness
  :ready (vec item)
  :blocked (vec blocked-item))

(type readiness-of
  (fn ((ref snapshot) (ref scope))
    readiness))

(defn readiness-of (snapshot scope)
  (let (index (index-of snapshot)
        assessed (collect (map
                            (filter (iter (:items snapshot))
                              (fn (item)
                                (and (candidate? item) (in-scope? item scope))))
                            (fn (item)
                              (->blocked-item :item (clone item)
                                              :blockage (blockage-of snapshot
                                                                     (ref index)
                                                                     item))))))
    (->readiness :ready (ordered (startable-items (ref assessed)))
                 :blocked (waiting-items assessed))))

(type in-scope?
  (fn ((ref item) (ref scope)) bool))

(defn in-scope? (item scope)
  (match scope
    (every-roadmap true)
    ((one-roadmap id) (= (ref (:roadmap-id item)) id))))

(type candidate? (fn ((ref item)) bool))

(defn candidate? (item)
  (and (not= (:kind item) kind/epic)
       (= (:status item) status/open)
       (= (:claim item) claim/unclaimed)))

(type startable-items
  (fn ((ref (vec blocked-item)))
    (vec item)))

(defn startable-items (assessed)
  (collect (map (filter (iter assessed)
                  (fn (entry) (startable? entry)))
                (fn (entry) (clone (:item entry))))))

(type waiting-items
  (fn ((vec blocked-item))
    (vec blocked-item)))

(defn waiting-items (assessed)
  (collect (map (filter (iter assessed)
                  (fn (entry) (not (startable? entry))))
                clone)))

(type startable?
  (fn ((ref blocked-item)) bool))

(defn startable? (entry)
  (and (unblocked? (ref (:blockage entry)))
       (empty? (blocking-decisions (ref (:item entry))))))

(defn unblocked? (blockage)
  (and (empty? (:blockers blockage))
       (empty? (:path-conflicts blockage))))

(type blocking-decisions
  (fn ((ref item)) (vec decision-id)))

(defn blocking-decisions (_item) (vec))

(type blockage-of
  (fn ((ref snapshot)
       (ref ledger-index)
       (ref item))
    blockage))

(defn blockage-of (snapshot index item)
  (->blockage :blockers (blockers-of snapshot index item)
              :path-conflicts (conflicts-with-active-builds
                                index
                                (ref (:id item))
                                (ref (globs-of snapshot (ref (:id item)))))))

(type blockers-of
  (fn ((ref snapshot)
       (ref ledger-index)
       (ref item))
    (vec item-id)))

(defn blockers-of (snapshot index item)
  (-> (:deps snapshot)
      iter
      (filter (fn (dep)
                (and (= (:type dep) dep-type/blocks)
                     (= (:item dep) (:id item)))))
      (filter (fn (dep)
                (not= (indexed-status index (ref (:on dep)))
                      (some status/merged))))
      (map (fn (dep) (clone (:on dep))))
      collect))
