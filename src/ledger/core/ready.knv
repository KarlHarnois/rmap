(module
  "Computes which items can start and what blocks the others.")

(use ledger/model claim decision-id dep-type item item-id
                  kind roadmap-id snapshot status)

(use ledger/refusal ->blockage blockage)
(use ledger/core/statuses merged?)

(use ledger/core/locks conflicts-with-active-builds
                       globs-of)

(use ledger/core/order ordered)

(export blockage-of blocked-item blocking-decisions
        readiness readiness-of ready? scope)

(defenum scope
  every-roadmap
  (one-roadmap roadmap-id))

(defstruct blocked-item
  :item item
  :blockage blockage)

(defstruct readiness
  :ready (vec item)
  :blocked (vec blocked-item))

(defn readiness-of (snapshot scope)
  (let (candidates (candidates-in snapshot scope))
    (->readiness :ready (ordered (ready-among snapshot (ref candidates)))
                 :blocked (blocked-among snapshot (ref candidates)))))

(defn candidates-in (snapshot scope)
  (-> (:items snapshot)
      iter
      (filter (fn (item)
                (and (candidate? item) (in-scope? item scope))))
      (map clone)
      collect))

(type in-scope?
  (fn ((ref item) (ref scope)) bool))

(defn in-scope? (item scope)
  (match scope
    (every-roadmap true)
    ((one-roadmap id) (= (ref (:roadmap-id item)) id))))

(type candidate? (fn ((ref item)) bool))

(defn candidate? (item)
  (and (not= (:kind item) kind/epic)
       (= (:status item) status/open)
       (= (:claim item) claim/unclaimed)))

(defn ready-among (snapshot candidates)
  (-> candidates iter
      (filter (fn (item) (ready? snapshot item)))
      (map clone)
      collect))

(defn blocked-among (snapshot candidates)
  (-> candidates iter
      (filter (fn (item) (not (ready? snapshot item))))
      (map (fn (item)
             (->blocked-item :item (clone item)
                             :blockage (blockage-of snapshot item))))
      collect))

(defn ready? (snapshot item)
  (and (candidate? item)
       (unblocked? (blockage-of snapshot item))
       (empty? (blocking-decisions item))))

(defn unblocked? (blockage)
  (and (empty? (:blockers blockage))
       (empty? (:path-conflicts blockage))))

(type blocking-decisions
  (fn ((ref item)) (vec decision-id)))

(defn blocking-decisions (_item) (vec))

(defn blockage-of (snapshot item)
  (->blockage :blockers (blockers-of snapshot item)
              :path-conflicts (conflicts-with-active-builds
                                snapshot
                                (ref (:id item))
                                (ref (globs-of snapshot (ref (:id item)))))))

(type blockers-of
  (fn ((ref snapshot) (ref item))
    (vec item-id)))

(defn blockers-of (snapshot item)
  (-> (:deps snapshot)
      iter
      (filter (fn (dep)
                (and (= (:type dep) dep-type/blocks)
                     (= (:item dep) (:id item)))))
      (filter (fn (dep)
                (not (merged? snapshot (ref (:on dep))))))
      (map (fn (dep) (clone (:on dep))))
      collect))
