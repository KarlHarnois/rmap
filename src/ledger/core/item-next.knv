(module
  "Works out the next action for an item from its status and from what holds it.")

(use ledger/model claim item item-id snapshot status)
(use ledger/model/criteria criterion-verdict)
(use ledger/model/pull-requests pull-request)
(use ledger/model/sessions live-session)

(use ledger/core/actions action actor next-action planned
                         planned-by)

(use ledger/core/pull-requests pull-request-of)
(use ledger/core/ready readiness ready-in?)
(use ledger/core/review-states review-step review-step-of)
(use ledger/core/decision-actions blocked-only-by-rejected?)

(export status-actions)

(type status-actions
  (fn ((ref readiness)
       (ref snapshot)
       (ref (vec pull-request))
       (ref (vec criterion-verdict))
       (ref (vec live-session))
       (ref item))
    (vec next-action)))

(defn status-actions (readiness snapshot pull-requests
                                verdicts live-reviews item)
  (match (:status item)
    (open (open-actions readiness snapshot item))
    (dispatched (claimed-actions action/work item))
    (reported (claimed-actions action/accept-report item))
    (in-review (review-actions pull-requests verdicts live-reviews item))
    (fixing (claimed-actions action/fix item))
    (merging (review-actions pull-requests verdicts live-reviews item))
    (merged (vec))
    (accepted (vec))
    (dropped (vec))))

(type open-actions
  (fn ((ref readiness)
       (ref snapshot)
       (ref item))
    (vec next-action)))

(defn open-actions (readiness snapshot item)
  (if (ready-in? readiness (ref (:id item)))
    (vec (planned action/dispatch none none))
    (waiting-actions readiness snapshot (ref (:id item)))))

(type waiting-actions
  (fn ((ref readiness)
       (ref snapshot)
       (ref item-id))
    (vec next-action)))

(defn waiting-actions (readiness snapshot id)
  (collect (map (filter (iter (:blocked readiness))
                  (fn (held)
                    (= (ref (:id (:item held))) id)))
                (fn (held) (waiting-action snapshot held)))))

(defn waiting-action (snapshot held)
  (let (blockage (ref (:blockage held)))
    (if (blocked-only-by-rejected? snapshot blockage)
      (planned action/replan none (some (clone blockage)))
      (planned action/wait none (some (clone blockage))))))

(type review-actions
  (fn ((ref (vec pull-request))
       (ref (vec criterion-verdict))
       (ref (vec live-session))
       (ref item))
    (vec next-action)))

(defn review-actions (pull-requests verdicts live-reviews item)
  (match (review-step-of (pull-request-of pull-requests (ref (:id item)))
                         verdicts live-reviews item)
    (merge (claimed-actions action/merge item))
    ((live-review reviewer)
     (vec (planned-by actor/worker action/review (some reviewer) none)))
    (send-fixes (claimed-actions action/send-fixes item))
    (start-review (claimed-actions action/review item))
    (verify (claimed-actions action/verify item))))

(defn claimed-actions (action item)
  (vec (planned action
                (claimant (ref (:claim item)))
                none)))

(defn claimant (claim)
  (match claim
    ((claimed-by session) (some (clone (:session session))))
    (unclaimed none)))
