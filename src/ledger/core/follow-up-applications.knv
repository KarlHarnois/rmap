(module
  "Chooses which proposals become items when a research or design item closes, and which decisions still hold it.")

(use ledger/model decision-status)
(use ledger/model/decisions decision)
(use ledger/model/follow-ups follow-up follow-up-decision)
(use ledger/core/new-items distinct)

(export applicable pending-decisions)

(defn pending-decisions (decisions)
  (loop (index 0
         ids (vec))
    (cond
      ((>= index (len decisions)) ids)
      ((pending? (at decisions index))
       (recur (inc index)
              (appended ids
                        (clone (:id (at decisions index))))))
      (else (recur (inc index) ids)))))

(defn applicable (follow-ups decisions)
  (let (skips (chosen-skips decisions))
    (loop (index 0
           kept (vec))
      (cond
        ((>= index (len follow-ups)) kept)
        ((applies? (at follow-ups index) (ref skips) decisions)
         (recur (inc index)
                (appended kept (clone (at follow-ups index)))))
        (else (recur (inc index) kept))))))

(type pending?
  (fn ((ref decision)) bool))

(defn pending? (decision)
  (or (= (:status decision) decision-status/proposed)
      (= (:status decision) decision-status/rejected)))

(type applies?
  (fn ((ref follow-up)
       (ref (vec string))
       (ref (vec decision)))
    bool))

(defn applies? (follow-up skips decisions)
  (and (not (contains? skips (clone (:id follow-up))))
       (linked-selected? follow-up decisions)))

(type chosen-skips
  (fn ((ref (vec decision))) (vec string)))

(defn chosen-skips (decisions)
  (let (all (vec))
    (for-each decisions
      (fn (decision)
        (for-each (chosen-option-skips decision)
          (fn (id) (push! all (clone id))))))
    (distinct (ref all))))

(defn chosen-option-skips (decision)
  (if (= (:status decision) decision-status/accepted)
    (option-skips-at decision (chosen-number decision))
    (vec)))

(defn chosen-number (decision)
  (match (:outcome decision)
    ((some outcome) (:option outcome))
    (none none)))

(defn option-skips-at (decision number)
  (match number
    ((some chosen) (option-skips decision chosen))
    (none (vec))))

(defn option-skips (decision number)
  (match (find (iter (:options decision))
           (fn (option)
             (= (:number option) number)))
    ((some option) (clone (:skips option)))
    (none (vec))))

(defn linked-selected? (follow-up decisions)
  (match (:decision follow-up)
    ((some link) (selected? link decisions))
    (none true)))

(defn selected? (link decisions)
  (any? (iter decisions)
    (fn (decision) (matches-link? decision link))))

(type matches-link?
  (fn ((ref decision) (ref follow-up-decision))
    bool))

(defn matches-link? (decision link)
  (and (= (ref (:id decision))
          (ref (:decision link)))
       (= (:status decision) decision-status/accepted)
       (= (chosen-number decision)
          (some (:option link)))))

(defn appended (items extra)
  (let (all items) (push! all extra) all))
