(module
  "Indexes a snapshot once: items by id, the status each item shows, and the paths active builds hold.")

(use ledger/model item item-id kind path-lock snapshot
                  status)

(use ledger/core/epics shown-status-of)
(use ledger/core/phases active? delivered?)
(use ledger/core/snapshot lock-of)

(export active-locks delivered-id? index-of indexed-status
        ledger-index with-shown-status)

(defstruct ledger-index
  :items (hash-map string item)
  :statuses (hash-map string status)
  :active-locks (vec path-lock))

(type index-of
  (fn ((ref snapshot)) ledger-index))

(defn index-of (snapshot)
  (let (items (items-by-id (ref (:items snapshot)))
        children (child-statuses (ref (:items snapshot))))
    (->ledger-index :active-locks (active-locks-of snapshot)
                    :statuses (shown-statuses (ref (:items snapshot))
                                              (ref children))
                    :items items)))

(defn active-locks (index)
  (ref (:active-locks index)))

(type with-shown-status
  (fn ((ref ledger-index) (ref item))
    item))

(defn with-shown-status (index item)
  (assoc (clone item)
         :status (unwrap-or (indexed-status index (ref (:id item)))
                            (:status item))))

(type delivered-id?
  (fn ((ref ledger-index) (ref item-id))
    bool))

(defn delivered-id? (index id)
  (match (get (:items index)
              (as-str (:value id)))
    ((some item)
     (delivered? (:kind item)
                 (unwrap-or (indexed-status index id) (:status item))))
    (none false)))

(type indexed-status
  (fn ((ref ledger-index) (ref item-id))
    (option status)))

(defn indexed-status (index id)
  (map-some (get (:statuses index)
                 (as-str (:value id)))
            (fn (status) (deref status))))

(type items-by-id
  (fn ((ref (vec item)))
    (hash-map string item)))

(defn items-by-id (items)
  (into-hash-map (collect (map (iter items)
                            (fn (item)
                              (pair (clone (:value (:id item)))
                                    (clone item)))))))

(defn child-statuses (items)
  (loop (index 0
         (groups (hash-map string (vec status))) (hash-map))
    (if (< index (len items))
      (recur (inc index)
             (with-child-status groups (at items index)))
      groups)))

(type with-child-status
  (fn ((hash-map string (vec status))
       (ref item))
    (hash-map string (vec status))))

(defn with-child-status (groups item)
  (match (ref (:parent item))
    ((some parent)
     (update groups
             (clone (:value parent))
             (fn (statuses)
               (appended statuses (:status item)))
             (vec)))
    (none groups)))

(defn appended (items extra)
  (let (all items) (push! all extra) all))

(type shown-statuses
  (fn ((ref (vec item))
       (ref (hash-map string (vec status))))
    (hash-map string status)))

(defn shown-statuses (items children)
  (into-hash-map (collect (map (iter items)
                            (fn (item)
                              (pair (clone (:value (:id item)))
                                    (shown-status-of item
                                                     (get children
                                                          (as-str (:value (:id item)))))))))))

(type active-locks-of
  (fn ((ref snapshot)) (vec path-lock)))

(defn active-locks-of (snapshot)
  (collect (map (filter (iter (:items snapshot))
                  (fn (item) (active-build? item)))
                (fn (item) (lock-of snapshot item)))))

(type active-build?
  (fn ((ref item)) bool))

(defn active-build? (item)
  (and (= (:kind item) kind/build)
       (active? (:status item))))
