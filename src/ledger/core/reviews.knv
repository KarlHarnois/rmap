(module
  "Decides whether a reviewer session may start a review or record its verdict, the review row and the session it ends, and the live review session a start records.")

(use ledger/model item session timestamp)

(use ledger/model/sessions ->session-end end-reason
                           session-id)

(use ledger/model/pull-requests ->review head pull-request
                                review review-id
                                review-request)

(use ledger/refusal pull-request-refusal refusal)
(use ledger/core/heads current-head)
(use ledger/core/pull-requests present-pull-request)
(use ledger/core/phases finished?)

(export ->review-stamp approved-head check-live-review
        review-end review-stamp stamped-review)

(defstruct review-stamp
  :id review-id
  :session-id session-id
  :created-at timestamp)

(type check-live-review
  (fn ((ref (option session-id))
       (ref session))
    (result session-id refusal)))

(defn check-live-review (live reviewer)
  (ok-or (clone live)
         (refusal/pull-request (pull-request-refusal/review-session-required (clone
                                                                               reviewer)))))

(defn review-end (now)
  (->session-end :reason end-reason/finished :at (clone now)))

(type approved-head
  (fn ((ref item)
       (ref (option pull-request))
       (ref review-request)
       (ref (vec session)))
    (result head refusal)))

(defn approved-head (item pull-request request worker-sessions)
  (let-try (_ (check-unfinished item)
            present (present-pull-request item pull-request)
            _ (check-worker worker-sessions (ref (:reviewer request)))
            head (current-head (ref present)
                               (ref (:head request)))
            _ (check-fresh (ref present)
                           (ref (:reviewer request))
                           (ref head)))
    (ok head)))

(type stamped-review
  (fn ((ref review-request) head review-stamp) review))

(defn stamped-review (request head stamp)
  (->review :id (:id stamp)
            :item (clone (:item request))
            :session-id (:session-id stamp)
            :reviewer (clone (:reviewer request))
            :kind (:kind request)
            :head head
            :verdict (:verdict request)
            :created-at (clone (:created-at stamp))))

(type check-unfinished
  (fn ((ref item)) (result unit refusal)))

(defn check-unfinished (item)
  (if (finished? (:status item))
    (err (refusal/item-closed (clone (:id item))))
    (ok (do))))

(type check-worker
  (fn ((ref (vec session)) (ref session))
    (result unit refusal)))

(defn check-worker (worker-sessions reviewer)
  (if (any? (iter worker-sessions)
        (fn (worker) (= worker reviewer)))
    (err (refusal/pull-request (pull-request-refusal/reviewer-is-worker (clone reviewer))))
    (ok (do))))

(defn check-fresh (pull-request reviewer head)
  (match (stale-review (:reviews pull-request) reviewer head)
    ((some review) (not-fresh reviewer (ref review) head))
    (none (ok (do)))))

(type stale-review
  (fn ((ref (vec review))
       (ref session)
       (ref head))
    (option review)))

(defn stale-review (reviews reviewer head)
  (map-some (first (collect (map (filter (iter reviews)
                                   (fn (review)
                                     (and (= (ref (:reviewer review)) reviewer)
                                          (not= (ref (:head review)) head))))
                                 clone)))
            clone))

(type not-fresh
  (fn ((ref session) (ref review) (ref head))
    (result unit refusal)))

(defn not-fresh (reviewer review head)
  (err (refusal/pull-request (pull-request-refusal/reviewer-not-fresh (clone reviewer)
                                                                      (clone (:head
                                                                               review))
                                                                      (clone head)))))
