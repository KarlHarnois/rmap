(module
  "Keeps the next actions one actor takes, and the items and decisions that still have one.")

(use ledger/core/actions actor next-action)
(use ledger/core/next ->next-item next-entry next-item)

(use ledger/core/decision-next ->decision-next
                               decision-next)

(export taken-by)

(defn taken-by (entries wanted)
  (match wanted
    ((some chosen) (entries-for entries chosen))
    (none (collect (map (iter entries) clone)))))

(type entries-for
  (fn ((ref (vec next-entry)) actor)
    (vec next-entry)))

(defn entries-for (entries wanted)
  (let (kept (vec))
    (for-each entries
      (fn (entry)
        (match (entry-for entry wanted)
          ((some filled) (push! kept (clone filled)))
          (none (do)))))
    kept))

(defn entry-for (entry wanted)
  (match entry
    ((next-entry/listed-item item)
     (map-some (item-entry-for item wanted)
       (fn (filled) (next-entry/listed-item filled))))
    ((next-entry/listed-decision decision)
     (map-some (decision-entry-for decision wanted)
       (fn (filled) (next-entry/listed-decision filled))))))

(type item-entry-for
  (fn ((ref next-item) actor)
    (option next-item)))

(defn item-entry-for (item wanted)
  (let (actions (actions-for (ref (:actions item)) wanted))
    (if (empty? actions)
      none
      (some (->next-item :item (clone (:item item))
                         :roadmap (clone (:roadmap item))
                         :actions actions)))))

(type decision-entry-for
  (fn ((ref decision-next) actor)
    (option decision-next)))

(defn decision-entry-for (decision wanted)
  (let (actions (actions-for (ref (:actions decision)) wanted))
    (if (empty? actions)
      none
      (some (->decision-next :decision (clone (:decision decision))
                             :roadmap (clone (:roadmap decision))
                             :status (:status decision)
                             :title (clone (:title decision))
                             :actions actions)))))

(type actions-for
  (fn ((ref (vec next-action)) actor)
    (vec next-action)))

(defn actions-for (actions wanted)
  (collect (map (filter (iter actions)
                  (fn (planned)
                    (= (:actor planned) wanted)))
                clone)))
