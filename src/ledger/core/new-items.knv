(module
  "Checks a new item against the ledger and drops its repeated blockers and globs.")

(use ledger/model glob item item-id kind origin roadmap-id
                  snapshot)

(use ledger/refusal refusal)
(use ledger/core/snapshot existing find-item)

(export ->new-item check-new-item distinct new-item
        normalized)

(defstruct new-item
  :parent (option item-id)
  :title string
  :kind kind
  :origin origin
  :priority int
  :globs (vec glob)
  :after (vec item-id)
  :from (option item-id))

(defn check-new-item (snapshot roadmap-id request)
  (let-try (_ (check-epic-has-no-parent request)
            _ (check-build-has-globs request)
            _ (check-parent snapshot roadmap-id request)
            _ (check-all-exist snapshot (ref (:after request))))
    (check-optional-exists snapshot (ref (:from request)))))

(type check-epic-has-no-parent
  (fn ((ref new-item))
    (result unit refusal)))

(defn check-epic-has-no-parent (request)
  (if (and (= (:kind request) kind/epic)
           (some? (:parent request)))
    (err refusal/epic-has-parent)
    (ok (do))))

(type check-build-has-globs
  (fn ((ref new-item))
    (result unit refusal)))

(defn check-build-has-globs (request)
  (if (and (= (:kind request) kind/build)
           (empty? (:globs request)))
    (err refusal/build-needs-globs)
    (ok (do))))

(type check-parent
  (fn ((ref snapshot)
       (ref roadmap-id)
       (ref new-item))
    (result unit refusal)))

(defn check-parent (snapshot roadmap-id request)
  (match (:parent request)
    ((some parent-id)
     (check-parent-item (existing snapshot parent-id) roadmap-id))
    (none (ok (do)))))

(type check-parent-item
  (fn ((result item refusal) (ref roadmap-id))
    (result unit refusal)))

(defn check-parent-item (found roadmap-id)
  (let-try (parent found)
    (cond
      ((not= (:kind parent) kind/epic)
       (err (refusal/parent-not-epic (clone (:id parent)))))
      ((not= (ref (:roadmap-id parent)) roadmap-id)
       (err (refusal/parent-in-other-roadmap (clone (:id parent)))))
      (else (ok (do))))))

(defn check-all-exist (snapshot ids)
  (match (find (iter ids)
           (fn (id)
             (none? (find-item snapshot id))))
    ((some missing)
     (err (refusal/item-not-found (clone missing))))
    (none (ok (do)))))

(defn check-optional-exists (snapshot id)
  (match id
    ((some present)
     (map-ok (existing snapshot present)
       (fn (_) (do))))
    (none (ok (do)))))

(type distinct
  (where ((a clone partial-eq))
    (fn ((ref (vec a))) (vec a))))

(defn distinct (values)
  (let (unique (vec))
    (for-each values
      (fn (value)
        (when (not (contains? (ref unique) (clone value)))
          (push! unique (clone value)))))
    unique))

(type normalized (fn (new-item) new-item))

(defn normalized (request)
  (let (globs (distinct (ref (:globs request)))
        after (distinct (ref (:after request))))
    (-> request (assoc :globs globs) (assoc :after after))))
