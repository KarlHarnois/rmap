(module
  "Checks a new item against the ledger and drops its repeated blockers.")

(use ledger/model item item-id kind origin roadmap-id)
(use ledger/refusal refusal)
(use ledger/core/criteria criteria-input)
(use ledger/core/priorities check-priority)
(use ledger/core/snapshot existing find-item)

(export ->new-item check-description check-new-item
        description-input distinct new-item normalized)

(defstruct new-item
  :parent (option item-id)
  :title string
  :description description-input
  :criteria criteria-input
  :kind kind
  :origin origin
  :priority int
  :blocked-by (vec item-id)
  :discovered-from (option item-id))

(defenum description-input
  unspecified
  (text string)
  (from-file string)
  from-stdin)

(defn check-description (description)
  (match description
    ((some text) (check-description-text text))
    (none (err refusal/description-required))))

(defn check-new-item (snapshot roadmap-id request)
  (let-try (_ (check-epic-has-no-parent request)
            _ (check-priority (:priority request))
            _ (check-parent snapshot roadmap-id request)
            _ (check-all-exist snapshot (ref (:blocked-by request))))
    (check-optional-exists snapshot
                           (ref (:discovered-from request)))))

(defn normalized (request)
  (assoc request
         :blocked-by (distinct (ref (:blocked-by request)))))

(type distinct
  (where ((a clone partial-eq))
    (fn ((ref (vec a))) (vec a))))

(defn distinct (values)
  (let (unique (vec))
    (for-each values
      (fn (value)
        (when (not (contains? (ref unique) (clone value)))
          (push! unique (clone value)))))
    unique))

(defn check-description-text (text)
  (if (empty? (trim (as-str text)))
    (err refusal/description-required)
    (ok (do))))

(defn check-epic-has-no-parent (request)
  (if (and (= (:kind request) kind/epic)
           (some? (:parent request)))
    (err refusal/epic-has-parent)
    (ok (do))))

(defn check-parent (snapshot roadmap-id request)
  (match (:parent request)
    ((some parent-id)
     (check-parent-item (existing snapshot parent-id) roadmap-id))
    (none (ok (do)))))

(type check-parent-item
  (fn ((result item refusal) (ref roadmap-id))
    (result unit refusal)))

(defn check-parent-item (found roadmap-id)
  (let-try (parent found)
    (cond
      ((not= (:kind parent) kind/epic)
       (err (refusal/parent-not-epic (clone (:id parent)))))
      ((not= (ref (:roadmap-id parent)) roadmap-id)
       (err (refusal/parent-in-other-roadmap (clone (:id parent)))))
      (else (ok (do))))))

(defn check-all-exist (snapshot ids)
  (match (find (iter ids)
           (fn (id)
             (none? (find-item snapshot id))))
    ((some missing)
     (err (refusal/item-not-found (clone missing))))
    (none (ok (do)))))

(defn check-optional-exists (snapshot id)
  (match id
    ((some present)
     (map-ok (existing snapshot present)
       (fn (_) (do))))
    (none (ok (do)))))
