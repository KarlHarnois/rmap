(module
  "Checks that a head the caller names is a full commit SHA, so heads compare as equal only when they name the same commit.")

(use ledger/model/pull-requests ->head)
(use ledger/refusal pull-request-refusal refusal)

(export head-of)

(def head-length 40)

(def hex-digits "0123456789abcdef")

(defn head-of (text)
  (if (full-sha? text)
    (ok (->head :sha (clone text)))
    (err (refusal/pull-request (pull-request-refusal/invalid-head (clone
                                                                    text))))))

(defn full-sha? (text)
  (and (= (len text) head-length)
       (every? (chars (as-str text))
         (fn (character)
           (contains? hex-digits (as-str (str character)))))))
