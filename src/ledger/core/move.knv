(module
  "Names each move an item can make and computes the item a move leaves.")

(use ledger/refusal refusal)
(use ledger/core/phases finished?)
(use ledger/model claim glob item kind session status)

(export ->advancement advancement advancement->move
        kind-change move move-type move-type-of moved
        new-globs target-status)

(defenum move-type
  claim
  advance
  advance-to-build
  close
  drop)

(defenum move
  (claim session)
  (advance status)
  (advance-to-build (vec glob))
  close
  (drop string))

(defstruct advancement
  :to status
  :kind-change kind-change)

(defenum kind-change
  keep-kind
  (become-build (vec glob)))

(defn advancement->move (advancement)
  (let-match ((advancement :to target :kind-change change) advancement)
    (match change
      (keep-kind (ok (move/advance target)))
      ((become-build globs) (build-move target globs)))))

(defn move-type-of (move)
  (match move
    ((move/claim _) move-type/claim)
    ((move/advance _) move-type/advance)
    ((move/advance-to-build _) move-type/advance-to-build)
    (move/close move-type/close)
    ((move/drop _) move-type/drop)))

(defn new-globs (move)
  (match move
    ((move/advance-to-build globs) (some (clone globs)))
    (_ none)))

(defn moved (item move now)
  (let (target (target-status item move))
    (-> (clone item)
        (assoc :status target)
        (assoc :claim (claim-after item move))
        (assoc :kind (kind-after item move))
        (assoc :closed-at (closed-at-after item target now)))))

(type target-status
  (fn ((ref item) (ref move)) status))

(defn target-status (item move)
  (match move
    ((move/claim _) status/dispatched)
    ((move/advance target) target)
    ((move/advance-to-build _) status/dispatched)
    (move/close (closed-status (:kind item)))
    ((move/drop _) status/dropped)))

(defn build-move (target globs)
  (if (= target status/dispatched)
    (ok (move/advance-to-build globs))
    (err refusal/invalid-kind-change)))

(defn closed-status (kind)
  (match kind
    (research status/accepted)
    (design status/accepted)
    (_ status/merged)))

(defn claim-after (item move)
  (match move
    ((move/claim session) (claim/claimed-by (clone session)))
    ((move/advance target)
     (claim-kept-unless-reopened item target))
    (_ (clone (:claim item)))))

(defn claim-kept-unless-reopened (item target)
  (if (= target status/open)
    claim/unclaimed
    (clone (:claim item))))

(type kind-after
  (fn ((ref item) (ref move)) kind))

(defn kind-after (item move)
  (match move
    ((move/advance-to-build _) kind/build)
    (_ (:kind item))))

(defn closed-at-after (item target now)
  (if (finished? target)
    (some (clone now))
    (clone (:closed-at item))))
