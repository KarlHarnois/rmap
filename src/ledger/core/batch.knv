(module
  "Picks up to a number of ready items, in the order ready gives them.")

(use ledger/model item)
(use ledger/core/ready blocked-item)

(export ->batch batch batch-of batch-size batch-size-of)

(defstruct batch
  :size batch-size
  :picked (vec item)
  :blocked (vec blocked-item))

(defstruct batch-size
  :count int)

(defn batch-size-of (count)
  (if (>= count 1)
    (some (->batch-size :count count))
    none))

(defn batch-of (readiness size)
  (->batch :size size
           :picked (picked-items (ref (:ready readiness)) size)
           :blocked (clone (:blocked readiness))))

(type picked-items
  (fn ((ref (vec item)) batch-size)
    (vec item)))

(defn picked-items (ready size)
  (collect (map (take (iter ready) (:count size))
                clone)))
