(module
  "Shows each acceptance criterion with the latest verdict a reviewer session gave it.")

(use ledger/model/criteria ->criterion-status
                           ->criterion-verdict)

(export criterion-statuses latest-per-position)

(defn criterion-statuses (item verdicts)
  (let (own (collect (map (filter (iter verdicts)
                            (fn (verdict)
                              (= (ref (:item verdict)) (:id item))))
                          clone))
        latest (latest-per-position (ref own)))
    (collect (map (range 0 (len (:criteria item)))
               (fn (index)
                 (->criterion-status :position (inc index)
                                     :text (clone (at (:criteria item) index))
                                     :verdict (verdict-at (ref latest)
                                                          (inc index))))))))

(defn latest-per-position (verdicts)
  (let (latest (vec))
    (for-each (reverse verdicts)
      (fn (verdict)
        (when (not (position-present? (ref latest) (:position verdict)))
          (push! latest (clone verdict)))))
    (sort-by! latest :position)
    latest))

(defn position-present? (verdicts position)
  (any? (iter verdicts)
    (fn (verdict)
      (= (:position verdict) position))))

(defn verdict-at (verdicts position)
  (map-some (find (iter verdicts)
              (fn (verdict)
                (= (:position verdict) position)))
            clone))
