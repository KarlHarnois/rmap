(module
  "Checks a new item and a new or removed dependency against the ledger's rules.")

(use ledger/model dep glob item item-id kind origin
                  roadmap-id snapshot)

(use ledger/refusal refusal)
(use ledger/core/snapshot blocks? existing find-item)
(use ledger/core/cycles closes-cycle?)

(export ->new-item check-dep-change check-dep-removal
        check-new-dep check-new-item dep-change distinct
        new-item normalized)

(defstruct new-item
  :parent (option item-id)
  :title string
  :kind kind
  :origin origin
  :priority int
  :globs (vec glob)
  :after (vec item-id)
  :from (option item-id))

(defn check-new-item (snapshot roadmap-id request)
  (let-try (_ (check-epic-has-no-parent request)
            _ (check-build-has-globs request)
            _ (check-parent snapshot roadmap-id request)
            _ (check-all-exist snapshot (ref (:after request))))
    (check-optional-exists snapshot (ref (:from request)))))

(type check-epic-has-no-parent
  (fn ((ref new-item))
    (result unit refusal)))

(defn check-epic-has-no-parent (request)
  (if (and (= (:kind request) kind/epic)
           (some? (:parent request)))
    (err refusal/epic-has-parent)
    (ok (do))))

(type check-build-has-globs
  (fn ((ref new-item))
    (result unit refusal)))

(defn check-build-has-globs (request)
  (if (and (= (:kind request) kind/build)
           (empty? (:globs request)))
    (err refusal/build-needs-paths)
    (ok (do))))

(type check-parent
  (fn ((ref snapshot)
       (ref roadmap-id)
       (ref new-item))
    (result unit refusal)))

(defn check-parent (snapshot roadmap-id request)
  (match (:parent request)
    ((some parent-id)
     (check-parent-item (existing snapshot parent-id) roadmap-id))
    (none (ok (do)))))

(type check-parent-item
  (fn ((result item refusal) (ref roadmap-id))
    (result unit refusal)))

(defn check-parent-item (found roadmap-id)
  (let-try (parent found)
    (cond
      ((not= (:kind parent) kind/epic)
       (err (refusal/parent-not-epic (clone (:id parent)))))
      ((not= (ref (:roadmap-id parent)) roadmap-id)
       (err (refusal/parent-in-other-roadmap (clone (:id parent)))))
      (else (ok (do))))))

(defn check-all-exist (snapshot ids)
  (match (find (iter ids)
           (fn (id)
             (none? (find-item snapshot id))))
    ((some missing)
     (err (refusal/item-not-found (clone missing))))
    (none (ok (do)))))

(defn check-optional-exists (snapshot id)
  (match id
    ((some present)
     (map-ok (existing snapshot present)
       (fn (_) (do))))
    (none (ok (do)))))

(defn check-new-dep (snapshot item on)
  (let-try (_ (existing snapshot item)
            _ (existing snapshot on))
    (cond
      ((blocks-edge? snapshot item on)
       (err (refusal/dep-exists (clone item) (clone on))))
      ((closes-cycle? (ref (:deps snapshot)) item on)
       (err (refusal/cycle (clone item) (clone on))))
      (else (ok (do))))))

(defn check-dep-removal (snapshot item on)
  (if (blocks-edge? snapshot item on)
    (ok (do))
    (err (refusal/dep-not-found (clone item) (clone on)))))

(type blocks-edge?
  (fn ((ref snapshot)
       (ref item-id)
       (ref item-id))
    bool))

(defn blocks-edge? (snapshot item on)
  (any? (iter (:deps snapshot))
    (fn (dep)
      (and (blocks? dep)
           (= (ref (:item dep)) item)
           (= (ref (:on dep)) on)))))

(type distinct
  (where ((a clone partial-eq))
    (fn ((ref (vec a))) (vec a))))

(defn distinct (values)
  (let (unique (vec))
    (for-each values
      (fn (value)
        (when (not (contains? (ref unique) (clone value)))
          (push! unique (clone value)))))
    unique))

(type normalized (fn (new-item) new-item))

(defn normalized (request)
  (let (globs (distinct (ref (:globs request)))
        after (distinct (ref (:after request))))
    (-> request (assoc :globs globs) (assoc :after after))))

(defenum dep-change
  add
  remove)

(type check-dep-change
  (fn ((ref snapshot) (ref dep) dep-change)
    (result unit refusal)))

(defn check-dep-change (snapshot dep change)
  (match change
    (add (check-new-dep snapshot
                        (ref (:item dep))
                        (ref (:on dep))))
    (remove (check-dep-removal snapshot
                               (ref (:item dep))
                               (ref (:on dep))))))
