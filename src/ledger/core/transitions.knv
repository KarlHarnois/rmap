(module
  "Decides whether a move is a legal transition for an item in the ledger.")

(use ledger/model ->path-lock glob item kind path-lock
                  snapshot status)

(use ledger/refusal refusal)

(use ledger/core/move move move-type move-type-of
                      target-status)

(use ledger/core/ready blockage-of unblocked?)
(use ledger/core/index index-of)
(use ledger/core/phases unfinished-statuses)
(use ledger/core/new-items distinct)
(use ledger/core/path-conflicts conflicts-with-active-builds)
(use ledger/core/snapshot globs-of)

(export approved-move)

(defstruct allowance
  :move-type move-type
  :kinds (vec kind)
  :steps (vec (pair status status)))

(defn approved-move (snapshot item move)
  (let (resolved (with-stored-globs snapshot item move))
    (let-try (_ (check-table item (ref resolved))
              _ (check-ledger snapshot item (ref resolved)))
      (ok resolved))))

(defn with-stored-globs (snapshot item move)
  (match move
    ((move/advance-to-build globs)
     (move/advance-to-build (globs-or-stored snapshot item globs)))
    (other other)))

(type globs-or-stored
  (fn ((ref snapshot) (ref item) (vec glob))
    (vec glob)))

(defn globs-or-stored (snapshot item globs)
  (distinct (ref (if (empty? globs)
                   (globs-of snapshot (ref (:id item)))
                   globs))))

(type check-table
  (fn ((ref item) (ref move))
    (result unit refusal)))

(defn check-table (item move)
  (cond
    ((= (:kind item) kind/epic)
     (err refusal/epic-status-computed))
    ((allowed? item move) (ok (do)))
    (else (err (refusal/invalid-transition (:status item)
                                           (target-status item move))))))

(type allowed?
  (fn ((ref item) (ref move)) bool))

(defn allowed? (item move)
  (let (type (move-type-of move)
        step (pair (:status item) (target-status item move)))
    (any? (allowances)
      (fn (allowance)
        (and (= (:move-type allowance) type)
             (contains? (:kinds allowance) (:kind item))
             (contains? (:steps allowance) step))))))

(defn allowances ()
  (vec (->allowance :move-type move-type/claim
                    :kinds (work-kinds)
                    :steps (vec (pair status/open status/dispatched)))
       (->allowance :move-type move-type/advance
                    :kinds (work-kinds)
                    :steps (vec (pair status/dispatched status/open)))
       (->allowance :move-type move-type/advance
                    :kinds (reporting-kinds)
                    :steps (vec (pair status/dispatched status/reported)))
       (->allowance :move-type move-type/advance
                    :kinds (vec kind/build)
                    :steps (vec (pair status/dispatched status/in-review)
                                (pair status/in-review status/fixing)
                                (pair status/in-review status/merging)
                                (pair status/fixing status/in-review)
                                (pair status/merging status/fixing)))
       (->allowance :move-type move-type/advance-to-build
                    :kinds (reporting-kinds)
                    :steps (vec (pair status/reported status/dispatched)))
       (->allowance :move-type move-type/close
                    :kinds (vec kind/build)
                    :steps (vec (pair status/merging status/merged)))
       (->allowance :move-type move-type/close
                    :kinds (reporting-kinds)
                    :steps (vec (pair status/reported status/accepted)))
       (->allowance :move-type move-type/drop
                    :kinds (work-kinds)
                    :steps (steps-to-dropped))))

(defn work-kinds ()
  (vec kind/research kind/design kind/build))

(defn reporting-kinds () (vec kind/research kind/design))

(defn steps-to-dropped ()
  (collect (map (iter (unfinished-statuses))
             (fn (status)
               (pair (deref status) status/dropped)))))

(defn check-ledger (snapshot item move)
  (match move
    ((move/claim _) (check-ready snapshot item))
    ((move/advance-to-build globs)
     (check-free-globs snapshot item globs))
    (_ (ok (do)))))

(defn check-ready (snapshot item)
  (let (blockage (blockage-of snapshot (ref (index-of snapshot)) item))
    (if (unblocked? (ref blockage))
      (ok (do))
      (err (refusal/not-ready blockage)))))

(defn check-free-globs (snapshot item globs)
  (let (conflicts (conflicts-with-active-builds (ref (index-of snapshot))
                                                (ref (build-lock item globs))))
    (cond
      ((empty? globs) (err refusal/build-needs-globs))
      ((empty? conflicts) (ok (do)))
      (else (err (refusal/paths-conflict conflicts))))))

(type build-lock
  (fn ((ref item) (ref (vec glob)))
    path-lock))

(defn build-lock (item globs)
  (->path-lock :item (clone (:id item))
               :kind kind/build
               :globs (clone globs)))
