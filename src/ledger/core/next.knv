(module
  "Lists the next actions for each item and proposed decision, roadmap by roadmap, in the order ready uses.")

(use ledger/model item roadmap snapshot)
(use ledger/model/decisions decision)
(use ledger/model/reports report)
(use ledger/model/criteria criterion-verdict)
(use ledger/model/pull-requests pull-request)
(use ledger/model/sessions live-session)
(use ledger/core/actions next-action)
(use ledger/core/report-actions with-reports)
(use ledger/core/ready readiness-of)
(use ledger/core/snapshot scope work-items-in)
(use ledger/core/order ordered)
(use ledger/core/item-next status-actions)

(use ledger/core/decision-next decision-entries
                               decision-next)

(use ledger/core/decision-actions with-decision-actions)

(export ->deliveries ->next-item deliveries next-entry
        next-item next-of)

(defenum next-entry
  (listed-item next-item)
  (listed-decision decision-next))

(defstruct next-item
  :item item
  :roadmap roadmap
  :actions (vec next-action))

(defstruct deliveries
  :reports (vec report)
  :pull-requests (vec pull-request)
  :criterion-verdicts (vec criterion-verdict)
  :live-reviews (vec live-session))

(type next-of
  (fn ((ref snapshot)
       (ref (vec roadmap))
       (ref deliveries)
       (ref (vec decision)))
    (vec next-entry)))

(defn next-of (snapshot roadmaps deliveries decisions)
  (let (readiness (readiness-of snapshot (ref scope/every-roadmap))
        listed (vec))
    (for-each roadmaps
      (fn (roadmap)
        (for-each (roadmap-next-items snapshot
                                      (ref readiness)
                                      deliveries decisions
                                      roadmap)
                  (fn (entry)
                    (push! listed (clone entry))))))
    listed))

(defn roadmap-next-items (snapshot readiness deliveries decisions roadmap)
  (let (entries (collect (map (iter (decision-entries roadmap decisions))
                           (fn (entry)
                             (next-entry/listed-decision (clone entry))))))
    (for-each (roadmap-item-entries snapshot readiness
                                    deliveries decisions
                                    roadmap)
              (fn (entry)
                (push! entries (clone entry))))
    entries))

(defn roadmap-item-entries (snapshot readiness deliveries decisions roadmap)
  (-> (ordered (work-items-in snapshot roadmap))
      iter
      (map (fn (item)
             (next-entry/listed-item
               (->next-item :item (clone item)
                            :roadmap (clone roadmap)
                            :actions (with-reports (actions-of readiness
                                                               snapshot
                                                               deliveries
                                                               decisions
                                                               item)
                                                   (ref (:reports deliveries))
                                                   item)))))
      (filter (fn (entry) (filled? entry)))
      collect))

(defn filled? (entry)
  (match entry
    ((next-entry/listed-item item)
     (not (empty? (:actions item))))
    ((next-entry/listed-decision decision)
     (not (empty? (:actions decision))))))

(defn actions-of (readiness snapshot deliveries decisions item)
  (with-decision-actions readiness decisions item
                         (status-actions readiness snapshot
                                         (ref (:pull-requests deliveries))
                                         (ref (:criterion-verdicts deliveries))
                                         (ref (:live-reviews deliveries))
                                         item)))
