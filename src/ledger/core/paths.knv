(module
  "Decides when two path globs lock the same files.")

(export conflict?)

(defn conflict? (left right)
  (let (left-prefix (literal-prefix (:pattern left))
        right-prefix (literal-prefix (:pattern right)))
    (or (starts-with? left-prefix (as-str right-prefix))
        (starts-with? right-prefix (as-str left-prefix)))))

(defn literal-prefix (pattern)
  (-> pattern as-str chars
      (take-while (fn (character)
                    (not (wildcard? (deref character)))))
      (map (fn (character) (str character)))
      collect
      (join "")))

(defn wildcard? (character)
  (contains? "*?[{" (as-str (str character))))
