(module
  "Names each next action, the actor who takes it, and builds an action with the actor the table gives.")

(use ledger/model blockage session)
(use ledger/model/reports report-id)

(export action actor actor-of next-action planned
        planned-for-report)

(defstruct next-action
  :action action
  :actor actor
  :session (option session)
  :reasons (option blockage)
  :report (option report-id))

(defenum action
  dispatch
  wait
  ask
  await-decision
  replan
  work
  accept-report
  review
  verify
  fix
  merge
  answer)

(defenum actor
  controller
  agent
  worker
  manager
  user)

(defn planned-for-report (action session report)
  (assoc (planned action session none) :report (some report)))

(defn planned (action session reasons)
  (->next-action :action action
                 :actor (actor-of action)
                 :session session
                 :reasons reasons
                 :report none))

(defn actor-of (action)
  (match action
    (dispatch actor/controller)
    (wait actor/controller)
    (ask actor/agent)
    (await-decision actor/user)
    (replan actor/agent)
    (work actor/worker)
    (accept-report actor/agent)
    (review actor/agent)
    (verify actor/manager)
    (fix actor/worker)
    (merge actor/controller)
    (answer actor/agent)))
