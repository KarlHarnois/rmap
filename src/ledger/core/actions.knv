(module
  "Names each next action, the actor the table gives it, and builds an action.")

(use ledger/model blockage session)
(use ledger/model/reports report-id)

(export action actor actor-of next-action planned planned-by
        planned-for-report)

(defstruct next-action
  :action action
  :actor actor
  :session (option session)
  :reasons (option blockage)
  :report (option report-id))

(defenum action
  dispatch
  wait
  ask
  await-decision
  replan
  work
  accept-report
  review
  verify
  send-fixes
  fix
  merge
  answer)

(defenum actor
  controller
  manager
  worker
  user)

(defn planned-for-report (action session report)
  (assoc (planned action session none) :report (some report)))

(defn planned (action session reasons)
  (planned-by (actor-of action) action session reasons))

(defn planned-by (actor action session reasons)
  (->next-action :action action
                 :actor actor
                 :session session
                 :reasons reasons
                 :report none))

(defn actor-of (action)
  (match action
    (dispatch actor/controller)
    (wait actor/controller)
    (ask actor/manager)
    (await-decision actor/user)
    (replan actor/manager)
    (work actor/worker)
    (accept-report actor/manager)
    (review actor/controller)
    (verify actor/controller)
    (send-fixes actor/manager)
    (fix actor/worker)
    (merge actor/controller)
    (answer actor/manager)))
