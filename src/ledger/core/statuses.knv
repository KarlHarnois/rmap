(module
  "Finds items in a snapshot and computes the status an epic shows from its children.")

(use ledger/model item item-id kind snapshot status)
(use ledger/core/phases finished?)

(export epic-status find-item shown-status-of)

(type find-item
  (fn ((ref snapshot) (ref item-id))
    (option item)))

(defn find-item (snapshot id)
  (-> (:items snapshot)
      iter
      (find (fn (item) (= (ref (:id item)) id)))
      (map-some clone)))

(type shown-status-of
  (fn ((ref item) (option (ref (vec status))))
    status))

(defn shown-status-of (item children)
  (match (:kind item)
    (epic (epic-status children))
    (_ (:status item))))

(type epic-status
  (fn ((option (ref (vec status))))
    status))

(defn epic-status (children)
  (match children
    ((some statuses) (status-of-children statuses))
    (none status/open)))

(defn status-of-children (statuses)
  (if (every? (iter statuses)
        (fn (status) (finished? (deref status))))
    status/merged status/open))
