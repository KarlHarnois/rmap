(module
  "Checks an edit against the ledger and computes the item it changes.")

(use ledger/model exclusivity item)
(use ledger/refusal refusal)
(use ledger/core/criteria check-criteria criteria-input)

(use ledger/core/new-items check-description
                           description-input)

(use ledger/core/phases finished?)
(use ledger/core/priorities check-priority)

(export ->item-edit apply-edit check-criteria-edit
        check-description-edit check-edit criteria-edit
        description-edit item-edit)

(defstruct item-edit
  :title (option string)
  :priority (option int)
  :description description-input
  :criteria criteria-input
  :exclusive (option exclusivity))

(defenum description-edit
  keep
  (set (option string)))

(defenum criteria-edit
  keep
  (set (vec string)))

(type check-edit
  (fn ((ref item) (ref item-edit))
    (result unit refusal)))

(defn check-edit (item edit)
  (if (finished? (:status item))
    (check-finished-edit item edit)
    (check-priority-of edit)))

(defn check-description-edit (description)
  (match description
    (description-edit/keep (ok (do)))
    ((description-edit/set value) (check-description value))))

(defn check-criteria-edit (criteria)
  (match criteria
    (criteria-edit/keep (ok (do)))
    ((criteria-edit/set values) (check-criteria values))))

(type apply-edit
  (fn ((ref item) (ref item-edit) description-edit criteria-edit)
    item))

(defn apply-edit (item edit description criteria)
  (let (titled (with-title (clone item)
                           (ref (:title edit)))
        prioritized (with-priority titled (:priority edit))
        described (with-description prioritized description)
        exclusive (with-exclusive described (:exclusive edit)))
    (with-criteria exclusive criteria)))

(type check-finished-edit
  (fn ((ref item) (ref item-edit))
    (result unit refusal)))

(defn check-finished-edit (item edit)
  (if (changes-locked-field? edit)
    (err (refusal/item-closed (clone (:id item))))
    (ok (do))))

(type changes-locked-field?
  (fn ((ref item-edit)) bool))

(defn changes-locked-field? (edit)
  (or (some? (:title edit))
      (some? (:priority edit))
      (some? (:exclusive edit))))

(type check-priority-of
  (fn ((ref item-edit))
    (result unit refusal)))

(defn check-priority-of (edit)
  (match (:priority edit)
    ((some priority) (check-priority priority))
    (none (ok (do)))))

(type with-title
  (fn (item (ref (option string))) item))

(defn with-title (item title)
  (match title
    ((some value) (assoc item :title (clone value)))
    (none item)))

(type with-priority
  (fn (item (option int)) item))

(defn with-priority (item priority)
  (match priority
    ((some value) (assoc item :priority value))
    (none item)))

(type with-exclusive
  (fn (item (ref (option exclusivity)))
    item))

(defn with-exclusive (item exclusive)
  (match exclusive
    ((some value) (assoc item :exclusive (clone value)))
    (none item)))

(type with-description (fn (item description-edit) item))

(defn with-description (item description)
  (match description
    (description-edit/keep item)
    ((description-edit/set value)
     (assoc item :description (clone value)))))

(type with-criteria (fn (item criteria-edit) item))

(defn with-criteria (item criteria)
  (match criteria
    (criteria-edit/keep item)
    ((criteria-edit/set values)
     (assoc item :criteria (clone values)))))
