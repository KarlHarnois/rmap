(module
  "Names the levels a graph can be drawn at: one node per item, per epic, or per roadmap.")

(export graph-level graph-level-names)

(defenum graph-level
  item
  epic
  roadmap)

(def graph-level-names
  (vec (pair graph-level/item "item")
       (pair graph-level/epic "epic")
       (pair graph-level/roadmap "roadmap")))
