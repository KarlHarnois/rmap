(module
  "Decides which items and dependencies a graph shows: dropped items never, merged and accepted items only with their history.")

(use ledger/model dep item item-id status)
(use ledger/model/graphs history)

(export visible-deps visible-items visible?)

(type visible-items
  (fn ((ref (vec item)) (ref history))
    (vec item)))

(defn visible-items (items history)
  (collect (map (filter (iter items)
                  (fn (item) (visible? item history)))
                clone)))

(defn visible? (item history)
  (match (:status item)
    (dropped false)
    (merged (= (deref history) history/with-merged))
    (accepted (= (deref history) history/with-merged))
    (_ true)))

(type visible-deps
  (fn ((ref (vec dep)) (ref (vec item)))
    (vec dep)))

(defn visible-deps (deps shown)
  (collect (map (filter (iter deps)
                  (fn (dep)
                    (and (shown-id? shown (ref (:item dep)))
                         (shown-id? shown (ref (:on dep))))))
                clone)))

(type shown-id?
  (fn ((ref (vec item)) (ref item-id))
    bool))

(defn shown-id? (shown id)
  (any? (iter shown)
    (fn (item) (= (ref (:id item)) id))))
