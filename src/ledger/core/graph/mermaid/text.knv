(module
  "Writes the pieces of Mermaid source that name things: node ids, escaped text, node labels and subgraph headers.")

(use ledger/model item item-id origin)

(use ledger/names case-name kind-names origin-names
                  status-names)

(use ledger/core/graph/node-states node-state)

(export escaped external-label mermaid-id node-id node-label
        subgraph-header)

(def entity-codes
  (vec (pair (char "\"") "#quot;")
       (pair (char "#") "#35;")
       (pair (char "<") "#lt;")
       (pair (char ">") "#gt;")
       (pair (char "[") "#91;")
       (pair (char "]") "#93;")))

(defn escaped (text)
  (join (collect (map (chars text) escaped-char))
        ""))

(defn escaped-char (character)
  (match (find (iter entity-codes)
           (fn (entry)
             (= (first (deref entry)) character)))
    ((some entry) (str (second (deref entry))))
    (none (str character))))

(type node-id
  (fn ((ref item-id)) string))

(defn node-id (id)
  (mermaid-id (as-str (:value id))))

(defn mermaid-id (id)
  (join (collect (map (chars id) id-char))
        ""))

(defn id-char (character)
  (if (= character (char "-"))
    (str "_")
    (str character)))

(type subgraph-header
  (fn ((ref str) (ref str) (ref str))
    string))

(defn subgraph-header (id prefix title)
  (str "subgraph "
       (mermaid-id id)
       "[\"" prefix ": "
       (escaped title)
       "\"]"))

(type node-label
  (fn ((ref item) (ref node-state))
    string))

(defn node-label (item state)
  (str (:value (:id item))
       "<br/>"
       (escaped (as-str (:title item)))
       "<br/><i>"
       (case-name kind-names (:kind item))
       " · "
       (state-text state)
       (origin-text (:origin item))
       "</i>"))

(type external-label
  (fn ((ref item) (ref node-state) (ref str))
    string))

(defn external-label (item state roadmap-name)
  (str (node-label item state) "<br/>" (escaped roadmap-name)))

(defn state-text (state)
  (match (deref state)
    (node-state/ready (str "ready"))
    ((node-state/stored status)
     (str (case-name status-names status)))))

(defn origin-text (origin)
  (match origin
    (origin/planned (str ""))
    (_ (str " · " (case-name origin-names origin)))))
