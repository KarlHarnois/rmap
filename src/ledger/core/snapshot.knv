(module
  "Answers questions about one snapshot of the ledger: which item has an id, what it depends on, and which items a scope covers.")

(use ledger/model dep dep-type item item-id kind roadmap
                  roadmap-id snapshot)

(use ledger/refusal refusal)

(export blocked-by blocks? deps-of existing find-item
        in-scope? scope work-items-in)

(defenum scope
  every-roadmap
  (one-roadmap roadmap-id))

(defn existing (snapshot id)
  (ok-or (find-item snapshot id)
         (refusal/item-not-found (clone id))))

(type find-item
  (fn ((ref snapshot) (ref item-id))
    (option item)))

(defn find-item (snapshot id)
  (-> (:items snapshot)
      iter
      (find (fn (item) (= (ref (:id item)) id)))
      (map-some clone)))

(defn blocked-by (snapshot id)
  (collect (map (filter (iter (deps-of snapshot id))
                  (fn (dep) (blocks? dep)))
                (fn (dep) (clone (:on dep))))))

(type deps-of
  (fn ((ref snapshot) (ref item-id))
    (vec dep)))

(defn deps-of (snapshot id)
  (collect (map (filter (iter (:deps snapshot))
                  (fn (dep) (= (ref (:item dep)) id)))
                clone)))

(type blocks? (fn ((ref dep)) bool))

(defn blocks? (dep)
  (= (:type dep) dep-type/blocks))

(type work-items-in
  (fn ((ref snapshot) (ref roadmap))
    (vec item)))

(defn work-items-in (snapshot roadmap)
  (collect (map (filter (iter (:items snapshot))
                  (fn (item)
                    (and (not= (:kind item) kind/epic)
                         (= (:roadmap-id item) (:id roadmap)))))
                clone)))

(type in-scope?
  (fn ((ref item) (ref scope)) bool))

(defn in-scope? (item scope)
  (match scope
    (every-roadmap true)
    ((one-roadmap id) (= (ref (:roadmap-id item)) id))))
