(module
  "Finds the path conflicts between an item's globs and the paths active builds hold.")

(use ledger/model ->path-conflict glob item-id item-path
                  path-conflict snapshot)

(use ledger/core/paths conflict?)
(use ledger/core/index active-paths ledger-index)

(export conflicts-with-active-builds globs-of)

(type globs-of
  (fn ((ref snapshot) (ref item-id))
    (vec glob)))

(defn globs-of (snapshot id)
  (-> (:paths snapshot)
      iter
      (filter (fn (path) (= (ref (:item path)) id)))
      (map (fn (path) (clone (:glob path))))
      collect))

(type conflicts-with-active-builds
  (fn ((ref ledger-index)
       (ref item-id)
       (ref (vec glob)))
    (vec path-conflict)))

(defn conflicts-with-active-builds (index id globs)
  (let (conflicts (vec))
    (for-each (active-paths index)
      (fn (held)
        (when (not= (ref (:item held)) id)
          (for-each globs
            (fn (glob)
              (when (conflict? glob (ref (:glob held)))
                (push! conflicts (held-conflict held (clone glob)))))))))
    conflicts))

(type held-conflict
  (fn ((ref item-path) glob) path-conflict))

(defn held-conflict (held glob)
  (->path-conflict :with (clone (:item held))
                   :glob glob
                   :other-glob (clone (:glob held))))
