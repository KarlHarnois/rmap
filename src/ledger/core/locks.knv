(module
  "Finds the path conflicts between an item's globs and the active builds.")

(use ledger/model ->path-conflict glob item item-id kind
                  path-conflict snapshot status)

(use ledger/core/paths conflict?)
(use ledger/core/statuses find-item)

(export conflicts-with-active-builds globs-of)

(type globs-of
  (fn ((ref snapshot) (ref item-id))
    (vec glob)))

(defn globs-of (snapshot id)
  (-> (:paths snapshot)
      iter
      (filter (fn (path) (= (ref (:item path)) id)))
      (map (fn (path) (clone (:glob path))))
      collect))

(type conflicts-with-active-builds
  (fn ((ref snapshot)
       (ref item-id)
       (ref (vec glob)))
    (vec path-conflict)))

(defn conflicts-with-active-builds (snapshot id globs)
  (-> (:paths snapshot)
      iter
      (filter (fn (path)
                (and (not= (ref (:item path)) id)
                     (active-build-id? snapshot (ref (:item path))))))
      (map (fn (path)
             (conflicts-with-path globs
                                  (ref (:item path))
                                  (ref (:glob path)))))
      collect flatten-conflicts))

(defn conflicts-with-path (globs other-id other-glob)
  (-> globs iter
      (filter (fn (glob) (conflict? glob other-glob)))
      (map (fn (glob)
             (->path-conflict :with (clone other-id)
                              :glob (clone glob)
                              :other-glob (clone other-glob))))
      collect))

(type flatten-conflicts
  (fn ((vec (vec path-conflict)))
    (vec path-conflict)))

(defn flatten-conflicts (groups)
  (let (all (vec))
    (for-each groups
      (fn (group)
        (for-each group
          (fn (conflict)
            (push! all (clone conflict))))))
    all))

(defn active-build-id? (snapshot id)
  (match (find-item snapshot id)
    ((some item) (active-build? (ref item)))
    (none false)))

(type active-build?
  (fn ((ref item)) bool))

(defn active-build? (item)
  (and (= (:kind item) kind/build)
       (contains? (vec status/dispatched status/reported
                       status/in-review status/fixing
                       status/merging)
                  (:status item))))
