(module
  "Answers which decisions hold an item and whether a decision may start blocking one.")

(use ledger/model decision-block decision-status item)
(use ledger/core/decisions check-revisable)
(use ledger/core/decision-placement check-block)

(export blocking-decisions blocking-status? check-block-add)

(defn blocking-decisions (snapshot item)
  (collect (map (filter (iter (:decision-blocks snapshot))
                  (fn (block)
                    (and (blocking-status? (:status block))
                         (blocks-item? block item))))
                (fn (block) (clone (:decision block))))))

(defn blocking-status? (status)
  (or (= status decision-status/proposed)
      (= status decision-status/rejected)))

(defn check-block-add (snapshot index decision item)
  (let-try (_ (check-revisable decision))
    (check-block snapshot index
                 (ref (:roadmap-id decision))
                 item)))

(type blocks-item?
  (fn ((ref decision-block) (ref item))
    bool))

(defn blocks-item? (block item)
  (or (= (ref (:item block)) (ref (:id item)))
      (= (:parent item)
         (some (clone (:item block))))))
