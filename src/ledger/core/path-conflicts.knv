(module
  "Decides which paths two items' locks both claim, and finds the path conflicts between an item and the active builds.")

(use ledger/model ->path-conflict glob kind path-conflict
                  path-lock)

(use ledger/core/paths conflict?)
(use ledger/core/index active-locks ledger-index)

(export conflicts-with-active-builds lock-conflicts)

(type conflicts-with-active-builds
  (fn ((ref ledger-index) (ref path-lock))
    (vec path-conflict)))

(defn conflicts-with-active-builds (index claimant)
  (let (conflicts (vec))
    (for-each (active-locks index)
      (fn (holder)
        (when (not= (ref (:item holder))
                    (ref (:item claimant)))
          (for-each (lock-conflicts claimant holder)
            (fn (conflict)
              (push! conflicts (clone conflict)))))))
    conflicts))

(defn lock-conflicts (claimant holder)
  (if (and (takes-locks? claimant) (takes-locks? holder))
    (overlapping-globs claimant holder)
    (vec)))

(type takes-locks?
  (fn ((ref path-lock)) bool))

(defn takes-locks? (lock)
  (= (:kind lock) kind/build))

(type overlapping-globs
  (fn ((ref path-lock) (ref path-lock))
    (vec path-conflict)))

(defn overlapping-globs (claimant holder)
  (let (conflicts (vec))
    (for-each (:globs claimant)
      (fn (glob)
        (for-each (:globs holder)
          (fn (held)
            (when (conflict? glob held)
              (push! conflicts (held-conflict holder glob held)))))))
    conflicts))

(type held-conflict
  (fn ((ref path-lock) (ref glob) (ref glob))
    path-conflict))

(defn held-conflict (holder glob held)
  (->path-conflict :with (clone (:item holder))
                   :glob (clone glob)
                   :other-glob (clone held)))
