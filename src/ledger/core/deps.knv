(module
  "Checks adding and removing a blocks dependency.")

(use ledger/model dep item-id snapshot)
(use ledger/refusal refusal)
(use ledger/core/snapshot blocks? existing)
(use ledger/core/cycles closes-cycle?)

(export check-dep-change dep-change)

(defn check-new-dep (snapshot item on)
  (let-try (_ (existing snapshot item)
            _ (existing snapshot on))
    (cond
      ((blocks-edge? snapshot item on)
       (err (refusal/dep-exists (clone item) (clone on))))
      ((closes-cycle? (ref (:deps snapshot)) item on)
       (err (refusal/cycle (clone item) (clone on))))
      (else (ok (do))))))

(defn check-dep-removal (snapshot item on)
  (if (blocks-edge? snapshot item on)
    (ok (do))
    (err (refusal/dep-not-found (clone item) (clone on)))))

(type blocks-edge?
  (fn ((ref snapshot)
       (ref item-id)
       (ref item-id))
    bool))

(defn blocks-edge? (snapshot item on)
  (any? (iter (:deps snapshot))
    (fn (dep)
      (and (blocks? dep)
           (= (ref (:item dep)) item)
           (= (ref (:on dep)) on)))))

(defenum dep-change
  add
  remove)

(type check-dep-change
  (fn ((ref snapshot) (ref dep) dep-change)
    (result unit refusal)))

(defn check-dep-change (snapshot dep change)
  (match change
    (add (check-new-dep snapshot
                        (ref (:item dep))
                        (ref (:on dep))))
    (remove (check-dep-removal snapshot
                               (ref (:item dep))
                               (ref (:on dep))))))
