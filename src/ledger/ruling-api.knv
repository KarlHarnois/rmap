(module
  "Holds the rulings part of the ledger's public surface: the values, recording and reading rulings, and what is settled.")

(use ledger/model/rulings ruling)
(use ledger/core/rulings ruling-visibility)

(use ledger/operations/rulings add-ruling list-rulings
                               show-ruling)

(use ledger/operations/settled read-settled settled)

(export add-ruling list-rulings read-settled ruling
        ruling-visibility settled show-ruling)
