(module
  "Names each ledger refusal, its stable code, what the code means, and a sentence for the user.")

(use ledger/model blockage item-id path-conflict status)
(use ledger/names name-of status-names)

(export refusal refusal->message refusal-catalog
        refusal-code-text refusal-description)

(defenum refusal
  (roadmap-not-found string)
  (roadmap-exists string)
  (item-not-found item-id)
  (parent-not-epic item-id)
  (parent-in-other-roadmap item-id)
  epic-has-parent
  build-needs-paths
  epic-status-computed
  invalid-kind-change
  (invalid-transition status status)
  (not-ready blockage)
  (paths-conflict (vec path-conflict))
  (cycle item-id item-id)
  (dep-exists item-id item-id)
  (dep-not-found item-id item-id))

(defenum refusal-code
  roadmap-not-found
  roadmap-exists
  item-not-found
  parent-not-epic
  parent-in-other-roadmap
  epic-has-parent
  build-needs-paths
  epic-status-computed
  invalid-kind-change
  invalid-transition
  not-ready
  path-conflict
  cycle
  dep-exists
  dep-not-found)

(defstruct refusal-description
  :code string
  :meaning string)

(defn code-of (refused)
  (match refused
    ((refusal/roadmap-not-found _)
     refusal-code/roadmap-not-found)
    ((refusal/roadmap-exists _) refusal-code/roadmap-exists)
    ((refusal/item-not-found _) refusal-code/item-not-found)
    ((refusal/parent-not-epic _) refusal-code/parent-not-epic)
    ((refusal/parent-in-other-roadmap _)
     refusal-code/parent-in-other-roadmap)
    (refusal/epic-has-parent refusal-code/epic-has-parent)
    (refusal/build-needs-paths refusal-code/build-needs-paths)
    (refusal/epic-status-computed refusal-code/epic-status-computed)
    (refusal/invalid-kind-change refusal-code/invalid-kind-change)
    ((refusal/invalid-transition _ _)
     refusal-code/invalid-transition)
    ((refusal/not-ready _) refusal-code/not-ready)
    ((refusal/paths-conflict _) refusal-code/path-conflict)
    ((refusal/cycle _ _) refusal-code/cycle)
    ((refusal/dep-exists _ _) refusal-code/dep-exists)
    ((refusal/dep-not-found _ _) refusal-code/dep-not-found)))

(defn described (code meaning)
  (->refusal-description :code (str code)
                         :meaning (str meaning)))

(defn description-of (code)
  (match code
    (roadmap-not-found (described "roadmap-not-found"
                                  "No roadmap has that name."))
    (roadmap-exists (described "roadmap-exists"
                               "A roadmap already has that name."))
    (item-not-found (described "item-not-found" "No item has that id."))
    (parent-not-epic (described "parent-not-epic" "The parent is not an epic."))
    (parent-in-other-roadmap (described
                               "parent-in-other-roadmap"
                               "The parent belongs to another roadmap."))
    (epic-has-parent (described "epic-has-parent"
                                "An epic cannot have a parent."))
    (build-needs-paths (described "build-needs-paths"
                                  "A build needs at least one path."))
    (epic-status-computed (described "epic-status-computed"
                                     "An epic's status comes from its children, so no command moves it."))
    (invalid-kind-change (described "invalid-kind-change"
                                    "Only an advance to dispatched can turn an item into a build."))
    (invalid-transition (described "invalid-transition"
                                   "The transition table has no such move for this item."))
    (not-ready (described "not-ready"
                          "The item is blocked or path-conflicted. The error lists blockers, dropped_blockers and path_conflicts."))
    (path-conflict (described "path-conflict"
                              "The build's paths conflict with an active build. The error lists path_conflicts."))
    (cycle (described
             "cycle"
             "The dependency would close a cycle of blocks dependencies."))
    (dep-exists (described "dep-exists"
                           "The blocks dependency already exists."))
    (dep-not-found (described "dep-not-found"
                              "No such blocks dependency exists."))))

(defn refusal-code-text (refused)
  (clone (:code (description-of (code-of refused)))))

(defn refusal-catalog ()
  (collect (map (iter (vec refusal-code/roadmap-not-found
                           refusal-code/roadmap-exists
                           refusal-code/item-not-found
                           refusal-code/parent-not-epic
                           refusal-code/parent-in-other-roadmap
                           refusal-code/epic-has-parent
                           refusal-code/build-needs-paths
                           refusal-code/epic-status-computed
                           refusal-code/invalid-kind-change
                           refusal-code/invalid-transition
                           refusal-code/not-ready
                           refusal-code/path-conflict
                           refusal-code/cycle
                           refusal-code/dep-exists
                           refusal-code/dep-not-found))
                (fn (code)
                  (description-of (deref code))))))

(defn refusal->message (failure)
  (match failure
    ((roadmap-not-found name) (str "no roadmap is named " name))
    ((roadmap-exists name)
     (str "a roadmap named " name " already exists"))
    ((item-not-found id)
     (str "no item has the id " (:value id)))
    ((parent-not-epic id)
     (str "the parent " (:value id) " is not an epic"))
    ((parent-in-other-roadmap id)
     (str "the parent "
          (:value id)
          " belongs to another roadmap"))
    (epic-has-parent (str "an epic cannot have a parent"))
    (build-needs-paths (str "a build item needs at least one path"))
    (epic-status-computed (str
                            "an epic's status is computed from its children"))
    (invalid-kind-change (str "only an advance to dispatched can turn an item into a build"))
    ((invalid-transition from to)
     (str "an item cannot move from "
          (name-of status-names from)
          " to "
          (name-of status-names to)))
    ((not-ready _) (str "the item is not ready"))
    ((paths-conflict _)
     (str "the paths conflict with an active build"))
    ((cycle item on)
     (str (:value item)
          " after "
          (:value on)
          " would close a cycle"))
    ((dep-exists item on)
     (str (:value item) " already depends on " (:value on)))
    ((dep-not-found item on)
     (str (:value item) " does not depend on " (:value on)))))
