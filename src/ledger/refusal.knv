(module
  "Names each way the ledger refuses a call.")

(use ledger/model blockage decision-id decision-status
                  external-blocker-id item-id kind session
                  status)

(use ledger/model/rulings ruling-id)
(use ledger/model/pull-requests head)
(use ledger/model/reports report-id)
(use ledger/model/criteria criterion-gap)
(use ledger/pull-request-refusals pull-request-refusal)

(export pull-request-refusal refusal)

(defenum refusal
  (roadmap-not-found string)
  (roadmap-exists string)
  (roadmap-already-paused string)
  (roadmap-not-paused string)
  (max-active-out-of-range int)
  (item-not-found item-id)
  (item-closed item-id)
  description-required
  criteria-required
  blank-criterion
  (parent-not-epic item-id)
  (parent-in-other-roadmap item-id)
  epic-has-parent
  (priority-out-of-range int)
  epic-status-computed
  invalid-kind-change
  (invalid-transition status status)
  (not-ready blockage)
  (cycle item-id item-id)
  (dep-exists item-id item-id)
  (dep-not-found item-id item-id)
  (decision-not-found decision-id)
  (decision-frozen decision-id decision-status)
  (decision-incomplete string)
  (invalid-decision-transition decision-id decision-status
                               decision-status)
  (option-not-found decision-id int)
  (already-asked decision-id)
  (not-blockable item-id)
  (decision-in-other-roadmap item-id)
  (decision-block-exists decision-id item-id)
  (decision-block-not-found decision-id item-id)
  blank-external-blocker
  (external-blocker-not-found external-blocker-id)
  (external-blocker-cleared external-blocker-id)
  (external-blocker-in-other-item external-blocker-id item-id)
  (supersede-target-not-accepted decision-id)
  (decisions-pending (vec decision-id))
  (ruling-not-found ruling-id)
  (ruling-superseded ruling-id)
  (proposal-incomplete string)
  (proposal-duplicate string)
  (proposal-target-not-found string)
  (proposal-cycle string)
  (proposal-source-kind item-id kind)
  (proposal-writer session item-id)
  (proposal-decision-not-raised decision-id item-id)
  (unknown-skip decision-id int (vec string))
  (session-busy session)
  (session-not-live session)
  (session-not-claimant session item-id)
  report-empty
  (report-not-found report-id)
  (report-already-read report-id)
  (criteria-unmet (vec criterion-gap))
  (verifier-not-reviewer session)
  (verifier-is-worker session)
  (verifier-is-manager session)
  (criterion-not-found item-id int)
  verdict-head-required
  (verdict-head-not-current head head)
  (pull-request pull-request-refusal))
