(module
  "Names each refusal code.")

(use ledger/pull-request-refusal-codes pull-request-refusal-code)

(export refusal-code)

(defenum refusal-code
  roadmap-not-found
  roadmap-exists
  roadmap-already-paused
  roadmap-not-paused
  max-active-out-of-range
  item-not-found
  item-closed
  description-required
  criteria-required
  blank-criterion
  parent-not-epic
  parent-in-other-roadmap
  epic-has-parent
  priority-out-of-range
  epic-status-computed
  invalid-kind-change
  invalid-transition
  not-ready
  cycle
  dep-exists
  dep-not-found
  decision-not-found
  decision-frozen
  decision-incomplete
  invalid-decision-transition
  option-not-found
  already-asked
  not-blockable
  decision-in-other-roadmap
  decision-block-exists
  decision-block-not-found
  blank-external-blocker
  external-blocker-not-found
  external-blocker-cleared
  external-blocker-in-other-item
  supersede-target-not-accepted
  decisions-pending
  ruling-not-found
  ruling-superseded
  proposal-incomplete
  proposal-duplicate
  proposal-target-not-found
  proposal-cycle
  proposal-source-kind
  proposal-writer
  proposal-decision-not-raised
  unknown-skip
  session-busy
  session-not-live
  session-not-claimant
  report-empty
  report-not-found
  report-already-read
  criteria-unmet
  verifier-not-reviewer
  verifier-is-worker
  verifier-is-manager
  criterion-not-found
  verdict-head-required
  verdict-head-not-current
  (pull-request pull-request-refusal-code))
