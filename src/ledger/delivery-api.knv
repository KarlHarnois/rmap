(module
  "Holds the deliveries part of the ledger's public surface: a worker's reports, a build's pull request, and the reviews that approve it.")

(use ledger/model/reports ->report-id ->report-query
                          ->report-request body-source
                          recorded-report report report-id
                          report-kind report-query
                          report-reading report-request)

(use ledger/model/pull-requests ->review-request approval
                                pull-request recorded-head
                                recorded-review review
                                review-request)

(use ledger/operations/reports read-report record-report)

(use ledger/operations/report-queries list-reports
                                      show-report)

(use ledger/operations/reviews record-review)
(use ledger/operations/head-records record-head)
(use ledger/operations/pull-requests show-pull-request)
(use ledger/core/requirements approval-of approved?)

(use ledger/names report-kind-names review-kind-names
                  verdict-names)

(export ->report-id ->report-query ->report-request
        ->review-request approval approval-of approved?
        body-source list-reports pull-request read-report
        record-head record-report record-review
        recorded-head recorded-report recorded-review report
        report-id report-kind report-kind-names report-query
        report-reading report-request review
        review-kind-names review-request show-pull-request
        show-report verdict-names)
