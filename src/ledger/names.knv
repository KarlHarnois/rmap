(module
  "Pairs each ledger enum case with the text that names it in the database and on the command line.")

(use ledger/model/events event-type)
(use ledger/model/sessions end-reason)
(use ledger/model/reports report-kind)
(use ledger/model/pull-requests review-kind verdict)

(use ledger/model decision-status dep-type graph-format kind
                  origin roadmap-status runtime session-kind
                  status)

(export case-name case-named decision-status-names
        dep-type-names end-reason-names event-type-names
        graph-format-names kind-names origin-names
        report-kind-names review-kind-names
        roadmap-status-names runtime-names
        session-kind-names status-names verdict-names)

(def roadmap-status-names
  (vec (pair roadmap-status/active "active")
       (pair roadmap-status/paused "paused")
       (pair roadmap-status/done "done")))

(def kind-names
  (vec (pair kind/epic "epic")
       (pair kind/research "research")
       (pair kind/design "design")
       (pair kind/build "build")))

(def status-names
  (vec (pair status/open "open")
       (pair status/dispatched "dispatched")
       (pair status/reported "reported")
       (pair status/in-review "in_review")
       (pair status/fixing "fixing")
       (pair status/merging "merging")
       (pair status/merged "merged")
       (pair status/accepted "accepted")
       (pair status/dropped "dropped")))

(def origin-names
  (vec (pair origin/planned "planned")
       (pair origin/user-bug "user-bug")
       (pair origin/follow-up "follow-up")))

(def session-kind-names
  (vec (pair session-kind/work "work")
       (pair session-kind/fix "fix")
       (pair session-kind/review "review")))

(def runtime-names
  (vec (pair runtime/ringleader "ringleader")))

(def end-reason-names
  (vec (pair end-reason/reopened "reopened")
       (pair end-reason/replaced "replaced")
       (pair end-reason/finished "finished")
       (pair end-reason/superseded "superseded")
       (pair end-reason/abandoned "abandoned")))

(def dep-type-names
  (vec (pair dep-type/blocks "blocks")
       (pair dep-type/discovered-from "discovered_from")))

(def event-type-names
  (vec (pair event-type/roadmap-created "roadmap-created")
       (pair event-type/roadmap-paused "roadmap-paused")
       (pair event-type/roadmap-resumed "roadmap-resumed")
       (pair event-type/item-added "item-added")
       (pair event-type/item-claimed "item-claimed")
       (pair event-type/item-advanced "item-advanced")
       (pair event-type/item-closed "item-closed")
       (pair event-type/item-dropped "item-dropped")
       (pair event-type/edited "edited")
       (pair event-type/dep-added "dep-added")
       (pair event-type/dep-removed "dep-removed")
       (pair event-type/decision-proposed "decision-proposed")
       (pair event-type/decision-revised "decision-revised")
       (pair event-type/decision-asked "decision-asked")
       (pair event-type/decision-accepted "decision-accepted")
       (pair event-type/decision-rejected "decision-rejected")
       (pair event-type/decision-deprecated "decision-deprecated")
       (pair event-type/decision-block-added
             "decision-block-added")
       (pair event-type/decision-block-removed
             "decision-block-removed")
       (pair event-type/item-reported "item-reported")
       (pair event-type/report-read "report-read")
       (pair event-type/item-reviewed "item-reviewed")
       (pair event-type/head-recorded "head-recorded")
       (pair event-type/review-started "review-started")
       (pair event-type/session-ended "session-ended")))

(def report-kind-names
  (vec (pair report-kind/done "done")
       (pair report-kind/fixed "fixed")
       (pair report-kind/question "question")))

(def review-kind-names
  (vec (pair review-kind/behavior "behavior")
       (pair review-kind/design "design")))

(def verdict-names
  (vec (pair verdict/changes "changes")
       (pair verdict/approve "approve")))

(def decision-status-names
  (vec (pair decision-status/proposed "proposed")
       (pair decision-status/accepted "accepted")
       (pair decision-status/rejected "rejected")
       (pair decision-status/deprecated "deprecated")
       (pair decision-status/superseded "superseded")))

(def graph-format-names
  (vec (pair graph-format/mermaid "mermaid")))

(defn case-name (names value)
  (-> names iter
      (find (fn (entry)
              (let-match ((pair case _) (deref entry))
                (= case value))))
      (map-some (fn (entry)
                  (let-match ((pair _ name) (deref entry))
                    name)))
      (unwrap-or "")))

(defn case-named (names text)
  (-> names iter
      (find (fn (entry)
              (let-match ((pair _ name) (deref entry))
                (= (str name) (str text)))))
      (map-some (fn (entry)
                  (let-match ((pair case _) (deref entry))
                    case)))))
