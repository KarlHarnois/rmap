(module
  "Holds the ledger's own settings, its initialization and the roadmap collection.")

(use ledger/operations/database-path default-database-path)

(use ledger/operations/init init-ledger init-outcome
                            init-outcome-names init-report)

(use ledger/operations/roadmap-lifecycle pause-roadmap
                                         resume-roadmap)

(use ledger/operations/roadmaps list-roadmaps new-roadmap)

(use ledger/operations/transaction ->settings clock
                                   settings)

(export ->settings clock default-database-path init-ledger
        init-outcome init-outcome-names init-report
        list-roadmaps new-roadmap pause-roadmap
        resume-roadmap settings)
